# ==============================================================================
# Applicatie Omgevingsvariabelen (.env)
# ==============================================================================
# Kopieer dit bestand naar '.env' en pas de waarden aan voor jouw omgeving:
# cp .env.example .env
# ==============================================================================

# --- Basis Server Instellingen ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Optioneel voor productie domein validatie (bijv. voorbeeld.be):
# APP_DOMAIN=voorbeeld.be
# ALLOWED_DOMAINS=voorbeeld.be,www.voorbeeld.be

# --- Beveiliging ---
# VERPLICHT: Kies een willekeurige, geheime en lange string
SESSION_SECRET=replace_with_a_secure_random_string_at_least_32_chars

# --- Organisatie Gegevens ---
# Vervangt hardcoded organisatienamen en adressen in de hele applicatie
ORG_NAME=naam van de organisatie
ORG_FULL_NAME=Volledige organisatie naam
ORG_LOCATION=Locatie van de organisatie
ORG_ADDRESS_STREET=Straatnaam
ORG_POSTAL_CODE=Postcode
ORG_ADDRESS_REGION=Provincie
ORG_COUNTRY=Land
ORG_FACEBOOK_URL=https://www.facebook.com/jeVereniging
ORG_KEYWORDS=Chiro, jeugdbeweging, activiteiten, jeugdorganisatie

# --- E-mail & SMTP Configuratie ---
# Standaard SMTP instellingen voor het verzenden van e-mails (bevestigingen, notificaties, etc.)
SMTP_HOST=smtp.voorbeeld.be
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@voorbeeld.be
SMTP_PASS=jouw_smtp_wachtwoord

# Afzender e-mailadres (weergegeven als afzender in mails)
MAIL_FROM="voorbeeld" <noreply@voorbeeld.be>

# Ontvangers voor formulieren en beheer
CONTACT_EMAIL=contact@voorbeeld.be
ADMIN_EMAIL=admin@voorbeeld.be

# --- Web Push Meldingen (VAPID) ---
# Genereer nieuwe sleutels indien gewenst via: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# --- Google reCAPTCHA (Anti-spam voor contactformulier) ---
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# --- Feature Flags / Functionaliteit ---
FEED_PAGINATION_LIMIT=10
DISABLE_CONTACT_FORM=false
ENABLE_PUBLIC_REGISTRATIONS_VIEW=true
SHOW_GAMES_TO_ALL=true
