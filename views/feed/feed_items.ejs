<% posts.forEach(post => { 
    const avatarColor = getAvatarColor(post.author ? post.author.username : '');
    const initials = getInitials(post.author ? post.author.username : '');
%>
    <div class="card post-card mb-4" id="post-<%= post.id %>">
        <div class="card-header bg-transparent border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center">
                <% if (post.author && post.author.profilePicture) { %>
                    <img src="<%= post.author.profilePicture %>" class="rounded-circle me-3 flex-shrink-0 border shadow-sm" style="width: 45px; height: 45px; object-fit: cover; cursor: pointer;" alt="<%= capitalizeName(post.author.username) %>" onclick="showPolaroid('<%= post.author.profilePicture %>', '<%= capitalizeName(post.author.username) %>')">
                <% } else { %>
                    <div class="avatar-circle me-3" style="background-color: <%= avatarColor %>;">
                        <%= initials %>
                    </div>
                <% } %>
                <div>
                    <h6 class="mb-0 fw-bold"><%= post.author ? capitalizeName(post.author.username) : 'Onbekend' %></h6>
                    <small class="text-muted" style="font-size: 0.8rem;">
                        <%= new Date(post.createdAt).toLocaleDateString('nl-BE', { timeZone: 'Europe/Brussels', day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit' }) %>
                    </small>
                </div>
            </div>
            <% if ((post.author && user && post.author.id === user.id) || user.role === 'admin') { %>
                <div class="dropdown">
                    <button class="btn btn-link text-muted p-0" type="button" data-bs-toggle="dropdown" aria-label="Opties voor bericht">
                        <i class="bi bi-three-dots-vertical"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end border-0 shadow">
                        <li><a class="dropdown-item" href="#" onclick="enableEditMode('<%= post.id %>'); return false;"><i class="bi bi-pencil me-2"></i>Bewerken</a></li>
                        <li>
                            <form action="/feed/post/<%= post.id %>/delete" method="POST" onsubmit="return confirm('Post verwijderen?');">
                                <button type="submit" class="dropdown-item text-danger"><i class="bi bi-trash me-2"></i>Verwijderen</button>
                            </form>
                        </li>
                    </ul>
                </div>
            <% } %>
        </div>

        <div class="card-body">
            <!-- Post Content -->
            <div id="post-content-view-<%= post.id %>" class="mb-3">
                <div id="post-text-container-<%= post.id %>" class="post-text-container">
                    <div class="card-text text-dark" style="font-size: 1.05rem; white-space: pre-line;"><%- highlightMentions(post.content) %></div>

                    <!-- Attachments (Moved inside container) -->
                    <% if (post.attachments && post.attachments.length > 0) { %>
                        <div class="mt-3 d-flex flex-wrap gap-2">
                            <% post.attachments.forEach(file => { %>
                                <a href="<%= file.path %>" onclick="openFilePreview('<%= file.path %>', '<%= file.originalName %>'); return false;" class="btn btn-light btn-sm border text-primary">
                                    <i class="bi bi-file-earmark-text me-1"></i> <%= file.originalName %>
                                </a>
                            <% }) %>
                        </div>
                    <% } %>

                    <!-- Polls & Forms (Moved inside container) -->
                    <% if (post.poll) { 
                        const polls = Array.isArray(post.poll) ? post.poll : [post.poll];
                        polls.forEach((pollItem, pollIndex) => {
                    %>
                        <div class="bg-light p-3 rounded-3 mt-3 border poll-wrapper" data-post-id="<%= post.id %>">
                            <% 
                                // Filter responses for THIS poll index
                                const pollResponses = post.responses.filter(r => {
                                    if (r.type !== 'poll') return false;
                                    const rData = typeof r.data === 'string' ? JSON.parse(r.data) : r.data;
                                    const rIdx = (rData && rData.pollIndex !== undefined) ? parseInt(rData.pollIndex) : 0;
                                    return rIdx === pollIndex;
                                });
                                const totalVotes = pollResponses.length;
                                
                                const counts = {};
                                const voters = {}; 
                                pollItem.options.forEach((opt, idx) => { counts[idx] = 0; voters[idx] = []; });
                                let myVotes = [];
                                
                                pollResponses.forEach(r => {
                                    const rData = typeof r.data === 'string' ? JSON.parse(r.data) : r.data;
                                    let indices = Array.isArray(rData.optionIndices) ? rData.optionIndices : (rData.optionIndex !== undefined ? (Array.isArray(rData.optionIndex) ? rData.optionIndex : [parseInt(rData.optionIndex)]) : []);
                                    indices.forEach(idx => {
                                        if (counts[idx] !== undefined) {
                                            counts[idx]++;
                                            if(r.user) voters[idx].push(capitalizeName(r.user.username));
                                        }
                                    });
                                    if (r.userId === user.id) myVotes = indices;
                                });

                                const pollData = {
                                    question: pollItem.question,
                                    options: pollItem.options,
                                    counts: counts,
                                    voters: voters,
                                    totalVotes: totalVotes
                                };
                            %>
                            <h6 class="font-playful mb-3 poll-results-header" style="cursor: pointer;" onclick="showPollResults(this)" data-poll-results='<%= JSON.stringify(pollData).replace(/'/g, "&#39;") %>'>
                                <i class="bi bi-bar-chart-fill text-primary me-2"></i><%= pollItem.question %> <i class="bi bi-info-circle-fill text-muted ms-2" style="font-size: 0.8rem;"></i>
                            </h6>

                            <div class="poll-options-container" data-allow-multiple="<%= pollItem.allowMultiple %>">
                                <% pollItem.options.forEach((option, index) => { 
                                    const optText = typeof option === 'string' ? option : option.text;
                                    const addedBy = typeof option === 'string' ? null : option.addedBy;
                                    const count = counts[index] || 0;
                                    const pct = totalVotes > 0 ? Math.round((count / totalVotes) * 100) : 0;
                                    const isChecked = myVotes.includes(index);
                                %>
                                    <!-- Option Item -->
                                    <div class="poll-option-item position-relative mb-2 rounded-4 overflow-hidden border <%= isChecked ? 'border-primary border-2' : 'border-light' %> bg-white" 
                                         style="cursor: pointer; transition: transform 0.1s ease, border-color 0.2s;"
                                         onclick="togglePollVote(this, '<%= post.id %>', <%= pollIndex %>, <%= index %>, <%= pollItem.allowMultiple %>)"
                                         data-index="<%= index %>"
                                         data-selected="<%= isChecked %>">
                                        
                                        <!-- Progress Bar (Background) -->
                                        <div class="poll-progress-bar position-absolute top-0 start-0 h-100 bg-primary" 
                                             style="width: <%= pct %>%; opacity: 0.15; transition: width 0.6s cubic-bezier(0.4, 0, 0.2, 1); z-index: 0;"></div>
                                        
                                        <!-- Content -->
                                        <div class="position-relative p-3 d-flex align-items-center justify-content-between" style="z-index: 1;">
                                            <div class="d-flex align-items-center flex-grow-1">
                                                <i class="bi <%= isChecked ? 'bi-check-circle-fill text-primary' : (pollItem.allowMultiple ? 'bi-square text-muted' : 'bi-circle text-muted') %> poll-check-icon fs-5 me-3 transition-base"></i>
                                                <div class="d-flex flex-column">
                                                    <span class="fw-bold text-dark small option-text"><%= optText %></span>
                                                    <% if (addedBy) { %>
                                                        <small class="text-muted fst-italic" style="font-size: 0.65rem;">
                                                            Toegevoegd door <%= capitalizeName(addedBy) %>
                                                        </small>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <div class="ms-3 text-end">
                                                <span class="fw-bold text-primary small poll-percent-text"><%= pct %>%</span>
                                            </div>
                                        </div>
                                        
                                        <!-- Voters (Collapsible/Small) -->
                                        <div class="poll-voters-container px-3 pb-2 <%= voters[index].length > 0 ? '' : 'd-none' %>" style="z-index: 1; position: relative;">
                                            <div class="small text-muted fst-italic" style="font-size: 0.7rem;">
                                                <i class="bi bi-people-fill me-1 opacity-50"></i>
                                                <span class="poll-voters-list"><%= voters[index].slice(0, 3).join(', ') %><% if(voters[index].length > 3) { %>, ...<% } %></span>
                                            </div>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>

                            <% if (pollItem.allowUserOptions) { %>
                                <div class="mt-3 user-add-option-container">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 py-2 small fw-500 transition-all" 
                                            onclick="showAddUserOption(this)"
                                            style="border-width: 1.5px; display: inline-block;">
                                        <i class="bi bi-plus-circle me-2"></i> Optie toevoegen
                                    </button>
                                    <div class="add-option-input-wrapper d-none mt-2">
                                        <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                                            <input type="text" 
                                                   class="form-control form-control-sm border-0 ps-3" 
                                                   placeholder="Typ je optie..." 
                                                   onkeydown="if(event.key==='Enter') { event.preventDefault(); addUserPollOption(this, '<%= post.id %>', <%= pollIndex %>); } else if(event.key==='Escape') { event.preventDefault(); cancelAddUserOption(this); }"
                                                   style="flex: 1;">
                                            <button class="btn btn-primary border-0" 
                                                    type="button" 
                                                    onclick="addUserPollOption(this, '<%= post.id %>', <%= pollIndex %>)"
                                                    title="Optie toevoegen (Enter)"
                                                    style="padding: 0.4rem 0.9rem; white-space: nowrap;">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                            <button class="btn btn-outline-secondary border-0 border-start" 
                                                    type="button" 
                                                    onclick="cancelAddUserOption(this)"
                                                    title="Annuleren (Escape)"
                                                    style="padding: 0.4rem 0.9rem; white-space: nowrap;">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </div>
                                        <small class="text-muted mt-2 d-block" style="font-size: 0.75rem; margin-left: 0.25rem;">
                                            <i class="bi bi-info-circle me-1"></i>Je stemt automatisch op je eigen optie
                                        </small>
                                    </div>
                                </div>
                            <% } %>
                        </div>
                    <%  }); 
                       } 
                    %>

                    <% if (post.form) { %>
                        <div class="card border-info mt-3 mb-0">
                            <div class="card-header bg-info text-white py-1 small fw-bold">Formulier</div>
                            <div class="card-body p-3">
                                <% const myResponse = post.responses.find(r => r.userId === user.id && r.type === 'form'); %>
                                <% if (myResponse) { %>
                                    <div class="badge bg-success mb-2">Ingevuld!</div>
                                <% } %>
                                <form action="/feed/respond" method="POST">
                                    <input type="hidden" name="postId" value="<%= post.id %>">
                                    <input type="hidden" name="type" value="form">
                                    <% post.form.forEach((field, idx) => { %>
                                        <div class="mb-2">
                                            <label class="form-label small fw-bold mb-0"><%= field.label %></label>
                                            <% if (field.type === 'text') { %>
                                                <input type="text" class="form-control form-control-sm" name="data[<%= field.label %>]" required aria-label="<%= field.label %>">
                                            <% } else if (field.type === 'checkbox') { %>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="checkbox" name="data[<%= field.label %>]" value="Ja" aria-label="<%= field.label %>">
                                                    <label class="form-check-label small">Ja</label>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% }) %>
                                    <button type="submit" class="btn btn-sm btn-primary rounded-pill mt-2" <%= myResponse ? 'disabled' : '' %>>Verstuur</button>
                                </form>
                                <hr class="my-2">
                                <a class="text-decoration-none small text-muted" data-bs-toggle="collapse" href="#results-<%= post.id %>">
                                    <i class="bi bi-eye"></i> Bekijk <%= post.responses.filter(r => r.type === 'form').length %> inzendingen
                                </a>
                                <div class="collapse mt-2" id="results-<%= post.id %>">
                                    <div class="bg-light rounded p-2 small">
                                        <% post.responses.filter(r => r.type === 'form').forEach(r => { %>
                                            <div class="mb-1">
                                                <strong class="text-dark"><%= r.user ? capitalizeName(r.user.username) : 'Onbekend' %></strong>:
                                                <span class="text-muted"><%= typeof r.data === 'object' ? JSON.stringify(r.data).replace(/[{"}]/g, '').replace(/:/g, ': ') : r.data %></span>
                                            </div>
                                        <% }) %>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } %>
                </div>
                <button id="read-more-btn-<%= post.id %>" class="btn btn-link btn-sm p-0 text-decoration-none d-none mt-1 fw-bold" onclick="expandPost('<%= post.id %>')">
                    Meer weergeven <i class="bi bi-chevron-down"></i>
                </button>
            </div>

            <div id="post-content-edit-<%= post.id %>" class="d-none mb-3">
                <form action="/feed/post/<%= post.id %>/update" method="POST" enctype="multipart/form-data">
                    <textarea class="form-control rich-editor mb-2" name="content" rows="3"><%= post.content %></textarea>
                    
                    <% if (post.attachments && post.attachments.length > 0) { %>
                        <div class="mb-2 p-2 border rounded bg-light">
                            <label class="small text-muted fw-bold d-block mb-2">Bestaande bestanden:</label>
                            <% post.attachments.forEach((file, idx) => { %>
                                <div class="d-flex justify-content-between align-items-center mb-1 p-2 bg-white border rounded">
                                    <span class="small text-muted text-truncate me-2"><i class="bi bi-file-earmark"></i> <%= file.originalName %></span>
                                    <div>
                                        <input type="checkbox" class="btn-check" name="removed_attachments[]" value="<%= file.path %>" id="remove-<%= post.id %>-<%= idx %>" autocomplete="off">
                                        <label class="btn btn-sm btn-outline-danger" for="remove-<%= post.id %>-<%= idx %>">
                                            <i class="bi bi-trash"></i> Verwijderen
                                        </label>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="mb-2">
                         <label class="small text-muted fw-bold">Bestanden toevoegen:</label>
                         <input type="file" class="form-control form-control-sm" name="attachments" multiple>
                    </div>

                    <!-- Poll Builder for Edit -->
                    <div class="mb-2">
                        <button class="btn btn-outline-primary btn-sm rounded-pill mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#pollBuilder-<%= post.id %>">
                            <i class="bi bi-bar-chart"></i> Polls Bewerken
                        </button>
                        <div class="collapse mb-3 p-3 rounded bg-light" id="pollBuilder-<%= post.id %>">
                            <h6 class="font-playful">Polls</h6>
                            <div id="pollsContainer-<%= post.id %>">
                                <% if (post.poll) { 
                                    const polls = Array.isArray(post.poll) ? post.poll : [post.poll];
                                    polls.forEach((pollItem, pIdx) => { 
                                        const uniqueId = 'edit_' + post.id + '_' + pIdx;
                                %>
                                    <div class="card border-0 shadow-sm mb-3 poll-item overflow-hidden" id="poll-item-<%= uniqueId %>" style="border-radius: 15px;">
                                        <div class="card-header bg-primary text-white border-0 d-flex justify-content-between align-items-center py-2 px-3">
                                            <h6 class="mb-0 small fw-bold"><i class="bi bi-gear-fill me-2 opacity-75"></i>Poll Configureren</h6>
                                            <button type="button" class="btn-close btn-close-white small" style="font-size: 0.7rem;" aria-label="Verwijder poll" onclick="removePoll('<%= uniqueId %>')"></button>
                                        </div>
                                        <div class="card-body p-3 bg-white">
                                            <div class="mb-3">
                                                <label class="form-label small text-muted fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Stel je vraag</label>
                                                <div class="input-group input-group-sm rounded-3 overflow-hidden border">
                                                    <span class="input-group-text bg-light border-0 text-primary px-3"><i class="bi bi-question-circle-fill"></i></span>
                                                    <input type="text" class="form-control form-control-sm fw-bold border-0 ps-1 bg-light" name="polls[<%= uniqueId %>][question]" placeholder="Waar wil je over stemmen?" value="<%= pollItem.question %>" required>
                                                </div>
                                            </div>
                                            
                                            <div class="row g-2 mb-3">
                                                <div class="col-sm-6">
                                                    <div class="form-check form-switch p-2 rounded-3 border bg-light d-flex align-items-center justify-content-between px-3">
                                                        <label class="form-check-label small mb-0 ms-1 text-dark fw-500" for="pollMultiple-<%= uniqueId %>">Meerdere stemmen</label>
                                                        <input class="form-check-input ms-0 mt-0 shadow-none" type="checkbox" name="polls[<%= uniqueId %>][multiple]" id="pollMultiple-<%= uniqueId %>" <%= pollItem.allowMultiple ? 'checked' : '' %>>
                                                    </div>
                                                </div>
                                                <div class="col-sm-6">
                                                    <div class="form-check form-switch p-2 rounded-3 border bg-light d-flex align-items-center justify-content-between px-3">
                                                        <label class="form-check-label small mb-0 ms-1 text-dark fw-500" for="pollUserOptions-<%= uniqueId %>">User kan antwoorden toevoegen</label>
                                                        <input class="form-check-input ms-0 mt-0 shadow-none" type="checkbox" name="polls[<%= uniqueId %>][allowUserOptions]" id="pollUserOptions-<%= uniqueId %>" <%= pollItem.allowUserOptions ? 'checked' : '' %>>
                                                    </div>
                                                </div>
                                            </div>

                                            <label class="form-label small text-muted fw-bold text-uppercase mb-1" style="font-size: 0.65rem; letter-spacing: 0.5px;">Antwoordopties</label>
                                            <div id="pollOptions-<%= uniqueId %>" class="poll-options-list mb-2">
                                                <% pollItem.options.forEach((opt, oIdx) => { 
                                                    const valText = typeof opt === 'string' ? opt : (opt.text || '');
                                                %>
                                                    <div class="input-group input-group-sm mb-2 shadow-none transition-all rounded-3 overflow-hidden border">
                                                        <span class="input-group-text bg-white border-0 text-muted opacity-50 px-3"><i class="bi bi-grip-vertical"></i></span>
                                                        <input type="text" class="form-control form-control-sm border-0 ps-1" name="polls[<%= uniqueId %>][options][]" placeholder="Optie <%= oIdx + 1 %>" value="<%= valText %>">
                                                        <% if (oIdx >= 2) { %>
                                                            <button class="btn btn-outline-danger border-0 px-3" type="button" onclick="const p=this.parentElement; p.style.opacity='0'; p.style.transform='translateX(10px)'; setTimeout(()=>p.remove(), 200);"><i class="bi bi-trash-fill"></i></button>
                                                        <% } else { %>
                                                            <button class="btn btn-outline-light text-muted border-0 disabled opacity-25 px-3" type="button"><i class="bi bi-x-lg"></i></button>
                                                        <% } %>
                                                    </div>
                                                <% }) %>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill w-100 mt-1 py-1 fw-bold transition-all" style="font-size: 0.75rem; border-style: dashed; border-width: 2px;" onclick="addOptionToPoll('<%= uniqueId %>')">
                                                <i class="bi bi-plus-circle-fill me-1"></i> Extra optie toevoegen
                                            </button>
                                        </div>
                                    </div>
                                <%  }); } %>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill mt-2" onclick="addPoll('pollsContainer-<%= post.id %>')">
                                <i class="bi bi-plus-circle"></i> Poll Toevoegen
                            </button>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-sm btn-success rounded-pill">Opslaan</button>
                    <button type="button" class="btn btn-sm btn-light rounded-pill" onclick="disableEditMode('<%= post.id %>')">Annuleren</button>
                </form>
            </div>

            <!-- Action Bar (Likes & Comment Count) -->
            <div class="d-flex align-items-center justify-content-start justify-content-md-between mt-3 pt-3 border-top gap-3 gap-md-0">
                <div class="d-flex align-items-center">
                    <% 
                        const likes = post.likes || [];
                        const isLiked = likes.some(l => l.userId === user.id);
                        const likeCount = likes.length;
                        const likerNames = likes.map(l => l.user ? capitalizeName(l.user.username) : 'Onbekend').join(', ');
                        const firstLikerName = likes.length > 0 ? (likes[0].user ? capitalizeName(likes[0].user.username) : 'Onbekend') : '';
                        const likerArray = likes.map(l => l.user ? { username: l.user.username, profilePicture: l.user.profilePicture } : { username: 'Onbekend', profilePicture: null });
                    %>
                    <form action="/feed/post/<%= post.id %>/like" method="POST" class="like-form" data-post-id="<%= post.id %>">
                        <button type="submit" class="btn btn-action d-flex align-items-center <%= isLiked ? 'text-danger' : 'text-muted' %> bg-transparent border-0 p-0 me-3" aria-label="Vind ik leuk">
                            <i class="bi <%= isLiked ? 'bi-heart-fill' : 'bi-heart' %> fs-5 me-1"></i>
                            <span class="fw-bold like-count"><%= likeCount > 0 ? likeCount : '' %></span>
                        </button>
                    </form>
                    <% if (likeCount > 0) { %>
                        <small class="text-muted likers-list" 
                               style="font-size: 0.8rem; max-width: 200px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; cursor: pointer;"
                               data-likers='<%= JSON.stringify(likerArray).replace(/'/g, "&#39;") %>'
                               onclick="showLikesModal(this)">
                            <span class="likers-desktop d-none d-md-inline"><%= likerNames %></span>
                            <span class="likers-mobile d-inline d-md-none"><%= firstLikerName %><%= likeCount > 1 ? '...' : '' %></span>
                        </small>
                    <% } else { %>
                        <small class="text-muted likers-list" style="cursor: pointer;" onclick="showLikesModal(this)">
                            <span class="likers-desktop d-none d-md-inline"></span>
                            <span class="likers-mobile d-inline d-md-none"></span>
                        </small>
                    <% } %>
                </div>
                <div class="text-muted small comment-count-container">
                    <span class="comment-count-desktop d-none d-md-inline">
                        <span class="comment-count-number"><%= post.comments.length %></span> reacties
                    </span>
                    <span class="comment-count-mobile d-inline d-md-none">
                        <i class="bi bi-chat me-1"></i><span class="comment-count-number"><%= post.comments.length %></span>
                    </span>
                </div>
            </div>
        </div>

        <!-- Comments Section -->
        <div class="bg-light bg-opacity-50 p-3 rounded-bottom-4">
            <div class="comments-section-wrapper">
                <% 
                    const visibleComments = post.comments.slice(0, 2);
                    const hiddenComments = post.comments.slice(2);
                %>

                <% visibleComments.forEach(comment => { %>
                    <%- include('comment_partial', { comment: comment, user: user, post: post, depth: 0 }) %>
                <% }) %>

                <% if (hiddenComments.length > 0) { %>
                    <div class="collapse" id="hidden-comments-<%= post.id %>">
                        <% hiddenComments.forEach(comment => { %>
                            <%- include('comment_partial', { comment: comment, user: user, post: post, depth: 0 }) %>
                        <% }) %>
                    </div>
                    <button class="btn btn-link btn-sm text-decoration-none text-muted ps-0" type="button" data-bs-toggle="collapse" data-bs-target="#hidden-comments-<%= post.id %>" onclick="this.textContent = this.textContent.includes('Toon') ? 'Verberg reacties' : 'Toon meer reacties...'">
                        Toon meer reacties...
                    </button>
                <% } %>
            </div>

            <!-- New Comment Input -->
            <form action="/feed/comment" method="POST" class="mt-3 d-flex align-items-end comment-form">
                <% if (user.profilePicture) { %>
                    <img src="<%= user.profilePicture %>" class="rounded-circle me-2 flex-shrink-0 border shadow-sm mb-1" style="width: 32px; height: 32px; object-fit: cover; cursor: pointer;" alt="<%= capitalizeName(user.username) %>" onclick="showPolaroid('<%= user.profilePicture %>', '<%= capitalizeName(user.username) %>')">
                <% } else { %>
                    <div class="avatar-circle me-2 mb-1" style="background-color: <%= getAvatarColor(user.username) %>; width: 32px; height: 32px; font-size: 0.8rem;">
                        <%= getInitials(user.username) %>
                    </div>
                <% } %>
                <input type="hidden" name="postId" value="<%= post.id %>">
                <textarea name="content" class="form-control border-0 bg-white shadow-sm" placeholder="Schrijf een reactie..." required rows="1" style="resize: none; overflow: hidden; border-radius: 1rem;" oninput="autoResize(this)"></textarea>
                <button class="btn btn-link text-primary mb-1" type="submit" aria-label="Verstuur reactie"><i class="bi bi-send-fill"></i></button>
            </form>
        </div>
    </div>
<% }) %>