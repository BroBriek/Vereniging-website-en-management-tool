<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="font-playful"><i class="bi bi-folder2-open me-2 text-primary"></i>Bestanden</h1>
  <a href="/feed/group/<%= group.slug %>" class="btn btn-light rounded-pill px-3 shadow-sm">
    <i class="bi bi-arrow-left me-1"></i> Terug naar <%= group.name %>
  </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="card-header bg-white border-0 py-3">
    <h5 class="mb-0 fw-bold">Alle geüploade bestanden in <span class="text-primary"><%= group.name %></span></h5>
  </div>
  <div class="card-body p-0">
    <% if (files.length === 0) { %>
      <div class="p-5 text-center">
        <i class="bi bi-file-earmark-text display-1 text-muted opacity-25"></i>
        <p class="mt-3 text-muted">Nog geen bestanden geüpload in deze groep.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-4">Naam</th>
              <th>Type</th>
              <th class="text-end pe-4">Acties</th>
            </tr>
          </thead>
          <tbody>
            <% files.forEach(f => { 
                const ext = f.originalName.split('.').pop().toUpperCase();
            %>
              <tr>
                <td class="ps-4">
                  <a href="/download?path=<%= encodeURIComponent(f.path) %>&name=<%= encodeURIComponent(f.originalName) %>" onclick="openFilePreview('<%= f.path %>', '<%= f.originalName %>'); return false;" class="text-decoration-none fw-medium text-dark d-flex align-items-center">
                    <i class="bi bi-file-earmark-<%= ['PDF','JPG','JPEG','PNG','DOC','DOCX'].includes(ext) ? 'text' : 'code' %> me-3 fs-5 text-primary"></i>
                    <%= f.originalName %>
                  </a>
                </td>
                <td><span class="badge bg-light text-dark border"><%= ext %></span></td>
                <td class="text-end pe-4">
                  <div class="btn-group">
                    <button class="btn btn-sm btn-outline-primary rounded-start-pill px-3" onclick="openFilePreview('<%= f.path %>', '<%= f.originalName %>')">
                      <i class="bi bi-eye"></i>
                    </button>
                    <a class="btn btn-sm btn-outline-secondary rounded-end-pill px-3" href="/feed/group/<%= group.slug %>#post-<%= f.postId %>" title="Ga naar post">
                      <i class="bi bi-chat-left-text"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<script>
// triggerDownload and openFilePreview are now provided by /js/download-helper.js
</script>

<%- include('../partials/footer') %>
