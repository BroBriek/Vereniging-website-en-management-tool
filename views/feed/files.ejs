<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="font-playful"><i class="bi bi-folder2-open me-2 text-primary"></i>Bestanden</h1>
  <a href="/feed/group/<%= group.slug %>" class="btn btn-light rounded-pill px-3 shadow-sm">
    <i class="bi bi-arrow-left me-1"></i> Terug naar <%= group.name %>
  </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="card-header bg-white border-0 py-3">
    <h5 class="mb-0 fw-bold">Alle geüploade bestanden in <span class="text-primary"><%= group.name %></span></h5>
  </div>
  <div class="card-body p-0">
    <% if (files.length === 0) { %>
      <div class="p-5 text-center">
        <i class="bi bi-file-earmark-text display-1 text-muted opacity-25"></i>
        <p class="mt-3 text-muted">Nog geen bestanden geüpload in deze groep.</p>
      </div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
          <thead class="bg-light">
            <tr>
              <th class="ps-4">Naam</th>
              <th>Type</th>
              <th class="text-end pe-4">Acties</th>
            </tr>
          </thead>
          <tbody>
            <% files.forEach(f => { 
                const ext = f.originalName.split('.').pop().toUpperCase();
            %>
              <tr>
                <td class="ps-4">
                  <a href="<%= f.path %>" onclick="openFilePreview('<%= f.path %>', '<%= f.originalName %>'); return false;" class="text-decoration-none fw-medium text-dark d-flex align-items-center">
                    <i class="bi bi-file-earmark-<%= ['PDF','JPG','JPEG','PNG','DOC','DOCX'].includes(ext) ? 'text' : 'code' %> me-3 fs-5 text-primary"></i>
                    <%= f.originalName %>
                  </a>
                </td>
                <td><span class="badge bg-light text-dark border"><%= ext %></span></td>
                <td class="text-end pe-4">
                  <div class="btn-group">
                    <button class="btn btn-sm btn-outline-primary rounded-start-pill px-3" onclick="openFilePreview('<%= f.path %>', '<%= f.originalName %>')">
                      <i class="bi bi-eye"></i>
                    </button>
                    <a class="btn btn-sm btn-outline-secondary rounded-end-pill px-3" href="/feed/group/<%= group.slug %>#post-<%= f.postId %>" title="Ga naar post">
                      <i class="bi bi-chat-left-text"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>

<!-- File Preview Modal -->
<div class="modal fade" id="filePreviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0 shadow" style="height: 90vh;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title font-playful text-truncate" id="previewFileName" style="max-width: 80%;">Bestand</h5>
        <div class="d-flex gap-2">
            <a id="previewDownloadBtn" href="#" class="btn btn-primary btn-sm rounded-pill">
                <i class="bi bi-download"></i> Download
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
        </div>
      </div>
      <div class="modal-body p-0 h-100 position-relative bg-light">
        <div id="previewLoader" class="position-absolute top-50 start-50 translate-middle text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Laden...</p>
        </div>
        <iframe id="previewFrame" src="" class="w-100 h-100 border-0 rounded-bottom-4 d-none"></iframe>
        <div id="previewImageContainer" class="w-100 h-100 d-none d-flex align-items-center justify-content-center bg-white rounded-bottom-4 overflow-auto">
            <img id="previewImage" src="" class="img-fluid" style="max-height: 100%; object-fit: contain;">
        </div>
        <div id="previewError" class="d-none position-absolute top-50 start-50 translate-middle text-center p-4 w-100">
            <i class="bi bi-file-earmark-x display-1 text-muted"></i>
            <h5 class="mt-3">Voorbeeld niet beschikbaar</h5>
            <p class="text-muted mb-3">Dit bestandstype kan niet worden weergegeven in de browser of we kunnen er niet bij.</p>
            <a id="previewErrorDownloadBtn" href="#" class="btn btn-primary rounded-pill mt-2">
                <i class="bi bi-download"></i> Download Bestand
            </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
// triggerDownload and openFilePreview are now provided by /js/download-helper.js
</script>

<%- include('../partials/footer') %>
