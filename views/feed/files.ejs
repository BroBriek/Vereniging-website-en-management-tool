<%- include('../partials/header') %>

<style>
  /* Premium Responsive Files View Styles */
  @media (max-width: 768px) {
    /* Hide the original table headers */
    #filesTable thead {
      display: none !important;
    }
    
    /* Make table structure behave like a card list */
    #filesTable, 
    #filesTable tbody, 
    #filesTable tr, 
    #filesTable td {
      display: block !important;
      width: 100% !important;
    }
    
    /* Style each row as an individual modern list item */
    #filesTable tbody tr {
      border-bottom: 1px solid #f1f3f5 !important;
      padding: 1.25rem 1rem !important;
      position: relative !important;
      background-color: #ffffff !important;
      transition: background-color 0.2s ease !important;
    }
    
    #filesTable tbody tr:last-child {
      border-bottom: none !important;
    }
    
    #filesTable tbody tr:hover {
      background-color: #fafbfc !important;
    }
    
    /* Reset default table cell properties */
    #filesTable td {
      padding: 0 !important;
      border: none !important;
      text-align: left !important;
      background: transparent !important;
    }
    
    /* First Column: File icon and name */
    #filesTable td:nth-child(1) {
      margin-bottom: 0.4rem !important;
      padding-right: 95px !important; /* Extra padding to prevent filename overlapping buttons */
    }
    
    #filesTable td:nth-child(1) a {
      font-size: 0.95rem;
      font-weight: 600;
      color: #2c3e50 !important;
      display: flex !important;
      align-items: flex-start !important;
    }
    
    #filesTable td:nth-child(1) a i {
      margin-top: 0.15rem;
      margin-right: 0.75rem !important; /* cleaner gap */
    }
    
    /* Second Column: Badge for extension */
    #filesTable td:nth-child(2) {
      display: inline-block !important;
      width: auto !important;
      vertical-align: middle !important;
    }
    
    #filesTable td:nth-child(2) .badge {
      font-size: 0.75rem !important;
      padding: 0.25em 0.5em !important;
      font-weight: 500 !important;
      border-radius: 4px !important;
    }
    
    /* Separation dot between Badge and Date */
    #filesTable td:nth-child(2)::after {
      content: "•" !important;
      margin: 0 0.5rem !important;
      color: #cbd5e1 !important;
      font-weight: bold !important;
    }
    
    /* Third Column: Upload Date */
    #filesTable td:nth-child(3) {
      display: inline-block !important;
      width: auto !important;
      font-size: 0.8rem !important;
      color: #64748b !important;
      vertical-align: middle !important;
    }
    
    /* Fourth Column: Actions Container */
    #filesTable td:nth-child(4) {
      position: absolute !important;
      top: 1.1rem !important;
      right: 1rem !important;
      width: auto !important;
    }
    
    #filesTable td:nth-child(4) .btn-group {
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06) !important;
      border-radius: 50rem !important;
      overflow: hidden !important;
    }
    
    #filesTable td:nth-child(4) .btn {
      padding: 0.35rem 0.75rem !important;
    }
  }

  /* File Name Word Wrapping on all screen sizes */
  #filesTable td:nth-child(1) a {
    word-break: break-all;
    word-wrap: break-word;
    overflow-wrap: break-word;
  }
</style>

<% const isTetter = (typeof isTetterhoekje !== 'undefined' && isTetterhoekje) || (group && group.isTetterhoekje); %>
<% const groupBaseUrl = isTetter ? '/tetterhoekje' : '/feed'; %>
<% const backUrl = group && group.slug ? `${groupBaseUrl}/group/${group.slug}` : groupBaseUrl; %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="font-playful"><i class="bi bi-folder2-open me-2 text-primary"></i>Bestanden</h1>
  <a href="<%= backUrl %>" class="btn btn-light rounded-pill px-3 shadow-sm">
    <i class="bi bi-arrow-left me-1"></i>
    <span class="d-none d-sm-inline">Terug naar <%= group.name %></span>
    <span class="d-inline d-sm-none">Terug</span>
  </a>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden">
  <div class="card-header bg-white border-0 py-3">
    <h5 class="mb-0 fw-bold">Alle geüploade bestanden in <span class="text-primary"><%= group.name %></span></h5>
  </div>
  <div class="card-body p-0">
    <% if (files.length === 0) { %>
      <div class="p-5 text-center">
        <i class="bi bi-file-earmark-text display-1 text-muted opacity-25"></i>
        <p class="mt-3 text-muted">Nog geen bestanden geüpload in deze groep.</p>
      </div>
    <% } else { %>
      <!-- Search bar and filter controls -->
      <div class="px-4 pt-3 pb-2">
        <div class="row g-2 align-items-center">
          <div class="col-12 col-md-6 col-lg-5">
            <div class="position-relative">
              <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 14px; pointer-events: none;"></i>
              <input type="text" id="filesSearchInput" class="form-control rounded-pill ps-5 border-light shadow-sm" placeholder="Zoek bestanden..." autocomplete="off">
            </div>
          </div>
          <div class="col-12 col-md-6 col-lg-4">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-funnel text-muted"></i>
              <select id="filesSortSelect" class="form-select form-select-sm rounded-pill border-light shadow-sm w-100 flex-grow-1" style="max-width: 280px;">
                <option value="newest" selected>Nieuwste eerst</option>
                <option value="oldest">Oudste eerst</option>
                <option value="name-asc">Naam (A → Z)</option>
                <option value="name-desc">Naam (Z → A)</option>
                <option value="type-asc">Type (A → Z)</option>
                <option value="type-desc">Type (Z → A)</option>
              </select>
            </div>
          </div>
          <div class="col-12 col-lg-3">
            <span id="filesResultCount" class="text-muted small"></span>
          </div>
        </div>
      </div>

      <div class="table-responsive">
        <table class="table table-hover align-middle mb-0" id="filesTable">
          <thead class="bg-light">
            <tr>
              <th class="ps-4">Naam</th>
              <th>Type</th>
              <th>Datum</th>
              <th class="text-end pe-4">Acties</th>
            </tr>
          </thead>
          <tbody id="filesTableBody">
            <% files.forEach(f => { 
                const ext = f.originalName.split('.').pop().toUpperCase();
                const uploadDate = f.createdAt ? new Date(f.createdAt) : null;
            %>
              <tr data-name="<%= f.originalName.toLowerCase() %>" data-ext="<%= ext.toLowerCase() %>" data-date="<%= uploadDate ? uploadDate.toISOString() : '' %>">
                <td class="ps-4">
                  <a href="/download?path=<%= encodeURIComponent(f.path) %>&name=<%= encodeURIComponent(f.originalName) %>" onclick="openFilePreview('<%= f.path %>', '<%= f.originalName %>'); return false;" class="text-decoration-none fw-medium text-dark d-flex align-items-center">
                    <i class="bi bi-file-earmark-<%= ['PDF','JPG','JPEG','PNG','DOC','DOCX'].includes(ext) ? 'text' : 'code' %> me-3 fs-5 text-primary"></i>
                    <%= f.originalName %>
                  </a>
                </td>
                <td><span class="badge bg-light text-dark border"><%= ext %></span></td>
                <td class="text-muted small text-nowrap">
                  <% if (uploadDate) { %>
                    <%= uploadDate.toLocaleDateString('nl-BE', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  <% } else { %>
                    —
                  <% } %>
                </td>
                <td class="text-end pe-4">
                  <div class="btn-group">
                    <button class="btn btn-sm btn-outline-primary rounded-start-pill px-3" onclick="openFilePreview('<%= f.path %>', '<%= f.originalName %>')">
                      <i class="bi bi-eye"></i>
                    </button>
                    <a class="btn btn-sm btn-outline-secondary rounded-end-pill px-3" href="<%= backUrl %>#post-<%= f.postId %>" title="Ga naar post">
                      <i class="bi bi-chat-left-text"></i>
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>

      <!-- No results message (hidden by default) -->
      <div id="filesNoResults" class="p-4 text-center d-none">
        <i class="bi bi-search display-4 text-muted opacity-25"></i>
        <p class="mt-2 text-muted">Geen bestanden gevonden die overeenkomen met je zoekopdracht.</p>
      </div>
    <% } %>
  </div>
</div>

<script>
// triggerDownload and openFilePreview are now provided by /js/download-helper.js
</script>

<% if (files.length > 0) { %>
<script>
(function() {
  const searchInput = document.getElementById('filesSearchInput');
  const sortSelect = document.getElementById('filesSortSelect');
  const tbody = document.getElementById('filesTableBody');
  const noResults = document.getElementById('filesNoResults');
  const resultCount = document.getElementById('filesResultCount');
  const totalFiles = <%= files.length %>;

  function getRows() {
    return Array.from(tbody.querySelectorAll('tr'));
  }

  function updateResultCount(visibleCount) {
    if (searchInput.value.trim()) {
      resultCount.textContent = visibleCount + ' van ' + totalFiles + ' bestanden';
    } else {
      resultCount.textContent = totalFiles + ' bestanden';
    }
  }

  function filterRows() {
    const query = searchInput.value.trim().toLowerCase();
    const rows = getRows();
    let visible = 0;

    rows.forEach(row => {
      const name = row.getAttribute('data-name') || '';
      const ext = row.getAttribute('data-ext') || '';
      const match = !query || name.includes(query) || ext.includes(query);
      row.style.display = match ? '' : 'none';
      if (match) visible++;
    });

    noResults.classList.toggle('d-none', visible > 0);
    document.getElementById('filesTable').classList.toggle('d-none', visible === 0);
    updateResultCount(visible);
  }

  function sortRows() {
    const sortBy = sortSelect.value;
    const rows = getRows();

    rows.sort((a, b) => {
      switch (sortBy) {
        case 'newest': {
          const dA = a.getAttribute('data-date') || '';
          const dB = b.getAttribute('data-date') || '';
          return dB.localeCompare(dA);
        }
        case 'oldest': {
          const dA = a.getAttribute('data-date') || '';
          const dB = b.getAttribute('data-date') || '';
          return dA.localeCompare(dB);
        }
        case 'name-asc': {
          const nA = a.getAttribute('data-name') || '';
          const nB = b.getAttribute('data-name') || '';
          return nA.localeCompare(nB, 'nl');
        }
        case 'name-desc': {
          const nA = a.getAttribute('data-name') || '';
          const nB = b.getAttribute('data-name') || '';
          return nB.localeCompare(nA, 'nl');
        }
        case 'type-asc': {
          const eA = a.getAttribute('data-ext') || '';
          const eB = b.getAttribute('data-ext') || '';
          return eA.localeCompare(eB, 'nl') || (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '', 'nl');
        }
        case 'type-desc': {
          const eA = a.getAttribute('data-ext') || '';
          const eB = b.getAttribute('data-ext') || '';
          return eB.localeCompare(eA, 'nl') || (a.getAttribute('data-name') || '').localeCompare(b.getAttribute('data-name') || '', 'nl');
        }
        default:
          return 0;
      }
    });

    // Re-append sorted rows
    rows.forEach(row => tbody.appendChild(row));
  }

  // Debounced search for performance
  let searchTimeout;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(filterRows, 150);
  });

  sortSelect.addEventListener('change', () => {
    sortRows();
    filterRows();
  });

  // Initial count
  updateResultCount(totalFiles);
})();
</script>
<% } %>

<%- include('../partials/footer') %>
