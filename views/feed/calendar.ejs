<%- include('../partials/header') %>

<div class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="display-4 fw-bold mb-0">Leidingskalender</h1>
            <p class="text-muted lead mb-0">Alle publieke activiteiten (rood) en exclusieve leiding-events (blauw).</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/kalender/hulp" class="btn btn-chiro btn-sm shadow-sm" title="Abonneer op de Leidingskalender (Google Calendar, iCal, Outlook)">
                <i class="bi bi-calendar-plus me-1"></i> Abonneer op Kalender
            </a>
            <% if (user && user.role === 'admin') { %>
                <a href="/admin/events" class="btn btn-chiro btn-sm shadow-sm">
                    <i class="bi bi-pencil-square me-1"></i> Beheer Kalender
                </a>
            <% } %>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4 py-3 d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-primary"></i>
        <div>
            <strong>Leiding Sync:</strong> Als je op 'Abonneer op Kalender' klikt, krijg je <strong>alle</strong> evenementen (ook de privé leiding-events) automatisch in je eigen agenda. <a href="/help" class="alert-link">Hulp nodig bij instellen?</a>
        </div>
    </div>

    <% if (events.length === 0) { %>
        <div class="card p-5 text-center border-0 shadow-sm rounded-4">
            <div class="card-body py-5">
                <i class="bi bi-calendar-x display-1 text-muted mb-4 d-block"></i>
                <h3 class="fw-bold text-muted">Geen activiteiten gepland</h3>
                <p class="text-muted lead">Houd deze pagina in de gaten voor komende evenementen!</p>
            </div>
        </div>
    <% } else { %>
        <div class="row g-3">
            <% events.forEach(event => { 
                const [y, m, d] = event.date.split('-').map(Number);
                const dateObj = new Date(y, m - 1, d);
                const day = dateObj.getDate();
                const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
                const month = monthNames[dateObj.getMonth()];

                let dateDisplay = '';
                const hasEndDate = event.endDate && event.endDate !== event.date;
                if (hasEndDate) {
                    const [ey, em, ed] = event.endDate.split('-').map(Number);
                    const endDateObj = new Date(ey, em - 1, ed);
                    const endDay = endDateObj.getDate();
                    const endMonth = monthNames[endDateObj.getMonth()];
                    dateDisplay = `${day} ${month} t/m ${endDay} ${endMonth}`;
                }

                // Color coding: Public = Red, Private = Blue
                const badgeColor = event.isPrivate ? 'var(--chiro-blue)' : 'var(--chiro-red)';
                const shadowColor = event.isPrivate ? '#143862' : '#a82b2e';
            %>
                <div class="col-12">
                    <div class="calendar-card" 
                         data-event="<%= JSON.stringify(event) %>"
                         onclick="openEventModal(this)">
                            
                        <div class="calendar-date-badge me-4 shadow-sm" style="background-color: <%= badgeColor %>; box-shadow: 0 4px 0 <%= shadowColor %>;">
                            <span class="calendar-day"><%= day %></span>
                            <span class="calendar-month"><%= month %></span>
                        </div>
                        
                        <div class="flex-grow-1">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <h4 class="mb-0 fw-bold" style="color: <%= badgeColor %>;"><%= event.title %></h4>
                                <% if (event.isPrivate) { %>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem; font-family: var(--font-heading);">LEIDING ONLY</span>
                                <% } %>
                            </div>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                <% if (hasEndDate) { %>
                                    <small class="text-muted d-flex align-items-center">
                                        <i class="bi bi-calendar-range me-2 text-warning"></i> <%= dateDisplay %>
                                    </small>
                                <% } %>
                                <% if (event.startTime) { %>
                                    <small class="text-muted d-flex align-items-center">
                                        <i class="bi bi-clock me-2 text-info"></i> <%= event.startTime %><% if (event.endTime) { %> - <%= event.endTime %><% } %>
                                    </small>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="ms-3 d-none d-sm-block">
                            <i class="bi bi-chevron-right fs-4 text-muted opacity-50"></i>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<!-- Event Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
            <div class="modal-header border-0 pb-0 pe-4 pt-4">
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="container-fluid">
                    <div class="row g-0">
                        <!-- Date Sidebar -->
                        <div class="col-md-4 bg-light p-4 d-flex flex-column align-items-center justify-content-center text-center border-end">
                            <div class="calendar-date-badge mb-3 shadow-sm" id="modalDateBadge" style="width: 80px; height: 80px;">
                                <span class="calendar-day fs-2" id="modalDay"></span>
                                <span class="calendar-month fs-6" id="modalMonth"></span>
                            </div>
                            <div id="modalFullDate" class="fw-bold text-muted small mb-3"></div>
                            <div id="modalTimeInfo" class="text-primary small">
                                <i class="bi bi-clock me-1"></i> <span id="modalTimeText"></span>
                            </div>
                            <div id="modalPrivateBadge" class="mt-4 d-none">
                                <span class="badge bg-info text-white rounded-pill px-3 py-2 shadow-sm" style="font-family: var(--font-heading); font-size: 0.7rem;">LEIDING ONLY</span>
                            </div>
                        </div>
                        
                        <!-- Content Area -->
                        <div class="col-md-8 p-4 p-lg-5">
                            <h2 class="display-6 fw-bold mb-4 text-chiro-red" id="modalEventTitle" style="font-family: var(--font-heading);"></h2>
                            
                            <div class="event-description-container mb-5 fs-5">
                                <div id="modalEventDesc"></div>
                            </div>
                            
                            <div id="modalAttachmentsSection" class="d-none">
                                <h5 class="fw-bold mb-3 d-flex align-items-center">
                                    <i class="bi bi-paperclip me-2 text-primary"></i> Bijlagen
                                </h5>
                                <div id="modalAttachmentsList" class="list-group list-group-flush rounded-3 border">
                                    <!-- Attachments will be injected here -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-center pb-4 pt-0 bg-white">
                <button type="button" class="btn btn-chiro px-4 rounded-pill shadow-sm" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openEventModal(element) {
        const eventJson = element.getAttribute('data-event');
        if (!eventJson) return;
        
        const event = JSON.parse(eventJson);
        
        // Format date for modal
        const [y, m, d] = event.date.split('-').map(Number);
        const dateObj = new Date(y, m - 1, d);
        const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
        const fullMonthNames = ["januari", "februari", "maart", "april", "mei", "juni", "juli", "augustus", "september", "oktober", "november", "december"];
        
        document.getElementById('modalDay').textContent = dateObj.getDate();
        document.getElementById('modalMonth').textContent = monthNames[dateObj.getMonth()];
        
        let fullDateText = `${dateObj.getDate()} ${fullMonthNames[dateObj.getMonth()]} ${dateObj.getFullYear()}`;
        if (event.endDate && event.endDate !== event.date) {
            const [ey, em, ed] = event.endDate.split('-').map(Number);
            const endDateObj = new Date(ey, em - 1, ed);
            fullDateText += ` t/m ${endDateObj.getDate()} ${fullMonthNames[endDateObj.getMonth()]} ${endDateObj.getFullYear()}`;
        }
        document.getElementById('modalFullDate').textContent = fullDateText;

        // Time info
        const timeInfo = document.getElementById('modalTimeInfo');
        if (event.startTime) {
            let timeText = event.startTime;
            if (event.endTime) timeText += ` - ${event.endTime}`;
            document.getElementById('modalTimeText').textContent = timeText;
            timeInfo.classList.remove('d-none');
        } else {
            timeInfo.classList.add('d-none');
        }
        
        // Badge color
        const badge = document.getElementById('modalDateBadge');
        const badgeColor = event.isPrivate ? 'var(--chiro-blue)' : 'var(--chiro-red)';
        const shadowColor = event.isPrivate ? '#143862' : '#a82b2e';
        badge.style.backgroundColor = badgeColor;
        badge.style.boxShadow = `0 4px 0 ${shadowColor}`;

        document.getElementById('modalEventTitle').textContent = event.title;
        document.getElementById('modalEventTitle').style.color = badgeColor;
        
        const privateBadge = document.getElementById('modalPrivateBadge');
        if (event.isPrivate) {
            privateBadge.classList.remove('d-none');
        } else {
            privateBadge.classList.add('d-none');
        }

        // Use innerHTML to render HTML tags from the description
        document.getElementById('modalEventDesc').innerHTML = event.description || '<span class="text-muted fst-italic">Geen beschrijving beschikbaar.</span>';
        
        // Handle Attachments
        const attachmentsSection = document.getElementById('modalAttachmentsSection');
        const attachmentsList = document.getElementById('modalAttachmentsList');
        attachmentsList.innerHTML = '';
        
        let attachments = [];
        try {
            attachments = typeof event.attachments === 'string' ? JSON.parse(event.attachments) : (event.attachments || []);
        } catch (e) {
            console.error('Error parsing attachments:', e);
        }

        if (attachments && attachments.length > 0) {
            attachmentsSection.classList.remove('d-none');
            attachments.forEach(att => {
                const a = document.createElement('a');
                a.href = att.path;
                a.className = 'list-group-item list-group-item-action d-flex align-items-center py-3 border-start-0 border-end-0';
                a.target = '_blank';
                a.innerHTML = `
                    <i class="bi bi-file-earmark-arrow-down fs-4 me-3 text-primary"></i>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark">${att.name}</div>
                        <small class="text-muted">Klik om te openen / downloaden</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                `;
                attachmentsList.appendChild(a);
            });
        } else {
            attachmentsSection.classList.add('d-none');
        }

        const myModal = new bootstrap.Modal(document.getElementById('eventModal'));
        myModal.show();
    }
</script>

<%- include('../partials/footer') %>
