<%- include('../partials/header') %>

<div class="mb-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <h1 class="display-4 fw-bold mb-0">Leidingskalender</h1>
            <p class="text-muted lead mb-0">Alle publieke activiteiten (rood) en exclusieve leiding-events (blauw).</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a href="/kalender/hulp" class="btn btn-chiro btn-sm shadow-sm" title="Abonneer op de Leidingskalender (Google Calendar, iCal, Outlook)">
                <i class="bi bi-calendar-plus me-1"></i> Abonneer op Kalender
            </a>
            <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                <button type="button" class="btn btn-success btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center" onclick="openAddEventModal()">
                    <i class="bi bi-plus-circle me-1"></i> Activiteit Toevoegen
                </button>
                <a href="/kalender?view=public" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm d-inline-flex align-items-center" title="Bekijk de publieke kalenderpagina">
                    <i class="bi bi-globe2 me-1"></i> Publieke Pagina
                </a>
                <a href="/admin/events" class="btn btn-chiro btn-sm btn-edit-page shadow-sm">
                    <i class="bi bi-sliders"></i><span class="d-none d-sm-inline ms-1">Beheer Kalender</span><span class="d-sm-none ms-1">Beheer</span>
                </a>
            <% } %>
        </div>
    </div>

    <div class="alert alert-info border-0 shadow-sm rounded-4 mb-4 py-3 d-flex align-items-center">
        <i class="bi bi-info-circle-fill fs-4 me-3 text-primary"></i>
        <div>
            <strong>Leiding Sync:</strong> Als je op 'Abonneer op Kalender' klikt, krijg je <strong>alle</strong> evenementen (ook de privé leiding-events) automatisch in je eigen agenda. <a href="/help" class="alert-link">Hulp nodig bij instellen?</a>
        </div>
    </div>

    <% if (events.length === 0) { %>
        <div class="card p-5 text-center border-0 shadow-sm rounded-4">
            <div class="card-body py-5">
                <i class="bi bi-calendar-x display-1 text-muted mb-4 d-block"></i>
                <h3 class="fw-bold text-muted">Geen activiteiten gepland</h3>
                <p class="text-muted lead">Houd deze pagina in de gaten voor komende evenementen!</p>
            </div>
        </div>
    <% } else { %>
        <div class="row g-3">
            <% events.forEach(event => { 
                const [y, m, d] = event.date.split('-').map(Number);
                const dateObj = new Date(y, m - 1, d);
                const day = dateObj.getDate();
                const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
                const month = monthNames[dateObj.getMonth()];

                let dateDisplay = '';
                const hasEndDate = event.endDate && event.endDate !== event.date;
                if (hasEndDate) {
                    const [ey, em, ed] = event.endDate.split('-').map(Number);
                    const endDateObj = new Date(ey, em - 1, ed);
                    const endDay = endDateObj.getDate();
                    const endMonth = monthNames[endDateObj.getMonth()];
                    dateDisplay = `${day} ${month} t/m ${endDay} ${endMonth}`;
                }

                // Color coding: Public = Red, Private = Blue
                const badgeColor = event.isPrivate ? 'var(--chiro-blue)' : 'var(--chiro-red)';
                const shadowColor = event.isPrivate ? '#143862' : '#a82b2e';
            %>
                <div class="col-12">
                    <div class="calendar-card flex-column flex-sm-row align-items-stretch align-items-sm-center gap-3" 
                         data-event="<%= JSON.stringify(event) %>"
                         onclick="openEventModal(this)">
                        
                        <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                            <div class="calendar-date-badge shadow-sm flex-shrink-0" style="background-color: <%= badgeColor %>; box-shadow: 0 4px 0 <%= shadowColor %>;">
                                <span class="calendar-day"><%= day %></span>
                                <span class="calendar-month"><%= month %></span>
                            </div>
                            
                            <div class="flex-grow-1" style="min-width: 0;">
                                <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                    <h4 class="mb-0 fw-bold text-break" style="color: <%= badgeColor %>;"><%= event.title %></h4>
                                    <% if (event.isPrivate) { %>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem; font-family: var(--font-heading);">LEIDING ONLY</span>
                                    <% } else if (event.showOnPublicPage && user && (user.role === 'admin' || user.role === 'media')) { %>
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2 py-1" style="font-size: 0.7rem; font-family: var(--font-heading);"><i class="bi bi-megaphone-fill me-1"></i>OP STARTPAGINA</span>
                                    <% } %>
                                </div>
                                <div class="d-flex flex-wrap gap-2 mt-1">
                                    <% if (hasEndDate) { %>
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="bi bi-calendar-range me-2 text-warning"></i> <%= dateDisplay %>
                                        </small>
                                    <% } %>
                                    <% if (event.startTime) { %>
                                        <small class="text-muted d-flex align-items-center">
                                            <i class="bi bi-clock me-2 text-info"></i> <%= event.startTime %><% if (event.endTime) { %> - <%= event.endTime %><% } %>
                                        </small>
                                    <% } %>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right fs-5 text-muted opacity-50 d-sm-none ms-auto flex-shrink-0"></i>
                        </div>
                        
                        <div class="d-flex align-items-center justify-content-end gap-2 flex-shrink-0 <%= (user && (user.role === 'admin' || user.role === 'media')) ? 'border-top pt-2 pt-sm-0 border-sm-0-reset' : 'd-none d-sm-flex' %>">
                            <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center justify-content-center flex-grow-1 flex-sm-grow-0"
                                        title="Rechtstreeks bewerken"
                                        onclick="event.stopPropagation(); openEditEventModal(this.closest('.calendar-card'))">
                                    <i class="bi bi-pencil-square me-1"></i><span>Bewerken</span>
                                </button>
                            <% } %>
                            <i class="bi bi-chevron-right fs-4 text-muted opacity-50 d-none d-sm-inline"></i>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('../partials/event_modal') %>
<%- include('../partials/footer') %>
