<%
function getAvatarColor(username) {
    if (!username) return '#db3e41';
    const vibrantColors = ['#f1c40f', '#2ecc71', '#e67e22', '#e74c3c', '#3498db', '#9b59b6', '#1abc9c', '#d35400'];
    let hash = 0;
    for (let i = 0; i < username.length; i++) {
        hash = username.charCodeAt(i) + ((hash << 5) - hash);
    }
    return vibrantColors[Math.abs(hash) % vibrantColors.length];
}
function getInitials(username) {
    if (!username) return '?';
    return username.substring(0, 2).toUpperCase();
}
function highlightMentions(text) {
    if (!text) return '';
    const parts = text.split(/(<[^>]+>)/g);
    const processedParts = parts.map(part => {
        if (part.startsWith('<')) {
            if (part.toLowerCase().startsWith('<img')) {
                if (part.includes('src="http') && !part.includes('src="/uploads/')) {
                    return part.replace('>', ' onerror="handleBrokenImage(this)">');
                }
            }
            return part;
        }
        return part.replace(/@(\w+)/g, (match, username) => {
            const capitalized = username.charAt(0).toUpperCase() + username.slice(1).toLowerCase();
            return `<span class="text-primary fw-bold">@${capitalized}</span>`;
        });
    });
    return processedParts.join('');
}
%>
<div class="d-flex mb-3 align-items-start" id="comment-container-<%= comment.id %>">
    <% if (comment.author && comment.author.profilePicture) { %>
        <img src="<%= comment.author.profilePicture %>" class="rounded-circle me-2 flex-shrink-0 border shadow-sm" style="width: 32px; height: 32px; object-fit: cover; cursor: pointer;" alt="<%= capitalizeName(comment.author.username) %>" onclick="showPolaroid('<%= comment.author.profilePicture %>', '<%= capitalizeName(comment.author.username) %>')">
    <% } else { %>
        <div class="avatar-circle me-2 flex-shrink-0" style="background-color: <%= getAvatarColor(comment.author ? comment.author.username : '') %>; width: 32px; height: 32px; font-size: 0.8rem;">
            <%= getInitials(comment.author ? comment.author.username : '') %>
        </div>
    <% } %>
    <div class="flex-grow-1">
        <div class="comment-bubble w-100">
            <div class="d-flex justify-content-between align-items-baseline mb-1">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-bold small"><%= comment.author ? capitalizeName(comment.author.username) : 'Onbekend' %></span>
                    <span class="text-muted" style="font-size: 0.7rem;">
                        • <%= new Date(comment.createdAt).toLocaleDateString('nl-BE', { timeZone: 'Europe/Brussels', day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' }) %>
                    </span>
                </div>
                <% if ((comment.author && user && comment.author.id === user.id) || user.role === 'admin') { %>
                    <div class="dropdown">
                        <a href="#" class="text-muted small" data-bs-toggle="dropdown"><i class="bi bi-three-dots"></i></a>
                        <ul class="dropdown-menu dropdown-menu-end border-0 shadow-sm" style="font-size: 0.85rem;">
                            <li><a class="dropdown-item" href="#" onclick="enableCommentEdit('<%= comment.id %>'); return false;">Bewerken</a></li>
                            <li>
                                <form action="/feed/comment/<%= comment.id %>/delete" method="POST" class="comment-delete-form">
                                    <button type="submit" class="dropdown-item text-danger">Verwijderen</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                <% } %>
            </div>
            
            <div id="comment-content-view-<%= comment.id %>">
                <span class="small text-dark comment-text" style="white-space: pre-line;"><%- highlightMentions(comment.content) %></span>
            </div>
            
            <div id="comment-content-edit-<%= comment.id %>" class="d-none mt-2">
                <form action="/feed/comment/<%= comment.id %>/update" method="POST" class="comment-update-form">
                    <textarea name="content" class="form-control form-control-sm mb-1" rows="1" style="resize: none; overflow: hidden;" oninput="autoResize(this)" onfocus="autoResize(this)"><%= comment.content %></textarea>
                    <button type="submit" class="btn btn-sm btn-success py-0">Ok</button>
                    <button type="button" class="btn btn-sm btn-light py-0" onclick="disableCommentEdit('<%= comment.id %>')">X</button>
                </form>
            </div>
        </div>
        
        <div class="ms-1 mt-1 d-flex align-items-center gap-3">
            <a href="#" onclick="document.getElementById('reply-form-<%= comment.id %>').classList.toggle('d-none'); return false;" class="small text-muted text-decoration-none fw-bold" style="font-size: 0.75rem;">Beantwoorden</a>

            <div class="d-flex align-items-center gap-2">
                <% 
                    const likes = comment.likes || [];
                    const isLiked = likes.some(l => l.userId === user.id);
                    const likeCount = likes.length;
                    const likerArray = likes.map(l => l.user ? { username: l.user.username, profilePicture: l.user.profilePicture } : { username: 'Onbekend', profilePicture: null });
                %>
                
                <form action="/feed/comment/<%= comment.id %>/like" method="POST" class="like-form d-inline-block m-0" data-comment-id="<%= comment.id %>">
                    <button type="submit" class="btn btn-link p-0 text-decoration-none <%= isLiked ? 'text-danger' : 'text-muted' %> d-flex align-items-center" style="font-size: 0.75rem; border: none;" aria-label="Vind ik leuk">
                        <i class="bi <%= isLiked ? 'bi-heart-fill' : 'bi-heart' %>" style="font-size: 1.1rem;"></i>
                    </button>
                </form>

                <span id="like-count-container-<%= comment.id %>" 
                      class="d-flex align-items-center gap-1 text-muted like-view-trigger" 
                      style="font-size: 0.75rem; cursor: pointer; <%= likeCount > 0 ? '' : 'display: none !important;' %>"
                      data-likers='<%= JSON.stringify(likerArray).replace(/'/g, "&#39;") %>'
                      onclick="showLikesModal(this)">
                    <span class="fw-bold count-text"><%= likeCount %></span>
                    <i class="bi bi-people-fill"></i>
                </span>
            </div>
        </div>

        <!-- Reply Input -->
        <div id="reply-form-<%= comment.id %>" class="d-none mt-2">
            <form action="/feed/comment" method="POST" class="d-flex align-items-end comment-form">
                <input type="hidden" name="postId" value="<%= post.id %>">
                <input type="hidden" name="parentId" value="<%= comment.id %>">
                <textarea name="content" class="form-control form-control-sm me-2" placeholder="Antwoord..." required rows="1" style="resize: none; overflow: hidden; border-radius: 1rem;" oninput="autoResize(this)"></textarea>
                <button type="submit" class="btn btn-sm btn-primary rounded-circle d-flex align-items-center justify-content-center p-0 mb-1" style="width: 32px; height: 32px; flex-shrink: 0;"><i class="bi bi-send"></i></button>
            </form>
        </div>

        <!-- Nested Replies -->
        <% if (comment.replies && comment.replies.length > 0) { %>
            <div class="mt-2 reply-container depth-<%= depth || 0 %>">
                <% 
                   const firstReply = comment.replies[0];
                   const otherReplies = comment.replies.slice(1);
                   const nextDepth = (depth || 0) + 1;
                %>
                <%- include('comment_partial', { comment: firstReply, user: user, post: post, depth: nextDepth }) %>
                
                <% if (otherReplies.length > 0) { %>
                    <div class="collapse" id="replies-<%= comment.id %>">
                        <% otherReplies.forEach(reply => { %>
                            <%- include('comment_partial', { comment: reply, user: user, post: post, depth: nextDepth }) %>
                        <% }) %>
                    </div>
                    <button class="btn btn-link btn-sm text-decoration-none text-muted p-0 mt-1" type="button" data-bs-toggle="collapse" data-bs-target="#replies-<%= comment.id %>" onclick="this.textContent = this.textContent.includes('Toon') ? 'Verberg antwoorden' : 'Toon nog <%= otherReplies.length %> antwoorden'">
                        <i class="bi bi-arrow-return-right"></i> Toon nog <%= otherReplies.length %> antwoorden
                    </button>
                <% } %>
            </div>
        <% } %>
    </div>
</div>
