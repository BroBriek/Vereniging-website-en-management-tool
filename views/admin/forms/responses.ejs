<%- include('../../partials/header') %>

<style>
    .editable-cell {
        cursor: pointer;
        padding: 8px;
        border-radius: 4px;
        transition: background 0.2s;
        min-height: 40px;
        display: flex;
        align-items: center;
    }
    .editable-cell:hover {
        background-color: #f8f9fa;
        border: 1px dashed #dee2e6;
    }
    .edit-input {
        width: 100%;
        padding: 5px 10px !important;
        border: 2px solid #db3e41 !important;
        border-radius: 4px !important;
        outline: none;
        min-height: auto !important;
    }
    .saving-indicator {
        font-size: 0.8rem;
        color: #6c757d;
        display: none;
    }
    .response-row {
        transition: all 0.3s;
    }
    .response-row.deleting {
        opacity: 0.5;
        transform: scale(0.98);
    }
    /* Mobile responsive table adjustments */
    @media (max-width: 991.98px) {
        .table-mobile-responsive thead {
            display: none;
        }
        .table-mobile-responsive tr {
            display: block;
            border-bottom: 1px solid #eee;
            padding: 0.75rem 0;
        }
        .table-mobile-responsive tr:last-child {
            border-bottom: none;
        }
        .table-mobile-responsive td {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0.5rem 1rem !important;
            border: none !important;
            text-align: right;
        }
        .table-mobile-responsive td::before {
            content: attr(data-label);
            font-weight: 600;
            font-size: 0.7rem;
            color: #6c757d;
            text-transform: uppercase;
            margin-right: 1.5rem;
            text-align: left;
            flex-shrink: 0;
        }
        .table-mobile-responsive .editable-cell {
            padding: 4px 8px;
            min-height: auto;
            justify-content: flex-end;
            width: auto;
            max-width: 70%;
        }
        .table-mobile-responsive td.ps-4, .table-mobile-responsive td.pe-4 {
            padding-left: 1rem !important;
            padding-right: 1rem !important;
        }
        /* Specific alignment for the "Datum" cell content */
        .table-mobile-responsive td[data-label="Datum"] > div {
            text-align: right;
        }
    }
    /* Fix for global input styles interfering with bootstrap input groups */
    .input-group .form-control {
        padding: 0.4rem 0.75rem !important;
        border-radius: 8px !important;
        font-size: 0.95rem !important;
        min-height: auto !important;
        border: 1px solid #dee2e6 !important;
    }
    .input-group-text {
        border-radius: 8px 0 0 8px !important;
        border: 1px solid #dee2e6 !important;
        border-right: none !important;
    }
    /* Search bar styling */
    .search-container {
        position: relative;
        flex-grow: 1;
        max-width: 400px;
    }
    .search-container .bi-search {
        position: absolute;
        left: 1rem;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        z-index: 5;
    }
    .search-input {
        padding-left: 2.75rem !important;
        border-radius: 50px !important;
        border: 1px solid #dee2e6 !important;
        background-color: #f8f9fa !important;
        transition: all 0.2s ease;
        height: 42px !important;
        font-size: 0.95rem !important;
    }
    .search-input:focus {
        background-color: #fff !important;
        border-color: var(--bs-primary) !important;
        box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.1) !important;
    }
</style>

<div class="row">
    <% const canEditResponses = user.role === 'admin' || user.role === 'media' || form.creatorId === user.id; %>
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/forms">Formulieren</a></li>
                <li class="breadcrumb-item active">Antwoorden</li>
            </ol>
        </nav>
        <div class="d-flex flex-column flex-lg-row justify-content-between align-items-lg-center gap-3">
            <div>
                <h1 class="mb-0">Antwoorden: <%= form.title %></h1>
                <p class="text-muted mb-0"><%= responses.length %> antwoorden ontvangen. <% if (canEditResponses) { %><span class="text-primary small d-none d-md-inline"><i class="bi bi-info-circle"></i> Klik op een cel om deze aan te passen.</span><% } %></p>
            </div>
            <div class="d-flex flex-wrap gap-2 align-items-center w-100 w-lg-auto">
                <div class="search-container">
                    <i class="bi bi-search"></i>
                    <input type="text" id="tableSearch" class="form-control search-input" placeholder="Zoek in alle antwoorden...">
                </div>
                <div class="d-flex gap-2 ms-auto">
                    <div class="dropdown flex-grow-1 flex-sm-grow-0">
                        <button class="btn btn-primary dropdown-toggle w-100" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-download"></i> <span class="d-none d-sm-inline">Exporteer</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3">
                            <li>
                                <button type="button" class="dropdown-item py-2" data-bs-toggle="modal" data-bs-target="#eetdagExportModal">
                                    <i class="bi bi-printer me-2 text-primary"></i> Eetdag Export (PDF)
                                </button>
                            </li>
                            <li>
                                 <button type="button" class="dropdown-item py-2" onclick="triggerDownload('/admin/forms/<%= form.id %>/responses/export', 'responses-<%= form.slug %>.xlsx', this)">
                                     <i class="bi bi-file-earmark-excel me-2 text-success"></i> Excel Export
                                 </button>
                             </li>
                        </ul>
                    </div>
                    <a href="/forms/<%= form.slug %>" target="_blank" class="btn btn-outline-primary flex-grow-1 flex-sm-grow-0">
                        <i class="bi bi-eye"></i> <span class="d-none d-sm-inline">Bekijk</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12">
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-mobile-responsive mb-0 align-middle" id="responsesTable">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4 sortable" onclick="sortTable(0)" style="width: 150px; cursor: pointer;">Datum <i class="bi bi-arrow-down-up small ms-1"></i></th>
                                <th class="sortable" onclick="sortTable(1)" style="cursor: pointer;">Bijnaam <i class="bi bi-arrow-down-up small ms-1"></i></th>
                                <% 
                                    const questionFields = form.fields.filter(f => ['short_text', 'long_text', 'multiple_choice', 'multiple_choice_multi', 'pricing'].includes(f.type));
                                    questionFields.forEach((f, index) => { 
                                %>
                                    <th class="sortable" onclick="sortTable(<%= index + 2 %>)" style="cursor: pointer;"><%= f.label %> <i class="bi bi-arrow-down-up small ms-1"></i></th>
                                <% }) %>
                                <th class="text-end pe-4" style="width: 50px;"></th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (responses && responses.length > 0) { %>
                                <% responses.forEach(resp => { %>
                                    <tr id="response-row-<%= resp.id %>" class="response-row">
                                        <td class="ps-4" data-label="Datum" data-sort-value="<%= new Date(resp.submittedAt).getTime() %>">
                                            <div class="small fw-bold"><%= new Date(resp.submittedAt).toLocaleDateString('nl-BE') %></div>
                                            <div class="small text-muted"><%= new Date(resp.submittedAt).toLocaleTimeString('nl-BE', {hour: '2-digit', minute:'2-digit'}) %></div>
                                        </td>
                                        <td data-label="Bijnaam">
                                            <div class="editable-cell" 
                                                 <% if (canEditResponses) { %>onclick="startEdit(this, '<%= resp.id %>', 'nickname', 'short_text', [])"<% } %>
                                                 data-raw-value="<%= resp.nickname || '' %>">
                                                <span>
                                                    <% if (resp.nickname) { %>
                                                        <%= resp.nickname %>
                                                    <% } else { %>
                                                        <span class="text-muted fst-italic">Niet ingesteld</span>
                                                    <% } %>
                                                </span>
                                            </div>
                                        </td>
                                        <% questionFields.forEach(f => { 
                                            let answer = resp.data[f.id];
                                            let displayValue = '';
                                            const isArray = Array.isArray(answer);
                                            
                                            if (f.type === 'pricing' && typeof answer === 'object' && answer !== null) {
                                                const items = Object.entries(answer)
                                                    .filter(([key, val]) => key !== 'total' && parseInt(val) > 0)
                                                    .map(([key, val]) => `<span class="badge bg-light text-dark border me-1">${key}: ${val}</span>`);
                                                const total = parseFloat(answer.total) || 0;
                                                displayValue = items.join('') + (items.length > 0 ? `<div class="mt-1 small fw-bold text-primary">Totaal: €${total.toLocaleString('nl-BE', { minimumFractionDigits: 2 })}</div>` : '<span class="text-muted fst-italic">Geen selectie</span>');
                                            } else {
                                                displayValue = isArray ? answer.join(', ') : (answer || '-');
                                            }
                                        %>
                                            <td data-label="<%= f.label %>">
                                                <div class="editable-cell" 
                                                     <% if (canEditResponses) { %>onclick="startEdit(this, '<%= resp.id %>', '<%= f.id %>', '<%= f.type %>', <%= JSON.stringify(f.options || []) %>)"<% } %>
                                                     data-raw-value="<%= typeof answer === 'object' ? JSON.stringify(answer) : answer %>">
                                                     <span>
                                                         <% if (f.type === 'pricing') { %>
                                                             <%- displayValue %>
                                                         <% } else { %>
                                                             <%= displayValue %>
                                                         <% } %>
                                                     </span>
                                                </div>
                                            </td>
                                        <% }) %>
                                        <td class="text-end pe-4" data-label="Acties">
                                            <% if (canEditResponses) { %>
                                                <button type="button" class="btn btn-sm btn-outline-danger border-0" onclick="deleteResponse('<%= resp.id %>')" title="Verwijder dit antwoord">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="<%= questionFields.length + 3 %>" class="text-center py-5 text-muted">
                                        <i class="bi bi-chat-left-dots display-4 d-block mb-3 opacity-25"></i>
                                        Nog geen antwoorden ontvangen.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="saveToast" class="toast-container position-fixed bottom-0 end-0 p-3">
    <div class="toast align-items-center text-white bg-success border-0" role="alert" aria-live="assertive" aria-atomic="true">
        <div class="d-flex">
            <div class="toast-body">
                Aanpassing opgeslagen!
            </div>
            <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
        </div>
    </div>
</div>

<!-- Modal for editing pricing fields -->
<div class="modal fade" id="editPricingModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title font-playful" id="pricingModalTitle">Bestelling Aanpassen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div id="pricingModalFields"></div>
                <div class="mt-4 pt-3 border-top d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 font-playful">Nieuw Totaal</h5>
                    <h4 class="mb-0 text-primary fw-bold" id="pricingModalTotal">€0,00</h4>
                </div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" id="savePricingModalBtn">Opslaan</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal for Eetdag Export -->
<div class="modal fade" id="eetdagExportModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title font-playful">Exporteer naar Eetdagformaat</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-4">Selecteer welke velden op het briefje moeten komen te staan.</p>
                <form id="eetdagExportForm">
                    <div class="mb-4">
                        <label class="form-label fw-bold">Veld voor NAAM:</label>
                        <select name="nameField" class="form-select rounded-3" required>
                            <option value="">-- Selecteer veld --</option>
                            <% form.fields.filter(f => ['short_text', 'long_text', 'multiple_choice'].includes(f.type)).forEach(f => { %>
                                <option value="<%= f.id %>"><%= f.label %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Veld voor TAFEL (optioneel):</label>
                        <select name="tableField" class="form-select rounded-3">
                            <option value="">-- Geen veld --</option>
                            <% form.fields.filter(f => ['short_text', 'multiple_choice'].includes(f.type)).forEach(f => { %>
                                <option value="<%= f.id %>"><%= f.label %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Aantal extra blanco tickets:</label>
                        <input type="number" name="blankTickets" class="form-control rounded-3" min="0" value="0">
                        <small class="text-muted">Extra tickets met titels maar zonder waarden.</small>
                    </div>
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="useNicknames" id="useNicknames" value="true">
                            <label class="form-check-label fw-bold" for="useNicknames">Gebruik bijnamen indien beschikbaar</label>
                        </div>
                        <small class="text-muted d-block mt-1">Vervangt de normale naam op de tickets als er een bijnaam is ingevuld.</small>
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-bold">Sorteer tickets op:</label>
                        <select name="sortBy" class="form-select rounded-3">
                            <option value="alphabetical">Alfabetisch (Naam)</option>
                            <option value="newest">Datum (Nieuw naar Oud)</option>
                            <option value="oldest">Datum (Oud naar Nieuw)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold d-block">Velden voor BESTELLING:</label>
                        <div class="p-3 bg-light rounded-3 border" style="max-height: 200px; overflow-y: auto;">
                            <% form.fields.filter(f => ['pricing', 'multiple_choice', 'multiple_choice_multi'].includes(f.type)).forEach(f => { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="orderFields" value="<%= f.id %>" id="check-<%= f.id %>" <%= f.type === 'pricing' ? 'checked' : '' %>>
                                    <label class="form-check-label" for="check-<%= f.id %>">
                                        <%= f.label %> <small class="text-muted">(<%= f.type %>)</small>
                                    </label>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="executeEetdagExport()">
                    <i class="bi bi-file-earmark-pdf"></i> Exporteer PDF
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    function executeEetdagExport() {
        const form = document.getElementById('eetdagExportForm');
        const formData = new FormData(form);
        const nameField = formData.get('nameField');
        const tableField = formData.get('tableField');
        const blankTickets = formData.get('blankTickets');
        const orderFields = formData.getAll('orderFields');
        const useNicknames = formData.get('useNicknames');
        const sortBy = formData.get('sortBy');

        if (!nameField) {
            alert('Selecteer a.u.b. een veld voor de naam.');
            return;
        }
        if (orderFields.length === 0) {
            alert('Selecteer a.u.b. ten minste één veld voor de bestelling.');
            return;
        }

        const params = new URLSearchParams();
        params.append('nameField', nameField);
        if (tableField) params.append('tableField', tableField);
        if (blankTickets) params.append('blankTickets', blankTickets);
        if (useNicknames) params.append('useNicknames', 'true');
        if (sortBy) params.append('sortBy', sortBy);
        orderFields.forEach(id => params.append('orderFields', id));

        const exportUrl = `/admin/forms/<%= form.id %>/responses/export-eetdag?` + params.toString();
        
        // Use the centralized download system for better iOS/PWA support
        triggerDownload(exportUrl, `eetdag-<%= form.slug %>.pdf`, document.querySelector('[onclick="executeEetdagExport()"]'));
        
        bootstrap.Modal.getInstance(document.getElementById('eetdagExportModal')).hide();
    }

    function sortTable(n) {
        const table = document.getElementById("responsesTable");
        let rows, switching, i, x, y, shouldSwitch, dir, switchcount = 0;
        switching = true;
        dir = "asc"; 
        
        // Reset icons
        const headers = table.querySelectorAll('th.sortable i');
        headers.forEach(h => h.className = 'bi bi-arrow-down-up small ms-1');

        while (switching) {
            switching = false;
            rows = table.rows;
            for (i = 1; i < (rows.length - 1); i++) {
                shouldSwitch = false;
                x = rows[i].getElementsByTagName("TD")[n];
                y = rows[i + 1].getElementsByTagName("TD")[n];
                
                let xValue = x.getAttribute('data-sort-value') || x.innerText.toLowerCase();
                let yValue = y.getAttribute('data-sort-value') || y.innerText.toLowerCase();
                
                if (n === 0) { // Date column
                    xValue = parseInt(xValue);
                    yValue = parseInt(yValue);
                }

                if (dir == "asc") {
                    if (xValue > yValue) {
                        shouldSwitch = true;
                        break;
                    }
                } else if (dir == "desc") {
                    if (xValue < yValue) {
                        shouldSwitch = true;
                        break;
                    }
                }
            }
            if (shouldSwitch) {
                rows[i].parentNode.insertBefore(rows[i + 1], rows[i]);
                switching = true;
                switchcount ++;      
            } else {
                if (switchcount == 0 && dir == "asc") {
                    dir = "desc";
                    switching = true;
                }
            }
        }
        
        // Set active icon
        const icon = table.rows[0].getElementsByTagName("TH")[n].querySelector('i');
        icon.className = dir === 'asc' ? 'bi bi-arrow-up small ms-1' : 'bi bi-arrow-down small ms-1';
    }

    document.getElementById('tableSearch').addEventListener('input', function(e) {
        const query = e.target.value.toLowerCase();
        const rows = document.querySelectorAll('.response-row');
        rows.forEach(row => {
            const text = row.innerText.toLowerCase();
            row.style.display = text.includes(query) ? '' : 'none';
        });
    });

    function startEdit(container, responseId, fieldId, type, options) {
        if (container.querySelector('input') || container.querySelector('select') || container.querySelector('textarea')) return;

        const rawValue = container.getAttribute('data-raw-value');
        const originalHtml = container.innerHTML;

        if (type === 'pricing') {
            const data = JSON.parse(rawValue || '{}');
            const modalBody = document.getElementById('pricingModalFields');
            modalBody.innerHTML = '';
            
            options.forEach(opt => {
                const qty = data[opt.label] || 0;
                const div = document.createElement('div');
                div.className = 'mb-3 pb-3 border-bottom border-light d-flex align-items-center gap-3';
                div.innerHTML = `
                    <div class="flex-grow-1">
                        <div class="fw-bold">${opt.label}</div>
                        <div class="small text-muted">€${opt.price.toLocaleString('nl-BE', {minimumFractionDigits: 2})} per stuk</div>
                    </div>
                    <div style="width: 100px;">
                        <input type="number" class="form-control pricing-modal-qty" 
                               data-label="${opt.label}" data-price="${opt.price}" 
                               value="${qty}" min="0">
                    </div>
                `;
                modalBody.appendChild(div);
            });

            const updateModalTotal = () => {
                let total = 0;
                modalBody.querySelectorAll('.pricing-modal-qty').forEach(q => {
                    total += (parseInt(q.value) || 0) * parseFloat(q.getAttribute('data-price'));
                });
                document.getElementById('pricingModalTotal').innerText = '€' + total.toLocaleString('nl-BE', {minimumFractionDigits: 2});
                return total;
            };

            modalBody.querySelectorAll('.pricing-modal-qty').forEach(q => q.oninput = updateModalTotal);
            updateModalTotal();

            const modal = new bootstrap.Modal(document.getElementById('editPricingModal'));
            modal.show();

            document.getElementById('savePricingModalBtn').onclick = () => {
                const newData = { total: updateModalTotal() };
                modalBody.querySelectorAll('.pricing-modal-qty').forEach(q => {
                    newData[q.getAttribute('data-label')] = parseInt(q.value) || 0;
                });
                finishEdit(newData);
                modal.hide();
            };
            return;
        }

        let input;
        if (type === 'long_text') {
            input = document.createElement('textarea');
            input.className = 'edit-input';
            input.rows = 3;
            input.value = rawValue;
        } else if (type === 'multiple_choice') {
            input = document.createElement('select');
            input.className = 'form-select form-select-sm edit-input';
            options.forEach(opt => {
                const o = document.createElement('option');
                o.value = opt;
                o.text = opt;
                if (opt === rawValue) o.selected = true;
                input.appendChild(o);
            });
            const empty = document.createElement('option');
            empty.value = '';
            empty.text = '- Geen -';
            if (!rawValue) empty.selected = true;
            input.prepend(empty);
        } else if (type === 'multiple_choice_multi') {
            input = document.createElement('input');
            input.type = 'text';
            input.className = 'edit-input';
            try {
                const arr = JSON.parse(rawValue);
                input.value = Array.isArray(arr) ? arr.join(', ') : rawValue;
            } catch(e) {
                input.value = rawValue;
            }
        } else {
            input = document.createElement('input');
            input.type = 'text';
            input.className = 'edit-input';
            input.value = rawValue;
        }

        if (input) {
            container.innerHTML = '';
            container.appendChild(input);
            input.focus();
            input.onblur = () => finishEdit(input.value);
            input.onkeydown = (e) => {
                if (e.key === 'Enter' && type !== 'long_text') finishEdit(input.value);
                if (e.key === 'Escape') container.innerHTML = originalHtml;
            };
        }

        async function finishEdit(newValue) {
            // Handle multi-choice-multi array conversion if needed
            if (type === 'multiple_choice_multi' && typeof newValue === 'string') {
                newValue = newValue.split(',').map(v => v.trim()).filter(v => v !== '');
            }

            if (JSON.stringify(newValue) === JSON.stringify(rawValue)) {
                container.innerHTML = originalHtml;
                return;
            }

            try {
                const response = await fetch(`/admin/forms/responses/${responseId}`, {
                    method: 'PUT',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ fieldId, value: newValue })
                });

                if (response.ok) {
                    let displayValue = '';
                    if (type === 'pricing' && typeof newValue === 'object') {
                        const items = Object.entries(newValue)
                            .filter(([key, val]) => key !== 'total' && parseInt(val) > 0)
                            .map(([key, val]) => `<span class="badge bg-light text-dark border me-1">${key}: ${val}</span>`);
                        const total = parseFloat(newValue.total) || 0;
                        displayValue = items.join('') + (items.length > 0 ? `<div class="mt-1 small fw-bold text-primary">Totaal: €${total.toLocaleString('nl-BE', { minimumFractionDigits: 2 })}</div>` : '<span class="text-muted fst-italic">Geen selectie</span>');
                    } else {
                        displayValue = Array.isArray(newValue) ? newValue.join(', ') : (newValue || '-');
                    }
                    
                    container.innerHTML = `<span>${displayValue}</span>`;
                    container.setAttribute('data-raw-value', typeof newValue === 'object' ? JSON.stringify(newValue) : newValue);
                    
                    const toast = new bootstrap.Toast(document.querySelector('#saveToast .toast'));
                    toast.show();
                } else {
                    alert('Fout bij opslaan');
                    container.innerHTML = originalHtml;
                }
            } catch (err) {
                console.error(err);
                container.innerHTML = originalHtml;
            }
        }
    }

    async function deleteResponse(id) {
        if (!confirm('Weet je zeker dat je dit antwoord wilt verwijderen?')) return;

        const row = document.getElementById(`response-row-${id}`);
        row.classList.add('deleting');

        try {
            const response = await fetch(`/admin/forms/responses/${id}`, {
                method: 'DELETE'
            });

            if (response.ok) {
                row.style.transform = 'translateX(100px)';
                row.style.opacity = '0';
                setTimeout(() => row.remove(), 300);
            } else {
                row.classList.remove('deleting');
                alert('Fout bij verwijderen');
            }
        } catch (err) {
            console.error(err);
            row.classList.remove('deleting');
        }
    }
</script>

