<%- include('../../partials/header') %>

<div class="row">
    <div class="col-12 mb-4">
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3">
            <div>
                <h1 class="mb-0">Formulier Beheer</h1>
                <p class="text-muted mb-0 d-none d-sm-block">Beheer formulieren voor inschrijvingen, enquêtes of andere doeleinden.</p>
            </div>
            <div class="d-flex gap-2 w-100 w-sm-auto justify-content-start justify-content-sm-end">
                <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center">
                    <i class="bi bi-arrow-left me-1"></i> <span class="d-none d-sm-inline">Terug naar Dashboard</span><span class="d-inline d-sm-none">Terug</span>
                </a>
                <a href="/admin/forms/create" class="btn btn-primary rounded-pill px-3 d-inline-flex align-items-center flex-grow-1 flex-sm-grow-0 justify-content-center">
                    <i class="bi bi-plus-circle me-1"></i> <span class="d-none d-sm-inline">Nieuw Formulier</span><span class="d-inline d-sm-none">Nieuw</span>
                </a>
            </div>
        </div>
        <p class="text-muted mt-2 d-sm-none">Beheer formulieren voor inschrijvingen, enquêtes of andere doeleinden.</p>
    </div>

    <div class="col-12">
        <!-- Desktop Table View (visible on md and up) -->
        <div class="card shadow-sm border-0 d-none d-md-block">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="bg-light">
                            <tr>
                                <th class="ps-4">Titel</th>
                                <th>Status</th>
                                <th>Gemaakt door</th>
                                <th>Datum</th>
                                <th class="text-end pe-4">Acties</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (forms && forms.length > 0) { %>
                                <% forms.forEach(form => { %>
                                    <tr>
                                        <td class="ps-4">
                                            <div class="fw-bold"><%= form.title %></div>
                                            <small class="text-muted">/forms/<%= form.slug %></small>
                                        </td>
                                        <td>
                                            <% if (form.status === 'visible') { %>
                                                <span class="badge bg-success">Zichtbaar</span>
                                            <% } else if (form.status === 'closed') { %>
                                                <span class="badge bg-danger">Gesloten</span>
                                            <% } else { %>
                                                <span class="badge bg-secondary">Onzichtbaar</span>
                                            <% } %>
                                        </td>
                                        <td><%= form.creator ? capitalizeName(form.creator.username) : 'Onbekend' %></td>
                                        <td><%= new Date(form.createdAt).toLocaleDateString('nl-BE') %></td>
                                        <td class="text-end pe-4">
                                            <div class="btn-group btn-group-sm">
                                                <button type="button" class="btn btn-outline-secondary" title="Kopieer Link" onclick="copyFormLink('<%= form.slug %>')">
                                                    <i class="bi bi-link-45deg"></i>
                                                </button>
                                                <a href="/forms/<%= form.slug %>" target="_blank" class="btn btn-outline-info" title="Bekijk publieke pagina">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="/admin/forms/<%= form.id %>/responses" class="btn btn-outline-success" title="Antwoorden">
                                                    <i class="bi bi-chat-left-dots"></i>
                                                </a>
                                                <% if (user.role === 'admin' || user.role === 'media' || form.creatorId === user.id) { %>
                                                    <a href="/admin/forms/<%= form.id %>/edit" class="btn btn-outline-primary" title="Bewerken">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    <button type="button" class="btn btn-outline-warning" title="Herstel formulier (wis antwoorden)" onclick="resetFormFromIndex('<%= form.id %>', '<%= form.title %>')">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                    <form action="/admin/forms/<%= form.id %>/delete" method="POST" class="d-inline" onsubmit="return confirm('Weet je zeker dat je dit formulier wilt verwijderen? Alle antwoorden gaan ook verloren!');">
                                                        <button type="submit" class="btn btn-outline-danger" title="Verwijderen">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                <% } %>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="5" class="text-center py-5 text-muted">
                                        <i class="bi bi-file-earmark-text display-4 d-block mb-3"></i>
                                        Nog geen formulieren aangemaakt.
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Mobile Card View (visible on small screens only) -->
        <div class="d-md-none">
            <% if (forms && forms.length > 0) { %>
                <% forms.forEach(form => { %>
                    <div class="card shadow-sm border-0 mb-3 overflow-hidden">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold mb-0 text-primary"><%= form.title %></h5>
                                <div>
                                    <% if (form.status === 'visible') { %>
                                        <span class="badge bg-success">Zichtbaar</span>
                                    <% } else if (form.status === 'closed') { %>
                                        <span class="badge bg-danger">Gesloten</span>
                                    <% } else { %>
                                        <span class="badge bg-secondary">Onzichtbaar</span>
                                    <% } %>
                                </div>
                            </div>
                            <div class="text-muted small mb-3">/forms/<%= form.slug %></div>
                            
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="small text-muted mb-1">Maker</div>
                                    <div class="small fw-bold"><%= form.creator ? capitalizeName(form.creator.username) : 'Onbekend' %></div>
                                </div>
                                <div class="col-6 text-end">
                                    <div class="small text-muted mb-1">Datum</div>
                                    <div class="small fw-bold"><%= new Date(form.createdAt).toLocaleDateString('nl-BE') %></div>
                                </div>
                            </div>
                            
                            <div class="d-flex flex-wrap gap-2">
                                <button type="button" class="btn btn-outline-secondary btn-sm flex-grow-1" onclick="copyFormLink('<%= form.slug %>')">
                                    <i class="bi bi-link-45deg"></i> Link
                                </button>
                                <a href="/forms/<%= form.slug %>" target="_blank" class="btn btn-outline-info btn-sm flex-grow-1">
                                    <i class="bi bi-eye"></i> Bekijk
                                </a>
                                <a href="/admin/forms/<%= form.id %>/responses" class="btn btn-outline-success btn-sm flex-grow-1">
                                    <i class="bi bi-chat-left-dots"></i> Antwoorden
                                </a>
                                <% if (user.role === 'admin' || user.role === 'media' || form.creatorId === user.id) { %>
                                    <a href="/admin/forms/<%= form.id %>/edit" class="btn btn-outline-primary btn-sm flex-grow-1">
                                        <i class="bi bi-pencil"></i> Bewerken
                                    </a>
                                    <button type="button" class="btn btn-outline-warning btn-sm flex-grow-1" onclick="resetFormFromIndex('<%= form.id %>', '<%= form.title %>')">
                                        <i class="bi bi-arrow-counterclockwise"></i> Herstellen
                                    </button>
                                    <form action="/admin/forms/<%= form.id %>/delete" method="POST" class="d-inline flex-grow-1" onsubmit="return confirm('Weet je zeker dat je dit formulier wilt verwijderen? Alle antwoorden gaan ook verloren!');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                            <i class="bi bi-trash"></i> Wissen
                                        </button>
                                    </form>
                                <% } %>
                            </div>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="card shadow-sm border-0 text-center py-5 text-muted">
                    <i class="bi bi-file-earmark-text display-4 d-block mb-3"></i>
                    Nog geen formulieren aangemaakt.
                </div>
            <% } %>
        </div>
    </div>
</div>

<script>
    function copyFormLink(slug) {
        const url = window.location.origin + '/forms/' + slug;
        navigator.clipboard.writeText(url).then(() => {
            alert('Link gekopieerd naar klembord!');
        }).catch(err => {
            console.error('Copy failed', err);
            alert('Kon niet kopiëren naar klembord.');
        });
    }

    async function resetFormFromIndex(id, title) {
        if (!confirm(`Weet je zeker dat je ALLE antwoorden van het formulier "${title}" wilt verwijderen? Dit kan niet ongedaan gemaakt worden!`)) {
            return;
        }

        try {
            const response = await fetch(`/admin/forms/${id}/reset`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'Accept': 'application/json'
                }
            });

            const result = await response.json();
            if (response.ok && result.success) {
                alert('Formulier hersteld: alle antwoorden zijn verwijderd.');
                window.location.reload();
            } else {
                alert(result.error || 'Fout bij het herstellen van het formulier');
            }
        } catch (err) {
            console.error(err);
            alert('Fout bij communicatie met server');
        }
    }
</script>

<%- include('../../partials/footer') %>
