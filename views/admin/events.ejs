<%- include('../partials/header') %>
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <h1 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Kalender Beheren</h1>
    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-start justify-content-sm-end">
        <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i> <span class="d-none d-sm-inline">Terug naar Dashboard</span><span class="d-inline d-sm-none">Terug</span>
        </a>
        <button class="btn btn-success rounded-pill px-3 d-inline-flex align-items-center flex-grow-1 flex-sm-grow-0 justify-content-center" data-bs-toggle="modal" data-bs-target="#addEventModal">
            <i class="bi bi-plus-circle me-1"></i> Activiteit Toevoegen
        </button>
        <a href="/admin/info" class="btn btn-info text-white rounded-circle d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;" title="Algemene Hulp & Info">
            <i class="bi bi-info-circle"></i>
        </a>
    </div>
</div>

<!-- Add Event Modal -->
<div class="modal fade" id="addEventModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Nieuwe Activiteit Toevoegen</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="/admin/events" method="POST" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label class="fw-bold">Titel</label>
                            <input type="text" class="form-control" name="title" required placeholder="bv. Zondagse Vergadering">
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label class="fw-bold">Begindatum</label>
                            <input type="date" class="form-control" name="date" required>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label class="fw-bold">Einddatum (optioneel)</label>
                            <input type="date" class="form-control" name="endDate">
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label class="fw-bold">Startuur (optioneel)</label>
                            <input type="time" class="form-control" name="startTime">
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label class="fw-bold">Einduur (optioneel)</label>
                            <input type="time" class="form-control" name="endTime">
                        </div>
                        <div class="col-12 col-md-6 mb-3 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="isPrivate" id="isPrivate">
                                <label class="form-check-label" for="isPrivate">Alleen voor leiding (interne kalender)</label>
                            </div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="fw-bold">Beschrijving</label>
                            <textarea class="form-control rich-editor" name="description" rows="3"></textarea>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="fw-bold">Bijlagen / Documenten</label>
                            <input type="file" class="form-control" name="attachments" multiple>
                            <small class="text-muted">Max. 5 bestanden tegelijk.</small>
                        </div>
                    </div>
                    <div class="text-end mt-3">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="submit" class="btn btn-success">Opslaan & Toevoegen</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<h3>Geplande Activiteiten</h3>
<!-- Mobile Layout for Active Events -->
<div class="d-md-none mb-4">
    <% if (activeEvents.length === 0) { %>
        <div class="text-center text-muted py-4 card shadow-sm border-0 rounded-4 mb-3">
            <div class="card-body">Geen geplande activiteiten gevonden.</div>
        </div>
    <% } else { %>
        <% activeEvents.forEach(event => { %>
            <div class="card shadow-sm border-0 rounded-4 mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge <%= event.isPrivate ? 'bg-warning text-dark' : 'bg-info text-white' %> rounded-pill px-3">
                            <%= event.isPrivate ? 'Leiding' : 'Publiek' %>
                        </span>
                        <div class="text-muted small fw-bold">
                            <i class="bi bi-calendar3 me-1"></i><%= event.date %>
                            <% if (event.endDate && event.endDate !== event.date) { %>
                                <span>t/m <%= event.endDate %></span>
                            <% } %>
                        </div>
                    </div>
                    <h5 class="card-title fw-bold mb-3"><%= event.title %></h5>
                    <% if (event.startTime || event.endTime) { %>
                        <p class="card-text text-muted small mb-3">
                            <i class="bi bi-clock me-1"></i>
                            <%= event.startTime || '00:00' %> <%= event.endTime ? 't/m ' + event.endTime : '' %>
                        </p>
                    <% } %>
                    <div class="d-flex justify-content-end gap-2 border-top pt-2 mt-2">
                        <form action="/admin/events/<%= event.id %>/archive" method="POST" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-pill px-3" title="Archiveren">
                                <i class="bi bi-archive me-1"></i> Archiveren
                            </button>
                        </form>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick='openEditModal(<%- JSON.stringify(event).replace(/'/g, "&#39;") %>)'>
                            <i class="bi bi-pencil me-1"></i> Bewerken
                        </button>
                        <form action="/admin/events/<%= event.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Zeker weten?');" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-trash me-1"></i> Wis</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>

<div class="d-none d-md-block table-responsive mb-4">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th>Datum</th>
                <th>Titel</th>
                <th class="d-none d-md-table-cell">Type</th>
                <th class="text-end">Actie</th>
            </tr>
        </thead>
        <tbody>
            <% if (activeEvents.length === 0) { %>
                <tr>
                    <td colspan="4" class="text-center text-muted py-4">Geen geplande activiteiten gevonden.</td>
                </tr>
            <% } else { %>
                <% activeEvents.forEach(event => { %>
                    <tr>
                        <td>
                            <div class="fw-bold"><%= event.date %></div>
                            <% if (event.endDate && event.endDate !== event.date) { %>
                                <div class="small text-muted">t/m <%= event.endDate %></div>
                            <% } %>
                        </td>
                        <td>
                            <%= event.title %>
                            <div class="d-md-none small mt-1">
                                <% if (event.isPrivate) { %>
                                    <span class="badge bg-warning text-dark">Leiding</span>
                                <% } else { %>
                                    <span class="badge bg-info">Publiek</span>
                                <% } %>
                            </div>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <% if (event.isPrivate) { %>
                                <span class="badge bg-warning text-dark">Leiding</span>
                            <% } else { %>
                                <span class="badge bg-info">Publiek</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <form action="/admin/events/<%= event.id %>/archive" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Archiveren">
                                        <i class="bi bi-archive"></i>
                                    </button>
                                </form>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick='openEditModal(<%- JSON.stringify(event).replace(/'/g, "&#39;") %>)'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form action="/admin/events/<%= event.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Zeker weten?');" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            <% } %>
        </tbody>
    </table>
</div>

<% if (archivedEvents.length > 0) { %>
    <h3>Gearchiveerde Activiteiten</h3>
    <!-- Mobile Layout for Archived Events -->
    <div class="d-md-none mb-4">
        <% archivedEvents.forEach(event => { %>
            <div class="card shadow-sm border-0 rounded-4 mb-3 bg-light">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-secondary text-white rounded-pill px-3">Gearchiveerd</span>
                        <div class="text-muted small fw-bold">
                            <i class="bi bi-calendar3 me-1"></i><%= event.date %>
                            <% if (event.endDate && event.endDate !== event.date) { %>
                                <span>t/m <%= event.endDate %></span>
                            <% } %>
                        </div>
                    </div>
                    <h5 class="card-title fw-bold text-muted mb-3"><%= event.title %></h5>
                    <% if (event.startTime || event.endTime) { %>
                        <p class="card-text text-muted small mb-3">
                            <i class="bi bi-clock me-1"></i>
                            <%= event.startTime || '00:00' %> <%= event.endTime ? 't/m ' + event.endTime : '' %>
                        </p>
                    <% } %>
                    <div class="d-flex justify-content-end gap-2 border-top pt-2 mt-2">
                        <% if (event.isArchived) { %>
                            <form action="/admin/events/<%= event.id %>/unarchive" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm btn-outline-success rounded-pill px-3" title="Dearchiveren">
                                    <i class="bi bi-arrow-up-circle me-1"></i> Dearchiveren
                                </button>
                            </form>
                        <% } %>
                        <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick='openEditModal(<%- JSON.stringify(event).replace(/'/g, "&#39;") %>)'>
                            <i class="bi bi-pencil me-1"></i> Bewerken
                        </button>
                        <form action="/admin/events/<%= event.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Zeker weten?');" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3"><i class="bi bi-trash me-1"></i> Wis</button>
                        </form>
                    </div>
                </div>
            </div>
        <% }) %>
    </div>

    <div class="d-none d-md-block table-responsive mb-4">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Titel</th>
                    <th class="d-none d-md-table-cell">Type</th>
                    <th class="text-end">Actie</th>
                </tr>
            </thead>
            <tbody>
                <% archivedEvents.forEach(event => { %>
                    <tr>
                        <td>
                            <div class="fw-bold"><%= event.date %></div>
                            <% if (event.endDate && event.endDate !== event.date) { %>
                                <div class="small text-muted">t/m <%= event.endDate %></div>
                            <% } %>
                        </td>
                        <td>
                            <%= event.title %>
                            <div class="d-md-none small mt-1">
                                <% if (event.isPrivate) { %>
                                    <span class="badge bg-warning text-dark">Leiding</span>
                                <% } else { %>
                                    <span class="badge bg-info">Publiek</span>
                                <% } %>
                            </div>
                        </td>
                        <td class="d-none d-md-table-cell">
                            <% if (event.isPrivate) { %>
                                <span class="badge bg-warning text-dark">Leiding</span>
                            <% } else { %>
                                <span class="badge bg-info">Publiek</span>
                            <% } %>
                        </td>
                        <td class="text-end">
                            <div class="btn-group">
                                <% if (event.isArchived) { %>
                                    <form action="/admin/events/<%= event.id %>/unarchive" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-outline-success" title="Dearchiveren">
                                            <i class="bi bi-arrow-up-circle"></i>
                                        </button>
                                    </form>
                                <% } %>
                                <button type="button" class="btn btn-sm btn-outline-primary" onclick='openEditModal(<%- JSON.stringify(event).replace(/'/g, "&#39;") %>)'>
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <form action="/admin/events/<%= event.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Zeker weten?');" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
<% } %>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Activiteit Bewerken</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm" method="POST" enctype="multipart/form-data">
                    <div class="row">
                        <div class="col-12 col-md-6 mb-3">
                            <label>Titel</label>
                            <input type="text" class="form-control" name="title" id="editTitle" required>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label>Begindatum</label>
                            <input type="date" class="form-control" name="date" id="editDate" required>
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label>Einddatum (optioneel)</label>
                            <input type="date" class="form-control" name="endDate" id="editEndDate">
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label>Startuur (optioneel)</label>
                            <input type="time" class="form-control" name="startTime" id="editStartTime">
                        </div>
                        <div class="col-6 col-md-3 mb-3">
                            <label>Einduur (optioneel)</label>
                            <input type="time" class="form-control" name="endTime" id="editEndTime">
                        </div>
                        <div class="col-12 col-md-3 mb-3 d-flex align-items-end">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" name="isPrivate" id="editIsPrivate">
                                <label class="form-check-label" for="editIsPrivate">Alleen voor leiding</label>
                            </div>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label>Beschrijving</label>
                            <textarea class="form-control rich-editor" name="description" id="editDescription" rows="2"></textarea>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="fw-bold">Nieuwe Bijlagen</label>
                            <input type="file" class="form-control" name="attachments" multiple>
                            <small class="text-muted">Laat leeg om huidige bijlagen te behouden (tenzij je ze hieronder verwijdert).</small>
                        </div>
                        <div class="col-md-12 mb-3">
                            <label class="fw-bold">Huidige Bijlagen</label>
                            <div id="existingAttachmentsList" class="list-group">
                                <!-- Existing attachments will be listed here -->
                            </div>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="submit" class="btn btn-primary">Opslaan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditModal(event) {
        const form = document.getElementById('editForm');
        const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        form.action = `/admin/events/${event.id}?_method=PUT` + (token ? `&_csrf=${token}` : '');
        
        document.getElementById('editTitle').value = event.title;
        document.getElementById('editDate').value = event.date;
        document.getElementById('editEndDate').value = event.endDate || '';
        document.getElementById('editStartTime').value = event.startTime || '';
        document.getElementById('editEndTime').value = event.endTime || '';
        document.getElementById('editIsPrivate').checked = event.isPrivate || false;
        
        const descField = document.getElementById('editDescription');
        descField.value = event.description || '';

        // Handle existing attachments
        const attachmentsList = document.getElementById('existingAttachmentsList');
        attachmentsList.innerHTML = '';
        let attachments = [];
        try {
            attachments = typeof event.attachments === 'string' ? JSON.parse(event.attachments) : (event.attachments || []);
        } catch (e) {
            console.error('Error parsing attachments:', e);
        }

        attachments.forEach((att, index) => {
            const item = document.createElement('div');
            item.className = 'list-group-item d-flex justify-content-between align-items-center';
            item.innerHTML = `
                <span>${att.name}</span>
                <div>
                    <input type="hidden" name="existingAttachments" value='${JSON.stringify(att)}'>
                    <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.parentElement.parentElement.remove()">
                        <i class="bi bi-trash"></i>
                    </button>
                </div>
            `;
            attachmentsList.appendChild(item);
        });
        
        // Handle Quill editor update if it exists
        const modalEl = document.getElementById('editModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        
        modalEl.addEventListener('shown.bs.modal', function () {
            // If the editor isn't initialized yet, do it now
            if (!descField.classList.contains('rich-editor-initialized')) {
                if (window.initializeRichEditors) {
                    window.initializeRichEditors(descField);
                }
            }
            
            const quillContainer = descField.parentElement.querySelector('.ql-container');
            if (quillContainer) {
                const quill = Quill.find(quillContainer);
                if (quill) {
                    quill.root.innerHTML = event.description || '';
                }
            }
        }, { once: true });

        modal.show();
    }
</script>
<%- include('../partials/footer') %>