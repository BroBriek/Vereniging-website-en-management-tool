<%- include('../partials/header') %>

<%
const nowDate = new Date();
const fallbackToday = `${nowDate.getFullYear()}-${String(nowDate.getMonth() + 1).padStart(2, '0')}-${String(nowDate.getDate()).padStart(2, '0')}`;
const currentToday = typeof todayStr !== 'undefined' ? todayStr : fallbackToday;

const allCombinedEvents = [
    ...activeEvents.map(e => ({ ...(e.toJSON ? e.toJSON() : e), _bucket: ((e.endDate || e.date) >= currentToday) ? 'upcoming' : 'past' })),
    ...archivedEvents.map(e => ({ ...(e.toJSON ? e.toJSON() : e), _bucket: 'archived' }))
];

const countUpcoming = allCombinedEvents.filter(e => e._bucket === 'upcoming').length;
const countAllActive = activeEvents.length;
const countHomepage = activeEvents.filter(e => e.showOnPublicPage && !e.isPrivate).length;
const countPublic = activeEvents.filter(e => !e.isPrivate).length;
const countPrivate = activeEvents.filter(e => e.isPrivate).length;
const countPast = allCombinedEvents.filter(e => e._bucket === 'past').length;
const countArchived = archivedEvents.length;

const defaultFilter = countUpcoming > 0 ? 'upcoming' : 'all-active';
%>

<!-- Top Header -->
<div class="admin-events-header mb-4">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <a href="/admin" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center">
                <i class="bi bi-arrow-left me-1"></i> Dashboard
            </a>
            <a href="/kalender?view=public" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center" title="Bekijk en bewerk rechtstreeks op de publieke kalenderpagina">
                <i class="bi bi-globe2 me-1"></i> Publieke Kalender
            </a>
            <a href="/feed/calendar" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center" title="Bekijk de interne leidingskalender">
                <i class="bi bi-calendar3 me-1"></i> Leidingskalender
            </a>
        </div>
        <h1 class="mb-1 fw-bold"><i class="bi bi-calendar-event text-primary me-2"></i>Kalender Beheren</h1>
        <p class="text-muted small mb-0">Zoek, filter, voeg toe of bewerk activiteiten. Tip: je kunt activiteiten ook rechtstreeks op de publieke kalender aanklikken en bewerken!</p>
    </div>
    <div class="admin-events-header-actions">
        <button type="button" class="btn btn-success rounded-pill px-4 py-2 fw-bold shadow-sm d-inline-flex align-items-center justify-content-center flex-grow-1 flex-sm-grow-0" onclick="openAddEventModal()">
            <i class="bi bi-plus-circle-fill me-2"></i> Nieuwe Activiteit
        </button>
        <a href="/admin/info" class="btn btn-info text-white rounded-circle d-inline-flex align-items-center justify-content-center flex-shrink-0" style="width: 42px; height: 42px;" title="Algemene Hulp & Info">
            <i class="bi bi-info-circle"></i>
        </a>
    </div>
</div>

<!-- Filter Tabs & Search / Sort Toolbar Card -->
<div class="admin-toolbar-card shadow-sm rounded-4 mb-4">
    <div class="p-3 p-md-4">
        <!-- Category / Status Pills -->
        <div class="admin-filter-pills pb-3 mb-3 border-bottom" id="eventFilterPills" role="tablist">
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn <%= defaultFilter === 'upcoming' ? 'btn-primary text-white shadow-sm' : 'btn-light text-secondary border' %>" data-filter="upcoming">
                <i class="bi bi-calendar-check me-1"></i> Aankomend
                <span class="badge rounded-pill ms-1 <%= defaultFilter === 'upcoming' ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary' %>" id="badgeCountUpcoming"><%= countUpcoming %></span>
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn <%= defaultFilter === 'all-active' ? 'btn-primary text-white shadow-sm' : 'btn-light text-secondary border' %>" data-filter="all-active">
                <i class="bi bi-collection me-1"></i> Alle Actieve
                <span class="badge rounded-pill ms-1 <%= defaultFilter === 'all-active' ? 'bg-white text-primary' : 'bg-secondary-subtle text-secondary' %>" id="badgeCountAllActive"><%= countAllActive %></span>
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn btn-light text-secondary border" data-filter="homepage">
                <i class="bi bi-megaphone-fill text-success me-1"></i> Op Startpagina
                <span class="badge rounded-pill ms-1 bg-secondary-subtle text-secondary" id="badgeCountHomepage"><%= countHomepage %></span>
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn btn-light text-secondary border" data-filter="public">
                <i class="bi bi-globe2 text-info me-1"></i> Publiek
                <span class="badge rounded-pill ms-1 bg-secondary-subtle text-secondary" id="badgeCountPublic"><%= countPublic %></span>
            </button>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn btn-light text-secondary border" data-filter="private">
                <i class="bi bi-lock-fill text-warning me-1"></i> Alleen Leiding
                <span class="badge rounded-pill ms-1 bg-secondary-subtle text-secondary" id="badgeCountPrivate"><%= countPrivate %></span>
            </button>
            <% if (countPast > 0) { %>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn btn-light text-secondary border" data-filter="past">
                <i class="bi bi-clock-history me-1"></i> Afgelopen (Recent)
                <span class="badge rounded-pill ms-1 bg-secondary-subtle text-secondary" id="badgeCountPast"><%= countPast %></span>
            </button>
            <% } %>
            <button type="button" class="btn btn-sm rounded-pill px-3 py-2 fw-semibold event-filter-btn btn-light text-secondary border ms-lg-auto" data-filter="archived">
                <i class="bi bi-archive me-1"></i> Archief
                <span class="badge rounded-pill ms-1 bg-secondary-subtle text-secondary" id="badgeCountArchived"><%= countArchived %></span>
            </button>
        </div>

        <!-- Search, Month Filter & Sort Controls -->
        <div class="row g-2 align-items-center">
            <div class="col-12 col-md-5 col-lg-6">
                <div class="position-relative">
                    <i class="bi bi-search position-absolute top-50 translate-middle-y text-muted" style="left: 16px; pointer-events: none;"></i>
                    <input type="search" id="adminEventSearch" class="form-control admin-filter-control ps-5" placeholder="Zoek op titel, datum of beschrijving (bv. Kamp, Zondag)...">
                </div>
            </div>
            <div class="col-12 col-sm-6 col-md-4 col-lg-3">
                <select id="adminEventMonthFilter" class="form-select admin-filter-control" aria-label="Filter op maand">
                    <option value="all">📅 Alle maanden</option>
                </select>
            </div>
            <div class="col-12 col-sm-6 col-md-3 col-lg-3">
                <select id="adminEventSort" class="form-select admin-filter-control" aria-label="Sorteer activiteiten">
                    <option value="date-asc">⬆️ Eerstvolgende eerst</option>
                    <option value="date-desc">⬇️ Nieuwste / verste eerst</option>
                    <option value="title-asc">🔤 Titel (A - Z)</option>
                </select>
            </div>
        </div>
    </div>
</div>

<!-- Results Summary Bar -->
<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3 px-1">
    <div class="text-muted small fw-medium" id="eventResultsSummary">
        Activiteiten laden...
    </div>
    <button type="button" id="btnResetEventFilters" class="btn btn-link btn-sm text-decoration-none p-0 d-none">
        <i class="bi bi-x-circle me-1"></i>Alle filters wissen
    </button>
</div>

<!-- Dynamic Grouped Events Container -->
<div id="adminEventsListContainer" class="mb-5"></div>

<!-- Empty State -->
<div id="adminEventsEmptyState" class="admin-toolbar-card shadow-sm rounded-4 text-center py-5 mb-5 d-none">
    <div class="p-4">
        <i class="bi bi-calendar2-x display-3 text-muted opacity-50 mb-3 d-block"></i>
        <h4 class="fw-bold text-dark mb-1" id="emptyStateTitle">Geen activiteiten gevonden</h4>
        <p class="text-muted mb-3" id="emptyStateText">Er zijn geen activiteiten die overeenkomen met je huidige zoekopdracht of filter.</p>
        <div class="d-flex justify-content-center gap-2 flex-wrap">
            <button type="button" class="btn btn-outline-secondary rounded-pill px-4" onclick="resetAdminEventFilters()">
                <i class="bi bi-arrow-counterclockwise me-1"></i> Filters herstellen
            </button>
            <button type="button" class="btn btn-success rounded-pill px-4" onclick="openAddEventModal()">
                <i class="bi bi-plus-circle me-1"></i> Nieuwe Activiteit Toevoegen
            </button>
        </div>
    </div>
</div>

<!-- Embedded Events Data for Instant Filtering, Grouping & Sorting -->
<script id="adminEventsDataJson" type="application/json">
<%- JSON.stringify(allCombinedEvents).replace(/<\//g, '<\\/') %>
</script>

