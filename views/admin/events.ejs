<%- include('../partials/event_modal') %>

<script>
    // Backwards-compatible alias
    window.openEditModal = function(eventObj) {
        window.openEditEventModal(eventObj);
    };

    (function() {
        const TODAY_STR = '<%= currentToday %>';
        const MONTH_NAMES_SHORT = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
        const MONTH_NAMES_FULL = ["Januari", "Februari", "Maart", "April", "Mei", "Juni", "Juli", "Augustus", "September", "Oktober", "November", "December"];
        const DAY_NAMES_FULL = ["Zondag", "Maandag", "Dinsdag", "Woensdag", "Donderdag", "Vrijdag", "Zaterdag"];

        let allEvents = [];
        try {
            const raw = document.getElementById('adminEventsDataJson')?.textContent || '[]';
            allEvents = JSON.parse(raw);
        } catch (e) {
            console.error('Could not parse events JSON:', e);
            allEvents = [];
        }

        let activeFilter = '<%= defaultFilter %>';
        let searchQuery = '';
        let selectedMonth = 'all';
        let currentSort = activeFilter === 'upcoming' ? 'date-asc' : 'date-desc';

        const searchInput = document.getElementById('adminEventSearch');
        const monthSelect = document.getElementById('adminEventMonthFilter');
        const sortSelect = document.getElementById('adminEventSort');
        const listContainer = document.getElementById('adminEventsListContainer');
        const emptyState = document.getElementById('adminEventsEmptyState');
        const summaryEl = document.getElementById('eventResultsSummary');
        const resetBtn = document.getElementById('btnResetEventFilters');

        function getCsrfToken() {
            return document.querySelector('meta[name="csrf-token"]')?.getAttribute('content') || '';
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#39;');
        }

        function stripHtml(html) {
            if (!html) return '';
            return String(html).replace(/<[^>]*>?/gm, ' ').replace(/&nbsp;/gi, ' ').replace(/\s+/g, ' ').trim();
        }

        function formatEventDateInfo(event) {
            const [y, m, d] = (event.date || '2026-01-01').split('-').map(Number);
            const dateObj = new Date(y, m - 1, d);
            const dayName = DAY_NAMES_FULL[dateObj.getDay()];
            const dayNum = dateObj.getDate();
            const monthShort = MONTH_NAMES_SHORT[dateObj.getMonth()];
            const monthFull = MONTH_NAMES_FULL[dateObj.getMonth()].toLowerCase();

            let fullLabel = `${dayName} ${dayNum} ${monthFull} ${y}`;
            const hasEndDate = Boolean(event.endDate && event.endDate !== event.date);
            if (hasEndDate) {
                const [ey, em, ed] = event.endDate.split('-').map(Number);
                const endObj = new Date(ey, em - 1, ed);
                const endMonthFull = MONTH_NAMES_FULL[endObj.getMonth()].toLowerCase();
                fullLabel = `${dayNum} ${monthFull} t/m ${endObj.getDate()} ${endMonthFull} ${ey}`;
            }

            // Relative days calculation
            const [ty, tm, td] = TODAY_STR.split('-').map(Number);
            const todayMidnight = new Date(ty, tm - 1, td);
            const startMidnight = new Date(y, m - 1, d);
            const endRef = hasEndDate ? new Date(...event.endDate.split('-').map((n, i) => i === 1 ? Number(n) - 1 : Number(n))) : startMidnight;
            const diffDays = Math.round((startMidnight - todayMidnight) / (1000 * 60 * 60 * 24));

            let relativeBadge = '';
            if (event._bucket === 'archived') {
                relativeBadge = `<span class="badge bg-secondary-subtle text-secondary border rounded-pill">Gearchiveerd</span>`;
            } else if (startMidnight <= todayMidnight && endRef >= todayMidnight) {
                relativeBadge = `<span class="badge bg-danger text-white rounded-pill">Vandaag / Bezig</span>`;
            } else if (diffDays === 1) {
                relativeBadge = `<span class="badge bg-warning text-dark rounded-pill">Morgen</span>`;
            } else if (diffDays > 1 && diffDays <= 14) {
                relativeBadge = `<span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill">Binnen ${diffDays} dagen</span>`;
            } else if (endRef < todayMidnight) {
                relativeBadge = `<span class="badge bg-light text-muted border rounded-pill">Afgelopen</span>`;
            }

            return {
                dayNum,
                monthShort,
                monthKey: `${y}-${String(m).padStart(2, '0')}`,
                monthGroupLabel: `${MONTH_NAMES_FULL[dateObj.getMonth()]} ${y}`,
                fullLabel,
                hasEndDate,
                relativeBadge
            };
        }

        function populateMonthDropdown() {
            if (!monthSelect) return;
            const currentVal = monthSelect.value;
            const monthMap = new Map();

            allEvents.forEach(ev => {
                if (!ev.date) return;
                const [y, m] = ev.date.split('-').map(Number);
                if (!y || !m) return;
                const key = `${y}-${String(m).padStart(2, '0')}`;
                const label = `${MONTH_NAMES_FULL[m - 1]} ${y}`;
                monthMap.set(key, (monthMap.get(key) || { label, count: 0 }));
                monthMap.get(key).count += 1;
            });

            const sortedKeys = Array.from(monthMap.keys()).sort();
            monthSelect.innerHTML = `<option value="all">📅 Alle maanden (${allEvents.length})</option>`;
            sortedKeys.forEach(key => {
                const info = monthMap.get(key);
                const opt = document.createElement('option');
                opt.value = key;
                opt.textContent = `${info.label} (${info.count})`;
                monthSelect.appendChild(opt);
            });
            if (sortedKeys.includes(currentVal)) {
                monthSelect.value = currentVal;
            }
        }

        function updateCounters() {
            const cUpcoming = allEvents.filter(e => e._bucket === 'upcoming').length;
            const activeList = allEvents.filter(e => e._bucket !== 'archived');
            const cAllActive = activeList.length;
            const cHomepage = activeList.filter(e => e.showOnPublicPage && !e.isPrivate).length;
            const cPublic = activeList.filter(e => !e.isPrivate).length;
            const cPrivate = activeList.filter(e => e.isPrivate).length;
            const cPast = allEvents.filter(e => e._bucket === 'past').length;
            const cArchived = allEvents.filter(e => e._bucket === 'archived').length;

            const setBadge = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };
            setBadge('badgeCountUpcoming', cUpcoming);
            setBadge('badgeCountAllActive', cAllActive);
            setBadge('badgeCountHomepage', cHomepage);
            setBadge('badgeCountPublic', cPublic);
            setBadge('badgeCountPrivate', cPrivate);
            setBadge('badgeCountPast', cPast);
            setBadge('badgeCountArchived', cArchived);
        }

        function matchesFilter(event) {
            if (activeFilter === 'upcoming' && event._bucket !== 'upcoming') return false;
            if (activeFilter === 'all-active' && event._bucket === 'archived') return false;
            if (activeFilter === 'homepage' && (event._bucket === 'archived' || !event.showOnPublicPage || event.isPrivate)) return false;
            if (activeFilter === 'public' && (event._bucket === 'archived' || event.isPrivate)) return false;
            if (activeFilter === 'private' && (event._bucket === 'archived' || !event.isPrivate)) return false;
            if (activeFilter === 'past' && event._bucket !== 'past') return false;
            if (activeFilter === 'archived' && event._bucket !== 'archived') return false;

            if (selectedMonth !== 'all') {
                const evMonth = (event.date || '').slice(0, 7);
                if (evMonth !== selectedMonth) return false;
            }

            if (searchQuery) {
                const q = searchQuery.toLowerCase();
                const dateInfo = formatEventDateInfo(event);
                const haystack = [
                    event.title || '',
                    stripHtml(event.description || ''),
                    event.date || '',
                    event.endDate || '',
                    dateInfo.fullLabel,
                    dateInfo.monthGroupLabel,
                    event.isPrivate ? 'leiding intern prive' : 'publiek openbaar',
                    event.showOnPublicPage ? 'startpagina homepagina' : ''
                ].join(' ').toLowerCase();

                if (!haystack.includes(q)) return false;
            }

            return true;
        }

        function renderEvents() {
            const filtered = allEvents.filter(matchesFilter);

            // Sort filtered events
            filtered.sort((a, b) => {
                if (currentSort === 'title-asc') {
                    return (a.title || '').localeCompare(b.title || '', 'nl');
                }
                if (currentSort === 'date-desc') {
                    return (b.date || '').localeCompare(a.date || '');
                }
                return (a.date || '').localeCompare(b.date || '');
            });

            const hasActiveSearchOrMonth = searchQuery.length > 0 || selectedMonth !== 'all';
            if (resetBtn) {
                resetBtn.classList.toggle('d-none', !hasActiveSearchOrMonth);
            }

            if (summaryEl) {
                const filterNames = {
                    'upcoming': 'aankomende activiteiten',
                    'all-active': 'actieve activiteiten',
                    'homepage': 'activiteiten op de startpagina',
                    'public': 'publieke activiteiten',
                    'private': 'leidingsactiviteiten',
                    'past': 'recent afgelopen activiteiten',
                    'archived': 'gearchiveerde activiteiten'
                };
                summaryEl.textContent = `${filtered.length} ${filterNames[activeFilter] || 'activiteiten'} weergegeven`;
            }

            if (filtered.length === 0) {
                listContainer.innerHTML = '';
                emptyState.classList.remove('d-none');
                return;
            }

            emptyState.classList.add('d-none');

            // Group by Month-Year (unless sorting alphabetically)
            const groups = [];
            if (currentSort === 'title-asc') {
                groups.push({ label: 'Alfabetisch overzicht (A - Z)', items: filtered });
            } else {
                const groupMap = new Map();
                filtered.forEach(ev => {
                    const info = formatEventDateInfo(ev);
                    if (!groupMap.has(info.monthKey)) {
                        const grp = { key: info.monthKey, label: info.monthGroupLabel, items: [] };
                        groupMap.set(info.monthKey, grp);
                        groups.push(grp);
                    }
                    groupMap.get(info.monthKey).items.push(ev);
                });
            }

            const token = getCsrfToken();
            let html = '';

            groups.forEach(group => {
                html += `
                    <div class="mb-4">
                        <div class="d-flex align-items-center justify-content-between mb-2 px-1">
                            <h5 class="admin-month-header fw-bold mb-0 d-flex align-items-center gap-2">
                                <i class="bi bi-calendar3 text-primary"></i> ${escapeHtml(group.label)}
                            </h5>
                            <span class="badge bg-light text-secondary border rounded-pill">${group.items.length} ${group.items.length === 1 ? 'activiteit' : 'activiteiten'}</span>
                        </div>
                        <div class="d-flex flex-column gap-2">
                `;

                group.items.forEach(ev => {
                    const info = formatEventDateInfo(ev);
                    const plainDesc = stripHtml(ev.description);
                    const shortDesc = plainDesc.length > 120 ? plainDesc.slice(0, 117) + '...' : plainDesc;

                    let attCount = 0;
                    try {
                        const parsedAtt = typeof ev.attachments === 'string' ? JSON.parse(ev.attachments) : (ev.attachments || []);
                        attCount = Array.isArray(parsedAtt) ? parsedAtt.length : 0;
                    } catch (e) {}

                    let stampBg = 'var(--chiro-red, #db3e41)';
                    if (ev._bucket === 'archived' || ev._bucket === 'past') {
                        stampBg = '#64748b';
                    } else if (ev.isPrivate) {
                        stampBg = 'var(--chiro-blue, #1d4e89)';
                    }

                    const serializedEvent = escapeHtml(JSON.stringify(ev));

                    html += `
                        <div class="admin-event-card ${ev._bucket !== 'upcoming' ? 'is-past-event' : ''}" data-event-id="${ev.id}" data-event="${serializedEvent}">
                            <div class="admin-event-layout">
                                <!-- Date Stamp + Title & Meta -->
                                <div class="admin-event-main">
                                    <div class="admin-event-stamp shadow-sm" style="background-color: ${stampBg}; cursor: pointer;" onclick="openEventModal(this.closest('.admin-event-card'))" title="Klik om details te bekijken">
                                        <span class="stamp-day">${info.dayNum}</span>
                                        <span class="stamp-month">${info.monthShort}</span>
                                    </div>

                                    <div class="admin-event-info">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <a class="h5 fw-bold mb-0 admin-event-title-link text-break" onclick="openEventModal(this.closest('.admin-event-card'))">
                                                ${escapeHtml(ev.title)}
                                            </a>
                                            ${info.relativeBadge}
                                            ${ev.isPrivate
                                                ? `<span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill"><i class="bi bi-lock-fill me-1"></i>Alleen Leiding</span>`
                                                : `<span class="badge bg-info-subtle text-info-emphasis border border-info-subtle rounded-pill"><i class="bi bi-globe2 me-1"></i>Publiek</span>`
                                            }
                                            ${(!ev.isPrivate && ev.showOnPublicPage)
                                                ? `<span class="badge bg-success text-white rounded-pill"><i class="bi bi-megaphone-fill me-1"></i>Op Startpagina</span>`
                                                : ''
                                            }
                                        </div>

                                        <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                                            <span><i class="bi bi-calendar-event me-1"></i>${escapeHtml(info.fullLabel)}</span>
                                            ${ev.startTime ? `<span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-clock me-1 text-primary"></i>${escapeHtml(ev.startTime)}${ev.endTime ? ' - ' + escapeHtml(ev.endTime) : ''}</span>` : ''}
                                            ${attCount > 0 ? `<span class="badge bg-light text-secondary border rounded-pill"><i class="bi bi-paperclip me-1 text-primary"></i>${attCount} ${attCount === 1 ? 'bijlage' : 'bijlagen'}</span>` : ''}
                                        </div>

                                        ${shortDesc ? `<div class="admin-event-desc-preview mt-1">${escapeHtml(shortDesc)}</div>` : ''}
                                    </div>
                                </div>

                                <!-- Action Buttons Inside Box -->
                                <div class="admin-event-actions">
                                    ${!ev.isPrivate ? `
                                        <button type="button"
                                                class="btn btn-sm ${ev.showOnPublicPage ? 'btn-success text-white' : 'btn-outline-secondary'} rounded-pill px-3 d-inline-flex align-items-center btn-mobile-expand"
                                                title="${ev.showOnPublicPage ? 'Verwijder van de openbare startpagina' : 'Zet bij Aankomende Activiteiten op de startpagina'}"
                                                onclick="togglePublicHomepage(${ev.id}, this)">
                                            <i class="bi ${ev.showOnPublicPage ? 'bi-megaphone-fill' : 'bi-megaphone'} me-1"></i>
                                            <span class="small">${ev.showOnPublicPage ? 'Op Startpagina' : '+ Startpagina'}</span>
                                        </button>
                                    ` : ''}

                                    <button type="button"
                                            class="btn btn-sm btn-primary rounded-pill px-3 d-inline-flex align-items-center btn-mobile-expand"
                                            onclick="openEditEventModal(this.closest('.admin-event-card'))">
                                        <i class="bi bi-pencil-square me-1"></i> Bewerken
                                    </button>

                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-light border rounded-pill px-2" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Meer acties">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 rounded-3 p-1">
                                            <li>
                                                <button type="button" class="dropdown-item rounded-2 small py-2" onclick="openEventModal(this.closest('.admin-event-card'))">
                                                    <i class="bi bi-eye me-2 text-primary"></i>Voorbeeld bekijken
                                                </button>
                                            </li>
                                            <li>
                                                <button type="button" class="dropdown-item rounded-2 small py-2" onclick="duplicateAdminEvent(this.closest('.admin-event-card'))">
                                                    <i class="bi bi-files me-2 text-info"></i>Dupliceren als nieuw
                                                </button>
                                            </li>
                                            <li><hr class="dropdown-divider my-1"></li>
                                            ${ev._bucket === 'archived' ? `
                                                <li>
                                                    <form action="/admin/events/${ev.id}/unarchive?_csrf=${encodeURIComponent(token)}" method="POST">
                                                        <input type="hidden" name="_csrf" value="${escapeHtml(token)}">
                                                        <button type="submit" class="dropdown-item rounded-2 small py-2 text-success">
                                                            <i class="bi bi-arrow-up-circle me-2"></i>Herstellen uit archief
                                                        </button>
                                                    </form>
                                                </li>
                                            ` : `
                                                <li>
                                                    <form action="/admin/events/${ev.id}/archive?_csrf=${encodeURIComponent(token)}" method="POST">
                                                        <input type="hidden" name="_csrf" value="${escapeHtml(token)}">
                                                        <button type="submit" class="dropdown-item rounded-2 small py-2 text-warning">
                                                            <i class="bi bi-archive me-2"></i>Archiveren
                                                        </button>
                                                    </form>
                                                </li>
                                            `}
                                            <li>
                                                <form action="/admin/events/${ev.id}?_method=DELETE&_csrf=${encodeURIComponent(token)}" method="POST" onsubmit="return confirm('Weet je zeker dat je deze activiteit wilt verwijderen?');">
                                                    <input type="hidden" name="_csrf" value="${escapeHtml(token)}">
                                                    <button type="submit" class="dropdown-item rounded-2 small py-2 text-danger">
                                                        <i class="bi bi-trash me-2"></i>Definitief verwijderen
                                                    </button>
                                                </form>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>
                        </div>
                    `;
                });

                html += `
                        </div>
                    </div>
                `;
            });

            listContainer.innerHTML = html;
        }

        window.togglePublicHomepage = async function(eventId, btnEl) {
            if (!eventId) return;
            if (btnEl) btnEl.disabled = true;
            try {
                const res = await fetch(`/admin/events/${eventId}/toggle-public`, {
                    method: 'POST',
                    headers: {
                        'Accept': 'application/json',
                        'Content-Type': 'application/json'
                    }
                });
                const data = await res.json();
                if (data && data.success) {
                    const target = allEvents.find(e => Number(e.id) === Number(eventId));
                    if (target) {
                        target.showOnPublicPage = Boolean(data.showOnPublicPage);
                        target.isPrivate = Boolean(data.isPrivate);
                    }
                    updateCounters();
                    renderEvents();
                } else {
                    window.location.reload();
                }
            } catch (err) {
                console.error('Error toggling public status:', err);
                window.location.reload();
            }
        };

        window.duplicateAdminEvent = function(cardEl) {
            if (!cardEl) return;
            try {
                const ev = JSON.parse(cardEl.getAttribute('data-event'));
                window.openAddEventModal({
                    title: ev.title + ' (Kopie)',
                    date: ev.date,
                    endDate: ev.endDate,
                    startTime: ev.startTime,
                    endTime: ev.endTime,
                    description: ev.description,
                    isPrivate: ev.isPrivate,
                    showOnPublicPage: ev.showOnPublicPage
                });
            } catch (e) {
                console.error('Could not duplicate event:', e);
            }
        };

        window.resetAdminEventFilters = function() {
            searchQuery = '';
            selectedMonth = 'all';
            activeFilter = 'all-active';
            currentSort = 'date-asc';
            if (searchInput) searchInput.value = '';
            if (monthSelect) monthSelect.value = 'all';
            if (sortSelect) sortSelect.value = 'date-asc';
            syncFilterPillStyles();
            renderEvents();
        };

        function syncFilterPillStyles() {
            const buttons = document.querySelectorAll('.event-filter-btn');
            buttons.forEach(btn => {
                const isSelected = btn.getAttribute('data-filter') === activeFilter;
                btn.classList.toggle('btn-primary', isSelected);
                btn.classList.toggle('text-white', isSelected);
                btn.classList.toggle('shadow-sm', isSelected);
                btn.classList.toggle('btn-light', !isSelected);
                btn.classList.toggle('text-secondary', !isSelected);
                btn.classList.toggle('border', !isSelected);

                const badge = btn.querySelector('.badge');
                if (badge) {
                    badge.classList.toggle('bg-white', isSelected);
                    badge.classList.toggle('text-primary', isSelected);
                    badge.classList.toggle('bg-secondary-subtle', !isSelected);
                    badge.classList.toggle('text-secondary', !isSelected);
                }
            });
        }

        document.querySelectorAll('.event-filter-btn').forEach(btn => {
            btn.addEventListener('click', function() {
                activeFilter = this.getAttribute('data-filter');
                if (activeFilter === 'upcoming') {
                    currentSort = 'date-asc';
                } else if (activeFilter === 'archived' || activeFilter === 'past') {
                    currentSort = 'date-desc';
                }
                if (sortSelect) sortSelect.value = currentSort;
                syncFilterPillStyles();
                renderEvents();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                searchQuery = this.value.trim();
                renderEvents();
            });
        }

        if (monthSelect) {
            monthSelect.addEventListener('change', function() {
                selectedMonth = this.value;
                renderEvents();
            });
        }

        if (sortSelect) {
            sortSelect.value = currentSort;
            sortSelect.addEventListener('change', function() {
                currentSort = this.value;
                renderEvents();
            });
        }

        if (resetBtn) {
            resetBtn.addEventListener('click', window.resetAdminEventFilters);
        }

        populateMonthDropdown();
        updateCounters();
        renderEvents();
    })();
</script>

<%- include('../partials/footer') %>
