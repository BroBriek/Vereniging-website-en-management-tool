<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Kalender Beheren</h1>
    <div>
        <a href="/admin/info" class="btn btn-info text-white me-2" title="Algemene Hulp & Info">
            <i class="bi bi-info-circle"></i> Algemene Info
        </a>
        <a href="/admin" class="btn btn-secondary">Terug</a>
    </div>
</div>

<div class="card mb-4">
    <div class="card-header">Nieuwe Activiteit</div>
    <div class="card-body">
        <form action="/admin/events" method="POST">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label>Titel</label>
                    <input type="text" class="form-control" name="title" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label>Begindatum</label>
                    <input type="date" class="form-control" name="date" required>
                </div>
                <div class="col-md-3 mb-3">
                    <label>Einddatum (optioneel)</label>
                    <input type="date" class="form-control" name="endDate">
                </div>
                <div class="col-md-3 mb-3">
                    <label>Startuur (optioneel)</label>
                    <input type="time" class="form-control" name="startTime">
                </div>
                <div class="col-md-3 mb-3">
                    <label>Einduur (optioneel)</label>
                    <input type="time" class="form-control" name="endTime">
                </div>
                <div class="col-md-12 mb-3">
                    <label>Beschrijving</label>
                    <textarea class="form-control rich-editor" name="description" rows="2"></textarea>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Toevoegen</button>
        </form>
    </div>
</div>

<h3>Geplande Activiteiten</h3>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Datum</th>
            <th>Titel</th>
            <th>Actie</th>
        </tr>
    </thead>
    <tbody>
        <% events.forEach(event => { %>
            <tr>
                <td>
                    <%= event.date %>
                    <% if (event.endDate && event.endDate !== event.date) { %>
                        t/m <%= event.endDate %>
                    <% } %>
                </td>
                <td><%= event.title %></td>
                <td>
                    <div class="btn-group">
                        <button type="button" class="btn btn-sm btn-primary me-1" onclick='openEditModal(<%- JSON.stringify(event).replace(/'/g, "&#39;") %>)'>
                            Bewerk
                        </button>
                        <form action="/admin/events/<%= event.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Zeker weten?');">
                            <button type="submit" class="btn btn-sm btn-danger">Verwijder</button>
                        </form>
                    </div>
                </td>
            </tr>
        <% }) %>
    </tbody>
</table>

<!-- Edit Modal -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Activiteit Bewerken</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm" method="POST">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label>Titel</label>
                            <input type="text" class="form-control" name="title" id="editTitle" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Begindatum</label>
                            <input type="date" class="form-control" name="date" id="editDate" required>
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Einddatum (optioneel)</label>
                            <input type="date" class="form-control" name="endDate" id="editEndDate">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Startuur (optioneel)</label>
                            <input type="time" class="form-control" name="startTime" id="editStartTime">
                        </div>
                        <div class="col-md-3 mb-3">
                            <label>Einduur (optioneel)</label>
                            <input type="time" class="form-control" name="endTime" id="editEndTime">
                        </div>
                        <div class="col-md-12 mb-3">
                            <label>Beschrijving</label>
                            <textarea class="form-control rich-editor" name="description" id="editDescription" rows="2"></textarea>
                        </div>
                    </div>
                    <div class="text-end">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
                        <button type="submit" class="btn btn-primary">Opslaan</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function openEditModal(event) {
        const form = document.getElementById('editForm');
        form.action = `/admin/events/${event.id}?_method=PUT`;
        
        document.getElementById('editTitle').value = event.title;
        document.getElementById('editDate').value = event.date;
        document.getElementById('editEndDate').value = event.endDate || '';
        document.getElementById('editStartTime').value = event.startTime || '';
        document.getElementById('editEndTime').value = event.endTime || '';
        
        const descField = document.getElementById('editDescription');
        descField.value = event.description || '';
        
        // Handle Quill editor update if it exists
        const modalEl = document.getElementById('editModal');
        const modal = bootstrap.Modal.getOrCreateInstance(modalEl);
        
        modalEl.addEventListener('shown.bs.modal', function () {
            // If the editor isn't initialized yet, do it now
            if (!descField.classList.contains('rich-editor-initialized')) {
                if (window.initializeRichEditors) {
                    window.initializeRichEditors(descField);
                }
            }
            
            const quillContainer = descField.parentElement.querySelector('.ql-container');
            if (quillContainer) {
                const quill = Quill.find(quillContainer);
                if (quill) {
                    quill.root.innerHTML = event.description || '';
                }
            }
        }, { once: true });

        modal.show();
    }
</script>
<%- include('../partials/footer') %>