<%- include('../partials/header', { fullWidth: true }) %>

<!-- Admin Wiki Hero -->
<style>
    :root {
        --wiki-sidebar-width: 280px;
    }
    .admin-hero {
        background: linear-gradient(135deg, var(--chiro-blue) 0%, #2c5da0 50%, var(--chiro-red) 100%);
        padding: 50px 0;
        border-radius: 0 0 50px 50px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        margin-bottom: 3rem;
        position: relative;
    }
    .admin-hero-text h1 {
        font-size: 3.5rem;
        color: white;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
    }
    .wiki-container {
        display: flex;
        gap: 30px;
    }
    .wiki-sidebar {
        width: var(--wiki-sidebar-width);
        position: sticky;
        top: 110px;
        height: calc(100vh - 140px);
        overflow-y: auto;
        padding-right: 10px;
    }
    .wiki-content {
        flex: 1;
        max-width: 900px;
    }
    .wiki-nav-link {
        display: block;
        padding: 10px 15px;
        color: var(--text-color);
        text-decoration: none;
        border-radius: 12px;
        margin-bottom: 5px;
        transition: all 0.2s;
        font-family: var(--font-heading);
    }
    .wiki-nav-link:hover {
        background-color: rgba(29, 78, 137, 0.1);
        color: var(--chiro-blue);
        transform: translateX(5px);
    }
    .wiki-nav-link.active {
        background-color: var(--chiro-blue);
        color: white;
    }
    .wiki-section {
        background: white;
        border-radius: 30px;
        padding: 40px;
        margin-bottom: 40px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.05);
        border: 1px solid rgba(0,0,0,0.05);
    }
    .wiki-section h2 {
        font-size: 2.2rem;
        border-bottom: 3px solid var(--chiro-red);
        display: inline-block;
        padding-bottom: 5px;
        margin-bottom: 30px;
    }
    .wiki-section h3 {
        color: var(--chiro-blue);
        margin-top: 2rem;
        font-weight: 700;
    }
    .pro-tip {
        background-color: #fff9db;
        border-left: 5px solid #fcc419;
        padding: 20px;
        border-radius: 15px;
        margin: 20px 0;
    }
    .warning-box {
        background-color: #fff5f5;
        border-left: 5px solid #ff6b6b;
        padding: 20px;
        border-radius: 15px;
        margin: 20px 0;
    }
    .feature-tag {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 1px;
        font-weight: bold;
        padding: 4px 10px;
        border-radius: 50px;
        margin-bottom: 10px;
        display: inline-block;
    }
    @media (max-width: 991px) {
        .wiki-container { flex-direction: column; }
        .wiki-sidebar { width: 100%; position: static; height: auto; }
    }
</style>

<div class="admin-hero">
    <div class="container">
        <div class="admin-hero-text text-center text-white">
            <h1>Hoofdleiding Wiki</h1>
            <p class="lead">De ultieme handleiding voor het beheer van Chiro Meeuwen (voor de website trouwens...).</p>
            <a href="/admin" class="btn btn-light rounded-pill px-4 mt-3 fw-bold">
                <i class="bi bi-arrow-left me-2"></i>Terug naar Dashboard
            </a>
        </div>
    </div>
</div>

<div class="container pb-6">
    <div class="wiki-container">
        <!-- Sidebar Navigation -->
        <aside class="wiki-sidebar d-none d-lg-block">
            <h5 class="fw-bold mb-3 px-3">Onderwerpen</h5>
            <nav>
                <a href="#cms" class="wiki-nav-link"><i class="bi bi-pencil-square me-2"></i>Content & Pagina's</a>
                <a href="#inschrijvingen" class="wiki-nav-link"><i class="bi bi-people me-2"></i>Inschrijvingen</a>
                <a href="#leiding" class="wiki-nav-link"><i class="bi bi-person-badge me-2"></i>Leidingsploeg</a>
                <a href="#kalender" class="wiki-nav-link"><i class="bi bi-calendar3 me-2"></i>Kalender</a>
                <a href="#feed" class="wiki-nav-link"><i class="bi bi-chat-dots me-2"></i>Leidingshoek & Events</a>
                <a href="#boekhouding" class="wiki-nav-link"><i class="bi bi-piggy-bank me-2"></i>Boekhouding</a>
                <a href="#email" class="wiki-nav-link"><i class="bi bi-envelope me-2"></i>Email Tool</a>
                <a href="#gebruikers" class="wiki-nav-link"><i class="bi bi-shield-lock me-2"></i>Toegang & Rollen</a>
                <a href="#systeem" class="wiki-nav-link text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Systeem & Danger Zone</a>
            </nav>
        </aside>

        <!-- Wiki Content -->
        <main class="wiki-content">

            <!-- SECTION: CMS -->
            <section id="cms" class="wiki-section">
                <span class="feature-tag bg-primary text-white">Basis Beheer</span>
                <h2>Inhoud & Pagina's</h2>
                <p>De website is opgedeeld in vaste pagina's die je via de interface kunt bewerken zonder technische kennis.</p>
                
                <h3>Pagina's Aanpassen</h3>
                <p>Navigeer op de publieke site naar een pagina (bv. Home of Praktisch). Als je bent ingelogd als admin, zie je bovenaan een knop <strong>"Bewerk Pagina"</strong>. Hiermee open je de editor voor die specifieke pagina.</p>
                
                <h3>De Slimme Editor</h3>
                <p>De editor werkt vergelijkbaar met Word of Google Docs:</p>
                <ul>
                    <li><strong>Tekststijlen:</strong> Gebruik "Kop 1" voor hoofdtitels en "Kop 2" voor tussentitels. Dit is belangrijk voor de zoekmachines (SEO).</li>
                    <li><strong>Afbeeldingen:</strong> Je hoeft geen afbeeldingen meer apart te uploaden. Je kunt ze simpelweg <strong>plakken (Ctrl+V)</strong> in het tekstvak of erheen slepen.</li>
                    <li><strong>Links:</strong> Selecteer een tekst en gebruik de link-knop om te verwijzen naar andere websites of PDF-bestanden.</li>
                </ul>

                <div class="pro-tip">
                    <i class="bi bi-lightbulb-fill text-warning me-2"></i>
                    <strong>Pro-tip:</strong> Gebruik de editor ook om knoppen te maken! Maak een link en de website zorgt automatisch voor de juiste styling.
                </div>
            </section>

            <!-- SECTION: INSCHRIJVINGEN -->
            <section id="inschrijvingen" class="wiki-section">
                <span class="feature-tag bg-success text-white">Ledenbeheer</span>
                <h2>Inschrijvingen & Ledenlijst</h2>
                <p>Hier kun je de inschrijvingen bekijken en verwerken.</p>

                <h3>Werkjaren & Periodes</h3>
                <p>Het systeem werkt met <strong>Periodes</strong> (bv. '24-25'). Elke inschrijving is gekoppeld aan een periode.</p>
                <ul>
                    <li><strong>Filteren:</strong> In het overzicht kun je per werkjaar filteren. Oude inschrijvingen worden nooit gewist, maar gearchiveerd.</li>
                    <li><strong>Zoeken:</strong> De zoekbalk doorzoekt namen, e-mails, en telefoonnummers van zowel leden als ouders.</li>
                </ul>

                <h3>Exporteren</h3>
                <p>Je kunt de lijst op twee manieren exporteren:</p>
                <ol>
                    <li><strong>Excel (.xlsx):</strong> Volledige export met alle kolommen, inclusief medische info, voor verdere verwerking in Excel.</li>
                    <li><strong>PDF Lijst:</strong> Een compacte, print-vriendelijke versie, ideaal voor tijdens activiteiten of op kamp.</li>
                </ol>

                <div class="warning-box">
                    <i class="bi bi-exclamation-triangle-fill text-danger me-2"></i>
                    <strong>Let op:</strong> Gebruik de optie <strong>"Start Nieuw Werkjaar"</strong> (onder de knop <strong>Werkjaar</strong>) alleen aan het begin van een nieuw Chiro-jaar (september). Dit maakt de actieve lijst leeg voor nieuwe registraties en archiveert de huidige leden onder de huidige periode.
                </div>
            </section>

            <!-- SECTION: LEIDING -->
            <section id="leiding" class="wiki-section">
                <span class="feature-tag bg-info text-white">Team</span>
                <h2>Leidingsploeg</h2>
                <p>Hier beheer je wie er op de "Leiding" pagina verschijnt.</p>
                
                <h3>Leiding Toevoegen</h3>
                <p>Kies een afdeling (bv. Keti's) en vul de naam in. De website sorteert leiding automatisch alfabetisch binnen hun afdeling.</p>
                
                <h3>Groepsfoto's & Carousel</h3>
                <p>Als een afdeling veel leiding heeft (meer dan 4), verandert de weergave op de site automatisch in een handige schuiflijst (carousel) om te voorkomen dat de pagina te lang wordt.</p>
            </section>

            <!-- SECTION: KALENDER -->
            <section id="kalender" class="wiki-section">
                <span class="feature-tag bg-danger text-white">Planning</span>
                <h2>Kalender & Synchronisatie</h2>
                <p>De kalender ondersteunt zowel publieke als interne events.</p>

                <h3>Publiek vs. Privé (Leiding Only)</h3>
                <ul>
                    <li><strong>Publiek (Rood):</strong> Zichtbaar voor iedereen. Voorbeelden: Startdag, Christus Koning, Kamp.</li>
                    <li><strong>Privé (Blauw):</strong> Alleen zichtbaar voor ingelogde leiding. Voorbeelden: LKs, Leidingsweekend,..</li>
                </ul>

                <h3>Automatische Agenda Sync</h3>
                <p>Elke leiding kan hun persoonlijke Chiro-kalender koppelen aan hun telefoon (Google/Apple Calendar). 
                Omdat dit via een unieke <strong>Calendar Token</strong> werkt, krijgen zij hun privé-events automatisch te zien in hun eigen agenda app, terwijl ouders alleen de publieke rode items zien.</p>
            </section>

            <!-- SECTION: FEED -->
            <section id="feed" class="wiki-section">
                <span class="feature-tag bg-warning text-dark">Intern</span>
                <h2>Leidingshoek & Event Pagina's</h2>
                <p>De Leidingshoek is het sociale intranet van de Chiro.</p>

                <h3>Groepen vs. Events</h3>
                <ul>
                    <li><strong>Groepen:</strong> Voor langdurige groepen (bv. "Leidingsploeg 24-25" of zelfs "Kookmoekes").</li>
                    <li><strong>Events:</strong> Voor tijdelijke, grote projecten (bv. "Leidingsweekend" of "Afscheid stoppende leiding"). Een event krijgt een eigen grote banner en duidelijke datums.</li>
                </ul>

                <h3>Interactieve Posts</h3>
                <p>Je kunt meer dan alleen tekst posten:</p>
                <ul>
                    <li><strong>Polls:</strong> Vraag snel wie er komt eten of welke kleur de nieuwe truien moeten worden.</li>
                    <li><strong>Formulieren:</strong> Je kunt een formulier-schema (JSON) toevoegen aan een post om gestructureerd data te verzamelen (bv. dieetwensen voor een weekend).</li>
                    <li><strong>Mentions:</strong> Gebruik <code>@naam</code> om iemand een directe notificatie te sturen.</li>
                </ul>

                <div class="pro-tip">
                    <i class="bi bi-shield-lock-fill me-2 text-primary"></i>
                    <strong>Toegangsbeheer:</strong> Je kunt per groep/event instellen wie toegang heeft. Admins hebben altijd overal toegang, maar voor gewone leiding moet je de toegang vinken bij hun gebruikersprofiel.
                </div>
            </section>

            <!-- SECTION: BOEKHOUDING -->
            <section id="boekhouding" class="wiki-section">
                <span class="feature-tag bg-success text-white">Financiën</span>
                <h2>Boekhouding (Financieel Tool)</h2>
                <p>Een krachtig systeem om de kas van de Chiro te beheren.</p>

                <h3>Mappenstructuur</h3>
                <p>Werk met mappen om alles georganiseerd te houden. Maak bijvoorbeeld een map "Werkjaar 24-25" met daarin submappen "Kamp", "Activiteiten" en "Inschrijvingsgeld".</p>

                <h3>Transacties & De "Betaald" Toggle</h3>
                <p>Elk item kan een transactie zijn (met een bedrag) of een map (zonder bedrag).</p>
                <ul>
                    <li><strong>Niet Betaald:</strong> Als je het vinkje "Betaald" uitzet, wordt de regel geel gemarkeerd.</li>
                    <li><strong>Logica:</strong> Onbetaalde items worden <strong>niet</strong> meegeteld in het totaal van de map. Dit is essentieel voor het bijhouden van wat er <em>daadwerkelijk</em> op de bankrekening staat vs. wat er nog moet komen.</li>
                </ul>

                <h3>Totaalberekening</h3>
                <p>Het saldo dat je bovenaan een map ziet, is de som van alle betaalde transacties in die map PLUS de totalen van alle submappen.</p>

                <div class="pro-tip">
                    <i class="bi bi-file-earmark-excel-fill text-success me-2"></i>
                    <strong>Export:</strong> Gebruik de <strong>"Export Niet Betaald"</strong> knop om een lijst te genereren van alle mensen die nog geld verschuldigd zijn.
                </div>
            </section>

            <!-- SECTION: EMAIL -->
            <section id="email" class="wiki-section">
                <span class="feature-tag bg-info text-white">Communicatie</span>
                <h2>Email Tool</h2>
                <p>Veilig en professioneel mailen naar grote groepen.</p>
                
                <h3>Doelgroepen</h3>
                <p>Je kunt mailen naar:</p>
                <ul>
                    <li><strong>Leiding:</strong> Alle actieve leiding op de site.</li>
                    <li><strong>Leden & Ouders:</strong> Alle inschrijvingen van een geselecteerde periode.</li>
                    <li><strong>Individueel:</strong> Een handmatige invoer van een adres.</li>
                </ul>

                <h3>BCC & Privacy</h3>
                <p>Het systeem zet automatisch alle ontvangers in <strong>BCC</strong>. Dit is wettelijk verplicht (GDPR) zodat ouders elkaars e-mailadres niet kunnen zien.</p>
            </section>

            <!-- SECTION: GEBRUIKERS -->
            <section id="gebruikers" class="wiki-section">
                <span class="feature-tag bg-secondary text-white">Beveiliging</span>
                <h2>Toegang & Rollen</h2>
                
                <p>Er zijn drie verschillende rollen in het systeem, elk met hun eigen rechten:</p>
                <ul>
                    <li><strong>Admin (Hoofdleiding):</strong> Heeft toegang tot werkelijk alles. Van de financiën en ledenlijst tot de "Danger Zone" met backups en reset-functies.</li>
                    <li><strong>Media (Website & Formulieren):</strong> Een speciale rol voor leiding die de website beheert. Zij kunnen teksten aanpassen, de kalender beheren, leiding toevoegen en formulieren maken/bekijken. Zij hebben <strong>geen</strong> toegang tot gevoelige info zoals de boekhouding, de volledige ledenlijst of systeeminstellingen.</li>
                    <li><strong>Member (Leiding):</strong> De standaard rol. Zij kunnen alleen de Leidingshoek zien (voor de groepen waar ze toegang toe hebben), berichten plaatsen en hun eigen instellingen beheren.</li>
                </ul>

                <h3>Wachtwoord Vergeten?</h3>
                <p>Als een leiding zijn wachtwoord vergeet, kan een admin bij "Gebruikers" op "Bewerk" klikken en handmatig een nieuw tijdelijk wachtwoord instellen.</p>
            
                <div class="pro-tip">
                    <i class="bi bi-shield-lock-fill text-primary me-2"></i>
                    <strong>Weetje:</strong> Er is een onzichtbare <strong>"Admin"-account</strong>. Deze wordt vooral gebruikt voor het testen van nieuwe features maar kan ook gebruikt worden als beide hoofdleiding hun wachtwoord vergeten zijn.
                </div>
            
            </section>

            <!-- SECTION: SYSTEEM -->
            <section id="systeem" class="wiki-section border-danger">
                <span class="feature-tag bg-danger text-white">Systeem</span>
                <h2>Systeem & Danger Zone</h2>
                <p>Deze functies staan onderaan het dashboard en zijn alleen voor noodgevallen of groot onderhoud.</p>
                
                <h3>Backups</h3>
                <p>Maak regelmatig een backup. Een backup bevat de volledige database (teksten, gebruikers, inschrijvingen) en alle geüploade bestanden.</p>
                
                <h3>Reset Functies</h3>
                <ul>
                    <li><strong>Reset Inschrijvingen:</strong> Wist alle leden uit de database. Gebruik dit alleen als je zeker weet dat je de oude lijst niet meer nodig hebt (of na een volledige backup).</li>
                    <li><strong>Reset Website:</strong> Brengt de site terug naar de "fabrieksinstellingen". Alles wordt gewist behalve je eigen admin account.</li>
                </ul>
            </section>

        </main>
    </div>
</div>

<script>
    // Smooth scrolling for wiki navigation
    document.querySelectorAll('.wiki-nav-link').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
            e.preventDefault();
            const targetId = this.getAttribute('href');
            const targetElement = document.querySelector(targetId);
            const offset = 100;
            const elementPosition = targetElement.getBoundingClientRect().top;
            const offsetPosition = elementPosition + window.pageYOffset - offset;

            window.scrollTo({
                top: offsetPosition,
                behavior: 'smooth'
            });

            // Update active state
            document.querySelectorAll('.wiki-nav-link').forEach(link => link.classList.remove('active'));
            this.classList.add('active');
        });
    });

    // Highlight active section on scroll
    window.addEventListener('scroll', () => {
        let current = "";
        const sections = document.querySelectorAll('.wiki-section');
        const navLinks = document.querySelectorAll('.wiki-nav-link');
        
        sections.forEach(section => {
            const sectionTop = section.offsetTop;
            if (pageYOffset >= sectionTop - 150) {
                current = section.getAttribute('id');
            }
        });

        navLinks.forEach(link => {
            link.classList.remove('active');
            if (link.getAttribute('href').includes(current)) {
                link.classList.add('active');
            }
        });
    });
</script>

