<%- include('../partials/header') %>
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
  <h1 class="mb-0">Leidingshoekjes beheren</h1>
  <div class="d-flex gap-2 w-100 w-sm-auto justify-content-start justify-content-sm-end">
    <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center">
      <i class="bi bi-arrow-left me-1"></i> <span class="d-none d-sm-inline">Terug naar Dashboard</span><span class="d-inline d-sm-none">Terug</span>
    </a>
    <button class="btn btn-success rounded-pill px-3 d-inline-flex align-items-center flex-grow-1 flex-sm-grow-0 justify-content-center" data-bs-toggle="modal" data-bs-target="#addPageModal">
      <i class="bi bi-plus-circle me-1"></i> Nieuw Hoekje
    </button>
  </div>
</div>

<%
  const normalGroups = groups.filter(g => !g.isEvent);
  const eventGroups = groups.filter(g => g.isEvent);
%>

<!-- Add Page Modal -->
<div class="modal fade" id="addPageModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg">
    <div class="modal-content">
      <div class="modal-header bg-success text-white">
        <h5 class="modal-title">Nieuw Leidingshoekje Toevoegen</h5>
        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <form action="/admin/feedgroups" method="POST">
          <div class="row">
            <div class="col-md-4 mb-3">
              <label class="fw-bold">Naam</label>
              <input type="text" name="name" class="form-control" placeholder="vb. Groep 2025" required>
            </div>
            <div class="col-md-4 mb-3">
              <label class="fw-bold">Jaar (optioneel)</label>
              <input type="text" name="year" class="form-control" placeholder="2025">
            </div>
            <div class="col-md-4 mb-3">
              <label class="fw-bold">Omschrijving</label>
              <input type="text" name="description" class="form-control" placeholder="Omschrijving">
            </div>
          </div>
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="newGroupIsEvent" name="isEvent">
            <label class="form-check-label" for="newGroupIsEvent">Dit is een event</label>
          </div>
          <div class="text-end mt-3">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
            <button type="submit" class="btn btn-success">Opslaan & Toevoegen</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<h3>Leidingshoekjes</h3>
<div class="table-responsive mb-5">
  <table class="table table-striped align-middle">
    <thead>
      <tr>
        <th>Naam</th>
        <th class="d-none d-md-table-cell">Slug</th>
        <th class="d-none d-sm-table-cell">Jaar</th>
        <th class="text-end">Acties</th>
      </tr>
    </thead>
    <tbody>
      <% normalGroups.forEach(g => { %>
        <tr>
          <td>
            <div class="fw-bold"><%= g.name %></div>
            <div class="d-md-none small"><code><%= g.slug %></code></div>
            <div class="d-sm-none small text-muted"><%= g.year || '' %></div>
          </td>
          <td class="d-none d-md-table-cell"><code><%= g.slug %></code></td>
          <td class="d-none d-sm-table-cell"><%= g.year || '' %></td>
          <td class="text-end">
            <div class="btn-group">
              <button class="btn btn-sm btn-outline-warning" onclick="openEditModal('<%= g.id %>', '<%= g.name %>', '<%= g.year || '' %>', '<%= g.description || '' %>', <%= g.isEvent ? 'true' : 'false' %>)" title="Bewerken">
                <i class="bi bi-pencil"></i>
              </button>
              <form action="/admin/feedgroups/<%= g.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Verwijderen?');" style="display:inline;">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Verwijderen"><i class="bi bi-trash"></i></button>
              </form>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div>

<% if (eventGroups.length) { %>
  <h3>Evenementen / Leidingsoekjes</h3>
  <div class="table-responsive mb-5">
    <table class="table table-striped align-middle">
      <thead>
        <tr>
          <th>Naam</th>
          <th class="d-none d-md-table-cell">Slug</th>
          <th class="d-none d-sm-table-cell">Jaar</th>
          <th class="text-end">Acties</th>
        </tr>
      </thead>
      <tbody>
        <% eventGroups.forEach(g => { %>
          <tr>
            <td>
              <div class="fw-bold"><%= g.name %> <span class="badge bg-warning text-dark ms-2">Event</span></div>
              <div class="d-md-none small"><code><%= g.slug %></code></div>
              <div class="d-sm-none small text-muted"><%= g.year || '' %></div>
            </td>
            <td class="d-none d-md-table-cell"><code><%= g.slug %></code></td>
            <td class="d-none d-sm-table-cell"><%= g.year || '' %></td>
            <td class="text-end">
              <div class="btn-group">
                <button class="btn btn-sm btn-outline-warning" onclick="openEditModal('<%= g.id %>', '<%= g.name %>', '<%= g.year || '' %>', '<%= g.description || '' %>', <%= g.isEvent ? 'true' : 'false' %>)" title="Bewerken">
                  <i class="bi bi-pencil"></i>
                </button>
                <form action="/admin/feedgroups/<%= g.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Verwijderen?');" style="display:inline;">
                  <button type="submit" class="btn btn-sm btn-outline-danger" title="Verwijderen"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
<% } %>

<!-- Edit Modal -->
<div class="modal fade" id="editGroupModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Groep Bewerken</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>
      <div class="modal-body">
        <form id="editGroupForm" action="" method="POST">
          <input type="hidden" name="_method" value="PUT">
          <div class="mb-3">
            <label>Naam</label>
            <input type="text" name="name" id="editName" class="form-control" required>
          </div>
          <div class="mb-3">
            <label>Jaar</label>
            <input type="text" name="year" id="editYear" class="form-control">
          </div>
          <div class="mb-3">
            <label>Omschrijving</label>
            <input type="text" name="description" id="editDesc" class="form-control">
          </div>
          <div class="form-check form-switch mb-3">
            <input class="form-check-input" type="checkbox" id="editIsEvent" name="isEvent">
            <label class="form-check-label" for="editIsEvent">Dit is een event</label>
          </div>
          <div class="text-end">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuleren</button>
            <button type="submit" class="btn btn-primary">Opslaan</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function openEditModal(id, name, year, desc, isEvent) {
    const form = document.getElementById('editGroupForm');
    // Ensure ID is valid before setting action
    if (id) {
        const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
        form.action = '/admin/feedgroups/' + id + (token ? '?_csrf=' + token : '');
    }
    
    document.getElementById('editName').value = name;
    document.getElementById('editYear').value = year;
    document.getElementById('editDesc').value = desc;
    document.getElementById('editIsEvent').checked = isEvent === true || isEvent === 'true';
    
    const modal = new bootstrap.Modal(document.getElementById('editGroupModal'));
    modal.show();
}
</script>

<%- include('../partials/footer') %>
