<%- include('../partials/header') %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <h1 class="mb-0"><i class="bi bi-file-earmark-richtext me-2"></i>Pagina Beheer</h1>
        <p class="text-muted mb-0 d-none d-sm-block">Beheer hier alle pagina's van de website.</p>
    </div>
    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-start justify-content-sm-end">
        <a href="/admin" class="btn btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center">
            <i class="bi bi-arrow-left me-1"></i> <span class="d-none d-sm-inline">Terug naar Dashboard</span><span class="d-inline d-sm-none">Terug</span>
        </a>
        <a href="/admin/custom-pages/create" class="btn btn-primary rounded-pill px-3 d-inline-flex align-items-center flex-grow-1 flex-sm-grow-0 justify-content-center">
            <i class="bi bi-plus-lg me-1"></i> Nieuwe Pagina
        </a>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-5">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="mb-0 fw-bold"><i class="bi bi-layout-sidebar-inset me-2 text-primary"></i>Standaard Pagina's</h5>
    </div>
    <div class="card-body p-0">
        <!-- Mobile Layout for Standaard Pagina's -->
        <div class="d-block d-md-none p-3">
            <% builtInPages.forEach(page => { %>
                <div class="card shadow-sm border rounded-4 mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold mb-0 text-dark"><%= page.name %></h6>
                            <% if (page.isHidden) { %>
                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2">Verborgen</span>
                            <% } else { %>
                                <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Zichtbaar</span>
                            <% } %>
                        </div>
                        <div class="mb-3 text-muted small">
                            <i class="bi bi-link-45deg me-1"></i><code><%= page.path %></code>
                        </div>
                        <div class="d-flex justify-content-end gap-2 border-top pt-2">
                            <a href="<%= page.path %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3" target="_blank">
                                <i class="bi bi-eye me-1"></i> Bekijk
                            </a>
                            <% if (page.editPath) { %>
                                <a href="<%= page.editPath %>" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                    <i class="bi bi-pencil me-1"></i> Bewerken
                                </a>
                            <% } %>
                            <form action="/admin/pages/toggle" method="POST" style="display:inline;">
                                <input type="hidden" name="path" value="<%= page.path %>">
                                <input type="hidden" name="action" value="<%= page.isHidden ? 'show' : 'hide' %>">
                                <button type="submit" class="btn btn-sm <%= page.isHidden ? 'btn-outline-success' : 'btn-outline-warning' %> rounded-pill px-3">
                                    <i class="bi bi-<%= page.isHidden ? 'eye' : 'eye-slash' %> me-1"></i> <%= page.isHidden ? 'Toon' : 'Verberg' %>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="d-none d-md-block table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Pagina</th>
                        <th>Pad</th>
                        <th>Status</th>
                        <th class="text-end pe-4">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    <% builtInPages.forEach(page => { %>
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold"><%= page.name %></div>
                            </td>
                            <td><code><%= page.path %></code></td>
                            <td>
                                <% if (page.isHidden) { %>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">Verborgen in Menu</span>
                                <% } else { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Zichtbaar in Menu</span>
                                <% } %>
                            </td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <a href="<%= page.path %>" class="btn btn-sm btn-light border" target="_blank" title="Bekijk pagina">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <% if (page.editPath) { %>
                                        <a href="<%= page.editPath %>" class="btn btn-sm btn-light border" title="Bewerken">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                    <% } %>
                                    <form action="/admin/pages/toggle" method="POST" style="display:inline;">
                                        <input type="hidden" name="path" value="<%= page.path %>">
                                        <input type="hidden" name="action" value="<%= page.isHidden ? 'show' : 'hide' %>">
                                        <button type="submit" class="btn btn-sm btn-light border <%= page.isHidden ? 'text-success' : 'text-warning' %>" 
                                                title="<%= page.isHidden ? 'Toon in menu' : 'Verberg in menu' %>">
                                            <i class="bi bi-<%= page.isHidden ? 'eye' : 'eye-slash' %>"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<div class="card shadow-sm border-0 rounded-4">
    <div class="card-header bg-white py-3 border-0">
        <h5 class="mb-0 fw-bold"><i class="bi bi-file-earmark-plus me-2 text-info"></i>Dynamische Pagina's</h5>
    </div>
    <div class="card-body p-0">
        <!-- Mobile Layout for Dynamische Pagina's -->
        <div class="d-block d-md-none p-3">
            <% if (customPages.length === 0) { %>
                <div class="text-center py-4 card shadow-sm border rounded-4 mb-3">
                    <div class="card-body">
                        <div class="text-muted">
                            <p class="mb-2">Nog geen aangepaste pagina's gemaakt.</p>
                            <a href="/admin/custom-pages/create" class="btn btn-sm btn-outline-primary rounded-pill px-3">Maak je eerste pagina</a>
                        </div>
                    </div>
                </div>
            <% } %>
            <% customPages.forEach(page => { %>
                <div class="card shadow-sm border rounded-4 mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h6 class="fw-bold mb-0 text-dark"><%= page.title %></h6>
                            <div class="d-flex gap-1">
                                <% if (page.status === 'visible') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2">Zichtbaar</span>
                                <% } else { %>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-2">Onzichtbaar</span>
                                <% } %>
                                <% if (page.showInNavbar) { %>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2">Menu</span>
                                <% } else if (page.isLinkOnly) { %>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-2">Link</span>
                                <% } else { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-2">Verborgen</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="text-muted small mb-2">
                            <i class="bi bi-link-45deg me-1"></i><code>/p/<%= page.slug %></code>
                        </div>
                        <div class="text-muted small mb-3">
                            <i class="bi bi-person me-1"></i><%= page.creator ? page.creator.username : 'Onbekend' %>
                        </div>
                        <div class="d-flex flex-wrap gap-2 justify-content-end border-top pt-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-2" 
                                    onclick="copyLink('/p/<%= page.slug %>')" title="Kopieer link">
                                <i class="bi bi-link-45deg"></i>
                            </button>
                            <a href="/p/<%= page.slug %>" class="btn btn-sm btn-outline-secondary rounded-pill px-3" target="_blank">
                                <i class="bi bi-eye me-1"></i>
                            </a>
                            <a href="/admin/custom-pages/<%= page.id %>/edit" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                <i class="bi bi-pencil me-1"></i>
                            </a>
                            <form action="/admin/custom-pages/<%= page.id %>/toggle" method="POST" style="display:inline;">
                                <button type="submit" class="btn btn-sm <%= page.status === 'visible' ? 'btn-outline-warning' : 'btn-outline-success' %> rounded-pill px-3">
                                    <i class="bi bi-<%= page.status === 'visible' ? 'eye-slash' : 'eye' %> me-1"></i> <%= page.status === 'visible' ? 'Verberg' : 'Toon' %>
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3" 
                                    onclick="confirmDelete('<%= page.id %>', '<%= page.title %>')">
                                <i class="bi bi-trash me-1"></i>
                            </button>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>

        <div class="d-none d-md-block table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Titel</th>
                        <th>Status</th>
                        <th>Zichtbaarheid</th>
                        <th>Aangemaakt door</th>
                        <th class="text-end pe-4">Acties</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (customPages.length === 0) { %>
                        <tr>
                            <td colspan="5" class="text-center py-5">
                                <div class="text-muted">
                                    <p>Nog geen aangepaste pagina's gemaakt.</p>
                                    <a href="/admin/custom-pages/create" class="btn btn-sm btn-outline-primary rounded-pill">Maak je eerste pagina</a>
                                </div>
                            </td>
                        </tr>
                    <% } %>
                    <% customPages.forEach(page => { %>
                        <tr>
                            <td class="ps-4">
                                <div class="fw-bold"><%= page.title %></div>
                                <div class="small text-muted">/p/<%= page.slug %></div>
                            </td>
                            <td>
                                <% if (page.status === 'visible') { %>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-3">Zichtbaar</span>
                                <% } else { %>
                                    <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle rounded-pill px-3">Onzichtbaar</span>
                                <% } %>
                            </td>
                            <td>
                                <% if (page.showInNavbar) { %>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-3">Menu</span>
                                <% } else if (page.isLinkOnly) { %>
                                    <span class="badge bg-info-subtle text-info border border-info-subtle rounded-pill px-3">Alleen Link</span>
                                <% } else { %>
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded-pill px-3">Verborgen</span>
                                <% } %>
                            </td>
                            <td><%= page.creator ? page.creator.username : 'Onbekend' %></td>
                            <td class="text-end pe-4">
                                <div class="btn-group">
                                    <button type="button" class="btn btn-sm btn-light border" 
                                            onclick="copyLink('/p/<%= page.slug %>')" title="Kopieer link">
                                        <i class="bi bi-link-45deg"></i>
                                    </button>
                                    <a href="/p/<%= page.slug %>" class="btn btn-sm btn-light border" target="_blank" title="Bekijk pagina">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a href="/admin/custom-pages/<%= page.id %>/edit" class="btn btn-sm btn-light border" title="Bewerken">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form action="/admin/custom-pages/<%= page.id %>/toggle" method="POST" style="display:inline;">
                                        <button type="submit" class="btn btn-sm btn-light border <%= page.status === 'visible' ? 'text-warning' : 'text-success' %>" 
                                                title="<%= page.status === 'visible' ? 'Maak Onzichtbaar' : 'Maak Zichtbaar' %>">
                                            <i class="bi bi-<%= page.status === 'visible' ? 'eye-slash' : 'eye' %>"></i>
                                        </button>
                                    </form>
                                    <button type="button" class="btn btn-sm btn-light border text-danger" 
                                            onclick="confirmDelete('<%= page.id %>', '<%= page.title %>')" title="Verwijderen">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0">
                <h5 class="modal-title font-playful">Pagina Verwijderen</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Ben je zeker dat je de pagina <strong id="deletePageTitle"></strong> wilt verwijderen? Dit kan niet ongedaan gemaakt worden.
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuleren</button>
                <form id="deleteForm" method="POST">
                    <button type="submit" class="btn btn-danger rounded-pill px-4">Verwijderen</button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function copyLink(path) {
        const fullUrl = window.location.origin + path;
        navigator.clipboard.writeText(fullUrl).then(() => {
            const alertDiv = document.createElement('div');
            alertDiv.className = 'alert alert-success fixed-top m-3 shadow-lg border-0 rounded-4';
            alertDiv.style.zIndex = '9999';
            alertDiv.style.width = 'fit-content';
            alertDiv.style.left = '50%';
            alertDiv.style.transform = 'translateX(-50%)';
            alertDiv.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Link gekopieerd naar klembord!';
            document.body.appendChild(alertDiv);
            setTimeout(() => alertDiv.remove(), 3000);
        }).catch(err => {
            console.error('Copy failed:', err);
        });
    }

    function confirmDelete(id, title) {
        document.getElementById('deletePageTitle').innerText = title;
        document.getElementById('deleteForm').action = '/admin/custom-pages/' + id + '/delete';
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }
</script>

<%- include('../partials/footer') %>
