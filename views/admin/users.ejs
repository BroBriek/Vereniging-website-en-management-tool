<style>
    .avatar-circle-sm {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.8rem;
    }
    /* Polaroid Overlay */
    .polaroid-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.85);
        z-index: 10000;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(8px);
    }
    .polaroid-container {
        background-color: white;
        padding: 15px 15px 50px 15px;
        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
        transform: rotate(-2deg);
        transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        max-width: 90%;
        width: auto;
        display: inline-block;
    }
    .polaroid-container:hover {
        transform: rotate(0deg) scale(1.02);
    }
    .polaroid-photo img {
        max-width: 80vw;
        max-height: 70vh;
        min-width: 250px;
        display: block;
        background-color: #eee;
        border: 1px solid #ddd;
    }
    .polaroid-caption {
        font-family: 'Patrick Hand', 'Brush Script MT', cursive;
        font-size: 2rem;
        text-align: center;
        margin-top: 20px;
        color: #2c3e50;
        line-height: 1;
    }
</style>

<div id="polaroid-overlay" class="polaroid-overlay d-none" onclick="closePolaroid()">
    <div class="polaroid-container" onclick="event.stopPropagation()">
        <div class="polaroid-photo">
            <img id="polaroid-image" src="" alt="Profile Picture">
        </div>
        <div class="polaroid-caption" id="polaroid-caption"></div>
    </div>
</div>

<script>
function showPolaroid(src, name) {
    document.getElementById('polaroid-image').src = src;
    document.getElementById('polaroid-caption').textContent = name;
    document.getElementById('polaroid-overlay').classList.remove('d-none');
    document.body.style.overflow = 'hidden';
}
function closePolaroid() {
    document.getElementById('polaroid-overlay').classList.add('d-none');
    document.body.style.overflow = '';
}
</script>

<%- include('../partials/header') %>
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Gebruikers Beheren</h1>
    <div>
        <a href="/admin/info" class="btn btn-info text-white me-2" title="Algemene Hulp & Info">
            <i class="bi bi-info-circle"></i> Algemene Info
        </a>
        <a href="/admin" class="btn btn-secondary">Terug</a>
    </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger"><%= error %></div>
<% } %>

<div class="card mb-4">
    <div class="card-header">Nieuwe Gebruiker Toevoegen</div>
    <div class="card-body">
        <form action="/admin/users" method="POST">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <label>Gebruikersnaam</label>
                    <input type="text" class="form-control" name="username" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label>Wachtwoord</label>
                    <input type="password" class="form-control" name="password" required>
                </div>
                <div class="col-md-4 mb-3">
                    <label>Rol</label>
                    <select class="form-select" name="role">
                        <option value="leader">Leiding (Geen Admin)</option>
                        <option value="media">Media (Website & Formulieren)</option>
                        <option value="admin">Administrator</option>
                    </select>
                </div>
            </div>
            <button type="submit" class="btn btn-success">Toevoegen</button>
        </form>
    </div>
</div>

<% 
    const activeUsers = users.filter(u => u.isActive !== false);
    const inactiveUsers = users.filter(u => u.isActive === false);
%>

<h3>Actieve Gebruikers</h3>
<div class="table-responsive">
    <table class="table table-striped align-middle">
        <thead>
            <tr>
                <th style="width: 45px;"></th>
                <th>Gebruikersnaam</th>
                <th class="d-none d-md-table-cell">Rol</th>
                <th class="text-end">Actie</th>
            </tr>
        </thead>
        <tbody>
            <% activeUsers.forEach(u => { %>
                <tr>
                    <td>
                        <% if (u.profilePicture) { %>
                            <img src="<%= u.profilePicture %>" class="rounded-circle border shadow-sm" style="width: 32px; height: 32px; object-fit: cover; cursor: pointer;" alt="<%= capitalizeName(u.username) %>" onclick="showPolaroid('<%= u.profilePicture %>', '<%= capitalizeName(u.username) %>')">
                        <% } else { %>
                            <div class="avatar-circle-sm" style="background-color: <%= getAvatarColor(u.username) %>;">
                                <%= u.username.substring(0, 2).toUpperCase() %>
                            </div>
                        <% } %>
                    </td>
                    <td>
                        <div class="fw-bold"><%= capitalizeName(u.username) %></div>
                        <div class="d-md-none small">
                            <% if(u.role === 'admin') { %>
                                <span class="badge bg-danger">Admin</span>
                            <% } else if(u.role === 'media') { %>
                                <span class="badge bg-warning text-dark">Media</span>
                            <% } else { %>
                                <span class="badge bg-info">Leiding</span>
                            <% } %>
                        </div>
                    </td>
                    <td class="d-none d-md-table-cell">
                        <% if(u.role === 'admin') { %>
                            <span class="badge bg-danger">Admin</span>
                        <% } else if(u.role === 'media') { %>
                            <span class="badge bg-warning text-dark">Media</span>
                        <% } else { %>
                            <span class="badge bg-info">Leiding</span>
                        <% } %>
                    </td>
                    <td class="text-end">
                        <div class="btn-group">
                            <a href="/admin/users/<%= u.id %>/edit" class="btn btn-sm btn-outline-primary" title="Bewerken">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <% if (user.id !== u.id) { %>
                                <form action="/admin/users/<%= u.id %>/toggle-status?_method=PUT" method="POST" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="Zet op non-actief (oud-leiding)">
                                        <i class="bi bi-archive"></i>
                                    </button>
                                </form>
                                <form action="/admin/users/<%= u.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Zeker weten?');" style="display:inline;">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Verwijderen"><i class="bi bi-trash"></i></button>
                                </form>
                            <% } else { %>
                                <span class="text-muted small p-2">(Ik)</span>
                            <% } %>
                        </div>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</div>

<div class="mt-5">
    <button class="btn btn-secondary w-100 w-md-auto" type="button" data-bs-toggle="collapse" data-bs-target="#inactiveUsersList" aria-expanded="false" aria-controls="inactiveUsersList">
        <i class="bi bi-clock-history"></i> Toon Oud-Leiding (<%= inactiveUsers.length %>)
    </button>
    
    <div class="collapse mt-3" id="inactiveUsersList">
        <div class="card card-body bg-light border-0 shadow-sm">
            <h4 class="text-muted mb-4">Oud-Leiding (Inactief)</h4>
            <% if (inactiveUsers.length === 0) { %>
                <p class="text-muted">Geen oud-leiding.</p>
            <% } else { %>
                <div class="table-responsive">
                    <table class="table table-sm text-muted align-middle">
                        <thead>
                            <tr>
                                <th style="width: 45px;"></th>
                                <th>Gebruikersnaam</th>
                                <th class="d-none d-md-table-cell">Rol</th>
                                <th class="text-end">Actie</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% inactiveUsers.forEach(u => { %>
                                <tr>
                                    <td>
                                        <% if (u.profilePicture) { %>
                                            <img src="<%= u.profilePicture %>" class="rounded-circle border shadow-sm" style="width: 32px; height: 32px; object-fit: cover; cursor: pointer;" alt="<%= capitalizeName(u.username) %>" onclick="showPolaroid('<%= u.profilePicture %>', '<%= capitalizeName(u.username) %>')">
                                        <% } else { %>
                                            <div class="avatar-circle-sm" style="background-color: <%= getAvatarColor(u.username) %>; opacity: 0.6;">
                                                <%= u.username.substring(0, 2).toUpperCase() %>
                                            </div>
                                        <% } %>
                                    </td>
                                    <td>
                                        <div class="fw-bold"><%= capitalizeName(u.username) %></div>
                                        <div class="d-md-none small"><span class="badge bg-secondary">Oud-Leiding</span></div>
                                    </td>
                                    <td class="d-none d-md-table-cell"><span class="badge bg-secondary">Oud-Leiding</span></td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <form action="/admin/users/<%= u.id %>/toggle-status?_method=PUT" method="POST" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Maak weer actief">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            </form>
                                            <form action="/admin/users/<%= u.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Definitief verwijderen?');" style="display:inline;">
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Verwijderen"><i class="bi bi-trash"></i></button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } %>
        </div>
    </div>
</div>
<%- include('../partials/footer') %>
