<%- include('../../partials/header') %>

<style>
    .builder-container {
        display: flex;
        gap: 20px;
        min-height: 70vh;
    }
    .builder-sidebar {
        width: 280px;
        flex-shrink: 0;
        background: #f8f9fa;
        padding: 20px;
        border-radius: 10px;
        height: fit-content;
        position: sticky;
        top: 20px;
        max-height: 90vh;
        overflow-y: auto;
    }
    @media (max-width: 992px) {
        .builder-container {
            flex-direction: column;
        }
        .builder-sidebar {
            width: 100%;
            position: relative;
            top: 0;
            max-height: none;
            order: 2;
        }
        .builder-main {
            order: 1;
        }
    }
    .builder-main {
        flex-grow: 1;
        background: white;
        padding: 30px;
        border-radius: 10px;
        border: 2px dashed #dee2e6;
        min-height: 500px;
    }
    .draggable-item {
        background: white;
        padding: 12px 15px;
        border-radius: 8px;
        margin-bottom: 10px;
        border: 1px solid #dee2e6;
        cursor: grab;
        transition: all 0.2s;
        display: flex;
        align-items: center;
        gap: 10px;
        user-select: none;
    }
    .draggable-item:hover {
        border-color: #db3e41;
        color: #db3e41;
        box-shadow: 0 4px 8px rgba(0,0,0,0.05);
    }
    .item-preview {
        position: relative;
        padding: 20px;
        border: 2px solid transparent;
        border-radius: 8px;
        margin-bottom: 15px;
        transition: border-color 0.2s;
        background: #fff;
    }
    .item-preview:hover {
        border-color: #dee2e6;
    }
    .item-actions {
        position: absolute;
        top: 10px;
        right: 10px;
        display: none;
        gap: 5px;
        z-index: 100;
    }
    .item-preview:hover .item-actions {
        display: flex;
    }
    .drag-handle {
        position: absolute;
        left: -15px;
        top: 50%;
        transform: translateY(-50%);
        color: #adb5bd;
        cursor: grab;
        padding: 10px;
        display: none;
    }
    .item-preview:hover .drag-handle {
        display: block;
    }
    .empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: #adb5bd;
        text-align: center;
    }

    /* Resizable & Rotatable Styles */
    .resizable-wrapper {
        position: relative;
        display: inline-block;
        margin: 20px 0;
        cursor: default;
        transition: box-shadow 0.2s;
    }
    .item-preview:hover .resizable-wrapper {
        outline: 1px dashed #db3e41;
    }
    .resize-handle {
        width: 12px;
        height: 12px;
        background: #db3e41;
        border: 2px solid white;
        border-radius: 50%;
        position: absolute;
        display: none;
        z-index: 10;
        cursor: nwse-resize;
    }
    .item-preview:hover .resize-handle {
        display: block;
    }
    .resize-handle.nw { top: -6px; left: -6px; cursor: nwse-resize; }
    .resize-handle.ne { top: -6px; right: -6px; cursor: nesw-resize; }
    .resize-handle.sw { bottom: -6px; left: -6px; cursor: nesw-resize; }
    .resize-handle.se { bottom: -6px; right: -6px; cursor: nwse-resize; }

    .rotate-handle {
        width: 12px;
        height: 12px;
        background: #28a745;
        border: 2px solid white;
        border-radius: 50%;
        position: absolute;
        top: -25px;
        left: 50%;
        transform: translateX(-50%);
        display: none;
        z-index: 10;
        cursor: crosshair;
    }
    .rotate-handle::after {
        content: '';
        position: absolute;
        top: 10px;
        left: 50%;
        width: 2px;
        height: 15px;
        background: #28a745;
        transform: translateX(-50%);
    }
    .item-preview:hover .rotate-handle {
        display: block;
    }

    .columns-container {
        display: flex;
        gap: 0;
        width: 100%;
        position: relative;
        margin: 15px 0;
    }
    .column-box {
        min-height: 120px;
        background: #f8f9fa;
        border-radius: 8px;
        padding: 15px;
        border: 1px dashed #dee2e6;
        position: relative;
        transition: all 0.2s;
    }
    .column-box.drag-over {
        background: rgba(219, 62, 65, 0.05);
        border-color: #db3e41;
        border-style: solid;
        box-shadow: inset 0 0 10px rgba(0,0,0,0.05);
    }
    .column-divider {
        width: 15px;
        cursor: col-resize;
        background: transparent;
        transition: background 0.2s;
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 5;
    }
    .column-divider:hover {
        background: rgba(219, 62, 65, 0.1);
    }
    .column-divider::after {
        content: '';
        width: 2px;
        height: 40px;
        background: #dee2e6;
        border-radius: 2px;
    }
    .column-divider:hover::after {
        background: #db3e41;
    }
    
    .nested-item {
        position: relative;
        padding: 10px;
        border: 1px solid transparent;
        border-radius: 6px;
        margin-bottom: 10px;
        background: white;
        transition: all 0.2s;
    }
    .nested-item:hover {
        border-color: #dee2e6;
        box-shadow: 0 2px 5px rgba(0,0,0,0.05);
    }
    .nested-item .item-actions {
        top: 2px;
        right: 2px;
        transform: scale(0.85);
    }

    .spacer-preview {
        border: 1px dashed #dee2e6;
        background: rgba(248, 249, 250, 0.5);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #adb5bd;
        font-size: 0.8rem;
        position: relative;
    }
    .spacer-preview:hover {
        border-color: #db3e41;
        background: rgba(219, 62, 65, 0.05);
    }
    .spacer-handle {
        position: absolute;
        bottom: -5px;
        left: 50%;
        transform: translateX(-50%);
        width: 30px;
        height: 10px;
        background: #dee2e6;
        border-radius: 5px;
        cursor: ns-resize;
        display: none;
    }
    .spacer-preview:hover .spacer-handle {
        display: block;
    }
</style>

<div class="row">
    <div class="col-12 mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a href="/admin/pages">Pagina's</a></li>
                <li class="breadcrumb-item active"><%= page ? 'Bewerken' : 'Nieuwe Pagina' %></li>
            </ol>
        </nav>
        <h1><%= page ? 'Bewerk Pagina' : 'Nieuwe Pagina' %></h1>
    </div>
</div>

<form id="pageBuilderSubmit" action="<%= page ? '/admin/custom-pages/' + page.id + '/edit' : '/admin/custom-pages' %>" method="POST" enctype="multipart/form-data">
    <div class="row mb-4">
        <div class="col-md-8">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Titel van de pagina</label>
                        <input type="text" name="title" class="form-control form-control-lg" placeholder="bv. Onze Geschiedenis" value="<%= page ? page.title : '' %>" required>
                    </div>
                    
                    <div class="border-top pt-3">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" name="bannerEnabled" id="bannerEnabledSwitch" value="true" <%= page && page.bannerEnabled ? 'checked' : '' %>>
                            <label class="form-check-label fw-bold" for="bannerEnabledSwitch">Hero Banner inschakelen</label>
                        </div>
                        <div id="bannerOptions" style="<%= page && page.bannerEnabled ? '' : 'display: none;' %>">
                            <label class="form-label small text-muted">Banner afbeelding (Hero)</label>
                            <input type="file" name="bannerImage" class="form-control mb-2" accept="image/*">
                            <% if (page && page.bannerImage) { %>
                                <div class="mt-2">
                                    <p class="small text-muted mb-1">Huidige banner:</p>
                                    <img src="<%= page.bannerImage %>" class="img-thumbnail" style="max-height: 100px;">
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Status</label>
                        <select name="status" class="form-select">
                            <option value="invisible" <%= page && page.status === 'invisible' ? 'selected' : '' %>>Onzichtbaar (Concept)</option>
                            <option value="visible" <%= page && page.status === 'visible' ? 'selected' : '' %>>Zichtbaar (Publiek)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Zichtbaarheid</label>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="visibility" id="visNavbar" value="navbar" <%= page && page.showInNavbar ? 'checked' : (page ? '' : 'checked') %>>
                            <label class="form-check-label" for="visNavbar">In Navigatiebalk</label>
                        </div>
                        <div class="form-check">
                            <input class="form-check-input" type="radio" name="visibility" id="visLink" value="link" <%= page && page.isLinkOnly && !page.showInNavbar ? 'checked' : '' %>>
                            <label class="form-check-label" for="visLink">Alleen via Link</label>
                        </div>
                    </div>
                    <input type="hidden" name="showInNavbar" id="showInNavbarInput" value="<%= page ? page.showInNavbar : 'true' %>">
                    <input type="hidden" name="isLinkOnly" id="isLinkOnlyInput" value="<%= page ? page.isLinkOnly : 'false' %>">

                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-save me-1"></i> Pagina Opslaan
                    </button>
                </div>
            </div>
        </div>
    </div>

    <input type="hidden" name="content" id="contentJsonInput">

    <div class="builder-container">
        <!-- Sidebar -->
        <div class="builder-sidebar shadow-sm">
            <h5 class="font-playful mb-3">Componenten</h5>
            <div class="draggable-item" onclick="addComponent('header')" draggable="true" ondragstart="handleDragStart(event, 'header')">
                <i class="bi bi-type-h1 text-primary"></i> Titel/Kop
            </div>
            <div class="draggable-item" onclick="addComponent('text')" draggable="true" ondragstart="handleDragStart(event, 'text')">
                <i class="bi bi-fonts text-success"></i> Tekstblok
            </div>
            <div class="draggable-item" onclick="addComponent('image')" draggable="true" ondragstart="handleDragStart(event, 'image')">
                <i class="bi bi-image text-info"></i> Afbeelding
            </div>
            <div class="draggable-item" onclick="addComponent('columns')" draggable="true" ondragstart="handleDragStart(event, 'columns')">
                <i class="bi bi-columns-gap text-danger"></i> Kolommen
            </div>
            <div class="draggable-item" onclick="addComponent('button')" draggable="true" ondragstart="handleDragStart(event, 'button')">
                <i class="bi bi-link-45deg text-warning"></i> Knop/Link
            </div>
            <div class="draggable-item" onclick="addComponent('divider')" draggable="true" ondragstart="handleDragStart(event, 'divider')">
                <i class="bi bi-hr text-secondary"></i> Scheidingslijn
            </div>
            <div class="draggable-item" onclick="addComponent('spacer')" draggable="true" ondragstart="handleDragStart(event, 'spacer')">
                <i class="bi bi-distribute-vertical text-dark"></i> Afstandshouder
            </div>
        </div>

        <!-- Main Area -->
        <div class="builder-main shadow-sm" id="builderPreviewArea" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)">
            <div id="emptyState" class="empty-state">
                <i class="bi bi-plus-square-dotted display-4"></i>
                <h4>Begin met bouwen</h4>
                <p>Klik of sleep componenten van de linkerkant hierheen.</p>
            </div>
            <div id="contentPreviewList"></div>
        </div>
    </div>
</form>

<!-- Modal for editing components -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0">
                <h5 class="modal-title font-playful" id="editModalTitle">Component Bewerken</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="editModalBody"></div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Annuleren</button>
                <button type="button" class="btn btn-primary rounded-pill" id="saveChangesBtn">Opslaan</button>
            </div>
        </div>
    </div>
</div>

<script src="/js/rich-editor.js"></script>
<script>
    let components = <%- page && page.content ? JSON.stringify(page.content) : '[]' %>;
    let editingPath = '';
    let activeInteractPath = '';
    let interactionType = null; // 'resize', 'rotate', 'col-resize', 'spacer-resize'
    let startX, startY, startWidth, startHeight, startRotation, startCenterX, startCenterY, startLeftWidth, startRightWidth, activeColIdx;

    // Helper to get/set by path
    function getCompByPath(path) {
        if (!path) return components;
        const parts = path.toString().split('.');
        let current = components;
        for (let i = 0; i < parts.length; i++) {
            const part = parts[i];
            if (Array.isArray(current)) {
                current = current[parseInt(part)];
            } else {
                current = current[part];
            }
        }
        return current;
    }

    document.querySelectorAll('input[name="visibility"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
            if (e.target.value === 'navbar') {
                document.getElementById('showInNavbarInput').value = 'true';
                document.getElementById('isLinkOnlyInput').value = 'false';
            } else {
                document.getElementById('showInNavbarInput').value = 'false';
                document.getElementById('isLinkOnlyInput').value = 'true';
            }
        });
    });

    document.getElementById('bannerEnabledSwitch').addEventListener('change', (e) => {
        document.getElementById('bannerOptions').style.display = e.target.checked ? 'block' : 'none';
    });

    function renderComponents() {
        const list = document.getElementById('contentPreviewList');
        const emptyState = document.getElementById('emptyState');
        
        if (components.length === 0) {
            emptyState.style.display = 'flex';
        } else {
            emptyState.style.display = 'none';
        }

        list.innerHTML = renderComponentList(components, '');
        document.getElementById('contentJsonInput').value = JSON.stringify(components);
    }

    function renderComponentList(compArray, parentPath) {
        let html = '';
        compArray.forEach((comp, index) => {
            const path = parentPath === '' ? `${index}` : `${parentPath}.${index}`;
            
            // Migration for old columns
            if (comp.type === 'columns') {
                if (!comp.cols) {
                    // Check if it was the old 2-column format
                    const left = comp.left || (comp.leftType ? [{ type: comp.leftType, text: comp.leftText, url: comp.leftUrl }] : []);
                    const right = comp.right || (comp.rightType ? [{ type: comp.rightType, text: comp.rightText, url: comp.rightUrl }] : []);
                    comp.cols = [
                        { width: comp.leftWidth || 50, content: left },
                        { width: comp.rightWidth || 50, content: right }
                    ];
                    delete comp.left; delete comp.right; delete comp.leftWidth; delete comp.rightWidth;
                    delete comp.leftType; delete comp.leftText; delete comp.leftUrl;
                    delete comp.rightType; delete comp.rightText; delete comp.rightUrl;
                }
            }

            let innerHtml = '';
            switch(comp.type) {
                case 'header':
                    innerHtml = `<h${comp.level || 2}>${comp.text || 'Titel'}</h${comp.level || 2}>`;
                    break;
                case 'text':
                    innerHtml = `<div class="rich-text-content">${comp.text || 'Voeg tekst toe...'}</div>`;
                    break;
                case 'image':
                    const imgStyle = `
                        width: ${comp.width || '300px'};
                        height: ${comp.height || 'auto'};
                        transform: rotate(${comp.rotation || 0}deg);
                        object-fit: cover;
                    `;
                    innerHtml = comp.url ? `
                        <div class="text-center">
                            <div class="resizable-wrapper" style="${imgStyle}" data-path="${path}">
                                <img src="${comp.url}" class="img-fluid rounded shadow-sm" style="width: 100%; height: 100%; pointer-events: none; object-fit: cover;">
                                <div class="resize-handle nw" onmousedown="initResize(event, '${path}', 'nw')"></div>
                                <div class="resize-handle ne" onmousedown="initResize(event, '${path}', 'ne')"></div>
                                <div class="resize-handle sw" onmousedown="initResize(event, '${path}', 'sw')"></div>
                                <div class="resize-handle se" onmousedown="initResize(event, '${path}', 'se')"></div>
                                <div class="rotate-handle" onmousedown="initRotate(event, '${path}')"></div>
                            </div>
                        </div>
                    ` : '<div class="p-4 bg-light text-center rounded">Geen afbeelding</div>';
                    break;
                case 'columns':
                    let colsHtml = '';
                    comp.cols.forEach((col, colIdx) => {
                        colsHtml += `
                            <div class="column-box" style="width: ${col.width}%" data-path="${path}.cols.${colIdx}.content" ondragover="handleDragOver(event)" ondragleave="handleDragLeave(event)" ondrop="handleDrop(event)">
                                <small class="text-muted d-block mb-2"><i class="bi bi-layout-sidebar"></i> Kolom ${colIdx + 1} (${col.width}%)</small>
                                <div class="column-content">
                                    ${renderComponentList(col.content || [], `${path}.cols.${colIdx}.content`)}
                                    <div class="text-center py-2 text-muted small"><i class="bi bi-plus-circle"></i> Sleep hierheen</div>
                                </div>
                            </div>
                        `;
                        if (colIdx < comp.cols.length - 1) {
                            colsHtml += `<div class="column-divider" onmousedown="initColResize(event, '${path}', ${colIdx})"></div>`;
                        }
                    });
                    innerHtml = `<div class="columns-container" id="columns-${path}">${colsHtml}</div>`;
                    break;
                case 'button':
                    innerHtml = `<div class="text-${comp.align || 'start'}"><a href="${comp.url || '#'}" class="btn btn-primary">${comp.text || 'Knop'}</a></div>`;
                    break;
                case 'divider':
                    innerHtml = '<hr>';
                    break;
                case 'spacer':
                    innerHtml = `
                        <div class="spacer-preview" style="height: ${comp.height || 50}px;" data-path="${path}">
                            <i class="bi bi-arrows-expand me-1"></i> Afstandshouder (${comp.height || 50}px)
                            <div class="spacer-handle" onmousedown="initSpacerResize(event, '${path}')"></div>
                        </div>
                    `;
                    break;
            }

            const itemClass = parentPath === '' ? 'item-preview border-bottom mb-3 pb-3' : 'nested-item';
            html += `
                <div class="${itemClass}">
                    <div class="item-actions">
                        <button type="button" class="btn btn-sm btn-light border" onclick="moveComp('${path}', -1)" ${index === 0 ? 'disabled' : ''}><i class="bi bi-arrow-up"></i></button>
                        <button type="button" class="btn btn-sm btn-light border" onclick="moveComp('${path}', 1)" ${index === compArray.length - 1 ? 'disabled' : ''}><i class="bi bi-arrow-down"></i></button>
                        <button type="button" class="btn btn-sm btn-primary" onclick="editComp('${path}')"><i class="bi bi-pencil"></i></button>
                        <button type="button" class="btn btn-sm btn-danger" onclick="deleteComp('${path}')"><i class="bi bi-trash"></i></button>
                    </div>
                    ${innerHtml}
                </div>
            `;
        });
        return html;
    }

    // Interaction logic
    function initResize(e, path, handle) {
        e.preventDefault();
        e.stopPropagation();
        activeInteractPath = path;
        interactionType = 'resize';
        const wrapper = e.target.parentElement;
        const rect = wrapper.getBoundingClientRect();
        startX = e.clientX;
        startY = e.clientY;
        startWidth = rect.width;
        startHeight = rect.height;
        document.addEventListener('mousemove', handleInteraction);
        document.addEventListener('mouseup', stopInteraction);
    }

    function initRotate(e, path) {
        e.preventDefault();
        e.stopPropagation();
        activeInteractPath = path;
        interactionType = 'rotate';
        const wrapper = e.target.parentElement;
        const rect = wrapper.getBoundingClientRect();
        startCenterX = rect.left + rect.width / 2;
        startCenterY = rect.top + rect.height / 2;
        startRotation = getCompByPath(path).rotation || 0;
        
        const dx = e.clientX - startCenterX;
        const dy = e.clientY - startCenterY;
        startX = Math.atan2(dy, dx) * (180 / Math.PI);
        
        document.addEventListener('mousemove', handleInteraction);
        document.addEventListener('mouseup', stopInteraction);
    }

    function initColResize(e, path, colIdx) {
        e.preventDefault();
        e.stopPropagation();
        activeInteractPath = path;
        interactionType = 'col-resize';
        activeColIdx = colIdx;
        const container = document.getElementById(`columns-${path}`);
        const rect = container.getBoundingClientRect();
        startX = e.clientX;
        startWidth = rect.width;
        const comp = getCompByPath(path);
        startLeftWidth = comp.cols[colIdx].width;
        startRightWidth = comp.cols[colIdx + 1].width;
        document.addEventListener('mousemove', handleInteraction);
        document.addEventListener('mouseup', stopInteraction);
    }

    function initSpacerResize(e, path) {
        e.preventDefault();
        e.stopPropagation();
        activeInteractPath = path;
        interactionType = 'spacer-resize';
        const rect = e.target.parentElement.getBoundingClientRect();
        startY = e.clientY;
        startHeight = rect.height;
        document.addEventListener('mousemove', handleInteraction);
        document.addEventListener('mouseup', stopInteraction);
    }

    function handleInteraction(e) {
        if (!activeInteractPath) return;
        const comp = getCompByPath(activeInteractPath);

        if (interactionType === 'resize') {
            const dx = e.clientX - startX;
            const dy = e.clientY - startY;
            comp.width = Math.max(50, startWidth + dx) + 'px';
            comp.height = Math.max(50, startHeight + dy) + 'px';
            
            const wrapper = document.querySelector(`.resizable-wrapper[data-path="${activeInteractPath}"]`);
            if (wrapper) {
                wrapper.style.width = comp.width;
                wrapper.style.height = comp.height;
            }
        } else if (interactionType === 'rotate') {
            const dx = e.clientX - startCenterX;
            const dy = e.clientY - startCenterY;
            const angle = Math.atan2(dy, dx) * (180 / Math.PI);
            comp.rotation = (startRotation + (angle - startX));
            
            const wrapper = document.querySelector(`.resizable-wrapper[data-path="${activeInteractPath}"]`);
            if (wrapper) {
                wrapper.style.transform = `rotate(${comp.rotation}deg)`;
            }
        } else if (interactionType === 'col-resize') {
            const dx = e.clientX - startX;
            const percentageDelta = (dx / startWidth) * 100;
            
            let newLeftWidth = Math.round(startLeftWidth + percentageDelta);
            let newRightWidth = Math.round(startRightWidth - percentageDelta);
            
            // Constrain
            if (newLeftWidth >= 10 && newRightWidth >= 10) {
                comp.cols[activeColIdx].width = newLeftWidth;
                comp.cols[activeColIdx + 1].width = newRightWidth;

                const container = document.getElementById(`columns-${activeInteractPath}`);
                if (container) {
                    const boxes = container.querySelectorAll('.column-box');
                    boxes[activeColIdx].style.width = comp.cols[activeColIdx].width + '%';
                    boxes[activeColIdx + 1].style.width = comp.cols[activeColIdx + 1].width + '%';
                    
                    // Update text indicators
                    boxes[activeColIdx].querySelector('small').innerHTML = `<i class="bi bi-layout-sidebar"></i> Kolom ${activeColIdx + 1} (${comp.cols[activeColIdx].width}%)`;
                    boxes[activeColIdx + 1].querySelector('small').innerHTML = `<i class="bi bi-layout-sidebar"></i> Kolom ${activeColIdx + 2} (${comp.cols[activeColIdx + 1].width}%)`;
                }
            }
        } else if (interactionType === 'spacer-resize') {
            const dy = e.clientY - startY;
            comp.height = Math.max(10, startHeight + dy);
            
            const preview = document.querySelector(`.spacer-preview[data-path="${activeInteractPath}"]`);
            if (preview) {
                preview.style.height = comp.height + 'px';
                preview.innerHTML = `<i class="bi bi-arrows-expand me-1"></i> Afstandshouder (${comp.height}px) <div class="spacer-handle" onmousedown="initSpacerResize(event, '${activeInteractPath}')"></div>`;
            }
        }
    }

    function stopInteraction() {
        document.removeEventListener('mousemove', handleInteraction);
        document.removeEventListener('mouseup', stopInteraction);
        activeInteractPath = '';
        interactionType = null;
        renderComponents();
    }

    function addComponent(type, path = null) {
        let newComp = { type };
        if (type === 'header') { newComp.text = 'Nieuwe Titel'; newComp.level = 2; }
        if (type === 'text') { newComp.text = 'Klik om tekst te bewerken...'; }
        if (type === 'button') { newComp.text = 'Klik Hier'; newComp.url = ''; newComp.align = 'start'; }
        if (type === 'image') { newComp.url = ''; newComp.width = '300px'; newComp.height = 'auto'; newComp.rotation = 0; }
        if (type === 'columns') { 
            newComp.cols = [
                { width: 50, content: [] },
                { width: 50, content: [] }
            ];
        }
        if (type === 'spacer') {
            newComp.height = 50;
        }
        
        let targetArray;
        let newIndex;
        if (path) {
            targetArray = getCompByPath(path);
            if (!Array.isArray(targetArray)) {
                console.error('Target is not an array:', path, targetArray);
                return;
            }
            targetArray.push(newComp);
            newIndex = targetArray.length - 1;
        } else {
            components.push(newComp);
            newIndex = components.length - 1;
        }
        
        renderComponents();
        const newPath = path ? `${path}.${newIndex}` : `${newIndex}`;
        // Timeout to ensure DOM is ready and avoid conflicts with drag-and-drop state
        setTimeout(() => editComp(newPath), 50);
    }

    function editComp(path) {
        editingPath = path;
        const comp = getCompByPath(path);
        if (!comp) return;
        
        const body = document.getElementById('editModalBody');
        let html = '';

        switch(comp.type) {
            case 'header':
                html = `
                    <div class="mb-3">
                        <label class="form-label">Titel Tekst</label>
                        <input type="text" id="editHeaderTask" class="form-control" value="${comp.text || ''}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Grootte</label>
                        <select id="editHeaderLevel" class="form-select">
                            <option value="1" ${comp.level == 1 ? 'selected' : ''}>H1 (Grootst)</option>
                            <option value="2" ${comp.level == 2 ? 'selected' : ''}>H2</option>
                            <option value="3" ${comp.level == 3 ? 'selected' : ''}>H3</option>
                            <option value="4" ${comp.level == 4 ? 'selected' : ''}>H4</option>
                        </select>
                    </div>
                `;
                break;
            case 'text':
                html = `
                    <div class="mb-3">
                        <label class="form-label">Inhoud</label>
                        <textarea id="editRichText" class="form-control rich-editor" rows="10">${comp.text || ''}</textarea>
                        <small class="text-muted">Je kan HTML gebruiken voor meer opmaak.</small>
                    </div>
                `;
                break;
            case 'image':
                html = `
                    <div class="mb-3">
                        <label class="form-label">Afbeelding Bron</label>
                        <div class="card bg-light border-0 rounded-4 mb-3">
                            <div class="card-body p-4 text-center">
                                <i class="bi bi-cloud-upload display-4 text-muted mb-2"></i>
                                <p class="mb-3">Upload een afbeelding vanaf je apparaat</p>
                                <input type="file" id="compImageFile" class="form-control d-none" accept="image/*" onchange="handleCompImageUpload(this)">
                                <button type="button" class="btn btn-primary rounded-pill px-4" onclick="document.getElementById('compImageFile').click()">
                                    <i class="bi bi-upload me-2"></i>Kies Bestand
                                </button>
                                <div id="uploadStatus" class="mt-2 small text-primary" style="display: none;">
                                    <span class="spinner-border spinner-border-sm me-1"></span> Bezig met uploaden...
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Of gebruik een URL</label>
                            <div class="input-group">
                                <input type="text" id="editImageUrl" class="form-control" value="${comp.url || ''}" placeholder="https://...">
                                <button class="btn btn-outline-secondary" type="button" onclick="openMediaManager('editImageUrl')">Media</button>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Breedte</label>
                                <input type="text" id="editImageWidth" class="form-control" value="${comp.width || '300px'}" placeholder="bv. 100% of 300px">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Hoogte</label>
                                <input type="text" id="editImageHeight" class="form-control" value="${comp.height || 'auto'}" placeholder="bv. auto of 200px">
                            </div>
                            <div class="col-md-12 mb-3">
                                <label class="form-label">Rotatie (graden)</label>
                                <input type="number" id="editImageRotation" class="form-control" value="${comp.rotation || 0}">
                            </div>
                        </div>
                    </div>
                `;
                break;
            case 'columns':
                html = `
                    <div class="mb-3">
                        <label class="form-label">Aantal Kolommen</label>
                        <input type="number" id="editColCount" class="form-control" min="1" max="6" value="${comp.cols.length}" onchange="adjustColInputs(this.value)">
                        <small class="text-muted">Bij het verminderen van het aantal kolommen kan inhoud verloren gaan.</small>
                    </div>
                    <div id="colWidthContainer">
                        ${comp.cols.map((col, i) => `
                            <div class="mb-2">
                                <label class="form-label small">Breedte Kolom ${i+1} (%)</label>
                                <input type="number" class="form-control form-control-sm col-width-input" value="${col.width}" data-index="${i}">
                            </div>
                        `).join('')}
                    </div>
                `;
                break;
            case 'spacer':
                html = `
                    <div class="mb-3">
                        <label class="form-label">Hoogte (pixels)</label>
                        <input type="number" id="editSpacerHeight" class="form-control" value="${comp.height || 50}">
                    </div>
                `;
                break;
            case 'button':
                html = `
                    <div class="mb-3">
                        <label class="form-label">Knop Tekst</label>
                        <input type="text" id="editBtnText" class="form-control" value="${comp.text || ''}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Link (URL)</label>
                        <input type="text" id="editBtnUrl" class="form-control" value="${comp.url || ''}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Uitlijning</label>
                        <select id="editBtnAlign" class="form-select">
                            <option value="start" ${comp.align == 'start' ? 'selected' : ''}>Links</option>
                            <option value="center" ${comp.align == 'center' ? 'selected' : ''}>Midden</option>
                            <option value="end" ${comp.align == 'end' ? 'selected' : ''}>Rechts</option>
                        </select>
                    </div>
                `;
                break;
        }

        body.innerHTML = html;
        const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('editModal'));
        modal.show();

        if (comp.type === 'text' && window.initializeRichEditors) {
            window.initializeRichEditors(document.getElementById('editRichText'));
        }
    }

    function adjustColInputs(count) {
        const container = document.getElementById('colWidthContainer');
        const target = parseInt(count);
        if (isNaN(target) || target < 1) return;

        // Reset all widths to be equal when count changes for better UX
        const newWidth = Math.floor(100 / target);
        container.innerHTML = '';
        for (let i = 0; i < target; i++) {
            const div = document.createElement('div');
            div.className = 'mb-2';
            const width = (i === target - 1) ? (100 - (newWidth * (target - 1))) : newWidth;
            div.innerHTML = `
                <label class="form-label small">Breedte Kolom ${i+1} (%)</label>
                <input type="number" class="form-control form-control-sm col-width-input" value="${width}" data-index="${i}">
            `;
            container.appendChild(div);
        }
    }

    document.getElementById('saveChangesBtn').addEventListener('click', () => {
        const comp = getCompByPath(editingPath);
        if (!comp) return;

        if (comp.type === 'header') {
            comp.text = document.getElementById('editHeaderTask').value;
            comp.level = parseInt(document.getElementById('editHeaderLevel').value);
        } else if (comp.type === 'text') {
            comp.text = document.getElementById('editRichText').value;
        } else if (comp.type === 'image') {
            comp.url = document.getElementById('editImageUrl').value;
            comp.width = document.getElementById('editImageWidth').value;
            comp.height = document.getElementById('editImageHeight').value;
            comp.rotation = parseFloat(document.getElementById('editImageRotation').value);
        } else if (comp.type === 'columns') {
            const count = parseInt(document.getElementById('editColCount').value);
            const inputs = document.querySelectorAll('.col-width-input');
            const newCols = [];
            let totalWidth = 0;
            for (let i = 0; i < count; i++) {
                const width = parseInt(inputs[i].value);
                totalWidth += width;
                const oldContent = (comp.cols[i] && comp.cols[i].content) ? comp.cols[i].content : [];
                newCols.push({ width, content: oldContent });
            }
            
            if (totalWidth !== 100 && !confirm(`De kolommen tellen op tot ${totalWidth}% in plaats van 100%. Dit kan de weergave verstoren. Doorgaan?`)) {
                return;
            }
            comp.cols = newCols;
        } else if (comp.type === 'spacer') {
            comp.height = parseInt(document.getElementById('editSpacerHeight').value);
        } else if (comp.type === 'button') {
            comp.text = document.getElementById('editBtnText').value;
            comp.url = document.getElementById('editBtnUrl').value;
            comp.align = document.getElementById('editBtnAlign').value;
        }

        renderComponents();
        bootstrap.Modal.getInstance(document.getElementById('editModal')).hide();
    });

    function deleteComp(path) {
        if (confirm('Zeker dat je dit component wilt verwijderen?')) {
            const parts = path.toString().split('.');
            const index = parseInt(parts.pop());
            const parentPath = parts.join('.');
            const parentArray = parentPath ? getCompByPath(parentPath) : components;
            parentArray.splice(index, 1);
            renderComponents();
        }
    }

    function moveComp(path, dir) {
        const parts = path.toString().split('.');
        const index = parseInt(parts.pop());
        const parentPath = parts.join('.');
        const parentArray = parentPath ? getCompByPath(parentPath) : components;
        const newIndex = index + dir;
        if (newIndex >= 0 && newIndex < parentArray.length) {
            const temp = parentArray[index];
            parentArray[index] = parentArray[newIndex];
            parentArray[newIndex] = temp;
            renderComponents();
        }
    }

    function handleDragStart(e, type) { 
        e.dataTransfer.setData('type', type); 
    }
    function handleDragOver(e) { 
        e.preventDefault(); 
        e.stopPropagation();
        const target = e.target.closest('.column-box') || e.target.closest('.builder-main');
        if (target) {
            document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));
            target.classList.add('drag-over');
        }
    }
    function handleDragLeave(e) {
        e.preventDefault();
        e.stopPropagation();
        const target = e.target.closest('.column-box') || e.target.closest('.builder-main');
        if (target) target.classList.remove('drag-over');
    }
    function handleDrop(e) {
        e.preventDefault();
        e.stopPropagation();
        const type = e.dataTransfer.getData('type');
        if (!type) return;
        
        document.querySelectorAll('.drag-over').forEach(el => el.classList.remove('drag-over'));

        const columnBox = e.target.closest('.column-box');
        if (columnBox) {
            const path = columnBox.dataset.path;
            addComponent(type, path);
        } else {
            addComponent(type);
        }
    }

    function handleCompImageUpload(input) {
        if (!input.files || !input.files[0]) return;
        
        const file = input.files[0];
        const formData = new FormData();
        formData.append('image', file);
        
        const status = document.getElementById('uploadStatus');
        status.style.display = 'block';
        
        fetch('/admin/api/upload-image', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(data => {
            if (data.url) {
                document.getElementById('editImageUrl').value = data.url;
                status.innerHTML = '<i class="bi bi-check-circle-fill text-success"></i> Upload succesvol!';
            } else {
                throw new Error('Geen URL ontvangen');
            }
        })
        .catch(err => {
            console.error(err);
            status.innerHTML = '<i class="bi bi-exclamation-circle-fill text-danger"></i> Upload mislukt.';
        });
    }

    function openMediaManager(targetId) {
        const url = prompt('Geef de URL van de afbeelding op:');
        if (url) document.getElementById(targetId).value = url;
    }

    renderComponents();
</script>


