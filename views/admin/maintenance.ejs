<%- include('../partials/header') %>

<style>
  .maintenance-card {
    border: none;
    border-radius: 1rem;
    box-shadow: 0 0.5rem 1.5rem rgba(0, 0, 0, 0.08);
    background: white;
    overflow: hidden;
  }

  .nav-pills-custom .nav-link {
    color: #495057;
    font-weight: 500;
    padding: 0.8rem 1.2rem;
    border-radius: 0.75rem;
    transition: all 0.2s;
    border: 1px solid transparent;
    margin-bottom: 0.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .nav-pills-custom .nav-link:hover {
    background-color: #f8f9fa;
    color: #2c3e50;
  }

  .nav-pills-custom .nav-link.active {
    background-color: #fff4e5;
    color: #d97706;
    border-color: #fbbf24;
  }

  /* File Explorer Styling */
  .file-explorer-container {
    background: #fdfdfd;
    border: 1px solid #edf2f7;
    border-radius: 0.75rem;
  }

  .file-item-row {
    transition: background 0.15s ease;
    border-bottom: 1px solid #f1f5f9;
  }

  .file-item-row:hover {
    background-color: #f8fafc;
  }

  .file-icon {
    font-size: 1.25rem;
    width: 2rem;
    text-align: center;
  }

  /* Log Viewer Styling */
  .log-terminal {
    background: #1a202c;
    color: #e2e8f0;
    font-family: 'Monaco', 'Menlo', 'Ubuntu Mono', 'Consolas', monospace;
    font-size: 0.85rem;
    padding: 1.25rem;
    border-radius: 0.75rem;
    max-height: 400px;
    overflow-y: auto;
    line-height: 1.6;
    border: 1px solid #2d3748;
  }

  .log-terminal.stderr {
    border-left: 4px solid #f56565;
  }

  /* Stats Card Polish */
  .stat-widget {
    padding: 1.5rem;
    border-radius: 1rem;
    border: 1px solid #edf2f7;
    background: white;
    transition: transform 0.2s;
  }

  .stat-widget:hover {
    transform: translateY(-2px);
  }

  .stat-icon {
    width: 3rem;
    height: 3rem;
    border-radius: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    margin-bottom: 1rem;
  }

  /* Database Table UI (Original Style) */
  .table-data table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }

  .table-data th {
    background: #2c3e50;
    color: white;
    padding: 12px;
    text-align: left;
    font-weight: 600;
  }

  .table-data td {
    padding: 8px 12px;
    border-bottom: 1px solid #eee;
    max-width: 200px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .table-data tr:hover {
    background: #f8fafc;
  }

  .db-table-nav {
    max-height: 600px;
    overflow-y: auto;
  }

  .db-table-link {
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: all 0.2s;
    border-left: 3px solid transparent;
  }

  .db-table-link:hover {
    background: #f1f5f9;
  }

  .db-table-link.active {
    background: #ebf8ff;
    color: #2b6cb0;
    border-left-color: #3182ce;
    font-weight: 600;
  }

  .loading-spinner {
    width: 2.5rem;
    height: 2.5rem;
    border: 3px solid #f3f3f3;
    border-top: 3px solid #f6ad55;
    border-radius: 50%;
    animation: spin 1s linear infinite;
  }

  @keyframes spin { 0% { transform: rotate(0deg); } 100% { transform: rotate(360deg); } }

  .custom-modal-backdrop {
    position: fixed;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(4px);
    z-index: 1050;
    display: none;
    align-items: center;
    justify-content: center;
  }
  .custom-modal-backdrop.show { display: flex; }
  
  /* Fix Bootstrap's modal-dialog pointer-events: none */
  .custom-modal-backdrop .modal-dialog {
    pointer-events: auto;
    position: relative;
    z-index: 1051;
  }
</style>

<div class="container-fluid px-4 py-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h1 class="h2 fw-bold mb-1"><i class="bi bi-gear-wide-connected text-warning me-2"></i>Onderhoudstools</h1>
            <p class="text-muted mb-0">Geavanceerd beheer & systeemdiagnostiek</p>
        </div>
        <div class="col-auto">
            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill fw-bold">ADMIN ONLY</span>
        </div>
    </div>

    <div class="row g-4">
        <!-- Sidebar Navigation -->
        <div class="col-lg-3 col-xl-2">
            <div class="nav flex-column nav-pills nav-pills-custom" id="v-pills-tab" role="tablist" aria-orientation="vertical">
                <button class="nav-link active" onclick="switchTab(event, 'file-explorer')">
                    <i class="bi bi-folder2-open"></i> Bestandsbeheer
                </button>
                <button class="nav-link" onclick="switchTab(event, 'backups')">
                    <i class="bi bi-archive"></i> Backups
                </button>
                <button class="nav-link" onclick="switchTab(event, 'database')">
                    <i class="bi bi-hdd-stack"></i> Database
                </button>
                <button class="nav-link" onclick="switchTab(event, 'logs')">
                    <i class="bi bi-terminal"></i> Systeem Logs
                </button>
                <button class="nav-link" onclick="switchTab(event, 'calendar-stats')">
                    <i class="bi bi-calendar-check"></i> Kalender Stats
                </button>
                <button class="nav-link" onclick="switchTab(event, 'notifications')">
                    <i class="bi bi-bell"></i> Notificaties
                </button>
            </div>
        </div>

        <!-- Main Content Area -->
        <div class="col-lg-9 col-xl-10">
            <div class="maintenance-card card h-100">
                <div class="card-body p-4">
                    
                    <!-- File Explorer Tab -->
                    <div id="file-explorer" class="tab-content active">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0 fw-bold">Bestandsbeheer</h4>
                            <div class="breadcrumb mb-0 bg-light px-3 py-2 rounded-3 border">
                                <i class="bi bi-house-door me-2"></i>
                                <button class="btn btn-link btn-sm p-0 text-decoration-none" onclick="navigateToFolder('')">public</button>
                                <span id="breadcrumb-trail" class="text-muted ms-1"></span>
                            </div>
                        </div>
                        
                        <div id="file-list" class="list-group list-group-flush border rounded-3 mb-4">
                            <div class="text-center py-5">
                                <div class="loading-spinner mx-auto mb-3"></div>
                                <p class="text-muted">Bestanden laden...</p>
                            </div>
                        </div>

                        <!-- Editor (Hidden by default) -->
                        <div class="card border-primary d-none shadow-sm" id="file-editor">
                            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                                <h6 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Bewerk: <span id="editor-filename"></span></h6>
                                <div class="btn-group">
                                    <button class="btn btn-sm btn-outline-light" onclick="closeFileEditor()">Annuleren</button>
                                    <button class="btn btn-sm btn-light fw-bold" onclick="saveFile()">Opslaan</button>
                                </div>
                            </div>
                            <div class="card-body p-0">
                                <textarea id="file-content" class="form-control border-0 rounded-0" style="height: 500px; font-family: monospace;"></textarea>
                            </div>
                        </div>
                    </div>

                    <!-- Backups Tab -->
                    <div id="backups" class="tab-content d-none">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0 fw-bold">Systeem Backups</h4>
                            <div class="d-flex gap-2">
                                <button class="btn btn-outline-primary fw-bold shadow-sm" onclick="document.getElementById('backup-upload-input').click()">
                                    <i class="bi bi-upload me-2"></i>Upload .back
