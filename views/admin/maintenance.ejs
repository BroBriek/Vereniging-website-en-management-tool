                            <div class="btn-group shadow-sm">
                                <button class="btn btn-outline-danger" onclick="clearPM2Logs()">
                                    <i class="bi bi-trash me-2"></i>Wissen
                                </button>
                                <button class="btn btn-primary" onclick="refreshPM2Logs()">
                                    <i class="bi bi-arrow-repeat me-2"></i>Vernieuwen
                                </button>
                            </div>
                        </div>
                        <div id="logs-content">
                            <!-- Processes will be injected here -->
                        </div>
                    </div>

                    <!-- Calendar Stats Tab -->
                    <div id="calendar-stats" class="tab-content d-none">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h4 class="mb-0 fw-bold">ICS Kalender Gebruik</h4>
                            <button class="btn btn-outline-primary btn-sm rounded-pill px-3" onclick="loadCalendarStats()">
                                <i class="bi bi-arrow-clockwise me-1"></i>Verversen
                            </button>
                        </div>
                        <div id="calendar-stats-content">
                            <!-- Stats injected here -->
                        </div>
                    </div>

                    <!-- Notifications Tab -->
                    <div id="notifications" class="tab-content d-none">
                        <div class="alert alert-warning border-0 shadow-sm d-flex align-items-center mb-4">
                            <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                            <div>
                                <strong>Let op:</strong> Dit verstuurt echte notificaties naar gebruikers. Gebruik dit alleen voor noodzakelijke systeemtests of kritieke mededelingen.
                            </div>
                        </div>
                        
                        <div class="row">
                            <div class="col-md-7">
                                <div class="card border-0 shadow-sm bg-light">
                                    <div class="card-body p-4">
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Ontvanger</label>
                                            <select id="notif-user" class="form-select border-0 shadow-sm rounded-3 py-2">
                                                <option value="">Laden...</option>
                                            </select>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Titel</label>
                                            <input type="text" id="notif-title" class="form-control border-0 shadow-sm rounded-3 py-2" placeholder="Onderwerp van het bericht">
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-bold">Bericht</label>
                                            <textarea id="notif-body" class="form-control border-0 shadow-sm rounded-3" rows="4" placeholder="De inhoud van je mededeling..."></textarea>
                                        </div>
                                        <div class="mb-4">
                                            <label class="form-label fw-bold">Verzendmethode</label>
                                            <div class="btn-group w-100" role="group">
                                                <input type="radio" class="btn-check" name="send-method" id="method-push" value="notification" checked>
                                                <label class="btn btn-outline-primary" for="method-push"><i class="bi bi-phone me-2"></i>Push</label>
                                                
                                                <input type="radio" class="btn-check" name="send-method" id="method-email" value="email">
                                                <label class="btn btn-outline-primary" for="method-email"><i class="bi bi-envelope me-2"></i>Email</label>
                                                
                                                <input type="radio" class="btn-check" name="send-method" id="method-both" value="both">
                                                <label class="btn btn-outline-primary" for="method-both">Beide</label>
