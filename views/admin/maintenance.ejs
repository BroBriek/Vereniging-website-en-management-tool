                        <div class="row g-4">
                            <div class="col-md-3 border-end">
                                <h6 class="text-uppercase small fw-bold text-muted mb-3">Tabellen</h6>
                                <div id="table-list" class="db-table-nav list-group list-group-flush">
                                    <div class="loading-spinner loading-spinner-sm mx-auto"></div>
