                            </div>
                            <div class="col-md-9">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5 id="selected-table-name" class="mb-0 fw-bold text-primary">Selecteer een tabel</h5>
                                    <div class="d-flex gap-2">
                                        <select id="records-per-page" class="form-select form-select-sm" style="width: auto;">
                                            <option value="25">25 per pagina</option>
                                            <option value="50" selected>50 per pagina</option>
                                            <option value="100">100 per pagina</option>
                                        </select>
                                        <button class="btn btn-sm btn-outline-secondary" onclick="loadTableData()">
                                            <i class="bi bi-arrow-clockwise"></i>
                                        </button>
                                    </div>
                                </div>
                                <div id="table-data" class="table-responsive border rounded-3 bg-white">
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-database-fill-gear display-4 d-block mb-3 opacity-25"></i>
                                        Kies een tabel om gegevens te bekijken
                                    </div>
                                </div>
                                <div id="pagination" class="mt-3 d-flex justify-content-center"></div>
                            </div>
                        </div>
                    </div>

                    <!-- Logs Tab -->
                    <div id="logs" class="tab-content d-none">
                        <div class="d-flex justify-content-between align-items-center mb-4">
