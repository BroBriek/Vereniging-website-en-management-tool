</div>

<!-- Custom Backdrop & Modals -->
<div class="custom-modal-backdrop" id="modal-backdrop">
    <div class="modal-dialog bg-white rounded-4 shadow-lg overflow-hidden" id="edit-modal" style="width: 100%; max-width: 600px; display: none;">
        <div class="modal-header bg-light border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Record Aanpassen</h5>
            <button class="btn-close" onclick="closeEditModal()"></button>
        </div>
        <div class="modal-body p-4" id="modal-fields" style="max-height: 70vh; overflow-y: auto;">
            <!-- Fields injected here -->
        </div>
        <div class="modal-footer bg-light border-top px-4 py-3 d-flex justify-content-end gap-2">
            <button class="btn btn-secondary px-4" onclick="closeEditModal()">Annuleren</button>
            <button class="btn btn-primary px-4 fw-bold" onclick="saveEditedRecord()">Wijzigingen Opslaan</button>
        </div>
    </div>

    <!-- Backup Content Modal -->
    <div class="modal-dialog bg-white rounded-4 shadow-lg overflow-hidden" id="backup-content-modal" style="width: 100%; max-width: 800px; display: none;">
        <div class="modal-header bg-light border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
            <h5 class="mb-0 fw-bold">Backup Inhoud: <span id="backup-name-display" class="text-primary"></span></h5>
            <button class="btn-close" onclick="closeBackupContentModal()"></button>
        </div>
        <div class="modal-body p-4" id="backup-files-list" style="max-height: 60vh; overflow-y: auto; font-family: monospace;">
            <!-- Content injected here -->
        </div>
        <div class="modal-footer bg-light border-top px-4 py-3">
            <button class="btn btn-secondary px-4" onclick="closeBackupContentModal()">Sluiten</button>
        </div>
    </div>
</div>

<script>
  let currentFolder = '';
  let selectedTable = null;
  let currentPage = 0;
  let recordsPerPage = 50;
  let totalRecords = 0;
  let currentFilePath = null;

  // Tab switching
  function switchTab(event, tabName) {
    if (event) event.preventDefault();
    
    // Deactivate all
    document.querySelectorAll('.tab-content').forEach(tab => {
        tab.classList.add('d-none');
        tab.classList.remove('active');
    });
    document.querySelectorAll('.nav-link').forEach(btn => btn.classList.remove('active'));
    
    // Activate target
    const target = document.getElementById(tabName);
    target.classList.remove('d-none');
    target.classList.add('active');
    
    if (event) event.target.classList.add('active');
    
    // Load content
    if (tabName === 'file-explorer' && currentFolder === '') loadFileExplorer();
    else if (tabName === 'backups') loadBackups();
    else if (tabName === 'database' && selectedTable === null) loadTables();
    else if (tabName === 'logs') refreshPM2Logs();
    else if (tabName === 'calendar-stats') loadCalendarStats();
    else if (tabName === 'notifications') loadNotificationUsers();
  }

  // ===== FILE EXPLORER =====
  function loadFileExplorer() {
    fetch(`/admin/api/file-explorer?path=${encodeURIComponent(currentFolder)}`)
      .then(r => r.json())
      .then(data => displayFileList(data.items))
      .catch(err => {
          document.getElementById('file-list').innerHTML = `<div class="p-5 text-center text-danger">Fout bij laden: ${err.message}</div>`;
      });
  }

  function displayFileList(items) {
    let html = '';
    
    if (currentFolder !== '') {
      html += `
        <button class="list-group-item list-group-item-action d-flex align-items-center py-3" onclick="navigateToFolder('${getParentFolder(currentFolder)}')">
          <div class="file-icon text-muted me-3"><i class="bi bi-arrow-90deg-up"></i></div>
          <div class="fw-bold">..</div>
        </button>
      `;
    }
    
    items.forEach(item => {
      const icon = item.isDirectory ? '<i class="bi bi-folder-fill text-warning"></i>' : getFileIcon(item.extension);
      const size = item.size ? formatBytes(item.size) : '';
      
      html += `
        <div class="list-group-item list-group-item-action d-flex align-items-center py-3 file-item-row">
          <div class="file-icon me-3" onclick="${item.isDirectory ? `navigateToFolder('${item.path}')` : `editFile('${item.path}')`}">${icon}</div>
          <div class="flex-grow-1 text-truncate" onclick="${item.isDirectory ? `navigateToFolder('${item.path}')` : `editFile('${item.path}')`}" style="cursor: pointer;">
            <div class="fw-medium">${item.name}</div>
            <small class="text-muted">${size}</small>
          </div>
          <div class="btn-group">
            ${!item.isDirectory ? `<button class="btn btn-sm btn-outline-primary" onclick="editFile('${item.path}')" title="Bewerken"><i class="bi bi-pencil"></i></button>` : ''}
            ${!item.isDirectory ? `<a href="/admin/api/file-download?path=${encodeURIComponent(item.path)}" class="btn btn-sm btn-outline-success" title="Downloaden"><i class="bi bi-download"></i></a>` : ''}
            <button class="btn btn-sm btn-outline-danger" onclick="deleteFile('${item.path}')" title="Verwijderen"><i class="bi bi-trash"></i></button>
          </div>
        </div>
      `;
    });
    
    document.getElementById('file-list').innerHTML = html || '<div class="p-5 text-center text-muted">Geen bestanden gevonden</div>';
    updateBreadcrumb();
  }

  function navigateToFolder(path) {
    currentFolder = path;
    loadFileExplorer();
  }

  function getParentFolder(path) {
    const parts = path.split('/');
    parts.pop();
    return parts.join('/');
  }

  function updateBreadcrumb() {
    const trail = document.getElementById('breadcrumb-trail');
    if (!currentFolder) {
      trail.innerHTML = '';
      return;
    }
    
    const parts = currentFolder.split('/');
    let html = '';
    let path = '';
    
    parts.forEach((part, idx) => {
      path += (idx === 0 ? '' : '/') + part;
      html += ` / <button class="btn btn-link btn-sm p-0 text-decoration-none" onclick="navigateToFolder('${path}')">${part}</button>`;
    });
    
    trail.innerHTML = html;
  }

  function getFileIcon(ext) {
    const icons = {
      '.html': '<i class="bi bi-code-slash text-danger"></i>',
      '.css': '<i class="bi bi-palette text-info"></i>',
      '.js': '<i class="bi bi-filetype-js text-warning"></i>',
      '.json': '<i class="bi bi-filetype-json text-success"></i>',
      '.png': '<i class="bi bi-file-earmark-image text-primary"></i>',
      '.jpg': '<i class="bi bi-file-earmark-image text-primary"></i>',
      '.pdf': '<i class="bi bi-file-earmark-pdf text-danger"></i>',
      '.txt': '<i class="bi bi-file-earmark-text text-secondary"></i>'
    };
    return icons[ext] || '<i class="bi bi-file-earmark text-muted"></i>';
  }

  function formatBytes(bytes) {
    if (bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
  }

  function editFile(filePath) {
    currentFilePath = filePath;
    const editor = document.getElementById('file-editor');
    editor.classList.remove('d-none');
    document.getElementById('file-list').classList.add('d-none');
    
    fetch(`/admin/api/file-read?path=${encodeURIComponent(filePath)}`)
      .then(r => r.json())
      .then(data => {
        document.getElementById('editor-filename').textContent = filePath;
        document.getElementById('file-content').value = data.content;
        editor.scrollIntoView({ behavior: 'smooth' });
      })
      .catch(err => alert('Fout bij lezen: ' + err.message));
  }

  function closeFileEditor() {
    document.getElementById('file-editor').classList.add('d-none');
    document.getElementById('file-list').classList.remove('d-none');
    currentFilePath = null;
  }

  function saveFile() {
    const content = document.getElementById('file-content').value;
    fetch('/admin/api/file-save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: currentFilePath, content })
    })
      .then(r => r.json())
      .then(data => {
        showAlert('success', 'Bestand succesvol opgeslagen');
        closeFileEditor();
      })
      .catch(err => showAlert('error', err.message));
  }

  function deleteFile(filePath) {
    if (!confirm(`Verwijder '${filePath.split('/').pop()}' definitief?`)) return;
    
    fetch('/admin/api/file-delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ path: filePath })
    })
      .then(r => r.json())
      .then(data => {
        loadFileExplorer();
        showAlert('success', 'Bestand verwijderd');
      })
      .catch(err => showAlert('error', err.message));
  }

  // ===== DATABASE VIEWER =====
  function loadTables() {
    fetch('/admin/api/db-tables')
      .then(r => r.json())
      .then(data => {
        let html = '';
        data.tables.forEach(table => {
          html += `<div class="db-table-link" onclick="selectTable('${table.name}', this)">
            <i class="bi bi-table me-2"></i> ${table.name}
          </div>`;
        });
        document.getElementById('table-list').innerHTML = html;
      })
      .catch(err => {
        document.getElementById('table-list').innerHTML = '<div class="text-danger small">Fout bij laden</div>';
      });
  }

  function selectTable(tableName, el) {
    selectedTable = tableName;
    document.querySelectorAll('.db-table-link').forEach(l => l.classList.remove('active'));
    el.classList.add('active');
    document.getElementById('selected-table-name').textContent = tableName;
    currentPage = 0;
    loadTableData();
  }

  function loadTableData() {
    if (!selectedTable) return;
    
    recordsPerPage = parseInt(document.getElementById('records-per-page').value);
    const offset = currentPage * recordsPerPage;
    const container = document.getElementById('table-data');
    container.innerHTML = '<div class="text-center py-5"><div class="loading-spinner mx-auto"></div></div>';
    
    fetch(`/admin/api/db-data?tableName=${encodeURIComponent(selectedTable)}&limit=${recordsPerPage}&offset=${offset}`)
      .then(r => r.json())
      .then(data => {
        totalRecords = data.total;
        displayTableData(data.data);
        updatePagination();
      })
      .catch(err => {
        container.innerHTML = `<div class="p-4 text-danger">Fout: ${err.message}</div>`;
      });
  }

  function displayTableData(rows) {
    if (rows.length === 0) {
      document.getElementById('table-data').innerHTML = '<div class="p-5 text-center text-muted">Geen data in deze tabel</div>';
      return;
    }
    
    const columns = Object.keys(rows[0]);
    let html = '<table><thead><tr>';
    columns.forEach(col => html += `<th>${col}</th>`);
    html += '<th class="text-end">Acties</th></tr></thead><tbody>';
    
    rows.forEach(row => {
      html += '<tr>';
      columns.forEach(col => {
        let value = row[col];
        if (value === null || value === undefined) {
          value = '';
        } else if (typeof value === 'object') {
          value = JSON.stringify(value);
        } else {
          value = String(value);
        }
        
        // Truncate for display if too long
        const displayValue = value.length > 50 ? value.substring(0, 50) + '...' : value;
        html += `<td title="${escapeHtml(value)}">${escapeHtml(displayValue)}</td>`;
      });
      html += `
        <td class="text-end">
          <div class="btn-group">
            <button class="btn btn-sm btn-light border" onclick="editRecord('${selectedTable}', ${row.id})"><i class="bi bi-pencil"></i></button>
            <button class="btn btn-sm btn-light border text-danger" onclick="deleteRecord('${selectedTable}', ${row.id})"><i class="bi bi-trash"></i></button>
          </div>
        </td>
      </tr>`;
    });
    
    html += '</tbody></table>';
    document.getElementById('table-data').innerHTML = html;
  }

  function updatePagination() {
    const totalPages = Math.ceil(totalRecords / recordsPerPage);
    const pag = document.getElementById('pagination');
    if (totalPages <= 1) { pag.innerHTML = ''; return; }
    
    let html = '<nav><ul class="pagination pagination-sm mb-0">';
    html += `<li class="page-item ${currentPage === 0 ? 'disabled' : ''}"><button class="page-link" onclick="currentPage--; loadTableData()">&laquo;</button></li>`;
    html += `<li class="page-item disabled"><span class="page-link px-3">${currentPage + 1} / ${totalPages}</span></li>`;
    html += `<li class="page-item ${currentPage >= totalPages - 1 ? 'disabled' : ''}"><button class="page-link" onclick="currentPage++; loadTableData()">&raquo;</button></li>`;
    html += '</ul></nav>';
    pag.innerHTML = html;
  }

  // ===== APPLICATION LOGS =====
  function refreshPM2Logs() {
    const container = document.getElementById('logs-content');
    container.innerHTML = '<div class="text-center py-5"><div class="loading-spinner mx-auto"></div></div>';
    
    fetch('/admin/api/pm2-logs?lines=100')
      .then(r => r.json())
      .then(data => {
        if (data.error && !data.processes) {
            container.innerHTML = `<div class="alert alert-info border-0 shadow-sm">${escapeHtml(data.message || data.error)}</div>`;
            return;
        }

        let html = '';
        if (data.message) {
          html += `<div class="alert alert-info border-0 shadow-sm mb-4">${escapeHtml(data.message)}</div>`;
        }

        for (const [name, log] of Object.entries(data.processes || {})) {
          html += `
            <div class="card mb-4 border-0 shadow-sm rounded-4 overflow-hidden">
                <div class="card-header border-0 d-flex align-items-center bg-white py-3 px-4">
                    <span class="badge ${log.status === 'online' || log.status === 'running' ? 'bg-success' : 'bg-danger'} rounded-pill me-3" style="width: 12px; height: 12px; padding:0;">&nbsp;</span>
                    <h5 class="mb-0 fw-bold">${name} <small class="text-muted fw-normal ms-2">PID: ${log.pid}</small></h5>
                </div>
                <div class="card-body p-4 bg-light">
                    <div class="mb-3">
                        <label class="small text-uppercase fw-bold text-muted mb-2 d-block">System Output (stdout)</label>
                        <div class="log-terminal">${escapeHtml(log.stdout || 'Geen logs')}</div>
                    </div>
                    <div>
                        <label class="small text-uppercase fw-bold text-danger mb-2 d-block">Errors (stderr)</label>
                        <div class="log-terminal stderr">${escapeHtml(log.stderr || 'Geen errors')}</div>
                    </div>
                </div>
            </div>
          `;
        }
        container.innerHTML = html || '<p class="text-center text-muted">Geen actieve processen gevonden</p>';
      })
      .catch(err => container.innerHTML = `<div class="alert alert-danger">${escapeHtml(err.message)}</div>`);
  }

  // ===== CALENDAR STATS =====
