                                <input type="file" id="backup-upload-input" class="d-none" accept=".back" onchange="uploadBackup(this)">
                                <button class="btn btn-warning fw-bold shadow-sm" onclick="createBackup()">
                                    <i class="bi bi-plus-circle me-2"></i>Maak Nieuwe Backup
