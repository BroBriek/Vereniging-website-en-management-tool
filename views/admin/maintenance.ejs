    const container = document.getElementById('calendar-stats-content');
    container.innerHTML = '<div class="text-center py-5"><div class="loading-spinner mx-auto"></div></div>';
    
    fetch('/admin/api/calendar-stats')
      .then(r => r.json())
      .then(data => {
        let html = `
          <div class="row g-4 mb-5">
            <div class="col-md-4">
              <div class="stat-widget shadow-sm">
                <div class="stat-icon bg-primary bg-opacity-10 text-primary"><i class="bi bi-activity"></i></div>
                <div class="small text-muted text-uppercase fw-bold mb-1">Totaal Aanvragen</div>
                <div class="h3 fw-bold mb-0">${data.totalRequests}</div>
                <div class="small text-muted">Laatste 30 dagen</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="stat-widget shadow-sm">
                <div class="stat-icon bg-success bg-opacity-10 text-success"><i class="bi bi-people"></i></div>
                <div class="small text-muted text-uppercase fw-bold mb-1">Unieke Gebruikers</div>
                <div class="h3 fw-bold mb-0">${data.uniqueUsersCount}</div>
                <div class="small text-muted">Ingelogde leiding</div>
              </div>
            </div>
            <div class="col-md-4">
              <div class="stat-widget shadow-sm">
                <div class="stat-icon bg-warning bg-opacity-10 text-warning"><i class="bi bi-shield-lock"></i></div>
                <div class="small text-muted text-uppercase fw-bold mb-1">Unieke Gasten</div>
                <div class="h3 fw-bold mb-0">${data.uniqueGuestsCount}</div>
                <div class="small text-muted">Op IP-adres basis</div>
              </div>
            </div>
          </div>

          <div class="row g-4">
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 py-3"><h6 class="mb-0 fw-bold">Top Gebruikers</h6></div>
                    <div class="list-group list-group-flush">
        `;

        if (data.userRequests.length === 0) {
            html += '<div class="p-4 text-center text-muted small">Nog geen data beschikbaar</div>';
        } else {
            data.userRequests.forEach(req => {
                html += `
                    <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                        <div>
                            <div class="fw-bold">${req.user ? req.user.username : 'Onbekend'}</div>
                            <small class="text-muted">${new Date(req.lastAccess).toLocaleDateString('nl-BE')}</small>
                        </div>
                        <span class="badge bg-success rounded-pill px-3">${req.count}</span>
                    </div>
                `;
            });
        }

        html += `</div></div></div><div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white border-0 py-3"><h6 class="mb-0 fw-bold">Gast Toegang (IP / App)</h6></div>
                    <div class="list-group list-group-flush overflow-auto" style="max-height: 400px;">
        `;

        if (data.guestRequests.length === 0) {
            html += '<div class="p-4 text-center text-muted small">Nog geen data beschikbaar</div>';
        } else {
            data.guestRequests.forEach(req => {
                html += `
                    <div class="list-group-item py-3">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <div class="fw-bold small text-primary">${req.ipAddress}</div>
                            <span class="badge bg-light text-dark rounded-pill">${req.count}</span>
                        </div>
                        <div class="small text-muted text-truncate" title="${req.userAgent}">${req.userAgent || 'Onbekende kalender app'}</div>
                        <small class="text-muted" style="font-size: 0.7rem;">Laatste: ${new Date(req.lastAccess).toLocaleString('nl-BE')}</small>
                    </div>
                `;
            });
        }

        container.innerHTML = html + '</div></div></div></div>';
      })
      .catch(err => container.innerHTML = `<div class="alert alert-danger">${err.message}</div>`);
  }

  // ===== BACKUPS =====
  function loadBackups() {
    fetch('/admin/api/backups')
      .then(r => r.json())
      .then(data => {
          let html = '';
          if (data.backups.length === 0) {
              html = '<div class="col-12 text-center py-5 text-muted">Geen backups gevonden</div>';
          } else {
              data.backups.forEach(b => {
                  html += `
                    <div class="col-md-6 col-xl-4">
                        <div class="card border-0 shadow-sm h-100 rounded-4">
                            <div class="card-body p-4">
                                <div class="d-flex align-items-start mb-3">
                                    <div class="stat-icon bg-warning bg-opacity-10 text-warning mb-0 me-3">
                                        <i class="bi bi-archive-fill"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="fw-bold mb-1 text-truncate" title="${b.name}">${b.name}</h6>
                                        <small class="text-muted">${new Date(b.created).toLocaleString('nl-NL')}</small>
                                    </div>
                                </div>
                                <div class="d-grid gap-2 d-flex">
                                    <button class="btn btn-sm btn-outline-secondary flex-grow-1" onclick="viewBackupContent('${b.name}')">Inhoud</button>
                                    <a href="/admin/api/backups/download?name=${encodeURIComponent(b.name)}" class="btn btn-sm btn-outline-primary" title="Download .back"><i class="bi bi-download"></i></a>
                                    <button class="btn btn-sm btn-warning flex-grow-1 fw-bold" onclick="restoreBackup('${b.name}')">Herstel</button>
                                    <button class="btn btn-sm btn-outline-danger" onclick="deleteBackup('${b.name}')"><i class="bi bi-trash"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                  `;
              });
          }
          document.getElementById('backup-list').innerHTML = html;
      })
      .catch(err => document.getElementById('backup-list').innerHTML = `<div class="p-4 text-danger">${err.message}</div>`);
  }

  // ===== NOTIFICATIONS =====
  function loadNotificationUsers() {
    fetch('/admin/api/notification-users')
      .then(r => r.json())
      .then(data => {
        let html = '<option value="">-- Kies een gebruiker --</option>';
        data.users.forEach(u => html += `<option value="${u.id}">${u.username} (${u.email || 'geen mail'})</option>`);
        document.getElementById('notif-user').innerHTML = html;
      });
  }

  // Preview live updating
  document.getElementById('notif-title').addEventListener('input', e => document.getElementById('preview-title').textContent = e.target.value || 'Titel komt hier...');
  document.getElementById('notif-body').addEventListener('input', e => document.getElementById('preview-body').textContent = e.target.value || 'Bericht tekst wordt hier weergegeven tijdens het typen.');

  function sendTestNotification() {
    const userId = document.getElementById('notif-user').value;
    const title = document.getElementById('notif-title').value;
    const body = document.getElementById('notif-body').value;
    const sendMethod = document.querySelector('input[name="send-method"]:checked').value;
    
    if (!userId || !title || !body) return showAlert('error', 'Vul alle velden in');
    
    const fb = document.getElementById('notif-feedback');
    fb.innerHTML = '<div class="spinner-border spinner-border-sm me-2 text-primary"></div> Verzenden...';
    
    fetch('/admin/api/notification-send', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ userId, title, body, sendMethod })
    })
      .then(r => r.json())
      .then(data => {
        fb.innerHTML = '';
        if (data.success) {
          showAlert('success', 'Bericht succesvol verzonden!');
          document.getElementById('notif-title').value = '';
          document.getElementById('notif-body').value = '';
        } else showAlert('error', data.error);
      });
  }

  // ===== BACKDROP & MODALS =====
  function showModal(id) {
      document.getElementById('modal-backdrop').classList.add('show');
      document.getElementById(id).style.display = 'block';
      document.body.style.overflow = 'hidden';
  }

  function hideModals() {
      document.getElementById('modal-backdrop').classList.remove('show');
      document.querySelectorAll('.modal-dialog').forEach(m => m.style.display = 'none');
      document.body.style.overflow = 'auto';
  }

  // Reuse logic for editRecord, deleteRecord, createBackup, restoreBackup, deleteBackup, etc.
  // from previous implementation but with polished UI alerts/modals.

  function editRecord(tableName, id) {
    showModal('edit-modal');
    const fieldsContainer = document.getElementById('modal-fields');
    fieldsContainer.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';
    
    window.editingContext = { tableName, id };
  
    Promise.all([
      fetch(`/admin/api/db-data?tableName=${encodeURIComponent(tableName)}&limit=1&offset=0`).then(r => r.json()),
      fetch(`/admin/api/db-data?tableName=${encodeURIComponent(tableName)}&limit=1000&offset=0`).then(r => r.json())
    ]).then(([struct, full]) => {
        const record = full.data.find(r => r.id === id);
        if (!record) { fieldsContainer.innerHTML = 'Fout bij laden'; return; }
        window.editingContext.originalData = { ...record };
        
        let html = '';
        Object.keys(record).forEach(col => {
            let val = record[col];
            if (val === null || val === undefined) val = '';
            else if (typeof val === 'object') val = JSON.stringify(val);
            else val = String(val);

            html += `
                <div class="mb-3">
                    <label class="form-label small fw-bold text-muted text-uppercase">${col}</label>
                    ${val.length > 50 ? 
                        `<textarea class="form-control form-control-sm" data-column="${col}">${escapeHtml(val)}</textarea>` :
                        `<input type="text" class="form-control form-control-sm" data-column="${col}" value="${escapeHtml(val)}">`
                    }
                </div>
            `;
        });
        fieldsContainer.innerHTML = html;
    });
  }

  function closeEditModal() { hideModals(); }

  function saveEditedRecord() {
    const { tableName, id, originalData } = window.editingContext;
    const updates = {};
    let hasChanges = false;
    
    document.querySelectorAll('#modal-fields [data-column]').forEach(f => {
      const col = f.getAttribute('data-column');
      if (f.value !== String(originalData[col] || '')) {
        updates[col] = f.value;
        hasChanges = true;
      }
    });
    
    if (!hasChanges) return hideModals();
    
    fetch('/admin/api/db-update', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tableName, id, updates })
    })
      .then(r => r.json())
      .then(data => {
        if (data.success) {
          showAlert('success', 'Bijgewerkt!');
          hideModals();
          loadTableData();
        } else showAlert('error', data.error);
      });
  }

  function deleteRecord(tableName, id) {
    if (!confirm('Dit record definitief verwijderen?')) return;
    fetch('/admin/api/db-delete', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tableName, id })
    })
      .then(r => r.json())
      .then(data => { showAlert('success', 'Verwijderd'); loadTableData(); });
  }

  function createBackup() {
    fetch('/admin/api/backups/create', { method: 'POST' })
        .then(r => r.json())
        .then(data => { showAlert('success', 'Backup gereed'); loadBackups(); });
  }

  function uploadBackup(input) {
    if (!input.files || input.files.length === 0) return;
    const file = input.files[0];
    
    const password = prompt('Voer je wachtwoord in om de backup te uploaden en DIRECT te herstellen:');
    if (!password) {
        input.value = ''; // Reset input
        return;
    }

    const formData = new FormData();
    formData.append('backup', file);
    formData.append('password', password);

    showAlert('info', 'Backup wordt geüpload en hersteld... Dit kan even duren.');

    fetch('/admin/api/backups/upload', {
        method: 'POST',
        body: formData
    })
    .then(r => r.json())
    .then(data => {
        input.value = ''; // Reset input
        if (data.success) {
            showAlert('success', 'Backup succesvol geüpload en hersteld!');
            loadBackups();
        } else {
            showAlert('error', data.error || 'Upload mislukt');
        }
    })
    .catch(err => {
        input.value = '';
        showAlert('error', 'Upload fout: ' + err.message);
    });
  }

  function deleteBackup(name) {
    if (!confirm(`Verwijder backup '${name}'?`)) return;
    fetch('/admin/api/backups/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name })
    })
    .then(r => r.json()).then(data => { showAlert('success', 'Backup verwijderd'); loadBackups(); });
  }

  function restoreBackup(name) {
    if (!confirm(`⚠️ WAARSCHUWING: Overschrijf de huidige site met backup '${name}'?`)) return;
    
    const password = prompt('Voer je wachtwoord in om het herstel te bevestigen:');
    if (!password) return;

    showAlert('info', 'Herstelproces gestart... even geduld.');
    fetch('/admin/api/backups/restore', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ name, password })
    }).then(r => r.json()).then(data => {
        if (data.success) {
            showAlert('success', data.message);
        } else {
            showAlert('error', data.error);
        }
    });
  }

  function viewBackupContent(name) {
    document.getElementById('backup-name-display').textContent = name;
    showModal('backup-content-modal');
    const container = document.getElementById('backup-files-list');
    container.innerHTML = '<div class="text-center py-4"><div class="spinner-border text-primary"></div></div>';

    fetch(`/admin/api/backups/content?name=${encodeURIComponent(name)}`)
        .then(r => r.json())
        .then(data => {
            let html = '<div class="list-group list-group-flush">';
            data.contents.forEach(f => {
                html += `<div class="list-group-item d-flex justify-content-between py-2 small">
                    <span class="text-truncate me-3">${f.path}</span>
                    <span class="text-muted">${formatBytes(f.size)}</span>
                </div>`;
            });
            container.innerHTML = html + '</div>';
        });
  }

  function closeBackupContentModal() { hideModals(); }

  function clearPM2Logs() {
    if (!confirm('Alle proceslogs wissen?')) return;
    fetch('/admin/api/pm2-logs/clear', { method: 'POST' })
      .then(r => r.json())
      .then(data => { showAlert('success', 'Logs gewist'); refreshPM2Logs(); });
  }

  // ===== UTILITIES =====
  function escapeHtml(text) {
    const div = document.createElement('div');
    div.textContent = text;
    return div.innerHTML;
  }

  function showAlert(type, message) {
    const alert = document.createElement('div');
    alert.className = `alert alert-${type === 'error' ? 'danger' : type} alert-dismissible fade show shadow-sm position-fixed top-0 start-50 translate-middle-x mt-4`;
    alert.style.zIndex = '2000';
    alert.innerHTML = `<i class="bi bi-${type === 'success' ? 'check-circle' : 'info-circle'}-fill me-2"></i> ${message} <button type="button" class="btn-close" data-bs-dismiss="alert"></button>`;
    document.body.appendChild(alert);
    setTimeout(() => {
        const bsAlert = new bootstrap.Alert(alert);
        bsAlert.close();
    }, 5000);
  }

  document.addEventListener('DOMContentLoaded', () => {
    loadFileExplorer();

    // Close modals when clicking backdrop ONLY (not the dialogs)
    const backdrop = document.getElementById('modal-backdrop');
    backdrop.addEventListener('click', (e) => {
        // Only close if the background itself was clicked
        if (e.target === backdrop) {
            hideModals();
        }
    });

    // Prevent clicks inside any modal-dialog from bubbling up to the backdrop
    document.querySelectorAll('.modal-dialog').forEach(modal => {
        modal.addEventListener('click', (e) => {
            e.stopPropagation();
        });
    });
  });
</script>

