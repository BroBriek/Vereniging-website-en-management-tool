<%- include('../partials/header') %>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h1>
                Inschrijvingen 
                <span class="text-muted fs-4">
                    <% if (selectedPeriod === 'all') { %>
                        (Alles)
                    <% } else { %>
                        (<%= selectedPeriod %>)
                    <% } %>
                </span>
            </h1>
        </div>

        <!-- Search Bar -->
        <form action="/admin/registrations" method="GET" class="d-flex flex-grow-1 mx-4" style="max-width: 400px;">
            <input type="hidden" name="period" value="<%= selectedPeriod %>">
            <div class="input-group">
                <input type="text" name="search" class="form-control" placeholder="Zoek op naam, email..." value="<%= searchQuery %>">
                <% if (searchQuery) { %>
                    <a href="/admin/registrations?period=<%= selectedPeriod %>" class="btn btn-outline-secondary" title="Zoekopdracht wissen"><i class="bi bi-x-lg"></i></a>
                <% } %>
                <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
            </div>
        </form>

        <div>
            <div class="btn-group me-2">
                <button type="button" class="btn btn-outline-danger dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-file-pdf"></i> PDF
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/admin/registrations/export-pdf?mode=current">Huidige Periode (<%= currentPeriod %>)</a></li>
                    <li><a class="dropdown-item" href="/admin/registrations/export-pdf?mode=all">Alles (Archief)</a></li>
                </ul>
            </div>

            <div class="btn-group me-2">
                <button type="button" class="btn btn-outline-success dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="bi bi-file-earmark-spreadsheet"></i> Excel
                </button>
                <ul class="dropdown-menu">
                    <li><a class="dropdown-item" href="/admin/registrations/export?mode=current">Huidige Periode (<%= currentPeriod %>)</a></li>
                    <li><a class="dropdown-item" href="/admin/registrations/export?mode=all">Alles (Archief)</a></li>
                </ul>
            </div>
            
            <% if (canEdit) { %>
            <form action="/admin/registrations/new-period" method="POST" class="d-inline" onsubmit="return confirm('Ben je zeker? Dit start een nieuwe inschrijvingsperiode. De huidige lijst wordt verborgen (maar niet verwijderd).');">
                <button type="submit" class="btn btn-warning" title="Start een nieuw werkjaar"><i class="bi bi-calendar-plus"></i> Nieuwe Periode</button>
            </form>
            <% } %>

            <a href="<%= user.role === 'admin' ? '/admin' : '/' %>" class="btn btn-secondary ms-2">Terug</a>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar: Period Archive -->
        <div class="col-md-2 mb-4">
            <div class="list-group">
                <div class="list-group-item bg-dark text-white">
                    <i class="bi bi-archive"></i> Archief
                </div>
                <a href="/admin/registrations?period=all" class="list-group-item list-group-item-action <%= selectedPeriod === 'all' ? 'active' : '' %>">
                    Alles Tonen
                </a>
                <% allPeriods.forEach(p => { %>
                    <a href="/admin/registrations?period=<%= p %>" class="list-group-item list-group-item-action <%= selectedPeriod === p ? 'active' : '' %> d-flex justify-content-between align-items-center">
                        <%= p %>
                        <% if (p === currentPeriod) { %>
                            <span class="badge bg-success rounded-pill" title="Huidige actieve periode">Actief</span>
                        <% } %>
                    </a>
                <% }) %>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-md-10">
            <!-- Desktop View: Table -->
            <div class="table-responsive bg-white rounded shadow-sm d-none d-lg-block">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <% 
                            const getSortLink = (field, label) => {
                                const nextDir = (sortField === field && sortDirection === 'ASC') ? 'DESC' : 'ASC';
                                let url = `/admin/registrations?period=${selectedPeriod}`;
                                if (searchQuery) url += `&search=${encodeURIComponent(searchQuery)}`;
                                url += `&sort=${field}&direction=${nextDir}`;
                                
                                let icon = '';
                                if (sortField === field) {
                                    icon = sortDirection === 'ASC' ? '<i class="bi bi-caret-down-fill"></i>' : '<i class="bi bi-caret-up-fill"></i>';
                                } else {
                                    icon = '<i class="bi bi-arrow-down-up text-white-50" style="font-size: 0.8em;"></i>';
                                }
                                
                                return `<a href="${url}" class="text-white text-decoration-none d-flex align-items-center gap-2">${label} ${icon}</a>`;
                            };
                        %>
                        <tr>
                            <th><%- getSortLink('group', 'Groep') %></th>
                            <th><%- getSortLink('type', 'Rol') %></th>
                            <th><%- getSortLink('name', 'Naam') %></th>
                            <% if (selectedPeriod === 'all') { %> <th><%- getSortLink('period', 'Jaar') %></th> <% } %>
                            <th><%- getSortLink('birthdate', 'Geboortedatum') %></th>
                            <th>Contact (Email/Tel)</th>
                            <th>Ouders / Extra</th>
                            <th>Medisch</th>
                            <% if (canEdit) { %>
                            <th>Actie</th>
                            <% } %>
                        </tr>
                    </thead>
                    <tbody>
                        <% registrations.forEach(reg => { %>
                            <tr>
                                <td><span class="badge bg-secondary"><%= reg.group %></span></td>
                                <td>
                                    <% if (reg.type === 'leiding') { %>
                                        <span class="badge bg-danger">Leiding</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Lid</span>
                                    <% } %>
                                </td>
                                <td><strong><%= reg.firstName %> <%= reg.lastName %></strong></td>
                                <% if (selectedPeriod === 'all') { %> 
                                    <td><span class="badge bg-light text-dark border"><%= reg.period %></span></td> 
                                <% } %>
                                <td><%= reg.birthdate %></td>
                                <td>
                                    <%= reg.email %><br>
                                    <small class="text-muted"><%= reg.type === 'lid' ? reg.parentsPhone : reg.phone %></small>
                                </td>
                                <td>
                                    <% if (reg.type === 'lid') { %>
                                        <small>Ouders: <%= reg.parentsNames %></small><br>
                                        <% if(reg.memberPhone) { %><small>GSM Lid: <%= reg.memberPhone %></small><br><% } %>
                                        <small>Foto's: <%= reg.photoPermission ? 'Ja' : 'Nee' %></small>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                                <td>
                                    <% if (reg.medicalInfo) { %>
                                        <span class="text-danger" title="<%= reg.medicalInfo %>"><i class="bi bi-exclamation-circle-fill"></i> Zie info</span>
                                    <% } else { %>
                                        <span class="text-muted">-</span>
                                    <% } %>
                                </td>
                                <% if (canEdit) { %>
                                <td>
                                    <div class="d-flex gap-2">
                                        <a href="/admin/registrations/<%= reg.id %>/edit" class="btn btn-sm btn-outline-primary" title="Bewerk"><i class="bi bi-pencil"></i></a>
                                        <form action="/admin/registrations/<%= reg.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Weet je zeker dat je deze inschrijving wilt verwijderen?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Verwijder"><i class="bi bi-trash"></i></button>
                                        </form>
                                    </div>
                                </td>
                                <% } %>
                            </tr>
                        <% }) %>
                        <% if (registrations.length === 0) { %>
                            <tr>
                                <td colspan="<%= selectedPeriod === 'all' ? 9 : 8 %>" class="text-center py-4">
                                    <div class="text-muted">
                                        <% if (searchQuery) { %>
                                            Geen resultaten gevonden voor "<%= searchQuery %>" in periode <%= selectedPeriod %>.
                                        <% } else { %>
                                            Nog geen inschrijvingen in deze periode.
                                        <% } %>
                                    </div>
                                </td>
                            </tr>
                        <% } %>
                    </tbody>
                </table>
            </div>

            <!-- Mobile View: Cards -->
            <div class="d-lg-none">
                <div class="mb-3 text-muted fst-italic text-end small">
                    <i class="bi bi-arrow-down-up"></i> Sorteren kan via desktop weergave
                </div>
                <% registrations.forEach(reg => { %>
                    <div class="card mb-3 shadow-sm border-0">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light text-dark border-bottom-0">
                            <div>
                                <h5 class="mb-0 text-primary"><%= reg.firstName %> <%= reg.lastName %></h5>
                            </div>
                            <span class="badge bg-secondary rounded-pill"><%= reg.group %></span>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Rol</small>
                                    <% if (reg.type === 'leiding') { %>
                                        <span class="badge bg-danger">Leiding</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Lid</span>
                                    <% } %>
                                </div>
                                <% if (selectedPeriod === 'all') { %>
                                <div class="col-6">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Jaar</small>
                                    <span class="badge bg-light text-dark border"><%= reg.period %></span>
                                </div>
                                <% } %>
                                <div class="col-6">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Geboortedatum</small>
                                    <span class="fw-bold"><%= reg.birthdate %></span>
                                </div>
                                
                                <div class="col-12 mt-3">
                                    <div class="bg-light p-2 rounded">
                                        <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.75rem;"><i class="bi bi-envelope"></i> Contact</small>
                                        <div class="d-flex flex-column">
                                            <span class="text-break"><%= reg.email %></span>
                                            <span class="fw-bold"><i class="bi bi-telephone"></i> <%= reg.type === 'lid' ? reg.parentsPhone : reg.phone %></span>
                                        </div>
                                    </div>
                                </div>

                                <% if (reg.type === 'lid') { %>
                                <div class="col-12 mt-2">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Ouders / Extra</small>
                                    <div><%= reg.parentsNames %></div>
                                    <% if(reg.memberPhone) { %><div class="small text-muted">GSM Lid: <%= reg.memberPhone %></div><% } %>
                                    <div class="small text-muted">Foto's: <%= reg.photoPermission ? 'Ja' : 'Nee' %></div>
                                </div>
                                <% } %>

                                <% if (reg.medicalInfo) { %>
                                <div class="col-12 mt-2">
                                    <div class="alert alert-danger p-2 mb-0 d-flex gap-2 align-items-start">
                                        <i class="bi bi-exclamation-circle-fill mt-1"></i>
                                        <small><%= reg.medicalInfo %></small>
                                    </div>
                                </div>
                                <% } %>
                            </div>

                            <% if (canEdit) { %>
                            <div class="mt-3 pt-2 border-top d-flex justify-content-end gap-2">
                                <a href="/admin/registrations/<%= reg.id %>/edit" class="btn btn-outline-primary btn-sm flex-grow-1">
                                    <i class="bi bi-pencil"></i> Bewerken
                                </a>
                                <form action="/admin/registrations/<%= reg.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Weet je zeker dat je deze inschrijving wilt verwijderen?');" class="flex-grow-1">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100">
                                        <i class="bi bi-trash"></i> Verwijderen
                                    </button>
                                </form>
                            </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>

                <% if (registrations.length === 0) { %>
                    <div class="alert alert-secondary text-center">
                        <% if (searchQuery) { %>
                            Geen resultaten gevonden voor "<%= searchQuery %>".
                        <% } else { %>
                            Nog geen inschrijvingen.
                        <% } %>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
