<%- include('../partials/header') %>

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h1 class="mb-0">
                Inschrijvingen 
                <span class="text-muted fs-4">
                    <% if (selectedPeriod === 'all') { %>
                        (Alles)
                    <% } else { %>
                        (<%= selectedPeriod %>)
                    <% } %>
                </span>
            </h1>
        </div>

        <div class="d-flex flex-grow-1 justify-content-end gap-3 flex-wrap align-items-center">
            <!-- Search & Sort Bar -->
            <div class="d-flex gap-2 flex-wrap align-items-center" style="max-width: 800px; flex: 1 1 300px;">
                <!-- Registration Counter -->
                <div class="bg-white px-3 py-1 rounded shadow-sm d-flex align-items-center gap-2 border-0 h-100" style="min-height: 38px;">
                    <i class="bi bi-people-fill text-primary"></i>
                    <div class="lh-1">
                        <span class="fw-bold d-block"><%= registrations.length %></span>
                        <small class="text-muted" style="font-size: 0.7rem;">leden</small>
                    </div>
                </div>

                <form action="/admin/registrations" method="GET" class="d-flex flex-grow-1">
                    <input type="hidden" name="period" value="<%= selectedPeriod %>">
                    <input type="hidden" name="sort" value="<%= sortField %>">
                    <input type="hidden" name="direction" value="<%= sortDirection %>">
                    <div class="input-group">
                        <input type="text" name="search" class="form-control shadow-sm border-0" placeholder="Zoek op naam, email..." value="<%= searchQuery %>">
                        <% if (searchQuery) { %>
                            <a href="/admin/registrations?period=<%= selectedPeriod %>&sort=<%= sortField %>&direction=<%= sortDirection %>" class="btn btn-white border-0 shadow-sm" title="Zoekopdracht wissen"><i class="bi bi-x-lg"></i></a>
                        <% } %>
                        <button class="btn btn-primary shadow-sm" type="submit"><i class="bi bi-search"></i></button>
                    </div>
                </form>

                <div class="dropdown">
                    <button class="btn btn-white shadow-sm border-0 dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-sort-alpha-down"></i> Sorteer
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><h6 class="dropdown-header">Sorteer op</h6></li>
                        <li><a class="dropdown-item <%= sortField === 'default' ? 'active' : '' %>" href="/admin/registrations?period=<%= selectedPeriod %>&search=<%= searchQuery %>&sort=default&direction=ASC">Standaard (Groep)</a></li>
                        <li><a class="dropdown-item <%= sortField === 'name' ? 'active' : '' %>" href="/admin/registrations?period=<%= selectedPeriod %>&search=<%= searchQuery %>&sort=name&direction=ASC">Naam (A-Z)</a></li>
                        <li><a class="dropdown-item <%= sortField === 'birthdate' ? 'active' : '' %>" href="/admin/registrations?period=<%= selectedPeriod %>&search=<%= searchQuery %>&sort=birthdate&direction=ASC">Leeftijd</a></li>
                        <li><a class="dropdown-item <%= sortField === 'type' ? 'active' : '' %>" href="/admin/registrations?period=<%= selectedPeriod %>&search=<%= searchQuery %>&sort=type&direction=ASC">Rol (Leiding eerst)</a></li>
                        <% if (selectedPeriod === 'all') { %>
                            <li><a class="dropdown-item <%= sortField === 'period' ? 'active' : '' %>" href="/admin/registrations?period=<%= selectedPeriod %>&search=<%= searchQuery %>&sort=period&direction=DESC">Jaar (Nieuwste eerst)</a></li>
                        <% } %>
                    </ul>
                </div>
            </div>

            <div class="d-flex gap-2">
                <div class="btn-group">
                    <button type="button" class="btn btn-outline-dark dropdown-toggle shadow-sm" data-bs-toggle="dropdown" aria-expanded="false">
                        <i class="bi bi-download"></i> Exporteren
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li><h6 class="dropdown-header"><i class="bi bi-file-pdf text-danger"></i> PDF Document</h6></li>
                        <li><a class="dropdown-item" href="/admin/registrations/export-pdf?mode=current">Huidige Periode (<%= currentPeriod %>)</a></li>
                        <li><a class="dropdown-item" href="/admin/registrations/export-pdf?mode=all">Alles (Archief)</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header"><i class="bi bi-file-earmark-spreadsheet text-success"></i> Excel Spreadsheet</h6></li>
                        <li><a class="dropdown-item" href="/admin/registrations/export?mode=current">Huidige Periode (<%= currentPeriod %>)</a></li>
                        <li><a class="dropdown-item" href="/admin/registrations/export?mode=all">Alles (Archief)</a></li>
                    </ul>
                </div>
                
                <% if (canEdit) { %>
                <!-- Registration Period Toggle -->
                <form action="/admin/registrations/toggle" method="POST" class="d-inline">
                    <input type="hidden" name="isOpen" value="<%= !isRegistrationOpen %>">
                    <button type="submit" class="btn btn-<%= isRegistrationOpen ? 'outline-danger' : 'outline-success' %> shadow-sm" title="<%= isRegistrationOpen ? 'Inschrijvingen Sluiten' : 'Inschrijvingen Openen' %>">
                        <i class="bi bi-<%= isRegistrationOpen ? 'lock' : 'unlock' %>"></i>
                        <span class="d-none d-sm-inline"><%= isRegistrationOpen ? 'Sluit Inschrijvingen' : 'Open Inschrijvingen' %></span>
                    </button>
                </form>

                <div class="btn-group shadow-sm">
                    <button type="button" class="btn btn-warning dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" title="Werkjaar beheer">
                        <i class="bi bi-calendar-range"></i> Werkjaar
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                        <li>
                            <form action="/admin/registrations/new-period" method="POST" onsubmit="return confirm('Ben je zeker? Dit start een nieuwe inschrijvingsperiode. De huidige lijst wordt gearchiveerd en een nieuw leeg werkjaar wordt gestart.');">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-calendar-plus text-success"></i> Start Nieuw Werkjaar
                                </button>
                            </form>
                        </li>
                        <li>
                            <form action="/admin/registrations/delete-period" method="POST" onsubmit="return confirm('Ben je zeker dat je het laatste werkjaar wilt verwijderen? Dit kan enkel als er nog geen inschrijvingen zijn in dit jaar.');">
                                <button type="submit" class="dropdown-item">
                                    <i class="bi bi-calendar-minus text-danger"></i> Verwijder laatste werkjaar
                                </button>
                            </form>
                        </li>
                    </ul>
                </div>
                <% } %>

                <a href="<%= user.role === 'admin' ? '/admin' : '/' %>" class="btn btn-secondary shadow-sm">Terug</a>
            </div>
        </div>
    </div>

    <div class="row">
        <!-- Sidebar: Period Archive -->
        <div class="col-lg-2 col-md-4 mb-4">
            <div class="list-group shadow-sm border-0">
                <div class="list-group-item bg-dark text-white border-0 py-3">
                    <i class="bi bi-archive"></i> Archief
                </div>
                <a href="/admin/registrations?period=all" class="list-group-item list-group-item-action border-0 <%= selectedPeriod === 'all' ? 'active' : '' %>">
                    Alles Tonen
                </a>
                <% allPeriods.forEach(p => { %>
                    <a href="/admin/registrations?period=<%= p.period %>" class="list-group-item list-group-item-action border-0 <%= selectedPeriod === p.period ? 'active' : '' %> d-flex justify-content-between align-items-center">
                        <%= p.period %>
                        <% if (p.period === currentPeriod) { %>
                            <span class="badge bg-success rounded-pill" title="Huidige actieve periode" style="font-size: 0.6rem;">Actief</span>
                        <% } %>
                    </a>
                <% }) %>
            </div>
        </div>

        <!-- Main Content -->
        <div class="col-lg-10 col-md-8">
            <!-- Desktop View: Vertical List of Cards -->
            <div class="d-none d-lg-block">
                <% registrations.forEach(reg => { %>
                    <div class="card mb-3 shadow-sm border-0 overflow-hidden">
                        <div class="card-body p-0">
                            <div class="row g-0 align-items-center">
                                <!-- Status Color Strip -->
                                <div class="col-auto" style="width: 6px; align-self: stretch; background-color: <%= reg.type === 'leiding' ? '#dc3545' : '#198754' %>;"></div>
                                
                                <div class="col p-3">
                                    <div class="row align-items-center">
                                        <div class="col-3">
                                            <h5 class="mb-0 text-primary fw-bold"><%= reg.firstName %> <%= reg.lastName %></h5>
                                            <div class="mt-1">
                                                <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle"><%= reg.group %></span>
                                                <% if (selectedPeriod === 'all') { %>
                                                    <span class="badge bg-info-subtle text-info border border-info-subtle"><%= reg.period %></span>
                                                <% } %>
                                            </div>
                                        </div>
                                        
                                        <div class="col-2 border-start ps-4">
                                            <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Geboortedatum</small>
                                            <span class="fw-bold"><%= reg.birthdate %></span>
                                            <small class="text-muted d-block">(<%= new Date().getFullYear() - new Date(reg.birthdate).getFullYear() %>j)</small>
                                        </div>

                                        <div class="col-3 border-start ps-4">
                                            <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Contact Lid</small>
                                            <% if (reg.type === 'leiding') { %>
                                                <div class="text-break mb-1" title="<%= reg.email %>"><i class="bi bi-envelope text-muted me-2"></i><%= reg.email %></div>
                                                <div class="fw-bold"><i class="bi bi-telephone text-muted me-2"></i><%= reg.phone %></div>
                                            <% } else { %>
                                                <% if (reg.memberPhone) { %>
                                                    <div class="fw-bold"><i class="bi bi-telephone text-muted me-2"></i><%= reg.memberPhone %></div>
                                                <% } else { %>
                                                    <span class="text-muted small">Geen GSM</span>
                                                <% } %>
                                            <% } %>
                                        </div>

                                        <div class="col-2 border-start ps-4">
                                            <% if (reg.type === 'lid') { %>
                                                <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.7rem; letter-spacing: 0.5px;">Ouders / Contact</small>
                                                <div class="small text-truncate" title="<%= reg.parentsNames %>"><strong><%= reg.parentsNames %></strong></div>
                                                <div class="small"><i class="bi bi-telephone text-muted me-1"></i><%= reg.parentsPhone %></div>
                                                <div class="small text-truncate" title="<%= reg.email %>"><i class="bi bi-envelope text-muted me-1"></i><%= reg.email %></div>
                                            <% } else { %>
                                                <span class="badge bg-danger">Leiding</span>
                                            <% } %>
                                        </div>

                                        <div class="col-2 text-end pe-4">
                                            <div class="d-flex gap-2 justify-content-end align-items-center">
                                                <% if (reg.medicalInfo) { %>
                                                    <button type="button" 
                                                            class="btn btn-sm btn-warning shadow-sm border-0 d-flex align-items-center gap-2 px-2" 
                                                            title="Medische/Extra Info"
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#infoModal" 
                                                            data-info="<%= reg.medicalInfo %>"
                                                            data-name="<%= reg.firstName %> <%= reg.lastName %>">
                                                        <i class="bi bi-heart-pulse-fill"></i>
                                                        <span class="d-none d-xl-inline small fw-bold">Medisch</span>
                                                    </button>
                                                <% } %>

                                                <% if (canEdit) { %>
                                                <a href="/admin/registrations/<%= reg.id %>/edit" class="btn btn-sm btn-outline-primary" title="Bewerk"><i class="bi bi-pencil"></i></a>
                                                <form action="/admin/registrations/<%= reg.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Weet je zeker dat je deze inschrijving wilt verwijderen?');">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Verwijder"><i class="bi bi-trash"></i></button>
                                                </form>
                                                <% } %>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Mobile View: Existing Card Style -->
            <div class="d-lg-none">
                <% registrations.forEach(reg => { %>
                    <div class="card mb-3 shadow-sm border-0">
                        <div class="card-header d-flex justify-content-between align-items-center bg-light text-dark border-bottom-0">
                            <div>
                                <h5 class="mb-0 text-primary fw-bold"><%= reg.firstName %> <%= reg.lastName %></h5>
                            </div>
                            <div class="d-flex align-items-center gap-2">
                                <% if (reg.medicalInfo) { %>
                                    <button type="button" 
                                            class="btn btn-sm btn-warning shadow-sm border-0 d-flex align-items-center gap-2 px-2 py-1" 
                                            data-bs-toggle="modal" 
                                            data-bs-target="#infoModal" 
                                            data-info="<%= reg.medicalInfo %>"
                                            data-name="<%= reg.firstName %> <%= reg.lastName %>">
                                        <i class="bi bi-heart-pulse-fill"></i>
                                        <span class="small fw-bold">Medisch</span>
                                    </button>
                                <% } %>
                                <span class="badge bg-secondary rounded-pill"><%= reg.group %></span>
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Rol</small>
                                    <% if (reg.type === 'leiding') { %>
                                        <span class="badge bg-danger">Leiding</span>
                                    <% } else { %>
                                        <span class="badge bg-success">Lid</span>
                                    <% } %>
                                </div>
                                <% if (selectedPeriod === 'all') { %>
                                <div class="col-6">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Jaar</small>
                                    <span class="badge bg-light text-dark border"><%= reg.period %></span>
                                </div>
                                <% } %>
                                <div class="col-6">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Geboortedatum</small>
                                    <span class="fw-bold"><%= reg.birthdate %></span>
                                </div>
                                
                                <div class="col-12 mt-3">
                                    <div class="bg-light p-2 rounded">
                                        <small class="text-muted d-block text-uppercase mb-1" style="font-size: 0.75rem;"><i class="bi bi-envelope"></i> Contact <%= reg.type === 'lid' ? 'Lid' : '' %></small>
                                        <div class="d-flex flex-column">
                                            <% if (reg.type === 'leiding') { %>
                                                <span class="text-break small"><%= reg.email %></span>
                                                <span class="fw-bold"><i class="bi bi-telephone"></i> <%= reg.phone %></span>
                                            <% } else { %>
                                                <% if (reg.memberPhone) { %>
                                                    <span class="fw-bold"><i class="bi bi-telephone"></i> <%= reg.memberPhone %></span>
                                                <% } else { %>
                                                    <span class="text-muted small">Geen GSM Lid</span>
                                                <% } %>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <% if (reg.type === 'lid') { %>
                                <div class="col-12 mt-2">
                                    <small class="text-muted d-block text-uppercase" style="font-size: 0.75rem;">Ouders / Contact</small>
                                    <div class="small fw-bold"><%= reg.parentsNames %></div>
                                    <div class="small"><i class="bi bi-telephone text-muted me-1"></i><%= reg.parentsPhone %></div>
                                    <div class="small"><i class="bi bi-envelope text-muted me-1"></i><%= reg.email %></div>
                                    <div class="small text-muted mt-1">Foto's: <%= reg.photoPermission ? 'Ja' : 'Nee' %></div>
                                </div>
                                <% } %>
                            </div>

                            <% if (canEdit) { %>
                            <div class="mt-3 pt-2 border-top d-flex justify-content-end gap-2">
                                <a href="/admin/registrations/<%= reg.id %>/edit" class="btn btn-outline-primary btn-sm flex-grow-1 shadow-sm">
                                    <i class="bi bi-pencil"></i> Bewerken
                                </a>
                                <form action="/admin/registrations/<%= reg.id %>?_method=DELETE" method="POST" onsubmit="return confirm('Weet je zeker dat je deze inschrijving wilt verwijderen?');" class="flex-grow-1">
                                    <button type="submit" class="btn btn-outline-danger btn-sm w-100 shadow-sm">
                                        <i class="bi bi-trash"></i> Verwijderen
                                    </button>
                                </form>
                            </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>

            <% if (registrations.length === 0) { %>
                <div class="bg-white rounded shadow-sm p-5 text-center mt-3">
                    <i class="bi bi-person-x display-4 text-muted mb-3 d-block"></i>
                    <h5 class="text-muted">
                        <% if (searchQuery) { %>
                            Geen resultaten gevonden voor "<%= searchQuery %>".
                        <% } else { %>
                            Nog geen inschrijvingen gevonden in deze periode.
                        <% } %>
                    </h5>
                    <a href="/admin/registrations?period=<%= selectedPeriod %>" class="btn btn-link">Wis alle filters</a>
                </div>
            <% } %>
        </div>
    </div>
</div>

<!-- Info Modal -->
<div class="modal fade" id="infoModal" tabindex="-1" aria-labelledby="infoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-warning text-dark border-0">
                <h5 class="modal-title fw-bold" id="infoModalLabel">Medische / Extra Info</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <h6 class="text-muted mb-3" id="infoModalName"></h6>
                <div id="infoModalContent" class="p-3 bg-light rounded shadow-sm border-start border-warning border-4" style="white-space: pre-wrap;"></div>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function() {
        const infoModalElement = document.getElementById('infoModal');
        if (infoModalElement) {
            infoModalElement.addEventListener('show.bs.modal', function(event) {
                const button = event.relatedTarget;
                const info = button.getAttribute('data-info');
                const name = button.getAttribute('data-name');
                
                const modalTitleName = infoModalElement.querySelector('#infoModalName');
                const modalBodyContent = infoModalElement.querySelector('#infoModalContent');
                
                modalTitleName.textContent = name;
                modalBodyContent.textContent = info;
            });
        }
    });
</script>

<%- include('../partials/footer') %>
