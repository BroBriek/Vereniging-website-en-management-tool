<%- include('../partials/header') %>
<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <h1 class="mb-0">Bewerk Pagina: <%= slug %></h1>
    <div class="d-flex gap-2 w-100 w-sm-auto justify-content-start justify-content-sm-end flex-wrap">
        <a href="/admin/info" class="btn btn-info text-white rounded-pill px-3" title="Algemene Hulp & Info">
            <i class="bi bi-info-circle me-1"></i> Info
        </a>
        <% if (slug === 'register') { %>
            <a href="/admin/registrations" class="btn btn-primary rounded-pill px-3" title="Ledenlijst & Inschrijvingen">
                <i class="bi bi-people-fill me-1"></i> Inschrijvingen / Ledenlijst
            </a>
        <% } %>
        <a href="/admin" class="btn btn-secondary rounded-pill px-3">Terug</a>
    </div>
</div>

<form action="/admin/page/<%= slug %>" method="POST" enctype="multipart/form-data">
    <% if (slug === 'home') { %>
        <div class="alert alert-primary d-flex flex-wrap justify-content-between align-items-center gap-3 rounded-4 mb-4 shadow-sm border-0" style="background: linear-gradient(135deg, #e0f2fe 0%, #ede9fe 100%);">
            <div>
                <h5 class="fw-bold mb-1 text-primary"><i class="bi bi-magic me-2"></i>Nieuw: Intuïtieve Visuele Bewerker!</h5>
                <p class="mb-0 text-muted small">Klik direct op teksten en foto's op de hoofdpagina om ze aan te passen zonder formulieren.</p>
            </div>
            <a href="/home?edit=1" class="btn btn-primary rounded-pill px-4 shadow-sm fw-bold">
                <i class="bi bi-pencil-square me-1"></i> Open Visuele Bewerker
            </a>
        </div>
        <div class="row g-4 mb-4">
            <!-- Left Column: Hero & Intro -->
            <div class="col-lg-7">
                <!-- Section 1: Hero Banner -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-image me-2"></i>Hero Banner & Welkomsttekst
                        </h4>
                        <p class="text-muted small mb-0 mt-1">De grote hoofdbanner bovenaan de startpagina in avontuur-stijl.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3 card p-3 bg-light border-0 rounded-3">
                            <label class="form-label fw-bold">Huidige Hero Afbeelding</label>
                            <% if (contentMap.hero_image && contentMap.hero_image.content) { %>
                                <div class="mb-2">
                                    <img src="<%= contentMap.hero_image.content %>" alt="Current Hero" class="img-fluid rounded-3 shadow-sm" style="max-height: 180px;">
                                </div>
                            <% } else { %>
                                <p class="text-muted small mb-2">Standaard afbeelding wordt getoond.</p>
                            <% } %>
                            <label class="form-label small fw-bold">Nieuwe banner uploaden</label>
                            <input type="file" class="form-control" name="image" accept="image/*">
                            <input type="hidden" name="image_key" value="hero_image">
                            <label class="form-label small text-muted mt-2 mb-1">Of afbeeldingslink / URL</label>
                            <input type="text" class="form-control form-control-sm" name="hero_image_url" value="<%= contentMap.hero_image ? contentMap.hero_image.content : '' %>" placeholder="bijv. /uploads/... of https://...">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hero Badge (Tape-labeltje boven de titel)</label>
                            <input type="text" class="form-control" name="hero_badge" value="<%= contentMap.hero_badge ? contentMap.hero_badge.content : '📍 Zondag = Chirodag • Meeuwen' %>" placeholder="📍 Zondag = Chirodag • Meeuwen">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hoofdtitel</label>
                            <input type="text" class="form-control" name="hero_title" value="<%= contentMap.hero_title ? contentMap.hero_title.content : '' %>" placeholder="Welkom bij Chiro Meeuwen">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Ondertitel</label>
                            <input type="text" class="form-control" name="hero_text" value="<%= contentMap.hero_text ? contentMap.hero_text.content : '' %>" placeholder="Samen spelen, samen leven.">
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-bold">Hoofdfoto Bijschrift (Handschrift onder de centrale foto)</label>
                            <input type="text" class="form-control" name="hero_photo_caption" value="<%= contentMap.hero_photo_caption ? contentMap.hero_photo_caption.content : 'Welkom bij onze Chiro-bende! ⛺' %>" placeholder="Welkom bij onze Chiro-bende! ⛺">
                        </div>

                        <div class="row g-2">
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Knop 1 Tekst</label>
                                <input type="text" class="form-control form-control-sm" name="hero_btn1_text" value="<%= contentMap.hero_btn1_text ? contentMap.hero_btn1_text.content : 'Word lid / Inschrijven' %>">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Knop 1 Link</label>
                                <input type="text" class="form-control form-control-sm" name="hero_btn1_url" value="<%= contentMap.hero_btn1_url ? contentMap.hero_btn1_url.content : '/inschrijven' %>">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Knop 2 Tekst</label>
                                <input type="text" class="form-control form-control-sm" name="hero_btn2_text" value="<%= contentMap.hero_btn2_text ? contentMap.hero_btn2_text.content : 'Ontdek Ons Logboek' %>">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label fw-bold small">Knop 2 Link</label>
                                <input type="text" class="form-control form-control-sm" name="hero_btn2_url" value="<%= contentMap.hero_btn2_url ? contentMap.hero_btn2_url.content : '#logboek' %>">
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Logboek & Reisverslag (Intro) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-success">
                            <i class="bi bi-journal-bookmark me-2"></i>Chiro Logboek / Reisverslag (Intro)
                        </h4>
                        <p class="text-muted small mb-0 mt-1">Het centrale reisverslag met plakband en notitieboek-styling op de startpagina.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-3">
                            <label class="form-label fw-bold">Logboek Badge / Datumstempel</label>
                            <input type="text" class="form-control" name="logbook_badge" value="<%= contentMap.logbook_badge ? contentMap.logbook_badge.content : '📖 Reisverslag • Elke Zondag Avontuur' %>">
                        </div>
                        <div class="mb-3">
                            <label class="form-label fw-bold">Logboek Titel</label>
                            <input type="text" class="form-control" name="logbook_title" value="<%= contentMap.logbook_title ? contentMap.logbook_title.content : 'Uit Ons Chiro Logboek' %>">
                        </div>
                        <div class="mb-2">
                            <label class="form-label fw-bold">Inhoud (HTML & Rijke tekstbewerker)</label>
                            <textarea class="form-control rich-editor" name="intro" rows="8"><%= contentMap.intro ? contentMap.intro.content : '' %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Reispaspoort Statistieken -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-warning">
                            <i class="bi bi-card-checklist me-2"></i>Reispaspoort (Cijfers & Feiten)
                        </h4>
                        <p class="text-muted small mb-0 mt-1">4 speelse stempel-badges met cijfers over onze werking.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3">
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-bold">Cijfer 1</label>
                                <input type="text" class="form-control form-control-sm" name="stat_1_num" value="<%= contentMap.stat_1_num ? contentMap.stat_1_num.content : '170+' %>">
                                <label class="form-label small text-muted mt-1">Label 1</label>
                                <input type="text" class="form-control form-control-sm" name="stat_1_lbl" value="<%= contentMap.stat_1_lbl ? contentMap.stat_1_lbl.content : 'Enthousiaste leden' %>">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-bold">Cijfer 2</label>
                                <input type="text" class="form-control form-control-sm" name="stat_2_num" value="<%= contentMap.stat_2_num ? contentMap.stat_2_num.content : '26' %>">
                                <label class="form-label small text-muted mt-1">Label 2</label>
                                <input type="text" class="form-control form-control-sm" name="stat_2_lbl" value="<%= contentMap.stat_2_lbl ? contentMap.stat_2_lbl.content : 'Gemotiveerde leiding' %>">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-bold">Cijfer 3</label>
                                <input type="text" class="form-control form-control-sm" name="stat_3_num" value="<%= contentMap.stat_3_num ? contentMap.stat_3_num.content : '6' %>">
                                <label class="form-label small text-muted mt-1">Label 3</label>
                                <input type="text" class="form-control form-control-sm" name="stat_3_lbl" value="<%= contentMap.stat_3_lbl ? contentMap.stat_3_lbl.content : 'Leeftijdsgroepen' %>">
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label small fw-bold">Cijfer 4</label>
                                <input type="text" class="form-control form-control-sm" name="stat_4_num" value="<%= contentMap.stat_4_num ? contentMap.stat_4_num.content : '10' %>">
                                <label class="form-label small text-muted mt-1">Label 4</label>
                                <input type="text" class="form-control form-control-sm" name="stat_4_lbl" value="<%= contentMap.stat_4_lbl ? contentMap.stat_4_lbl.content : 'Dagen zomerkamp' %>">
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Polaroid Scrapbook Photos -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-danger">
                            <i class="bi bi-camera me-2"></i>Scrapbook Kiekjes (Polaroids met Tape)
                        </h4>
                        <p class="text-muted small mb-0 mt-1">Foto's die met tape en speelse hoekjes als polaroids op de homepagina getoond worden.</p>
                    </div>
                    <div class="card-body p-4">
                        <% 
                        const defaultPolaroids = [
                            { cap: 'Samen op avontuur! ⛺', tag: 'Zomerkamp & Weekends' },
                            { cap: 'Elke zondag ravotten 🌲', tag: 'Zondagmiddag 14u-17u' },
                            { cap: 'Vriendschap voor het leven ✨', tag: 'Onze Chiro-bende' },
                            { cap: 'Klaar voor de leiding! 🔥', tag: 'Leidingsploeg' }
                        ];
                        for (let i = 1; i <= 4; i++) { 
                            const def = defaultPolaroids[i - 1] || { cap: '', tag: '' };
                            const imgKey = 'polaroid_img_' + i;
                            const capKey = 'polaroid_cap_' + i;
                            const tagKey = 'polaroid_tag_' + i;
                        %>
                            <div class="border rounded-3 p-3 mb-3 bg-light">
                                <h6 class="fw-bold text-dark mb-2">📸 Polaroid <%= i %></h6>
                                <div class="mb-2">
                                    <% if (contentMap[imgKey] && contentMap[imgKey].content) { %>
                                        <div class="mb-2">
                                            <img src="<%= contentMap[imgKey].content %>" alt="Polaroid <%= i %>" class="img-fluid rounded shadow-sm" style="max-height: 90px;">
                                        </div>
                                    <% } %>
                                    <label class="form-label small fw-bold">Nieuwe foto uploaden</label>
                                    <input type="file" class="form-control form-control-sm mb-2" name="polaroid_img_<%= i %>" accept="image/*">
                                    <label class="form-label small text-muted">Of foto URL / pad</label>
                                    <input type="text" class="form-control form-control-sm" name="polaroid_img_<%= i %>_url" value="<%= contentMap[imgKey] ? contentMap[imgKey].content : '' %>" placeholder="bijv. /uploads/... of https://...">
                                </div>
                                <div class="mb-2">
                                    <label class="form-label small fw-bold">Bijschrift (Handschrift)</label>
                                    <input type="text" class="form-control form-control-sm" name="<%= capKey %>" value="<%= contentMap[capKey] ? contentMap[capKey].content : def.cap %>" placeholder="Handschrift tekst">
                                </div>
                                <div class="mb-0">
                                    <label class="form-label small fw-bold">Klein labeltje / Thema</label>
                                    <input type="text" class="form-control form-control-sm" name="<%= tagKey %>" value="<%= contentMap[tagKey] ? contentMap[tagKey].content : def.tag %>" placeholder="Thema of locatie">
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    <% } else if (slug === 'register') { %>
        <div class="row g-4 mb-4">
            <!-- Left Column: Form Content, Success Screen, and Email Template -->
            <div class="col-lg-8">
                <!-- Section 1: Inschrijvingspagina (Formulier) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-file-earmark-text me-2"></i>Inschrijvingspagina Teksten
                        </h4>
                        <p class="text-muted small mb-0 mt-1">Teksten die getoond worden op de inschrijvingspagina vóór het invullen van het formulier.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label class="form-label fw-bold">Tekst boven het inschrijvingsformulier</label>
                            <div class="form-text text-muted mb-2">Introductietekst of belangrijke informatie bovenaan de pagina.</div>
                            <textarea class="form-control rich-editor" name="top_text" rows="5"><%= contentMap.top_text ? contentMap.top_text.content : '' %></textarea>
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold">Belangrijke info (Onderaan het formulier)</label>
                            <div class="form-text text-muted mb-2">Informatie over lidgeld, bankrekeningnummer, afspraken, etc. Laat leeg om dit blok te verbergen op de inschrijvingspagina.</div>
                            <textarea class="form-control rich-editor" name="info_text" rows="8"><%= contentMap.info_text ? contentMap.info_text.content : '' %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Successcherm (Na Inschrijving) -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-success">
                            <i class="bi bi-check2-circle me-2"></i>Successcherm (Na Inschrijving)
                        </h4>
                        <p class="text-muted small mb-0 mt-1">Deze tekst wordt op het scherm getoond nadat een gebruiker de inschrijving succesvol heeft voltooid.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-2">
                            <label class="form-label fw-bold">Successcherm Bericht (HTML / Rich Text)</label>
                            <div class="form-text text-muted mb-2">Gebruik de rijke tekstbewerker om het bericht vorm te geven. Dynamische variabelen (zie hiernaast) worden automatisch ingevuld.</div>
                            <textarea class="form-control rich-editor" name="success_text" rows="8"><%= contentMap.success_text ? contentMap.success_text.content : '' %></textarea>
                        </div>
                    </div>
                </div>

                <!-- Section 3: Automatische Bevestigingsmail -->
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                        <h4 class="fw-bold mb-0 text-warning">
                            <i class="bi bi-envelope-paper me-2"></i>Automatische Bevestigingsmail
                        </h4>
                        <p class="text-muted small mb-0 mt-1">Stel het onderwerp en de inhoud in van de e-mail die automatisch wordt verstuurd naar het opgegeven e-mailadres.</p>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label for="email_subject" class="form-label fw-bold">Onderwerp E-mail</label>
                            <input type="text" class="form-control" id="email_subject" name="email_subject" value="<%= contentMap.email_subject ? contentMap.email_subject.content : ('Inschrijving ontvangen - ' + (typeof orgFullName !== 'undefined' && orgFullName ? orgFullName : (process.env.ORG_FULL_NAME || 'Chiro Vreugdeland Meeuwen'))) %>" placeholder="Inschrijving ontvangen - <%= typeof orgFullName !== 'undefined' && orgFullName ? orgFullName : (process.env.ORG_FULL_NAME || 'Chiro Vreugdeland Meeuwen') %>">
                        </div>

                        <div class="mb-2">
                            <label class="form-label fw-bold">Inhoud E-mail (HTML / Rich Text)</label>
                            <div class="form-text text-muted mb-2">De inhoud van de bevestigingsmail. Ook hier werken dynamische variabelen zoals {voornaam}, {groep}, etc.</div>
                            <textarea class="form-control rich-editor" name="email_text" rows="10"><%= contentMap.email_text ? contentMap.email_text.content : '' %></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Dynamic Variables Guide -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4 position-sticky" style="top: 20px;">
                    <div class="card-header bg-primary text-white border-0 py-3 px-4 rounded-top-4">
                        <h5 class="fw-bold mb-0"><i class="bi bi-code-slash me-2"></i>Dynamische Variabelen</h5>
                    </div>
                    <div class="card-body p-4">
                        <p class="small text-muted mb-3">
                            Neem deze variabelen op in het successcherm of het e-mailbericht. Ze worden bij elke inschrijving automatisch vervangen:
                        </p>

                        <div class="list-group list-group-flush small">
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{voornaam}</code>
                                <span class="text-muted">Voornaam</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{achternaam}</code>
                                <span class="text-muted">Achternaam</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{naam}</code>
                                <span class="text-muted">Volledige naam</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{groep}</code>
                                <span class="text-muted">Ribbels, Rakwi, etc.</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{type}</code>
                                <span class="text-muted">Lid of Leiding</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{email}</code>
                                <span class="text-muted">E-mailadres</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{ouders_naam}</code>
                                <span class="text-muted">Namen Ouders/Voogd</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{ouders_telefoon}</code>
                                <span class="text-muted">Telefoon Ouders</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{lid_telefoon}</code>
                                <span class="text-muted">GSM Lid</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{betaalmethode}</code>
                                <span class="text-muted">Betaalmethode</span>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-center px-0 py-2">
                                <code>{datum}</code>
                                <span class="text-muted">Datum inschrijving</span>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 rounded-3 mt-4 mb-0 small">
                            <i class="bi bi-lightbulb-fill text-info me-1"></i>
                            <strong>Tip:</strong> Als een tekstveld leeg gelaten wordt, wordt er een standaardtekst gebruikt.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex justify-content-end mb-5">
            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow">
                <i class="bi bi-check-lg me-2"></i>Pagina Teksten Opslaan
            </button>
        </div>
</form>

        <!-- Section 4: Formulier Velden Aanpassen -->
        <% if (formConfig) { %>
        <form action="/admin/register-form-config" method="POST" id="formConfigForm">
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h4 class="fw-bold mb-0" style="color: var(--chiro-primary, #db3e41);">
                        <i class="bi bi-sliders me-2"></i>Formulier Velden Aanpassen
                    </h4>
                    <p class="text-muted small mb-0 mt-1">Pas de labels, placeholders en teksten aan van alle velden in het inschrijvingsformulier. De standaardwaarden worden getoond als voorbeeld.</p>
                </div>
                <div class="card-body p-4">

                    <!-- Rolkeuze -->
                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2"><i class="bi bi-person-check me-1"></i> Rolkeuze</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Label boven rolkeuze</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="roleLabel" value="<%= formConfig.labels.roleLabel %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Optie "Lid"</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="roleLid" value="<%= formConfig.labels.roleLid %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Optie "Leiding"</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="roleLeiding" value="<%= formConfig.labels.roleLeiding %>">
                        </div>
                    </div>

                    <!-- Persoonsgegevens -->
                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2"><i class="bi bi-person me-1"></i> Persoonsgegevens</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Label voornaam</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="firstName" value="<%= formConfig.labels.firstName %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Placeholder voornaam</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="firstNamePlaceholder" value="<%= formConfig.labels.firstNamePlaceholder %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Label achternaam</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="lastName" value="<%= formConfig.labels.lastName %>">
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Placeholder achternaam</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="lastNamePlaceholder" value="<%= formConfig.labels.lastNamePlaceholder %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Label geboortedatum</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="birthdate" value="<%= formConfig.labels.birthdate %>">
                        </div>
                    </div>

                    <!-- Contactgegevens -->
                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2"><i class="bi bi-telephone me-1"></i> Contactgegevens</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Email label (lid)</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="emailLid" value="<%= formConfig.labels.emailLid %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Email label (leiding)</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="emailLeiding" value="<%= formConfig.labels.emailLeiding %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Email placeholder</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="emailPlaceholder" value="<%= formConfig.labels.emailPlaceholder %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Telefoon label (lid)</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="phoneLid" value="<%= formConfig.labels.phoneLid %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Telefoon label (leiding)</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="phoneLeiding" value="<%= formConfig.labels.phoneLeiding %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Telefoon placeholder</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="phonePlaceholder" value="<%= formConfig.labels.phonePlaceholder %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">2e Email label (lid)</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="secondEmailLid" value="<%= formConfig.labels.secondEmailLid || 'Tweede Email Ouders (Optioneel)' %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">2e Email placeholder</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="secondEmailPlaceholder" value="<%= formConfig.labels.secondEmailPlaceholder || 'tweede-ouder@voorbeeld.be' %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">2e Telefoon label (lid)</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="secondPhoneLid" value="<%= formConfig.labels.secondPhoneLid || 'Tweede Telefoon Ouders (Optioneel)' %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">2e Telefoon placeholder</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="secondPhonePlaceholder" value="<%= formConfig.labels.secondPhonePlaceholder || '0470 00 00 00' %>">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold">Knop 2e ouder toevoegen</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="addSecondParentBtn" value="<%= formConfig.labels.addSecondParentBtn || '+ Tweede ouder / contactpersoon toevoegen (optioneel)' %>">
                        </div>
                    </div>

                    <!-- Lid-specifieke velden -->
                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2"><i class="bi bi-people me-1"></i> Lid-specifieke velden</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Label namen ouders/voogd</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="parentsNames" value="<%= formConfig.labels.parentsNames %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Placeholder namen ouders</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="parentsNamesPlaceholder" value="<%= formConfig.labels.parentsNamesPlaceholder %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Label GSM lid</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="memberPhone" value="<%= formConfig.labels.memberPhone %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Placeholder GSM lid</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="memberPhonePlaceholder" value="<%= formConfig.labels.memberPhonePlaceholder %>">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Foto toestemming vraag</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="photoPermissionLabel" value="<%= formConfig.labels.photoPermissionLabel %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Optie "Ja"</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="photoYes" value="<%= formConfig.labels.photoYes %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Optie "Nee"</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="photoNo" value="<%= formConfig.labels.photoNo %>">
                        </div>
                    </div>

                    <!-- Groep & Betaling -->
                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2"><i class="bi bi-wallet2 me-1"></i> Groep & Betaling</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Label groepskeuze</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="groupLabel" value="<%= formConfig.labels.groupLabel %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Placeholder groepskeuze</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="groupPlaceholder" value="<%= formConfig.labels.groupPlaceholder %>">
                        </div>
                        <div class="col-md-12">
                            <label class="form-label small fw-bold">Label betaalvraag</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="paymentLabel" value="<%= formConfig.labels.paymentLabel %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Betaaloptie 1</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="paymentOption1" value="<%= formConfig.labels.paymentOption1 %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Betaaloptie 2</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="paymentOption2" value="<%= formConfig.labels.paymentOption2 %>">
                        </div>
                    </div>

                    <!-- Extra & Knop -->
                    <h6 class="fw-bold text-secondary mb-3 border-bottom pb-2"><i class="bi bi-chat-text me-1"></i> Extra & Knop</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Label extra info</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="medicalInfoLabel" value="<%= formConfig.labels.medicalInfoLabel %>">
                            <div class="form-text text-muted small">Laat dit veld leeg om het extra info veld te verbergen op de inschrijvingspagina.</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Placeholder extra info</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="medicalInfoPlaceholder" value="<%= formConfig.labels.medicalInfoPlaceholder %>">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Knop tekst</label>
                            <input type="text" class="form-control form-control-sm" data-label-key="submitButton" value="<%= formConfig.labels.submitButton %>">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Section 5: Extra Vragen -->
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-0 pt-4 px-4 pb-0">
                    <h4 class="fw-bold mb-0 text-info">
                        <i class="bi bi-plus-circle me-2"></i>Extra Vragen
                    </h4>
                    <p class="text-muted small mb-0 mt-1">Voeg extra vragen toe aan het inschrijvingsformulier. Deze verschijnen onderaan, vóór de privacy-checkbox.</p>
                </div>
                <div class="card-body p-4">
                    <div id="customQuestionsContainer">
                        <% if (formConfig.customQuestions && formConfig.customQuestions.length > 0) { %>
                            <% formConfig.customQuestions.forEach((q, idx) => { %>
                                <div class="custom-question-item card border rounded-3 p-3 mb-3" data-question-id="<%= q.id %>">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <span class="badge bg-info text-white">Vraag <span class="cq-number"><%= idx + 1 %></span></span>
                                        <button type="button" class="btn btn-sm btn-outline-danger border-0 remove-question-btn" title="Verwijder vraag">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-md-6">
                                            <label class="form-label small fw-bold">Vraag / Label</label>
                                            <input type="text" class="form-control form-control-sm cq-label" value="<%= q.label %>" placeholder="Bijv. Heb je nog bijzondere wensen?" required>
                                        </div>
                                        <div class="col-md-3">
                                            <label class="form-label small fw-bold">Type antwoord</label>
                                            <select class="form-select form-select-sm cq-type">
                                                <option value="text" <%= q.type === 'text' ? 'selected' : '' %>>Kort tekstveld</option>
                                                <option value="textarea" <%= q.type === 'textarea' ? 'selected' : '' %>>Lang tekstveld</option>
                                                <option value="radio" <%= q.type === 'radio' ? 'selected' : '' %>>Ja / Nee</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3 d-flex align-items-end gap-3">
                                            <div class="form-check">
                                                <input class="form-check-input cq-required" type="checkbox" id="cqReq<%= idx %>" <%= q.required ? 'checked' : '' %>>
                                                <label class="form-check-label small" for="cqReq<%= idx %>">Verplicht</label>
                                            </div>
                                        </div>
                                        <div class="col-md-6 cq-placeholder-wrapper" style="<%= q.type === 'radio' ? 'display:none' : '' %>">
                                            <label class="form-label small fw-bold">Placeholder</label>
                                            <input type="text" class="form-control form-control-sm cq-placeholder" value="<%= q.placeholder || '' %>" placeholder="Optioneel...">
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        <% } %>
                    </div>

                    <button type="button" class="btn btn-outline-info rounded-pill px-4" id="addQuestionBtn">
                        <i class="bi bi-plus-lg me-1"></i>Nieuwe Vraag Toevoegen
                    </button>

                    <div class="alert alert-light border rounded-3 mt-3 small">
                        <i class="bi bi-info-circle text-info me-1"></i>
                        Antwoorden op extra vragen worden opgeslagen bij de inschrijving en zijn zichtbaar in de inschrijvingsdetails en Excel-export.
                    </div>
                </div>
            </div>

            <input type="hidden" name="formConfigJson" id="formConfigJsonInput">

            <div class="mt-3 pt-3 border-top d-flex justify-content-end">
                <button type="submit" class="btn btn-info text-white btn-lg rounded-pill px-5 shadow" id="saveFormConfigBtn">
                    <i class="bi bi-sliders me-2"></i>Formulier Instellingen Opslaan
                </button>
            </div>
        </form>

        <script>
        (function() {
            const container = document.getElementById('customQuestionsContainer');
            const addBtn = document.getElementById('addQuestionBtn');
            const form = document.getElementById('formConfigForm');
            const jsonInput = document.getElementById('formConfigJsonInput');
            let questionCounter = container.querySelectorAll('.custom-question-item').length;

            function generateId() {
                return 'cq_' + Date.now() + '_' + Math.random().toString(36).substr(2, 5);
            }

            function renumberQuestions() {
                const items = container.querySelectorAll('.custom-question-item');
                items.forEach((item, idx) => {
                    const numSpan = item.querySelector('.cq-number');
                    if (numSpan) numSpan.textContent = idx + 1;
                });
            }

            function addQuestion(data) {
                questionCounter++;
                const id = (data && data.id) || generateId();
                const div = document.createElement('div');
                div.className = 'custom-question-item card border rounded-3 p-3 mb-3';
                div.dataset.questionId = id;
                const reqId = 'cqReqNew' + questionCounter;
                div.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge bg-info text-white">Vraag <span class="cq-number">${questionCounter}</span></span>
                        <button type="button" class="btn btn-sm btn-outline-danger border-0 remove-question-btn" title="Verwijder vraag">
                            <i class="bi bi-trash"></i>
                        </button>
                    </div>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold">Vraag / Label</label>
                            <input type="text" class="form-control form-control-sm cq-label" value="${data ? data.label : ''}" placeholder="Bijv. Heb je nog bijzondere wensen?" required>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold">Type antwoord</label>
                            <select class="form-select form-select-sm cq-type">
                                <option value="text" ${data && data.type === 'text' ? 'selected' : ''}>Kort tekstveld</option>
                                <option value="textarea" ${data && data.type === 'textarea' ? 'selected' : ''}>Lang tekstveld</option>
                                <option value="radio" ${data && data.type === 'radio' ? 'selected' : ''}>Ja / Nee</option>
                            </select>
                        </div>
                        <div class="col-md-3 d-flex align-items-end gap-3">
                            <div class="form-check">
                                <input class="form-check-input cq-required" type="checkbox" id="${reqId}" ${data && data.required ? 'checked' : ''}>
                                <label class="form-check-label small" for="${reqId}">Verplicht</label>
                            </div>
                        </div>
                        <div class="col-md-6 cq-placeholder-wrapper" style="${data && data.type === 'radio' ? 'display:none' : ''}">
                            <label class="form-label small fw-bold">Placeholder</label>
                            <input type="text" class="form-control form-control-sm cq-placeholder" value="${data ? (data.placeholder || '') : ''}" placeholder="Optioneel...">
                        </div>
                    </div>
                `;
                container.appendChild(div);
                bindQuestionEvents(div);
                renumberQuestions();
            }

            function bindQuestionEvents(item) {
                const removeBtn = item.querySelector('.remove-question-btn');
                if (removeBtn) {
                    removeBtn.addEventListener('click', function() {
                        if (confirm('Weet je zeker dat je deze vraag wilt verwijderen?')) {
                            item.remove();
                            renumberQuestions();
                        }
                    });
                }
                const typeSelect = item.querySelector('.cq-type');
                if (typeSelect) {
                    typeSelect.addEventListener('change', function() {
                        const placeholderWrapper = item.querySelector('.cq-placeholder-wrapper');
                        if (placeholderWrapper) {
                            placeholderWrapper.style.display = this.value === 'radio' ? 'none' : '';
                        }
                    });
                }
            }

            // Bind events on existing questions
            container.querySelectorAll('.custom-question-item').forEach(bindQuestionEvents);

            addBtn.addEventListener('click', function() {
                addQuestion(null);
            });

            // Before form submit, serialize config to JSON
            form.addEventListener('submit', function(e) {
                const labels = {};
                document.querySelectorAll('[data-label-key]').forEach(input => {
                    labels[input.dataset.labelKey] = input.value;
                });

                const customQuestions = [];
                container.querySelectorAll('.custom-question-item').forEach(item => {
                    const label = item.querySelector('.cq-label').value.trim();
                    if (!label) return; // skip empty
                    customQuestions.push({
                        id: item.dataset.questionId,
                        label: label,
                        type: item.querySelector('.cq-type').value,
                        required: item.querySelector('.cq-required').checked,
                        placeholder: (item.querySelector('.cq-placeholder') ? item.querySelector('.cq-placeholder').value.trim() : '')
                    });
                });

                const config = { labels, customQuestions };
                jsonInput.value = JSON.stringify(config);
            });
        })();
        </script>
        <% } %>
    <% } else { %>
        <div class="mb-3">
            <label class="form-label">Hoofdtekst (HTML toegestaan)</label>
            <textarea class="form-control rich-editor" name="main" rows="10"><%= contentMap.main ? contentMap.main.content : '' %></textarea>
        </div>
    <% } %>
    
    <% if (slug !== 'register') { %>
        <div class="mt-4 pt-3 border-top d-flex justify-content-end">
            <button type="submit" class="btn btn-success btn-lg rounded-pill px-5 shadow">
                <i class="bi bi-check-lg me-2"></i>Wijzigingen Opslaan
            </button>
        </div>
    </form>
    <% } %>
<%- include('../partials/footer') %>