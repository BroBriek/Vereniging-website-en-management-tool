<%- include('../partials/header') %>

<div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-3 mb-4">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
            <a href="/admin/users" class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-inline-flex align-items-center">
                <i class="bi bi-arrow-left me-1"></i> Terug naar Gebruikers
            </a>
            <a href="/admin/feedgroups" class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center">
                <i class="bi bi-chat-heart me-1"></i> Leidingshoekjes
            </a>
        </div>
        <h1 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Gebruiker Bewerken: <%= capitalizeName(target.username) %></h1>
    </div>
</div>

<% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4" role="alert">
        <div class="d-flex align-items-center">
            <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
            <div><%= error %></div>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Sluiten"></button>
    </div>
<% } %>

<div class="admin-edit-card shadow-lg rounded-4 position-relative overflow-hidden bg-white border mb-5">
    <span class="washi-tape washi-tape-red washi-tape-top-center"></span>
    <form action="/admin/users/<%= target.id %>?_method=PUT" method="POST">
        <div class="p-3 p-sm-4 pt-4">
            <!-- 1. Rol / Accounttype -->
            <div class="mb-3">
                <label class="form-label fw-bold text-dark small mb-2">Rol / Accounttype</label>
                <div class="row g-2" id="editUserRoleCards">
                    <div class="col-12 col-sm-6">
                        <label class="user-role-card d-flex align-items-start gap-2 p-2 p-sm-3 border rounded-3 h-100 w-100" style="cursor: pointer;">
                            <input type="radio" name="role" value="leader" class="form-check-input user-role-radio mt-1 flex-shrink-0" <%= (!target.role || target.role === 'leader') ? 'checked' : '' %>>
                            <div>
                                <div class="fw-bold text-dark small"><i class="bi bi-people-fill text-info me-1"></i>Leiding</div>
                                <div class="text-muted" style="font-size: 0.76rem; line-height: 1.3;">Standaard leidingsaccount voor leidingshoekjes, kalender en spelendatabank.</div>
                            </div>
                        </label>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="user-role-card d-flex align-items-start gap-2 p-2 p-sm-3 border rounded-3 h-100 w-100" style="cursor: pointer;">
                            <input type="radio" name="role" value="media" class="form-check-input user-role-radio mt-1 flex-shrink-0" <%= target.role === 'media' ? 'checked' : '' %>>
                            <div>
                                <div class="fw-bold text-dark small"><i class="bi bi-megaphone-fill text-primary me-1"></i>Media (Website & Formulieren)</div>
                                <div class="text-muted" style="font-size: 0.76rem; line-height: 1.3;">Leiding + beheer van publieke pagina's, leiding, kalender en formulieren.</div>
                            </div>
                        </label>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="user-role-card d-flex align-items-start gap-2 p-2 p-sm-3 border rounded-3 h-100 w-100" style="cursor: pointer;">
                            <input type="radio" name="role" value="admin" class="form-check-input user-role-radio mt-1 flex-shrink-0" <%= target.role === 'admin' ? 'checked' : '' %>>
                            <div>
                                <div class="fw-bold text-dark small"><i class="bi bi-shield-lock-fill text-danger me-1"></i>Administrator</div>
                                <div class="text-muted" style="font-size: 0.76rem; line-height: 1.3;">Volledige toegang tot alle beheerfuncties, inschrijvingen, financiën en instellingen.</div>
                            </div>
                        </label>
                    </div>
                    <div class="col-12 col-sm-6">
                        <label class="user-role-card user-role-card-kookmoeke d-flex align-items-start gap-2 p-2 p-sm-3 border rounded-3 h-100 w-100" style="cursor: pointer;">
                            <input type="radio" name="role" value="kookmoeke" class="form-check-input user-role-radio mt-1 flex-shrink-0" <%= target.role === 'kookmoeke' ? 'checked' : '' %>>
                            <div>
                                <div class="fw-bold text-dark small">
                                    <i class="bi bi-heart-fill text-warning me-1"></i>Kookmoeke
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle rounded-pill ms-1" style="font-size: 0.65rem;">Apart type</span>
                                </div>
                                <div class="text-muted" style="font-size: 0.76rem; line-height: 1.3;">Speciaal account voor de kookploeg (toegang tot Kampboekje & Tetterhoekje).</div>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- 2. Inloggegevens -->
            <div class="p-3 bg-light rounded-4 border mb-3">
                <div class="fw-bold text-dark small mb-2">
                    <i class="bi bi-key-fill text-primary me-1"></i>Inloggegevens
                </div>
                <div class="row g-3">
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Gebruikersnaam <span class="text-danger">*</span></label>
                        <input type="text" class="form-control admin-modal-input" name="username" value="<%= target.username %>" required>
                    </div>
                    <div class="col-12 col-md-6">
                        <label class="form-label small fw-bold text-secondary mb-1" style="font-size: 0.78rem;">Nieuw Wachtwoord <span class="text-muted fw-normal">(laat leeg om te behouden)</span></label>
                        <input type="text" class="form-control admin-modal-input" name="password" placeholder="Nieuw wachtwoord...">
                    </div>
                </div>
            </div>

            <!-- 3. Toegang tot Leidingshoekjes -->
            <div class="p-3 bg-light rounded-4 border">
                <div class="fw-bold text-dark small mb-2">
                    <i class="bi bi-chat-heart-fill text-primary me-1"></i>Toegang tot Leidingshoekjes
                </div>
                <div class="alert alert-info py-2 px-3 mb-3 small rounded-3">
                    <i class="bi bi-info-circle me-1"></i>Admins hebben automatisch toegang tot alle leidingshoekjes. Kookmoekes werken enkel met het Kampboekje & Tetterhoekje.
                </div>
                <div class="row g-2">
                    <% groups.forEach(g => { %>
                        <div class="col-12 col-sm-6 col-md-4">
                            <label class="admin-check-card d-flex align-items-center gap-2 p-2 border rounded-3 bg-white w-100" style="cursor: pointer;">
                                <input class="form-check-input admin-modal-checkbox m-0 flex-shrink-0" type="checkbox" name="groups" value="<%= g.id %>" <%= accessIds.includes(g.id) ? 'checked' : '' %>>
                                <span class="small fw-medium text-dark text-truncate"><%= g.name %> <%= g.year ? '(' + g.year + ')' : '' %></span>
                            </label>
                        </div>
                    <% }) %>
                </div>
            </div>
        </div>

        <div class="bg-light px-3 px-sm-4 py-3 border-top d-flex justify-content-between align-items-center">
            <a href="/admin/users" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-2">Annuleren</a>
            <button type="submit" class="btn btn-success btn-sm rounded-pill px-4 py-2 fw-bold shadow-sm">
                <i class="bi bi-check-lg me-1"></i>Wijzigingen Opslaan
            </button>
        </div>
    </form>
</div>

<style>
    .admin-modal-input {
        border: 2px solid #e2e8f0 !important;
        border-radius: 12px !important;
        padding: 0.5rem 0.75rem !important;
        font-size: 0.95rem !important;
        font-family: system-ui, -apple-system, sans-serif !important;
    }
    .admin-modal-input:focus {
        border-color: var(--chiro-blue, #1d4e89) !important;
        box-shadow: 0 0 0 3px rgba(29, 78, 137, 0.12) !important;
    }
    input[type="radio"].user-role-radio {
        padding: 0 !important;
        width: 1.15em !important;
        height: 1.15em !important;
        border-radius: 50% !important;
        border: 2px solid #94a3b8 !important;
    }
    input[type="radio"].user-role-radio:checked {
        border-color: var(--chiro-blue, #1d4e89) !important;
        background-color: var(--chiro-blue, #1d4e89) !important;
    }
    .user-role-card {
        transition: all 0.15s ease;
        background-color: #fff;
    }
    .user-role-card:has(input:checked) {
        border-color: var(--chiro-blue, #1d4e89) !important;
        background-color: #eff6ff;
        box-shadow: 0 0 0 2px rgba(29, 78, 137, 0.12);
    }
    .user-role-card-kookmoeke:has(input:checked) {
        border-color: #f59e0b !important;
        background-color: #fffbeb;
        box-shadow: 0 0 0 2px rgba(245, 158, 11, 0.18);
    }
    .admin-modal-checkbox {
        width: 1.15em !important;
        height: 1.15em !important;
        padding: 0 !important;
        border-radius: 5px !important;
        border: 2px solid #94a3b8 !important;
    }
    .admin-modal-checkbox:checked {
        background-color: var(--chiro-blue, #1d4e89) !important;
        border-color: var(--chiro-blue, #1d4e89) !important;
    }
    .admin-check-card:has(input:checked) {
        border-color: var(--chiro-blue, #1d4e89) !important;
        background-color: #eff6ff !important;
    }
</style>

<%- include('../partials/footer') %>
