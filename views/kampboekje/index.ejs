<%- include('../partials/header') %>

<style>
    body {
        background-color: #f8f9fa;
    }

    .font-playful {
        font-family: 'Fredoka', 'Patrick Hand', sans-serif;
    }

    .kampboek-header {
        background: linear-gradient(135deg, #17a2b8 0%, #007bff 100%);
        color: white;
        border-radius: 1.25rem;
        box-shadow: 0 10px 25px rgba(23, 162, 184, 0.25);
    }

    .entry-card {
        border: none;
        border-radius: 1.25rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        transition: transform 0.2s, box-shadow 0.2s;
        background-color: white;
    }

    .entry-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.08);
    }

    .entry-card.pinned {
        border-top: 4px solid #ffc107;
    }

    .avatar-circle {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        font-size: 0.9rem;
    }

    .badge-category {
        font-size: 0.75rem;
        padding: 0.4rem 0.8rem;
        border-radius: 50rem;
        font-weight: 600;
    }

    .entry-image-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
        gap: 10px;
    }

    .entry-image-grid img {
        width: 100%;
        height: 160px;
        object-fit: cover;
        border-radius: 0.75rem;
        cursor: pointer;
        transition: opacity 0.2s;
    }

    .entry-image-grid img:hover {
        opacity: 0.9;
    }
</style>

<div class="row justify-content-center">
    <div class="col-lg-11 col-xl-10">
        
        <!-- Alerts -->
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        <% } %>

        <!-- Header Banner -->
        <div class="card kampboek-header mb-4 p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="badge bg-white text-dark rounded-pill px-3 py-2 fw-bold text-uppercase" style="font-size: 0.75rem;">
                            <i class="bi bi-book-half text-primary me-1"></i> Kamp Logboek & Foto's
                        </span>
                    </div>
                    <h1 class="font-playful display-5 mb-1 text-white fw-bold">Kampboekje</h1>
                    <p class="mb-0 text-white-50 lead fs-6">Leg alle keukengeheimen, anekdotes, dagboeken en foto-herinneringen vast in een overzichtelijk kampboekje!</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4 py-2 font-playful shadow-sm text-dark fw-bold" data-bs-toggle="modal" data-bs-target="#createEntryModal">
                        <i class="bi bi-plus-lg me-1 text-primary"></i> Nieuw Verhaal / Foto's
                    </button>
                    <a href="/tetterhoekje" class="btn btn-outline-light rounded-pill px-3 py-2 font-playful">
                        <i class="bi bi-arrow-left me-1"></i> Tetterhoekje
                    </a>
                </div>
            </div>
        </div>

        <!-- Filter & Search Controls -->
        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body p-3">
                <form action="/kampboekje" method="GET" class="row g-2 align-items-center">
                    <div class="col-md-4">
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light border-0"><i class="bi bi-search"></i></span>
                            <input type="text" name="q" class="form-control bg-light border-0" placeholder="Zoek in verhalen..." value="<%= searchQuery %>">
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <select name="campName" class="form-select form-select-sm bg-light border-0" onchange="this.form.submit()">
                            <option value="">Alle Kampen</option>
                            <% campNames.forEach(camp => { %>
                                <option value="<%= camp %>" <%= selectedCamp === camp ? 'selected' : '' %>><%= camp %></option>
                            <% }) %>
                        </select>
                    </div>
                    <div class="col-md-3 col-6">
                        <select name="category" class="form-select form-select-sm bg-light border-0" onchange="this.form.submit()">
                            <option value="Alle">Alle Categorieën</option>
                            <option value="Keuken" <%= selectedCategory === 'Keuken' ? 'selected' : '' %>>Keuken</option>
                            <option value="Anekdote" <%= selectedCategory === 'Anekdote' ? 'selected' : '' %>>Anekdote</option>
                            <option value="Recept" <%= selectedCategory === 'Recept' ? 'selected' : '' %>>Recept</option>
                            <option value="Sfeer" <%= selectedCategory === 'Sfeer' ? 'selected' : '' %>>Sfeer</option>
                            <option value="Algemeen" <%= selectedCategory === 'Algemeen' ? 'selected' : '' %>>Algemeen</option>
                        </select>
                    </div>
                    <div class="col-md-2 d-flex justify-content-end">
                        <button type="submit" class="btn btn-primary btn-sm rounded-pill w-100 font-playful">
                            Filteren
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Entries List -->
        <% if (!entries || entries.length === 0) { %>
            <div class="card border-0 shadow-sm rounded-4 text-center p-5 bg-white">
                <i class="bi bi-journal-x display-1 text-muted opacity-50 mb-3"></i>
                <h4 class="font-playful text-dark">Nog geen kampboekje inzendingen</h4>
                <p class="text-muted mb-3">Maak de eerste inzending met een leuk verhaal of foto's van het kamp!</p>
                <div>
                    <button type="button" class="btn btn-primary rounded-pill px-4 font-playful" data-bs-toggle="modal" data-bs-target="#createEntryModal">
                        <i class="bi bi-plus-lg me-1"></i> Eerste Verhaal Toevoegen
                    </button>
                </div>
            </div>
        <% } else { %>
            <div class="row g-4">
                <% entries.forEach(entry => { %>
                    <div class="col-12">
                        <div class="card entry-card p-4 <%= entry.isPinned ? 'pinned' : '' %>">
                            <!-- Top Badge & Actions Header -->
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <% if (entry.isPinned) { %>
                                        <span class="badge bg-warning text-dark rounded-pill px-3 py-1"><i class="bi bi-pin-angle-fill me-1"></i> Vastgepind</span>
                                    <% } %>
                                    <span class="badge bg-info text-white badge-category"><%= entry.category || 'Algemeen' %></span>
                                    <span class="badge bg-light text-dark rounded-pill px-3 py-1"><i class="bi bi-geo-alt-fill me-1 text-primary"></i> <%= entry.campName %></span>
                                    <% if (entry.dayDate) { %>
                                        <span class="badge bg-light text-secondary rounded-pill px-3 py-1"><i class="bi bi-calendar-event me-1"></i> <%= entry.dayDate %></span>
                                    <% } %>
                                </div>

                                <div class="d-flex align-items-center gap-2">
                                    <% if (user.role === 'admin') { %>
                                        <form action="/kampboekje/<%= entry.id %>/pin" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-warning rounded-circle" title="<%= entry.isPinned ? 'Losmaken' : 'Vastpinnen' %>">
                                                <i class="bi <%= entry.isPinned ? 'bi-pin-angle-fill' : 'bi-pin-angle' %>"></i>
                                            </button>
                                        </form>
                                    <% } %>

                                    <% if (user.role === 'admin' || user.id === entry.authorId) { %>
                                        <form action="/kampboekje/<%= entry.id %>/delete" method="POST" onsubmit="return confirm('Entry definitief verwijderen?');" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-circle" title="Verwijderen">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>

                            <!-- Title -->
                            <h3 class="font-playful text-dark fw-bold mb-2"><%= entry.title %></h3>

                            <!-- Author info -->
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <% if (entry.author && entry.author.profilePicture) { %>
                                    <img src="<%= entry.author.profilePicture %>" class="rounded-circle border" style="width: 32px; height: 32px; object-fit: cover;" alt="<%= entry.author.username %>">
                                <% } else { %>
                                    <div class="avatar-circle" style="width: 32px; height: 32px; font-size: 0.75rem; background-color: <%= getAvatarColor(entry.author ? entry.author.username : 'User') %>;">
                                        <%= entry.author ? entry.author.username.substring(0, 2).toUpperCase() : '??' %>
                                    </div>
                                <% } %>
                                <span class="small text-muted">
                                    Geschreven door <strong><%= entry.author ? capitalizeName(entry.author.username) : 'Onbekend' %></strong> op <%= formatDate(entry.createdAt) %>
                                </span>
                            </div>

                            <!-- Content -->
                            <div class="entry-content text-secondary mb-3 fs-6" style="white-space: pre-line; line-height: 1.6;"><%- entry.content %></div>

                            <!-- Image Gallery -->
                            <% if (entry.images && entry.images.length > 0) { %>
                                <div class="entry-image-grid mt-2">
                                    <% entry.images.forEach(img => { %>
                                        <a href="<%= img.path %>" target="_blank" title="<%= img.originalName %>">
                                            <img src="<%= img.path %>" class="shadow-sm" alt="<%= img.originalName %>">
                                        </a>
                                    <% }) %>
                                </div>
                            <% } %>
                        </div>
                    </div>
                <% }) %>
            </div>
        <% } %>

    </div>
</div>

<!-- Modal: Create Entry -->
<div class="modal fade" id="createEntryModal" tabindex="-1" aria-labelledby="createEntryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header bg-primary text-white rounded-top-4">
                <h5 class="modal-title font-playful fw-bold" id="createEntryModalLabel">
                    <i class="bi bi-journal-plus me-2"></i> Nieuwe Inzending Kampboekje
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form action="/kampboekje/create" method="POST" enctype="multipart/form-data">
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-8">
                            <label class="form-label fw-bold">Titel <span class="text-danger">*</span></label>
                            <input type="text" name="title" class="form-control rounded-3" placeholder="bv. De legendarische pannenkoekenberg" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Categorie</label>
                            <select name="category" class="form-select rounded-3">
                                <option value="Keuken">Keuken</option>
                                <option value="Anekdote">Anekdote</option>
                                <option value="Recept">Recept</option>
                                <option value="Sfeer">Sfeer</option>
                                <option value="Algemeen" selected>Algemeen</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Kamp Naam / Jaar</label>
                            <input type="text" name="campName" class="form-control rounded-3" value="Zomerkamp 2026">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Dag / Datum</label>
                            <input type="text" name="dayDate" class="form-control rounded-3" placeholder="bv. Dag 4 - 24 juli">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Verhaal / Omschrijving <span class="text-danger">*</span></label>
                            <textarea name="content" class="form-control rounded-3" rows="5" placeholder="Schrijf hier het verhaal..." required style="resize: vertical;"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-bold">Foto's uploaden</label>
                            <input type="file" name="images" multiple class="form-control rounded-3" accept="image/*">
                            <small class="text-muted">Je kunt meerdere foto's tegelijk selecteren.</small>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light rounded-bottom-4">
                    <button type="button" class="btn btn-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuleren</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4 font-playful">Opslaan in Kampboekje</button>
                </div>
            </form>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>
