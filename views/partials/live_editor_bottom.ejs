<% if (user && (user.role === 'admin' || user.role === 'media')) { %>
    <!-- Image Cropper Modal -->
    <div class="modal fade" id="imageCropperModal" tabindex="-1" aria-labelledby="imageCropperModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                <div class="modal-header bg-primary text-white py-3 px-4">
                    <h5 class="modal-title d-flex align-items-center gap-2 mb-0" id="imageCropperModalLabel">
                        <i class="bi bi-crop"></i> Foto Bijsnijden & Aanpassen
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Sluiten"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Dropzone (Shown when no image is loaded yet) -->
                    <div id="cropper-dropzone" class="dropzone-area p-5 text-center border-2 border-dashed rounded-4 bg-light mb-3">
                        <i class="bi bi-cloud-arrow-up display-3 text-primary mb-3 d-block"></i>
                        <h5 class="fw-bold mb-2">Upload een nieuwe foto</h5>
                        <p class="text-muted small mb-3">Sleep een afbeelding hierheen of klik op bladeren</p>
                        <input type="file" id="modal-file-input" class="d-none" accept="image/*">
                        <div class="d-flex justify-content-center gap-2 flex-wrap">
                            <button type="button" class="btn btn-primary rounded-pill px-4" id="btn-browse-file">
                                <i class="bi bi-folder2-open me-1"></i> Bestand Kiezen
                            </button>
                            <button type="button" class="btn btn-outline-secondary rounded-pill px-3 d-none" id="btn-use-current">
                                <i class="bi bi-image me-1"></i> Huidige Foto Gebruiken
                            </button>
                        </div>
                    </div>

                    <!-- Crop Canvas Workspace -->
                    <div id="cropper-workspace" class="d-none">
                        <div class="cropper-container-box rounded-3 overflow-hidden d-flex align-items-center justify-content-center mb-3">
                            <img id="cropper-target-img" src="" alt="Bijsnijden">
                        </div>

                        <!-- Editing Toolbar (Rotate, Flip, Zoom, Ratio, Reset) -->
                        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 p-2 bg-light rounded-3 border">
                            <!-- Rotation & Flip -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="Draaien">
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-rotate-left" title="90° naar links draaien">
                                    <i class="bi bi-arrow-counterclockwise"></i> <span class="d-none d-sm-inline ms-1">-90°</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-rotate-right" title="90° naar rechts draaien">
                                    <i class="bi bi-arrow-clockwise"></i> <span class="d-none d-sm-inline ms-1">+90°</span>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-flip-x" title="Horizontaal spiegelen">
                                    <i class="bi bi-symmetry-vertical"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-flip-y" title="Verticaal spiegelen">
                                    <i class="bi bi-symmetry-horizontal"></i>
                                </button>
                            </div>

                            <!-- Zoom & Reset -->
                            <div class="btn-group btn-group-sm" role="group" aria-label="Zoom en herstel">
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-zoom-in" title="Inzoomen">
                                    <i class="bi bi-zoom-in"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-zoom-out" title="Uitzoomen">
                                    <i class="bi bi-zoom-out"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" id="btn-crop-reset" title="Uitsnede herstellen">
                                    <i class="bi bi-arrow-repeat"></i> Herstel
                                </button>
                            </div>

                            <!-- Aspect Ratios -->
                            <div class="btn-group btn-group-sm" role="group" id="crop-ratio-group" aria-label="Verhouding">
                                <button type="button" class="btn btn-outline-primary active" data-ratio="1" title="1:1 Vierkant (Polaroid)">1:1</button>
                                <button type="button" class="btn btn-outline-primary" data-ratio="1.33333" title="4:3 Liggend">4:3</button>
                                <button type="button" class="btn btn-outline-primary" data-ratio="0.75" title="3:4 Staand">3:4</button>
                                <button type="button" class="btn btn-outline-primary" data-ratio="NaN" title="Vrije uitsnede">Vrij</button>
                            </div>

                            <!-- Change file -->
                            <button type="button" class="btn btn-outline-dark btn-sm rounded-pill" id="btn-crop-change-file" title="Andere afbeelding uploaden">
                                <i class="bi bi-folder2-open me-1"></i> Andere foto
                            </button>
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light border-0 py-3 px-4 d-flex justify-content-between">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Annuleren</button>
                    <button type="button" class="btn btn-chiro rounded-pill px-4 shadow-sm" id="btn-crop-apply" disabled>
                        <i class="bi bi-check-lg me-1"></i> <span id="btn-crop-apply-text">Foto Toepassen</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script src="/vendor/cropper.min.js"></script>
    <script src="/js/live-editor.js"></script>
<% } %>
