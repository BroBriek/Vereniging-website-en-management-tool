    <% if (typeof fullWidth === 'undefined' || !fullWidth) { %>
        </div> <!-- End Container -->
    <% } %>
    <footer class="text-center text-white mt-auto">
        <div class="container py-4">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-uppercase mb-3" style="color: var(--chiro-yellow);">Adres</h5>
                    <p class="mb-1"><%= process.env.ORG_ADDRESS_STREET || 'Kloosterstraat 5' %></p>
                    <p><%= (process.env.ORG_POSTAL_CODE ? process.env.ORG_POSTAL_CODE + ' ' : '3670 ') + (typeof orgLocation !== 'undefined' && orgLocation ? orgLocation : (process.env.ORG_LOCATION || 'Meeuwen')) %></p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="text-uppercase mb-3" style="color: var(--chiro-yellow);">Contact</h5>
                    <p class="mb-1">
                        <a href="/contact" class="text-white text-decoration-none">Zie ons contactformulier</a>
                    </p>
                    <p class="small text-white-50">
                        Post sturen? Graag naar adres van de hoofdleiding.
                    </p>
                </div>
                <div class="col-md-4 mb-3">
                    <h5 class="text-uppercase mb-3" style="color: var(--chiro-yellow);">Info</h5>
                    <p class="text-white small">
                        <i class="bi bi-exclamation-circle me-1"></i> Wij verhuren onze lokalen <strong>niet</strong>.
                    </p>
                </div>
            </div>
            <hr class="border-secondary">
            <p class="mb-1">&copy; <%= new Date().getFullYear() %> <%= typeof orgName !== 'undefined' && orgName ? orgName : (process.env.ORG_NAME || 'Chiro Vreugdeland') %></p>
            <% if (!user) { %>
                <a href="/auth/login" class="text-white-50 text-decoration-none small">Leiding Login</a>
            <% } %>
            <div class="mt-2">
                <a href="/pdf/privacyNotice.pdf" target="_blank" rel="noopener" class="text-white-50 text-decoration-none small">Privacy Notice</a>
            </div>
        </div>
    </footer>
    <!-- Quill Link Modal -->
    <div class="modal fade" id="quillLinkModal" tabindex="-1" aria-labelledby="quillLinkModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title" id="quillLinkModalLabel" style="font-family: 'Fredoka', sans-serif; font-weight: 600;">Link Toevoegen</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="quillLinkUrl" class="form-label small text-muted text-uppercase fw-bold">URL (Webadres)</label>
                        <input type="url" class="form-control rounded-pill border-2" id="quillLinkUrl" placeholder="https://example.com" autofocus>
                    </div>
                    <div class="mb-0">
                        <label for="quillLinkText" class="form-label small text-muted text-uppercase fw-bold">Tekst (Optioneel)</label>
                        <input type="text" class="form-control rounded-pill border-2" id="quillLinkText" placeholder="Klik hier">
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Annuleren</button>
                    <button type="button" class="btn btn-primary rounded-pill px-4" id="quillLinkSubmit">Toevoegen</button>
                </div>
            </div>
        </div>
    </div>

    <!-- File Preview Modal -->
    <div class="modal fade" id="filePreviewModal" tabindex="-1" aria-hidden="true">
      <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content rounded-4 border-0 shadow" style="height: 90vh;">
          <div class="modal-header border-0 pb-0">
            <h5 class="modal-title font-playful text-truncate" id="previewFileName" style="max-width: 80%;">Bestand</h5>
            <div class="d-flex gap-2">
                <a id="previewDownloadBtn" href="#" class="btn btn-primary btn-sm rounded-pill" download>
                    <i class="bi bi-download"></i> Download
                </a>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
          </div>
          <div class="modal-body p-0 h-100 position-relative bg-light">
            <div id="previewLoader" class="position-absolute top-50 start-50 translate-middle text-center">
                <div class="spinner-border text-primary" role="status"></div>
                <p class="mt-2 text-muted">Laden...</p>
            </div>
            <iframe id="previewFrame" src="" class="w-100 h-100 border-0 rounded-bottom-4 d-none"></iframe>
            <div id="previewImageContainer" class="w-100 h-100 d-none d-flex align-items-center justify-content-center bg-white rounded-bottom-4 overflow-auto">
                <img id="previewImage" src="" class="img-fluid" style="max-height: 100%; object-fit: contain;">
            </div>
            <div id="previewError" class="d-none position-absolute top-50 start-50 translate-middle text-center p-4 w-100">
                <i class="bi bi-file-earmark-x display-1 text-muted"></i>
                <h5 class="mt-3">Voorbeeld niet beschikbaar</h5>
                <p class="text-muted mb-3">Dit bestandstype kan niet worden weergegeven in de browser of we kunnen er niet bij.</p>
                <a id="previewErrorDownloadBtn" href="#" class="btn btn-primary rounded-pill mt-2">
                    <i class="bi bi-download"></i> Download Bestand
                </a>
            </div>
          </div>
        </div>
      </div>
    </div>

    <% if (typeof user !== 'undefined' && user && user.firstLogin && user.role !== 'kookmoeke' && typeof settings !== 'undefined' && settings.first_login_message && settings.first_login_message.trim() !== '') { %>
    <!-- First Login Welcome Modal -->
    <div class="modal fade" id="firstLoginWelcomeModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="firstLoginWelcomeModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 30px; overflow: hidden; border: 5px solid var(--chiro-yellow) !important;">
                <div class="modal-header text-white border-0 py-4 px-4 position-relative" style="background: linear-gradient(135deg, var(--chiro-blue) 0%, #2980b9 100%);">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white rounded-circle p-2 d-flex align-items-center justify-content-center shadow-sm" style="width: 55px; height: 55px;">
                            <i class="bi bi-balloon-fill animate-balloon" style="font-size: 2rem; color: var(--chiro-yellow) !important; display: inline-block;"></i>
                        </div>
                        <div>
                            <h4 class="modal-title font-playful mb-0 text-white" id="firstLoginWelcomeModalLabel" style="font-weight: 700; font-family: var(--font-heading);">Welkom <%= capitalizeName(user.username) %>!</h4>
                            <small class="text-white-50" style="font-family: var(--font-body); font-size: 1.1rem;">Jouw eerste keer hier? We helpen je graag op weg!</small>
                        </div>
                    </div>
                </div>
                <div class="modal-body p-4 p-md-5" style="background-color: #fffdf9; font-family: var(--font-body); font-size: 1.3rem; line-height: 1.7; color: var(--text-color);">
                    <div class="welcome-text-content">
                        <%- settings.first_login_message %>
                    </div>
                </div>
                <div class="modal-footer border-0 px-4 py-3 bg-light d-flex justify-content-end">
                    <button type="button" class="btn btn-primary rounded-pill px-5 py-2 fw-bold shadow-sm font-playful" id="dismissFirstLoginBtn" style="background-color: var(--chiro-red); border-color: var(--chiro-red); font-size: 1.2rem; transition: all 0.2s ease;">
                        <i class="bi bi-check-circle-fill me-2"></i>Aan de slag!
                    </button>
                </div>
            </div>
        </div>
    </div>

    <style>
        .animate-balloon {
            animation: balloonWiggle 2s ease-in-out infinite;
        }
        @keyframes balloonWiggle {
            0%, 100% { transform: translateY(0) rotate(0deg); }
            50% { transform: translateY(-5px) rotate(5deg); }
        }
        #dismissFirstLoginBtn:hover {
            transform: scale(1.05);
            background-color: #c0392b !important;
            border-color: #c0392b !important;
        }
    </style>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const welcomeModalEl = document.getElementById('firstLoginWelcomeModal');
            if (welcomeModalEl) {
                const welcomeModal = new bootstrap.Modal(welcomeModalEl);
                welcomeModal.show();

                const dismissBtn = document.getElementById('dismissFirstLoginBtn');
                if (dismissBtn) {
                    dismissBtn.addEventListener('click', function() {
                        dismissBtn.disabled = true;
                        dismissBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Laden...';
                        
                        fetch('/account/dismiss-first-login', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                                'X-CSRF-Token': '<%= csrfToken %>'
                            }
                        })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                welcomeModal.hide();
                            } else {
                                console.error('Failed to dismiss first login popup');
                                welcomeModal.hide(); // Hide anyway to not block the user
                            }
                        })
                        .catch(err => {
                            console.error('Error dismiss first login:', err);
                            welcomeModal.hide(); // Hide anyway to not block the user
                        });
                    });
                }
            }
        });
    </script>
    <% } %>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/download-helper.js?v=1.0.1"></script>
    <script src="/js/rich-editor.js?v=1.3"></script>
</body>
</html>
