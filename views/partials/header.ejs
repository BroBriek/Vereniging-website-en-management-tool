    <meta property="og:url" content="https://www.chiromeeuwen.be<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Chiro Vreugdeland Meeuwen - Jeugdbeweging Meeuwen' %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Chiro Vreugdeland Meeuwen: jeugdbeweging voor kinderen in Meeuwen. Elke zondag spelen, activiteiten, vriendschap en plezier.' %>">
    <meta property="og:image" content="https://www.chiromeeuwen.be/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="nl_BE">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://www.chiromeeuwen.be<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
    <meta property="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Chiro Vreugdeland Meeuwen - Jeugdbeweging Meeuwen' %>">
    <meta property="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Chiro Vreugdeland Meeuwen: jeugdbeweging voor kinderen in Meeuwen. Elke zondag spelen, activiteiten, vriendschap en plezier.' %>">
    <meta property="twitter:image" content="https://www.chiromeeuwen.be/og-image.png">

    <!-- Canonical Tag -->
    <link rel="canonical" href="https://www.chiromeeuwen.be<%= typeof currentPath !== 'undefined' ? currentPath : '' %>" />

    <!-- Structured Data: Organization & LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Chiro Vreugdeland Meeuwen",
      "alternateName": "Chiro Meeuwen",
      "description": "Chiro Vreugdeland Meeuwen is een jeugdbeweging in Meeuwen met activiteiten voor kinderen van alle leeftijden.",
      "url": "https://www.chiromeeuwen.be",
      "logo": "https://www.chiromeeuwen.be/favicon.png",
      "image": "https://www.chiromeeuwen.be/og-image.png",
      "keywords": "Chiro, jeugdbeweging, Meeuwen, kinderen, activiteiten",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Kloosterstraat 5",
        "addressLocality": "Meeuwen",
        "addressRegion": "Limburg",
        "postalCode": "3670",
        "addressCountry": "BE"
      },
      "email": "<%= process.env.CONTACT_EMAIL || 'Chiromeeuwen@outlook.com' %>",
      "sameAs": [
        "https://www.facebook.com/ChiroVreugdelandMeeuwen"
      ]
    }
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=Patrick+Hand&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        :root {
            --chiro-red: <%= settings.theme_color_primary %>;
            --chiro-blue: <%= settings.theme_color_secondary %>;
            --chiro-yellow: <%= settings.theme_color_accent %>;
            --chiro-brown: <%= settings.theme_color_neutral %>;
            --bg-color: <%= settings.theme_color_bg %>;
            --text-color: <%= settings.theme_color_text %>;
        }
    </style>
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="<%= settings.theme_color_primary %>">
    <link rel="apple-touch-icon" href="/favicon.png">
    <% if (locals.csrfToken) { %>
    <meta name="csrf-token" content="<%= csrfToken %>">
    <script>
        (function() {
            const originalFetch = window.fetch;
            window.fetch = function(url, options = {}) {
                const token = document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');
                if (token && options.method && ['POST', 'PUT', 'DELETE', 'PATCH'].includes(options.method.toUpperCase())) {
                    options.headers = options.headers || {};
                    if (options.headers instanceof Headers) {
                        options.headers.set('X-CSRF-Token', token);
                    } else if (Array.isArray(options.headers)) {
                        let hasCsrf = false;
                        for (let i = 0; i < options.headers.length; i++) {
                            if (options.headers[i][0].toLowerCase() === 'x-csrf-token') {
                                hasCsrf = true;
                                break;
                            }
                        }
                        if (!hasCsrf) {
                            options.headers.push(['X-CSRF-Token', token]);
                        }
                    } else {
                        let hasCsrf = false;
                        for (const key in options.headers) {
                            if (key.toLowerCase() === 'x-csrf-token') {
                                hasCsrf = true;
                                break;
                            }
                        }
                        if (!hasCsrf) {
                            options.headers['X-CSRF-Token'] = token;
                        }
                    }
                }
                return originalFetch(url, options);
            };
        })();
    </script>
    <% } %>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/home">CHIRO VREUGDELAND</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
