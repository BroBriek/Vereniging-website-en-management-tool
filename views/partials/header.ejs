                                <% } %>
                                
                                <% if (!settings.move_menu_to_dashboard) { %>
                                    <h6 class="dropdown-header text-uppercase small fw-bold opacity-50 px-2 mt-2">Persoonlijk</h6>
                                    <% if (typeof enablePublicRegistrations !== 'undefined' && enablePublicRegistrations) { %>
                                        <a class="dropdown-item rounded-3 py-2" href="/admin/registrations"><i class="bi bi-people me-2 text-success"></i> Ledenlijst</a>
                                    <% } %>
                                    <a class="dropdown-item rounded-3 py-2" href="/feed"><i class="bi bi-chat-left-text me-2 text-warning"></i> Leidingshoekje</a>
                                    <% if (showGamesToAll || (user && user.username === 'admin')) { %>
                                        <a class="dropdown-item rounded-3 py-2" href="/games"><i class="bi bi-controller me-2 text-info"></i> Spelendatabank</a>
                                    <% } %>
                                    <a class="dropdown-item rounded-3 py-2" href="/feed/calendar"><i class="bi bi-calendar3 me-2 text-danger"></i> Leidingskalender</a>
                                    <a class="dropdown-item rounded-3 py-2" href="/account/settings"><i class="bi bi-gear me-2 text-secondary"></i> Instellingen</a>
                                <% } %>

                                <% if (originalAdminId || (user.username === 'admin' && user.secondaryUserId)) { %>
                                    <% if (!settings.move_menu_to_dashboard) { %>
                                        <hr class="dropdown-divider opacity-10">
                                    <% } %>
                                    <a class="dropdown-item rounded-3 py-2 text-primary fw-bold" href="/account/switch">
                                        <i class="bi bi-arrow-left-right me-2"></i> 
                                        <%= originalAdminId ? 'Terug naar Admin' : 'Switch naar Test Account' %>
