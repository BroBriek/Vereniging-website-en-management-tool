<!DOCTYPE html>
<html lang="nl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1">
    <meta name="keywords" content="Chiro Meeuwen, Chiro Vreugdeland, jeugdbeweging, jeugdorganisatie, kinderen activiteiten, Meeuwen">
    <title><%= typeof title !== 'undefined' ? title : 'Chiro Vreugdeland Meeuwen - Jeugdbeweging Meeuwen' %></title>
    <meta name="description" content="<%= typeof description !== 'undefined' ? description : 'Chiro Vreugdeland Meeuwen: jeugdbeweging voor kinderen in Meeuwen. Elke zondag spelen, activiteiten, vriendschap en plezier.' %>">

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://www.chiromeeuwen.be<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
    <meta property="og:title" content="<%= typeof title !== 'undefined' ? title : 'Chiro Vreugdeland Meeuwen - Jeugdbeweging Meeuwen' %>">
    <meta property="og:description" content="<%= typeof description !== 'undefined' ? description : 'Chiro Vreugdeland Meeuwen: jeugdbeweging voor kinderen in Meeuwen. Elke zondag spelen, activiteiten, vriendschap en plezier.' %>">
    <meta property="og:image" content="https://www.chiromeeuwen.be/og-image.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:locale" content="nl_BE">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://www.chiromeeuwen.be<%= typeof currentPath !== 'undefined' ? currentPath : '' %>">
    <meta property="twitter:title" content="<%= typeof title !== 'undefined' ? title : 'Chiro Vreugdeland Meeuwen - Jeugdbeweging Meeuwen' %>">
    <meta property="twitter:description" content="<%= typeof description !== 'undefined' ? description : 'Chiro Vreugdeland Meeuwen: jeugdbeweging voor kinderen in Meeuwen. Elke zondag spelen, activiteiten, vriendschap en plezier.' %>">
    <meta property="twitter:image" content="https://www.chiromeeuwen.be/og-image.png">

    <!-- Canonical Tag -->
    <link rel="canonical" href="https://www.chiromeeuwen.be<%= typeof currentPath !== 'undefined' ? currentPath : '' %>" />

    <!-- Structured Data: Organization & LocalBusiness -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": ["Organization", "LocalBusiness"],
      "name": "Chiro Vreugdeland Meeuwen",
      "alternateName": "Chiro Meeuwen",
      "description": "Chiro Vreugdeland Meeuwen is een jeugdbeweging in Meeuwen met activiteiten voor kinderen van alle leeftijden.",
      "url": "https://www.chiromeeuwen.be",
      "logo": "https://www.chiromeeuwen.be/favicon.png",
      "image": "https://www.chiromeeuwen.be/og-image.png",
      "keywords": "Chiro, jeugdbeweging, Meeuwen, kinderen, activiteiten",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Kloosterstraat 5",
        "addressLocality": "Meeuwen",
        "addressRegion": "Limburg",
        "postalCode": "3670",
        "addressCountry": "BE"
      },
      "email": "<%= process.env.CONTACT_EMAIL || 'Chiromeeuwen@outlook.com' %>",
      "sameAs": [
        "https://www.facebook.com/ChiroVreugdelandMeeuwen"
      ]
    }
    </script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.7.2/font/bootstrap-icons.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@300;400;500;600;700&family=Patrick+Hand&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="icon" type="image/x-icon" href="/favicon.ico">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#db3e41">
    <link rel="apple-touch-icon" href="/favicon.png">
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-light fixed-top">
        <div class="container">
            <a class="navbar-brand" href="/home">CHIRO VREUGDELAND</a>
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto py-3 py-lg-0">
                    <li class="nav-item"><a class="nav-link" href="/home">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/praktisch">Praktisch</a></li>
                    <li class="nav-item"><a class="nav-link" href="/afdelingen">Afdelingen</a></li>
                    <li class="nav-item"><a class="nav-link" href="/leiding">Leiding</a></li>
                    <li class="nav-item"><a class="nav-link" href="<%= user ? '/feed/calendar' : '/kalender' %>"><%= user ? 'Leidingskalender' : 'Kalender' %></a></li>
                    <li class="nav-item"><a class="nav-link" href="/t-shirts">T-Shirts</a></li>
                    <li class="nav-item"><a class="nav-link" href="/inschrijven">Inschrijven</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                    <% if (user) { %>
                        <li class="nav-item dropdown ms-lg-3 mt-3 mt-lg-0">
                            <a class="nav-user-pill dropdown-toggle d-inline-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <% if (user.profilePicture) { %>
                                    <img src="<%= user.profilePicture %>" class="rounded-circle me-2 flex-shrink-0 border border-2 border-white" style="width: 28px; height: 28px; object-fit: cover;" alt="<%= user.username %>">
                                <% } else { %>
                                    <i class="bi bi-person-circle me-2"></i>
                                <% } %>
                                <%= capitalizeName(user.username.split(' ')[0]) %>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg rounded-4 p-2 mt-2" aria-labelledby="userDropdown">
                                <% if (user.role === 'admin' || user.role === 'media') { %>
                                    <li><h6 class="dropdown-header text-uppercase small fw-bold opacity-50">Beheer</h6></li>
                                    <li><a class="dropdown-item rounded-3 py-2" href="/admin"><i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard</a></li>
                                    <li><hr class="dropdown-divider opacity-10"></li>
                                <% } %>
                                
                                <li><h6 class="dropdown-header text-uppercase small fw-bold opacity-50">Persoonlijk</h6></li>
                                <% if (typeof enablePublicRegistrations !== 'undefined' && enablePublicRegistrations) { %>
                                    <li><a class="dropdown-item rounded-3 py-2" href="/admin/registrations"><i class="bi bi-people me-2 text-success"></i> Ledenlijst</a></li>
                                <% } %>
                                <li><a class="dropdown-item rounded-3 py-2" href="/feed"><i class="bi bi-chat-left-text me-2 text-warning"></i> Leidingshoekje</a></li>
                                <% if (showGamesToAll || (user && user.username === 'admin')) { %>
                                    <li><a class="dropdown-item rounded-3 py-2" href="/games"><i class="bi bi-controller me-2 text-info"></i> Spelendatabank</a></li>
                                <% } %>
                                <li><a class="dropdown-item rounded-3 py-2" href="/feed/calendar"><i class="bi bi-calendar3 me-2 text-danger"></i> Leidingskalender</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="/account/settings"><i class="bi bi-gear me-2 text-secondary"></i> Instellingen</a></li>
                                
                                <% if (originalAdminId || (user.username === 'admin' && user.secondaryUserId)) { %>
                                    <li><a class="dropdown-item rounded-3 py-2 text-primary fw-bold" href="/account/switch">
                                        <i class="bi bi-arrow-left-right me-2"></i> 
                                        <%= originalAdminId ? 'Terug naar Admin' : 'Switch naar Test Account' %>
                                    </a></li>
                                <% } %>

                                <li><hr class="dropdown-divider opacity-10"></li>
                                <li><a class="dropdown-item rounded-3 py-2 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Uitloggen</a></li>
                            </ul>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <% if (typeof fullWidth === 'undefined' || !fullWidth) { %>
        <div class="container mt-4">
    <% } %>
        
    <!-- Global Alert System -->
    <div class="<%= (typeof fullWidth !== 'undefined' && fullWidth) ? 'container mt-4' : '' %>">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>

    <script>
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(function(){});
    }

    // Set current user data for JavaScript
    window.currentUser = {
        id: <%= user ? user.id : 'null' %>,
        username: '<%= user ? user.username : '' %>',
        role: '<%= user ? user.role : '' %>'
    };

    // Lock background scroll when mobile menu is open
    document.addEventListener('DOMContentLoaded', function() {
        var navbarCollapse = document.getElementById('navbarNav');
        var scrollPos = 0;

        if (navbarCollapse) {
            navbarCollapse.addEventListener('show.bs.collapse', function () {
                scrollPos = window.pageYOffset;
                document.body.style.top = '-' + scrollPos + 'px';
                document.body.classList.add('navbar-open');
            });
            navbarCollapse.addEventListener('hidden.bs.collapse', function () {
                document.body.classList.remove('navbar-open');
                document.body.style.top = '';
                window.scrollTo(0, scrollPos);
            });
            
            // Also close menu when clicking on a link (useful for hash links if any)
            var navLinks = navbarCollapse.querySelectorAll('.nav-link:not(.dropdown-toggle)');
            navLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    var bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
                    if (bsCollapse) {
                        bsCollapse.hide();
                    }
                });
            });
        }
    });
    </script>