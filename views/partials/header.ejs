                                        <% if (!isHidden('/praktisch')) { %><a class="dropdown-item rounded-3 py-2" href="/praktisch"><i class="bi bi-info-circle me-2 text-primary"></i> Praktisch</a><% } %>
                                        <% if (!isHidden('/afdelingen')) { %><a class="dropdown-item rounded-3 py-2" href="/afdelingen"><i class="bi bi-people me-2 text-success"></i> Afdelingen</a><% } %>
                                        <% if (!isHidden('/leiding')) { %><a class="dropdown-item rounded-3 py-2" href="/leiding"><i class="bi bi-person-badge me-2 text-warning"></i> Leiding</a><% } %>
                                        <% if (!isHidden('/kalender')) { %>
