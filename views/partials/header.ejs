    <% if (typeof fullWidth === 'undefined' || !fullWidth) { %>
        <div class="container mt-4">
    <% } %>
        
    <!-- Global Alert System -->
    <div class="<%= (typeof fullWidth !== 'undefined' && fullWidth) ? 'container mt-4' : '' %>">
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                <%= error %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>

        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>
                <%= success %>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        <% } %>
    </div>

    <script>
    if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/sw.js').catch(function(){});
    }

    // Set current user data for JavaScript
    window.currentUser = {
        id: <%= user ? user.id : 'null' %>,
        username: '<%= user ? user.username : '' %>',
        role: '<%= user ? user.role : '' %>'
    };

    // Lock background scroll when mobile menu is open
    document.addEventListener('DOMContentLoaded', function() {
        var navbarCollapse = document.getElementById('navbarNav');
        var scrollPos = 0;

        if (navbarCollapse) {
            navbarCollapse.addEventListener('show.bs.collapse', function () {
                scrollPos = window.pageYOffset;
                document.body.style.top = '-' + scrollPos + 'px';
                document.body.classList.add('navbar-open');
            });
            navbarCollapse.addEventListener('hidden.bs.collapse', function () {
                document.body.classList.remove('navbar-open');
                document.body.style.top = '';
                window.scrollTo(0, scrollPos);
            });
            
            // Also close menu when clicking on a link (useful for hash links if any)
            var navLinks = navbarCollapse.querySelectorAll('.nav-link:not(.dropdown-toggle), .dropdown-item');
            navLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    // Do not close if it is a toggle link or trigger (like collapse button)
                    if (link.hasAttribute('data-bs-toggle') || link.closest('[data-bs-toggle="collapse"]')) {
                        return;
                    }
                    var bsCollapse = bootstrap.Collapse.getInstance(navbarCollapse);
                    if (bsCollapse) {
                        bsCollapse.hide();
                    }
                });
            });
        }
    });
    </script>