                                    </div>
                                </div>

                                <!-- User Navigation Links -->
                                <% if (user.role === 'admin' || user.role === 'media' || settings.allow_all_forms_access || settings.move_menu_to_dashboard) { %>
                                    <h6 class="dropdown-header text-uppercase small fw-bold opacity-50 px-2 mt-2">Beheer</h6>
                                    <a class="dropdown-item rounded-3 py-2" href="/admin"><i class="bi bi-speedometer2 me-2 text-primary"></i> Dashboard</a>
                                    <% if (!settings.move_menu_to_dashboard) { %>
                                        <hr class="dropdown-divider opacity-10">
