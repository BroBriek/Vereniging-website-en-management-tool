<%- include('../partials/header', { fullWidth: true }) %>

<style>
    .info-hero {
        background: linear-gradient(135deg, var(--chiro-red) 0%, #d32f2f 50%, var(--chiro-blue) 100%);
        padding: 60px 0;
        border-radius: 0 0 50px 50px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.1);
        margin-bottom: 3rem;
        position: relative;
        overflow: hidden;
    }
    .info-hero::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background-image: radial-gradient(circle at 2px 2px, rgba(255,255,255,0.1) 1px, transparent 0);
        background-size: 30px 30px;
        pointer-events: none;
    }
    .info-hero-text {
        color: white;
        text-align: center;
        position: relative;
        z-index: 1;
    }
    .info-hero-text h1 {
        font-size: 3rem;
        color: white;
        text-shadow: 2px 2px 4px rgba(0,0,0,0.2);
        margin-bottom: 1rem;
    }
    .info-hero-text p {
        font-size: 1.2rem;
        opacity: 0.9;
        max-width: 700px;
        margin: 0 auto;
    }
    .step-card {
        border: none;
        border-radius: 20px;
        transition: transform 0.3s ease;
        height: 100%;
    }
    .step-card:hover {
        transform: translateY(-5px);
    }
    .step-number {
        width: 35px;
        height: 35px;
        background-color: var(--chiro-red);
        color: white;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
        margin-bottom: 1rem;
        flex-shrink: 0;
    }
    .copy-section {
        background-color: #f8f9fa;
        border: 2px dashed #dee2e6;
        border-radius: 20px;
        padding: 2rem;
        margin-top: 2rem;
    }
    .link-box {
        background: white;
        padding: 1rem;
        border-radius: 12px;
        border: 1px solid #ced4da;
        font-family: monospace;
        word-break: break-all;
        margin-bottom: 1rem;
        font-size: 0.9rem;
    }
</style>

<div class="info-hero">
    <div class="container">
        <div class="info-hero-text">
            <h1><i class="bi bi-calendar-check me-3"></i>Kalender Koppelen</h1>
            <p>Volg dit stappenplan om de Chiro-kalender automatisch in je eigen agenda te laten verschijnen.</p>
        </div>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            <div class="row g-4 mb-5">
                <!-- iPhone / iOS Section -->
                <div class="col-md-6">
                    <div class="card step-card shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="h4 fw-bold mb-4 text-primary"><i class="bi bi-apple me-2"></i>iPhone / iPad (iOS)</h2>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3">1</div>
                                <div>Open de <strong>Instellingen</strong> app.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3">2</div>
                                <div>Scroll naar beneden en tik op <strong>Agenda</strong>.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3">3</div>
                                <div>Tik op <strong>Accounts</strong> en daarna op <strong>Nieuwe account</strong>.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3">4</div>
                                <div>Kies <strong>Andere</strong> (onderaan de lijst).</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3">5</div>
                                <div>Tik op <strong>Voeg agenda-abonnement toe</strong>.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3">6</div>
                                <div>Plak de link (onderaan deze pagina) in het veld 'Server' en tik op <strong>Volgende</strong>.</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Android / Google Section -->
                <div class="col-md-6">
                    <div class="card step-card shadow-sm">
                        <div class="card-body p-4">
                            <h2 class="h4 fw-bold mb-4 text-success"><i class="bi bi-google me-2"></i>Android / Google Calendar</h2>
                            <p class="text-muted small mb-4">Let op: Dit werkt het beste via een computer (browser), de instelling wordt daarna automatisch op je telefoon gesynchroniseerd.</p>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3" style="background-color: #28a745;">1</div>
                                <div>Ga naar <a href="https://calendar.google.com" target="_blank" rel="noopener">calendar.google.com</a> in je browser.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3" style="background-color: #28a745;">2</div>
                                <div>Klik links op het <strong>plusje (+)</strong> naast 'Andere agenda's'.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3" style="background-color: #28a745;">3</div>
                                <div>Kies voor de optie <strong>Via URL</strong>.</div>
                            </div>
                            <div class="d-flex align-items-start mb-3">
                                <div class="step-number me-3" style="background-color: #28a745;">4</div>
                                <div>Plak de link (onderaan deze pagina) in het veld en klik op <strong>Agenda toevoegen</strong>.</div>
                            </div>
                            <div class="mt-4 p-3 bg-light rounded-4 border">
                                <i class="bi bi-info-circle text-success me-2"></i>
                                <small>De agenda verschijnt nu in je Google account en zal ook op je Android-telefoon zichtbaar worden.</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Link Copy Section -->
            <div class="copy-section text-center">
                <h3 class="h4 fw-bold mb-3">Jouw Persoonlijke Link</h3>
                <p class="text-muted mb-4">Klik op de knop om de link te kopiëren en gebruik deze in de stappen hierboven.</p>
                
                <div class="link-box mx-auto" style="max-width: 600px;" id="calendar-link">
                    <%= calendarUrl %>
                </div>

                <button class="btn btn-chiro btn-lg rounded-pill px-5 shadow-sm" onclick="copyCalendarLink()">
                    <i class="bi bi-clipboard me-2"></i> Link Kopiëren
                </button>
                
                <div id="copy-success" class="mt-3 text-success d-none">
                    <i class="bi bi-check-circle me-1"></i> Link gekopieerd!
                </div>

                <% if (user) { %>
                    <div class="mt-4 alert alert-info border-0 rounded-pill d-inline-block px-4 py-2 small">
                        <i class="bi bi-person-check-fill me-2"></i> Je bent ingelogd als <strong><%= user.username %></strong>. Dit is jouw persoonlijke leiding-link.
                    </div>
                <% } else { %>
                    <div class="mt-4 alert alert-warning border-0 rounded-pill d-inline-block px-4 py-2 small">
                        <i class="bi bi-shield-lock me-2"></i> Dit is de <strong>publieke</strong> kalender link. <a href="/login" class="fw-bold text-decoration-none">Log in</a> voor de leiding-link.
                    </div>
                <% } %>
            </div>

            <div class="text-center mt-5">
                <a href="/kalender" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-2"></i> Terug naar de Kalender
                </a>
            </div>

        </div>
    </div>
</div>

<script>
    function copyCalendarLink() {
        const linkText = document.getElementById('calendar-link').innerText.trim();
        navigator.clipboard.writeText(linkText).then(() => {
            const successMsg = document.getElementById('copy-success');
            successMsg.classList.remove('d-none');
            setTimeout(() => {
                successMsg.classList.add('d-none');
            }, 3000);
        });
    }
</script>

<%- include('../partials/footer', { fullWidth: true }) %>
