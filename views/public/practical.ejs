<%- include('../partials/header') %>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold mb-0">Praktisch</h1>
        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
            <a href="/admin/page/practical" class="btn btn-chiro btn-sm shadow-sm">
                <i class="bi bi-pencil-square me-1"></i> Bewerk Pagina
            </a>
        <% } %>
    </div>

    <div class="card p-4 p-md-5">
        <div class="card-body fs-5">
            <%- (content.main && content.main.content) ? content.main.content : '<div class="text-center py-5 text-muted"><i class="bi bi-info-circle display-1 mb-3 d-block"></i><p>Hier komt praktische info.</p></div>' %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>