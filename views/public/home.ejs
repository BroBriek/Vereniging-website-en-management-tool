<%- include('../partials/header', { fullWidth: true }) %>

<% 
var heroImage = (content.hero_image && content.hero_image.content) ? content.hero_image.content : '/uploads/image-1791810054939-717577279.jpeg';
var heroTitle = (content.hero_title && content.hero_title.content) ? content.hero_title.content : ('Welkom bij ' + orgFullName);
var heroText = (content.hero_text && content.hero_text.content) ? content.hero_text.content : 'Samen spelen, samen leven.';
var heroPhotoCaption = (content.hero_photo_caption && content.hero_photo_caption.content) ? content.hero_photo_caption.content : 'Welkom bij onze Chiro-bende! ⛺';

var heroBtn1Text = (content.hero_btn1_text && content.hero_btn1_text.content) ? content.hero_btn1_text.content : (enablePublicRegistrations ? 'Word lid / Inschrijven' : 'Ontdek Onze Afdelingen');
var heroBtn1Url = (content.hero_btn1_url && content.hero_btn1_url.content) ? content.hero_btn1_url.content : (enablePublicRegistrations ? '/inschrijven' : '/afdelingen');
var heroBtn2Text = (content.hero_btn2_text && content.hero_btn2_text.content) ? content.hero_btn2_text.content : 'Lees Ons Logboek';
var heroBtn2Url = (content.hero_btn2_url && content.hero_btn2_url.content) ? content.hero_btn2_url.content : '#logboek';

var logbookTitle = (content.logbook_title && content.logbook_title.content) ? content.logbook_title.content : 'Uit Ons Chiro Logboek';
var logbookBadge = (content.logbook_badge && content.logbook_badge.content) ? content.logbook_badge.content : '📖 Reisverslag • Elke Zondag Avontuur';

var stat1Num = (content.stat_1_num && content.stat_1_num.content) ? content.stat_1_num.content : '170+';
var stat1Lbl = (content.stat_1_lbl && content.stat_1_lbl.content) ? content.stat_1_lbl.content : 'Enthousiaste leden';

var stat2Num = (content.stat_2_num && content.stat_2_num.content) ? content.stat_2_num.content : '26';
var stat2Lbl = (content.stat_2_lbl && content.stat_2_lbl.content) ? content.stat_2_lbl.content : 'Gemotiveerde leiding';

var stat3Num = (content.stat_3_num && content.stat_3_num.content) ? content.stat_3_num.content : '6';
var stat3Lbl = (content.stat_3_lbl && content.stat_3_lbl.content) ? content.stat_3_lbl.content : 'Leeftijdsgroepen';

var stat4Num = (content.stat_4_num && content.stat_4_num.content) ? content.stat_4_num.content : '10';
var stat4Lbl = (content.stat_4_lbl && content.stat_4_lbl.content) ? content.stat_4_lbl.content : 'Dagen zomerkamp';

var boxJoinTitle = (content.box_join_title && content.box_join_title.content) ? content.box_join_title.content : 'Nieuw bij de Chiro?';
var boxJoinText = (content.box_join_text && content.box_join_text.content) ? content.box_join_text.content : 'Iedereen tussen 6 en 18 jaar is van harte welkom! Je mag altijd 3 zondagen helemaal gratis en vrijblijvend meespelen om de sfeer te proeven.';
var boxJoinBtnText = (content.box_join_btn_text && content.box_join_btn_text.content) ? content.box_join_btn_text.content : 'Praktische info & uren';
var boxJoinBtnUrl = (content.box_join_btn_url && content.box_join_btn_url.content) ? content.box_join_btn_url.content : '/praktisch';

var boxInfoTitle = (content.box_info_title && content.box_info_title.content) ? content.box_info_title.content : 'Goed om te weten';
var boxInfoItem1 = (content.box_info_item_1 && content.box_info_item_1.content) ? content.box_info_item_1.content : 'Elke zondag voorzien wij een lekker vieruurtje en drankje.';
var boxInfoItem2 = (content.box_info_item_2 && content.box_info_item_2.content) ? content.box_info_item_2.content : 'Uniform is pas verplicht vanaf de Tito\'s (12 jaar).';
var boxInfoItem3 = (content.box_info_item_3 && content.box_info_item_3.content) ? content.box_info_item_3.content : '26 enthousiaste leid(st)ers staan elke week paraat!';
var boxInfoBtnText = (content.box_info_btn_text && content.box_info_btn_text.content) ? content.box_info_btn_text.content : 'Ontdek alle afdelingen';
var boxInfoBtnUrl = (content.box_info_btn_url && content.box_info_btn_url.content) ? content.box_info_btn_url.content : '/afdelingen';
%>

<% if (user && (user.role === 'admin' || user.role === 'media')) { %>
    <link rel="stylesheet" href="/vendor/cropper.min.css">

    <!-- Admin Toolbar & Banner in Container -->
    <div class="container pt-3">
        <!-- Default Admin Banner (when edit mode is closed) -->
        <div id="live-edit-banner-default" class="mb-3">
            <div class="alert alert-info d-flex flex-wrap justify-content-between align-items-center gap-2 shadow-sm rounded-4 mb-0">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary text-white rounded-pill px-3 py-2"><i class="bi bi-shield-check me-1"></i>Beheermodus</span>
                    <span class="fw-bold">Wil je de hoofdpagina aanpassen?</span>
                </div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <button type="button" id="btn-toggle-edit-mode" class="btn btn-chiro btn-sm shadow-sm">
                        <i class="bi bi-pencil-square me-1"></i> Bewerkmodus inschakelen
                    </button>
                </div>
            </div>
        </div>

        <!-- Sticky Floating Toolbar (when edit mode is active) -->
        <div id="live-edit-toolbar" class="live-edit-toolbar d-none mb-3 rounded-4 overflow-hidden">
            <div class="container-fluid d-flex flex-wrap justify-content-between align-items-center gap-3 py-2 px-3">
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <span class="d-inline-flex align-items-center gap-2 fw-bold text-dark">
                        <span class="live-edit-pulse"></span>
                        Bewerkmodus actief
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-2 d-none d-md-inline-block">
                        <i class="bi bi-hand-index-thumb text-primary me-1"></i> Klik op de hero foto om te vervangen of klik op tekst om te typen
                    </span>
                    <span id="live-edit-dirty-badge" class="d-none"></span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button type="button" id="btn-save-inline" class="btn btn-success btn-sm px-3 fw-bold rounded-pill shadow-sm" disabled>
                        <i class="bi bi-cloud-check-fill me-1"></i> <span id="btn-save-text">Opslaan</span>
                    </button>
                    <button type="button" id="btn-cancel-inline" class="btn btn-outline-secondary btn-sm rounded-pill px-3" title="Herstel wijzigingen">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Herstel
                    </button>
                    <button type="button" id="btn-close-edit-mode" class="btn btn-outline-dark btn-sm rounded-pill px-3" title="Bewerkmodus sluiten">
                        <i class="bi bi-x-lg me-1"></i> Sluiten
                    </button>
                </div>
            </div>
        </div>
    </div>
<% } %>

<!-- Full-Width Hero Section at Top -->
<section class="hero-fullwidth-section">
    <div class="hero-fullwidth-media" data-live-edit="hero_image" data-live-edit-type="image" data-live-edit-ratio="2.2">
        <img src="<%= heroImage %>" alt="<%= heroTitle %>" class="hero-fullwidth-img" fetchpriority="high">
        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
            <div class="live-image-overlay">
                <i class="bi bi-crop"></i> <span>Hero foto bijsnijden / vervangen</span>
            </div>
        <% } %>
    </div>
    <div class="hero-wave-divider" aria-hidden="true">
        <svg viewBox="0 0 1440 70" preserveAspectRatio="none">
            <path d="M0,28 C360,65 540,10 720,40 C980,72 1200,18 1440,42 L1440,70 L0,70 Z" fill="var(--bg-color, #fdfbf7)"></path>
        </svg>
    </div>
</section>

<!-- Scrapbook Canvas & Main Content inside Container -->
<div class="container">
    <div class="scrapbook-canvas<% if (user && (user.role === 'admin' || user.role === 'media')) { %> admin-logged-in<% } %>" data-page-slug="home">
        <!-- Spread 1: Overlapping Playful Welcome Spread -->
        <section class="hero-welcome-spread mb-5">
            <span class="washi-tape washi-tape-yellow washi-tape-top-left"></span>
            <span class="washi-tape washi-tape-kraft washi-tape-top-right"></span>

            <div class="text-center py-2">
                <h1 class="journal-main-title mb-3" data-live-edit="hero_title" data-live-edit-type="text">
                    <%= heroTitle %>
                </h1>

                <p class="journal-main-lead mx-auto mb-4" style="max-width: 720px;" data-live-edit="hero_text" data-live-edit-type="text" data-multiline="true">
                    <%= heroText %>
                </p>

                <div class="d-flex flex-wrap justify-content-center gap-3 align-items-center">
                    <a href="<%= heroBtn1Url %>" class="btn btn-chiro" data-live-edit-btn data-live-edit-text="hero_btn1_text" data-live-edit-url="hero_btn1_url">
                        <i class="bi bi-compass me-1"></i> <span class="btn-label"><%= heroBtn1Text %></span>
                    </a>
                    <a href="<%= heroBtn2Url %>" class="btn btn-chiro-outline" data-live-edit-btn data-live-edit-text="hero_btn2_text" data-live-edit-url="hero_btn2_url">
                        <i class="bi bi-journal-richtext me-1"></i> <span class="btn-label"><%= heroBtn2Text %></span>
                    </a>
                </div>
            </div>
        </section>

    <!-- Spread 2: The Integrated Journal & Story Spread (Notebook Page + Sidebar Snapshots) -->
    <section id="logboek" class="mb-5">
        <div class="row g-4 g-lg-5 align-items-start">
            <!-- Main Logbook Story (Notebook page) -->
            <div class="col-lg-8">
                <div class="journal-notebook-page">
                    <span class="washi-tape washi-tape-red washi-tape-top-left"></span>
                    <span class="washi-tape washi-tape-yellow washi-tape-top-right"></span>

                    <div class="journal-notebook-inner">
                        <div class="mb-4 pb-3 border-bottom border-dashed">
                            <span class="badge bg-warning text-dark px-3 py-2 rounded-pill font-playful mb-2" data-live-edit="logbook_badge" data-live-edit-type="text">
                                <%= logbookBadge %>
                            </span>
                            <h2 class="notebook-title m-0" data-live-edit="logbook_title" data-live-edit-type="text"><%= logbookTitle %></h2>
                        </div>

                        <div class="notebook-body mb-4" data-live-edit="intro" data-live-edit-type="rich">
                            <%- (content.intro && content.intro.content) ? content.intro.content : '<p class="text-center py-4">Welkom op onze website. Hier vind je alle info over onze werking.</p>' %>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 pt-3 border-top border-dashed">
                            <div class="font-playful fs-4 text-danger fw-bold">
                                <i class="bi bi-heart-fill me-1"></i> Tot zondag op de Chiro!
                            </div>
                            <div class="d-flex gap-2 flex-wrap">
                                <a href="/leiding" class="btn btn-chiro btn-sm shadow-sm">
                                    <i class="bi bi-people me-1"></i> Ontmoet de Leiding
                                </a>
                                <a href="/contact" class="btn btn-outline-secondary rounded-pill btn-sm px-3">
                                    <i class="bi bi-envelope me-1"></i> Vraagje?
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Integrated Agenda / Upcoming Calendar Events Board -->
                <% 
                var hasUpcomingEvents = typeof upcomingEvents !== 'undefined' && upcomingEvents && upcomingEvents.length > 0;
                %>
                <% if (hasUpcomingEvents) { %>
                    <div class="journal-agenda-board">
                        <span class="washi-tape washi-tape-yellow washi-tape-top-left" style="width: 70px;"></span>
                        <span class="washi-tape washi-tape-kraft washi-tape-top-right" style="width: 55px;"></span>

                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-start align-items-sm-center gap-2 pb-3 border-bottom border-dashed">
                            <div>
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="badge bg-warning text-dark px-3 py-1 rounded-pill font-playful">
                                        <i class="bi bi-calendar-event me-1"></i> Agenda
                                    </span>
                                    <h3 class="notebook-title fs-3 m-0">Aankomende Activiteiten</h3>
                                </div>
                                <p class="text-muted small m-0">Mis geen enkel avontuur! Klik op een activiteit voor uren en details.</p>
                            </div>
                            <a href="/kalender" class="btn btn-chiro-outline btn-sm rounded-pill px-3 font-playful d-inline-flex align-items-center flex-shrink-0">
                                <span>Volledige kalender</span> <i class="bi bi-arrow-right ms-1"></i>
                            </a>
                        </div>

                        <div class="agenda-items-list mt-3">
                            <% upcomingEvents.forEach((event) => { 
                                const [y, m, d] = event.date.split('-').map(Number);
                                const dateObj = new Date(y, m - 1, d);
                                const day = dateObj.getDate();
                                const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
                                const month = monthNames[dateObj.getMonth()];

                                const hasEndDate = event.endDate && event.endDate !== event.date;
                                let dateRangeText = '';
                                if (hasEndDate) {
                                    const [ey, em, ed] = event.endDate.split('-').map(Number);
                                    const endDateObj = new Date(ey, em - 1, ed);
                                    const endDay = endDateObj.getDate();
                                    const endMonth = monthNames[endDateObj.getMonth()];
                                    dateRangeText = `${day} ${month} t/m ${endDay} ${endMonth}`;
                                }

                                const plainDesc = (event.description || '').replace(/<[^>]*>?/gm, '').replace(/&nbsp;/g, ' ').trim();
                                const shortDesc = plainDesc.length > 95 ? plainDesc.slice(0, 92) + '...' : plainDesc;
                                
                                let attCount = 0;
                                try {
                                    const parsedAtts = typeof event.attachments === 'string' ? JSON.parse(event.attachments) : (event.attachments || []);
                                    attCount = parsedAtts.length;
                                } catch(e) {}
                            %>
                                <article class="agenda-item"
                                         data-event="<%= JSON.stringify(event) %>"
                                         onclick="openEventModal(this)"
                                         role="button"
                                         tabindex="0"
                                         onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openEventModal(this);}"
                                         aria-label="Bekijk details van <%= event.title %>">
                                    
                                    <!-- Date Stamp -->
                                    <div class="agenda-date-box">
                                        <span class="agenda-day"><%= day %></span>
                                        <span class="agenda-month"><%= month %></span>
                                    </div>

                                    <!-- Content -->
                                    <div class="agenda-content">
                                        <div class="d-flex flex-wrap align-items-center gap-2 mb-1">
                                            <h4 class="agenda-title font-playful m-0"><%= event.title %></h4>
                                        </div>

                                        <div class="agenda-badges">
                                            <% if (hasEndDate) { %>
                                                <span class="badge bg-warning text-dark rounded-pill">
                                                    <i class="bi bi-calendar-range me-1"></i> <%= dateRangeText %>
                                                </span>
                                            <% } %>
                                            <% if (event.startTime) { %>
                                                <span class="badge bg-white text-secondary border rounded-pill">
                                                    <i class="bi bi-clock me-1 text-primary"></i> <%= event.startTime %><% if (event.endTime) { %> - <%= event.endTime %><% } %>
                                                </span>
                                            <% } %>
                                            <% if (attCount > 0) { %>
                                                <span class="badge bg-white text-muted border rounded-pill">
                                                    <i class="bi bi-paperclip me-1 text-secondary"></i> Bijlage
                                                </span>
                                            <% } %>
                                        </div>

                                        <% if (shortDesc) { %>
                                            <p class="agenda-desc mt-1 mb-0"><%= shortDesc %></p>
                                        <% } %>
                                    </div>

                                    <!-- Arrow Button -->
                                    <div class="agenda-arrow">
                                        <span class="btn btn-sm btn-outline-secondary rounded-pill px-3 d-none d-md-inline-flex align-items-center font-playful">
                                            Details <i class="bi bi-chevron-right ms-1"></i>
                                        </span>
                                        <i class="bi bi-chevron-right text-muted fs-5 d-md-none"></i>
                                    </div>
                                </article>
                            <% }) %>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 pt-3 mt-3 border-top border-dashed">
                            <span class="small text-muted"><i class="bi bi-info-circle me-1"></i> Zondagse activiteiten zijn van 14u tot 17u.</span>
                            <a href="/kalender" class="text-chiro-blue fw-bold small text-decoration-none font-playful">
                                Bekijk de volledige kalender <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                <% } else if (user && (user.role === 'admin' || user.role === 'media')) { %>
                    <div class="journal-agenda-board">
                        <span class="washi-tape washi-tape-yellow washi-tape-top-left" style="width: 70px;"></span>
                        <div class="text-center py-4 px-3 bg-light rounded-4 border border-dashed">
                            <i class="bi bi-calendar-plus text-primary fs-2 mb-2 d-block"></i>
                            <h4 class="font-playful fw-bold text-dark mb-1">Aankomende Activiteiten</h4>
                            <p class="text-muted small mb-3" style="max-width: 460px; margin: 0 auto;">
                                Er zijn momenteel geen activiteiten aangevinkt voor de startpagina. Vink in het kalenderbeheer <strong>'Toon op openbare pagina'</strong> aan om dit vak automatisch te vullen!
                            </p>
                            <a href="/admin/events" class="btn btn-chiro btn-sm shadow-sm rounded-pill px-4">
                                <i class="bi bi-gear-fill me-1"></i> Activiteiten Beheren
                            </a>
                        </div>
                    </div>
                <% } %>
            </div>

            <!-- Sidebar: Reispaspoort & Playful Info Cards (NO photos!) -->
            <div class="col-lg-4">
                <div class="d-flex flex-column gap-4">
                    <!-- Reispaspoort Visa Sheet -->
                    <div class="passport-visa-sheet">
                        <span class="washi-tape washi-tape-kraft washi-tape-top-center" style="width: 75px; height: 18px; top: -9px;"></span>
                        <div class="visa-sheet-header">
                            <span class="visa-title font-playful">✈️ CHIRO REISPASPOORT</span>
                        </div>
                        <div class="visa-grid">
                            <div class="visa-stamp visa-red">
                                <div class="visa-num" data-live-edit="stat_1_num" data-live-edit-type="text"><%= stat1Num %></div>
                                <div class="visa-lbl" data-live-edit="stat_1_lbl" data-live-edit-type="text"><%= stat1Lbl %></div>
                            </div>
                            <div class="visa-stamp visa-blue">
                                <div class="visa-num" data-live-edit="stat_2_num" data-live-edit-type="text"><%= stat2Num %></div>
                                <div class="visa-lbl" data-live-edit="stat_2_lbl" data-live-edit-type="text"><%= stat2Lbl %></div>
                            </div>
                            <div class="visa-stamp visa-yellow">
                                <div class="visa-num" data-live-edit="stat_3_num" data-live-edit-type="text"><%= stat3Num %></div>
                                <div class="visa-lbl" data-live-edit="stat_3_lbl" data-live-edit-type="text"><%= stat3Lbl %></div>
                            </div>
                            <div class="visa-stamp visa-brown">
                                <div class="visa-num" data-live-edit="stat_4_num" data-live-edit-type="text"><%= stat4Num %></div>
                                <div class="visa-lbl" data-live-edit="stat_4_lbl" data-live-edit-type="text"><%= stat4Lbl %></div>
                            </div>
                        </div>
                    </div>

                    <!-- Playful Invitation Notice Card: 3x Gratis Meespelen -->
                    <div class="sidebar-notice-card note-yellow">
                        <span class="washi-tape washi-tape-red washi-tape-top-center" style="width: 75px; height: 18px; top: -9px;"></span>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-balloon-heart-fill text-danger fs-4"></i>
                            <h4 class="font-playful fs-5 m-0 text-dark" data-live-edit="box_join_title" data-live-edit-type="text"><%= boxJoinTitle %></h4>
                        </div>
                        <p class="text-muted small mb-3" data-live-edit="box_join_text" data-live-edit-type="text" data-multiline="true"><%= boxJoinText %></p>
                        <a href="<%= boxJoinBtnUrl %>" class="btn btn-chiro-outline btn-sm rounded-pill w-100 font-playful d-inline-flex justify-content-center align-items-center gap-1" data-live-edit-btn data-live-edit-text="box_join_btn_text" data-live-edit-url="box_join_btn_url">
                            <i class="bi bi-info-circle"></i> <span class="btn-label"><%= boxJoinBtnText %></span>
                        </a>
                    </div>

                    <!-- Playful Quick Facts Notice Card: Goed om te weten -->
                    <div class="sidebar-notice-card note-blue">
                        <span class="washi-tape washi-tape-yellow washi-tape-top-center" style="width: 75px; height: 18px; top: -9px;"></span>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-lightbulb-fill text-warning fs-4"></i>
                            <h4 class="font-playful fs-5 m-0 text-dark" data-live-edit="box_info_title" data-live-edit-type="text"><%= boxInfoTitle %></h4>
                        </div>
                        <ul class="list-unstyled small text-muted mb-3 d-flex flex-column gap-2">
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                                <span data-live-edit="box_info_item_1" data-live-edit-type="text"><%= boxInfoItem1 %></span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                                <span data-live-edit="box_info_item_2" data-live-edit-type="text"><%= boxInfoItem2 %></span>
                            </li>
                            <li class="d-flex align-items-start gap-2">
                                <i class="bi bi-check-circle-fill text-success flex-shrink-0 mt-1"></i>
                                <span data-live-edit="box_info_item_3" data-live-edit-type="text"><%= boxInfoItem3 %></span>
                            </li>
                        </ul>
                        <a href="<%= boxInfoBtnUrl %>" class="text-chiro-blue fw-bold small text-decoration-none font-playful d-inline-flex align-items-center" data-live-edit-btn data-live-edit-text="box_info_btn_text" data-live-edit-url="box_info_btn_url">
                            <span class="btn-label"><%= boxInfoBtnText %></span> <i class="bi bi-arrow-right ms-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Spread 3: Postcards (Quick Navigation) -->
    <section class="mb-5">
        <div class="scrapbook-section-header">
            <span class="scrapbook-stamp-label"><i class="bi bi-signpost-split me-1"></i> Reisgids</span>
            <h2 class="scrapbook-section-title">Snel op Pad</h2>
            <p class="scrapbook-section-subtitle">Alles wat je wilt weten om meteen mee te doen met onze Chiro.</p>
        </div>

        <div class="postcard-grid">
            <a href="/afdelingen" class="postcard-nav-card">
                <span class="washi-tape washi-tape-yellow washi-tape-top-right" style="width: 55px; height: 16px; top: -8px; right: 18px;"></span>
                <div>
