<%- include('../partials/header') %>

<%
var calendarBadge = (content && content.calendar_badge && content.calendar_badge.content) ? content.calendar_badge.content : '📅 Activiteiten & Planning';
var calendarTitle = (content && content.calendar_title && content.calendar_title.content) ? content.calendar_title.content : 'Chiro Kalender';
var calendarLead = (content && content.calendar_lead && content.calendar_lead.content) ? content.calendar_lead.content : 'Al onze zondagen, weekends, feestelijkheden en kampdata overzichtelijk op een rij. Mis geen enkel avontuur!';
%>

<div class="scrapbook-canvas<% if (user && (user.role === 'admin' || user.role === 'media')) { %> admin-logged-in<% } %>" data-page-slug="calendar">
    <%- include('../partials/live_editor_top', { pageSlug: 'calendar', pageTitle: 'Kalender' }) %>

    <!-- Header Spread -->
    <header class="scrapbook-page-header">
        <span class="washi-tape washi-tape-yellow washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-yellow washi-tape-top-right"></span>

        <h1 class="journal-main-title mb-3" data-live-edit="calendar_title" data-live-edit-type="text">
            <%- calendarTitle %>
        </h1>

        <p class="journal-main-lead mb-3" data-live-edit="calendar_lead" data-live-edit-type="text">
            <%- calendarLead %>
        </p>

        <div class="d-flex flex-wrap gap-2 pt-2">
            <a href="/kalender/hulp" class="btn btn-chiro btn-sm shadow-sm" title="Abonneer op de kalender (Google Calendar, iCal, Outlook)">
                <i class="bi bi-calendar-plus me-1"></i> Abonneer op Smartphone
            </a>
            <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                <button type="button" class="btn btn-success btn-sm rounded-pill shadow-sm px-3" onclick="openAddEventModal({ isPrivate: false })">
                    <i class="bi bi-plus-circle me-1"></i> Activiteit Toevoegen
                </button>
                <a href="/admin/events" class="btn btn-outline-primary btn-sm rounded-pill shadow-sm px-3">
                    <i class="bi bi-sliders me-1"></i> Overzicht Beheren
                </a>
            <% } %>
        </div>
    </header>

    <!-- Subscription Tip Note -->
    <div class="scrapbook-card mb-4 p-3 bg-light border-0">
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-lightbulb-fill fs-3 text-warning"></i>
            <div class="small text-muted">
                <strong>Handige tip:</strong> Klik op <a href="/kalender/hulp" class="fw-bold text-chiro-blue text-decoration-underline">Abonneer op Smartphone</a> om alle activiteiten rechtstreeks te synchroniseren met je Apple, Google of Outlook agenda!
            </div>
        </div>
    </div>

    <!-- Events List -->
    <% if (events.length === 0) { %>
        <div class="scrapbook-notebook-card text-center py-5 my-4">
            <span class="washi-tape washi-tape-kraft washi-tape-top-center"></span>
            <div class="scrapbook-notebook-inner py-4">
                <i class="bi bi-calendar-x display-2 text-muted opacity-50 mb-3 d-block"></i>
                <h3 class="fw-bold text-dark font-playful">Even rustig aan doen...</h3>
                <p class="text-muted lead mb-0">Er staan momenteel geen activiteiten op de planning. Houd deze pagina in de gaten voor komende evenementen!</p>
            </div>
        </div>
    <% } else { %>
        <div class="row g-3 mb-5">
            <% events.forEach(event => { 
                const [y, m, d] = event.date.split('-').map(Number);
                const dateObj = new Date(y, m - 1, d);
                const day = dateObj.getDate();
                const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
                const month = monthNames[dateObj.getMonth()];

                let dateDisplay = '';
                const hasEndDate = event.endDate && event.endDate !== event.date;
                if (hasEndDate) {
                    const [ey, em, ed] = event.endDate.split('-').map(Number);
                    const endDateObj = new Date(ey, em - 1, ed);
                    const endDay = endDateObj.getDate();
                    const endMonth = monthNames[endDateObj.getMonth()];
                    dateDisplay = `${day} ${month} t/m ${endDay} ${endMonth}`;
                }
            %>
                <div class="col-12">
                    <div class="calendar-ticket-item d-flex flex-column flex-sm-row align-items-stretch align-items-sm-center gap-3" 
                         data-event="<%= JSON.stringify(event) %>"
                         onclick="openEventModal(this)">
                        
                        <div class="d-flex align-items-center gap-3 flex-grow-1" style="min-width: 0;">
                            <!-- Ticket Date Stamp -->
                            <div class="calendar-ticket-stamp">
                                <span class="calendar-ticket-day"><%= day %></span>
                                <span class="calendar-ticket-month"><%= month %></span>
                            </div>
                            
                            <!-- Event Info -->
                            <div class="flex-grow-1" style="min-width: 0;">
                                <h4 class="mb-1 text-chiro-blue fw-bold font-playful text-break"><%= event.title %></h4>
                                <div class="d-flex flex-wrap gap-2 mt-1 align-items-center">
                                    <% if (hasEndDate) { %>
                                        <span class="badge bg-warning text-dark rounded-pill">
                                            <i class="bi bi-calendar-range me-1"></i> <%= dateDisplay %>
                                        </span>
                                    <% } %>
                                    <% if (event.startTime) { %>
                                        <span class="badge bg-light text-muted border rounded-pill">
                                            <i class="bi bi-clock me-1 text-primary"></i> <%= event.startTime %><% if (event.endTime) { %> - <%= event.endTime %><% } %>
                                        </span>
                                    <% } %>
                                    <% if (event.location) { %>
                                        <span class="badge bg-light text-muted border rounded-pill d-none d-md-inline-block">
                                            <i class="bi bi-geo-alt me-1 text-danger"></i> <%= event.location %>
                                        </span>
                                    <% } %>
                                </div>
                            </div>
                            <i class="bi bi-chevron-right text-muted d-sm-none ms-auto flex-shrink-0"></i>
                        </div>
                        
                        <div class="d-flex align-items-center justify-content-end gap-2 flex-shrink-0 <%= (user && (user.role === 'admin' || user.role === 'media')) ? 'border-top pt-2 pt-sm-0 border-sm-0-reset' : 'd-none d-sm-flex' %>">
                            <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary rounded-pill px-3 d-inline-flex align-items-center justify-content-center flex-grow-1 flex-sm-grow-0"
                                        title="Rechtstreeks bewerken"
                                        onclick="event.stopPropagation(); openEditEventModal(this.closest('.calendar-ticket-item'))">
                                    <i class="bi bi-pencil-square me-1"></i><span>Bewerken</span>
                                </button>
                            <% } %>
                            <span class="btn btn-sm btn-light rounded-pill px-3 d-none d-sm-inline-flex align-items-center font-playful">
                                Details <i class="bi bi-chevron-right ms-1"></i>
                            </span>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<%- include('../partials/event_modal') %>

<%- include('../partials/live_editor_bottom') %>
<%- include('../partials/footer') %>
