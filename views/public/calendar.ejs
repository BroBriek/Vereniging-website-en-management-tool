<%- include('../partials/header') %>

<%
var calendarBadge = (content && content.calendar_badge && content.calendar_badge.content) ? content.calendar_badge.content : '📅 Activiteiten & Planning';
var calendarTitle = (content && content.calendar_title && content.calendar_title.content) ? content.calendar_title.content : 'Chiro Kalender';
var calendarLead = (content && content.calendar_lead && content.calendar_lead.content) ? content.calendar_lead.content : 'Al onze zondagen, weekends, feestelijkheden en kampdata overzichtelijk op een rij. Mis geen enkel avontuur!';
%>

<div class="scrapbook-canvas<% if (user && (user.role === 'admin' || user.role === 'media')) { %> admin-logged-in<% } %>" data-page-slug="calendar">
    <%- include('../partials/live_editor_top', { pageSlug: 'calendar', pageTitle: 'Kalender' }) %>

    <!-- Header Spread -->
    <header class="scrapbook-page-header">
        <span class="washi-tape washi-tape-yellow washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-kraft washi-tape-top-right"></span>

        <h1 class="journal-main-title mb-3" data-live-edit="calendar_title" data-live-edit-type="text">
            <%= calendarTitle %>
        </h1>

        <p class="journal-main-lead mb-3" data-live-edit="calendar_lead" data-live-edit-type="text">
            <%= calendarLead %>
        </p>

        <div class="d-flex flex-wrap gap-2 pt-2">
            <a href="/kalender/hulp" class="btn btn-chiro btn-sm shadow-sm" title="Abonneer op de kalender (Google Calendar, iCal, Outlook)">
                <i class="bi bi-calendar-plus me-1"></i> Abonneer op Smartphone
            </a>
            <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                <a href="/admin/events" class="btn btn-outline-primary btn-sm rounded-pill shadow-sm">
                    <i class="bi bi-calendar-plus me-1"></i> Activiteiten beheren
                </a>
            <% } %>
        </div>
    </header>

    <!-- Subscription Tip Note -->
    <div class="scrapbook-card mb-4 p-3 bg-light border-0">
        <span class="washi-tape washi-tape-yellow washi-tape-top-left" style="width: 70px;"></span>
        <div class="d-flex align-items-center gap-3">
            <i class="bi bi-lightbulb-fill fs-3 text-warning"></i>
            <div class="small text-muted">
                <strong>Handige tip:</strong> Klik op <a href="/kalender/hulp" class="fw-bold text-chiro-blue text-decoration-underline">Abonneer op Smartphone</a> om alle activiteiten rechtstreeks te synchroniseren met je Apple, Google of Outlook agenda!
            </div>
        </div>
    </div>

    <!-- Events List -->
    <% if (events.length === 0) { %>
        <div class="scrapbook-notebook-card text-center py-5 my-4">
            <span class="washi-tape washi-tape-kraft washi-tape-top-center"></span>
            <div class="scrapbook-notebook-inner py-4">
                <i class="bi bi-calendar-x display-2 text-muted opacity-50 mb-3 d-block"></i>
                <h3 class="fw-bold text-dark font-playful">Even rustig aan doen...</h3>
                <p class="text-muted lead mb-0">Er staan momenteel geen activiteiten op de planning. Houd deze pagina in de gaten voor komende evenementen!</p>
            </div>
        </div>
    <% } else { %>
        <div class="row g-3 mb-5">
            <% events.forEach(event => { 
                const [y, m, d] = event.date.split('-').map(Number);
                const dateObj = new Date(y, m - 1, d);
                const day = dateObj.getDate();
                const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
                const month = monthNames[dateObj.getMonth()];

                let dateDisplay = '';
                const hasEndDate = event.endDate && event.endDate !== event.date;
                if (hasEndDate) {
                    const [ey, em, ed] = event.endDate.split('-').map(Number);
                    const endDateObj = new Date(ey, em - 1, ed);
                    const endDay = endDateObj.getDate();
                    const endMonth = monthNames[endDateObj.getMonth()];
                    dateDisplay = `${day} ${month} t/m ${endDay} ${endMonth}`;
                }
            %>
                <div class="col-12">
                    <div class="calendar-ticket-item d-flex align-items-center gap-3" 
                         data-event="<%= JSON.stringify(event) %>"
                         onclick="openEventModal(this)">
                        
                        <!-- Ticket Date Stamp -->
                        <div class="calendar-ticket-stamp">
                            <span class="washi-tape washi-tape-yellow washi-tape-top-center" style="width: 45px; height: 16px; top: -8px;"></span>
                            <span class="calendar-ticket-day"><%= day %></span>
                            <span class="calendar-ticket-month"><%= month %></span>
                        </div>
                        
                        <!-- Event Info -->
                        <div class="flex-grow-1">
                            <h4 class="mb-1 text-chiro-blue fw-bold font-playful"><%= event.title %></h4>
                            <div class="d-flex flex-wrap gap-2 mt-1 align-items-center">
                                <% if (hasEndDate) { %>
                                    <span class="badge bg-warning text-dark rounded-pill">
                                        <i class="bi bi-calendar-range me-1"></i> <%= dateDisplay %>
                                    </span>
                                <% } %>
                                <% if (event.startTime) { %>
                                    <span class="badge bg-light text-muted border rounded-pill">
                                        <i class="bi bi-clock me-1 text-primary"></i> <%= event.startTime %><% if (event.endTime) { %> - <%= event.endTime %><% } %>
                                    </span>
                                <% } %>
                                <% if (event.location) { %>
                                    <span class="badge bg-light text-muted border rounded-pill d-none d-md-inline-block">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i> <%= event.location %>
                                    </span>
                                <% } %>
                            </div>
                        </div>
                        
                        <div class="ms-auto d-flex align-items-center gap-2">
                            <span class="btn btn-sm btn-light rounded-pill px-3 d-none d-sm-inline-flex align-items-center font-playful">
                                Details <i class="bi bi-chevron-right ms-1"></i>
                            </span>
                            <i class="bi bi-chevron-right text-muted d-sm-none"></i>
                        </div>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } %>
</div>

<!-- Event Details Modal -->
<div class="modal fade" id="eventModal" tabindex="-1" aria-labelledby="eventModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden position-relative">
            <span class="washi-tape washi-tape-red washi-tape-top-center"></span>
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="d-flex flex-column flex-sm-row gap-4 align-items-start align-items-sm-center mb-4">
                    <div id="modalDateBadge" class="calendar-ticket-stamp mx-auto mx-sm-0" style="width: 80px; height: 80px;">
                        <span id="modalDay" class="calendar-ticket-day fs-2"></span>
                        <span id="modalMonth" class="calendar-ticket-month"></span>
                    </div>
                    <div>
                        <h3 id="modalEventTitle" class="fw-bold mb-2 font-playful"></h3>
                        <div class="d-flex flex-wrap gap-2 text-muted small">
                            <span id="modalFullDate" class="badge bg-light text-dark border rounded-pill px-3 py-1"></span>
                            <span id="modalTimeInfo" class="badge bg-light text-dark border rounded-pill px-3 py-1 d-none">
                                <i class="bi bi-clock me-1 text-primary"></i><span id="modalTimeText"></span>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="scrapbook-card p-4 bg-light border-0 mb-4">
                    <h5 class="fw-bold text-dark font-playful mb-2">Over deze activiteit</h5>
                    <div id="modalEventDesc" class="text-muted" style="line-height: 1.6;"></div>
                </div>

                <div id="modalAttachmentsSection" class="d-none">
                    <h5 class="fw-bold text-dark font-playful mb-2">
                        <i class="bi bi-paperclip me-1 text-primary"></i> Bijlagen
                    </h5>
                    <div id="modalAttachmentsList" class="list-group rounded-3 border-0 shadow-sm"></div>
                </div>
            </div>
            <div class="modal-footer border-0 justify-content-end p-4 pt-0">
                <button type="button" class="btn btn-chiro rounded-pill px-4" data-bs-dismiss="modal">Sluiten</button>
            </div>
        </div>
    </div>
</div>

<script>
    function openEventModal(element) {
        const eventJson = element.getAttribute('data-event');
        if (!eventJson) return;
        
        const event = JSON.parse(eventJson);
        
        const [y, m, d] = event.date.split('-').map(Number);
        const dateObj = new Date(y, m - 1, d);
        const monthNames = ["JAN", "FEB", "MRT", "APR", "MEI", "JUN", "JUL", "AUG", "SEP", "OKT", "NOV", "DEC"];
        const fullMonthNames = ["januari", "februari", "maart", "april", "mei", "juni", "juli", "augustus", "september", "oktober", "november", "december"];
        
        document.getElementById('modalDay').textContent = dateObj.getDate();
        document.getElementById('modalMonth').textContent = monthNames[dateObj.getMonth()];
        
        let fullDateText = `${dateObj.getDate()} ${fullMonthNames[dateObj.getMonth()]} ${dateObj.getFullYear()}`;
        if (event.endDate && event.endDate !== event.date) {
            const [ey, em, ed] = event.endDate.split('-').map(Number);
            const endDateObj = new Date(ey, em - 1, ed);
            fullDateText += ` t/m ${endDateObj.getDate()} ${fullMonthNames[endDateObj.getMonth()]} ${endDateObj.getFullYear()}`;
        }
        document.getElementById('modalFullDate').textContent = fullDateText;

        const timeInfo = document.getElementById('modalTimeInfo');
        if (event.startTime) {
            let timeText = event.startTime;
            if (event.endTime) timeText += ` - ${event.endTime}`;
            document.getElementById('modalTimeText').textContent = timeText;
            timeInfo.classList.remove('d-none');
        } else {
            timeInfo.classList.add('d-none');
        }

        document.getElementById('modalEventTitle').textContent = event.title;
        document.getElementById('modalEventDesc').innerHTML = event.description || '<span class="text-muted fst-italic">Geen extra beschrijving beschikbaar.</span>';
        
        const attachmentsSection = document.getElementById('modalAttachmentsSection');
        const attachmentsList = document.getElementById('modalAttachmentsList');
        attachmentsList.innerHTML = '';
        
        let attachments = [];
        try {
            attachments = typeof event.attachments === 'string' ? JSON.parse(event.attachments) : (event.attachments || []);
        } catch (e) {
            console.error('Error parsing attachments:', e);
        }

        if (attachments && attachments.length > 0) {
            attachmentsSection.classList.remove('d-none');
            attachments.forEach(att => {
                const a = document.createElement('a');
                a.href = `/download?path=${encodeURIComponent(att.path)}&name=${encodeURIComponent(att.name)}`;
                a.className = 'list-group-item list-group-item-action d-flex align-items-center py-3';
                a.onclick = (e) => {
                    e.preventDefault();
                    if (typeof openFilePreview === 'function') {
                        openFilePreview(att.path, att.name);
                    } else {
                        window.location.href = a.href;
                    }
                    return false;
                };
                a.innerHTML = `
                    <i class="bi bi-file-earmark-arrow-down fs-4 me-3 text-primary"></i>
                    <div class="flex-grow-1">
                        <div class="fw-bold text-dark">${att.name}</div>
                        <small class="text-muted">Klik om te downloaden / bekijken</small>
                    </div>
                    <i class="bi bi-chevron-right text-muted small"></i>
                `;
                attachmentsList.appendChild(a);
            });
        } else {
            attachmentsSection.classList.add('d-none');
        }

        const myModal = new bootstrap.Modal(document.getElementById('eventModal'));
        myModal.show();
    }
</script>

<%- include('../partials/live_editor_bottom') %>
<%- include('../partials/footer') %>
