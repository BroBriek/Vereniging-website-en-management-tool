<%- include('../partials/header') %>

<%
var shirtsBadge = (content.shirts_badge && content.shirts_badge.content) ? content.shirts_badge.content : ('👕 Officiële Chiro ' + orgName + ' Kledij');
var shirtsTitle = (content.shirts_title && content.shirts_title.content) ? content.shirts_title.content : (orgName + ' T-shirt');
var shirtsLead = (content.shirts_lead && content.shirts_lead.content) ? content.shirts_lead.content : 'Herkenbaar, oersterk en supercomfortabel voor elke zondag, uitstap en kamp!';
var shirtPrice = (content.shirt_price && content.shirt_price.content) ? content.shirt_price.content : '€15';
var shirtImg = (content.shirt_image && content.shirt_image.content) ? content.shirt_image.content : null;
%>

<div class="scrapbook-canvas<% if (user && (user.role === 'admin' || user.role === 'media')) { %> admin-logged-in<% } %>" data-page-slug="shirts">
    <%- include('../partials/live_editor_top', { pageSlug: 'shirts', pageTitle: 'T-Shirts' }) %>

    <!-- Header Spread -->
    <header class="scrapbook-page-header">
        <span class="washi-tape washi-tape-red washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-yellow washi-tape-top-right"></span>

        <h1 class="journal-main-title mb-3" data-live-edit="shirts_title" data-live-edit-type="text">
            <%= shirtsTitle %>
        </h1>

        <p class="journal-main-lead mb-0" data-live-edit="shirts_lead" data-live-edit-type="text">
            <%= shirtsLead %>
        </p>
    </header>

    <div class="row g-5 mb-5">
        <!-- Product Image Section (Left) -->
        <div class="col-lg-5">
            <div class="position-sticky" style="top: 100px;">
                <div class="sidebar-polaroid shirt-showcase-box p-4" style="box-shadow: 0 16px 35px rgba(0,0,0,0.08);">
                    <span class="washi-tape washi-tape-yellow washi-tape-top-center"></span>
                    <div class="shirt-price-stamp" data-live-edit="shirt_price" data-live-edit-type="text"><%= shirtPrice %></div>

                    <div class="polaroid-img-wrapper my-3" data-live-edit="shirt_image" data-live-edit-type="image" data-live-edit-ratio="1" style="aspect-ratio: 1/1; background-color: #f0f7ff;">
                        <% if (shirtImg) { %>
                            <img src="<%= shirtImg %>" alt="<%= orgName %> T-shirt" class="polaroid-img" style="object-fit: contain; padding: 1.5rem;">
                        <% } else { %>
                            <div class="d-flex align-items-center justify-content-center h-100 py-4">
                                <div class="rounded-circle mx-auto d-flex align-items-center justify-content-center" style="width: 220px; height: 220px; background-color: #e3f2fd;">
                                    <span style="font-size: 7.5rem; line-height: 1;">👕</span>
                                </div>
                            </div>
                        <% } %>
                        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                            <div class="live-image-overlay">
                                <i class="bi bi-crop"></i> <span>T-shirt foto aanpassen</span>
                            </div>
                        <% } %>
                    </div>

                    <div class="polaroid-caption font-playful fs-4"><%= orgName %> Shirt</div>
                    <div class="polaroid-tag">ORIGINAL MERCHANDISE</div>
                </div>

                <!-- Product Details Box -->
                <div class="scrapbook-card mt-4 p-4">
                    <span class="washi-tape washi-tape-kraft washi-tape-top-left" style="width: 70px;"></span>
                    <h5 class="fw-bold text-chiro-blue mb-3 font-playful">
                        <i class="bi bi-patch-check-fill text-success me-2"></i>Product details
                    </h5>
                    <ul class="list-unstyled mb-0 text-muted">
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> 100% Duurzaam kwaliteitskatoen</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Originele Chiro-blauwe kleur</li>
                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i> Slijtvaste, wasbare zeefdruk</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i> Ideaal voor zondagen, weekends & kamp</li>
                    </ul>
                </div>
            </div>
        </div>

        <!-- Product Info & Order Form Section (Right) -->
        <div class="col-lg-7">
            <div class="scrapbook-notebook-card p-4 p-md-5">
                <span class="washi-tape washi-tape-red washi-tape-top-right"></span>

                <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                    <span class="scrapbook-stamp-label mb-0">
                        <i class="bi bi-bag-check me-1"></i> Bestelformulier
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill font-playful px-3 py-1">
                        Snel en eenvoudig
                    </span>
                </div>

                <!-- Editable Content Area (Price/Description) -->
                <div class="notebook-body mb-4" data-live-edit="main" data-live-edit-type="rich">
                    <%- (content.main && content.main.content) ? content.main.content : `
                    <p>Het officiële T-shirt van ${orgFullName}! Perfect voor op zondagen, uitstappen en ons legendarische zomerkamp. Zo zijn we in één oogopslag herkenbaar als één grote familie.</p>
                    ` %>
                </div>

                <hr class="my-4 opacity-10">

                <!-- Step 1: Size -->
                <div class="mb-5">
                    <label class="h5 fw-bold text-chiro-blue mb-3 d-flex align-items-center font-playful">
                        <span class="step-number me-3">1</span> Kies je maat
                    </label>
                    
                    <div class="mb-4">
                        <small class="text-uppercase fw-bold text-muted ls-1 mb-2 d-block">Kinderen</small>
                        <div class="d-flex flex-wrap gap-2">
                            <% ['4/6 jaar', '6/8 jaar', '8/10 jaar', '10/12 jaar', '12/14 jaar'].forEach(size => { %>
                                <input type="radio" class="btn-check" name="size" id="size-<%= size.replace(/[^a-zA-Z0-9]/g, '') %>" value="<%= size %>" autocomplete="off" onchange="updateUI()">
                                <label class="btn btn-size-select" for="size-<%= size.replace(/[^a-zA-Z0-9]/g, '') %>"><%= size %></label>
                            <% }) %>
                        </div>
                    </div>

                    <div>
                        <small class="text-uppercase fw-bold text-muted ls-1 mb-2 d-block">Volwassenen / Leiding</small>
                        <div class="d-flex flex-wrap gap-2">
                            <% ['S', 'M', 'L', 'XL', 'XXL'].forEach(size => { %>
                                <input type="radio" class="btn-check" name="size" id="size-<%= size %>" value="<%= size %>" autocomplete="off" onchange="updateUI()">
                                <label class="btn btn-size-select" for="size-<%= size %>"><%= size %></label>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <!-- Step 2: Name -->
                <div class="mb-5">
                    <label for="memberName" class="h5 fw-bold text-chiro-blue mb-3 d-flex align-items-center font-playful">
                        <span class="step-number me-3">2</span> Voor wie is het T-shirt?
                    </label>
                    <div class="input-group input-group-lg shadow-sm border rounded-pill overflow-hidden bg-white">
                        <span class="input-group-text bg-white border-0 ps-4"><i class="bi bi-person text-chiro-red fs-5"></i></span>
                        <input type="text" id="memberName" class="form-control border-0 py-3" placeholder="Naam + Voornaam lid" oninput="updateUI()">
                    </div>
                </div>

                <!-- Step 3: Payment (Dynamically shown) -->
                <div id="paymentBox" class="shirt-receipt-box d-none">
                    <span class="washi-tape washi-tape-yellow washi-tape-top-center"></span>
                    <label class="h5 fw-bold text-chiro-blue mb-3 d-flex align-items-center font-playful">
                        <span class="step-number me-3">3</span> Bestellen maar!
                    </label>
                    
                    <p class="mb-4">Top! Stort <span class="fw-bold text-chiro-red fs-5"><%= shirtPrice %></span> op het onderstaande rekeningnummer om je bestelling te voltooien.</p>
                    
                    <div class="order-summary-card p-4 rounded-4 mb-4 bg-white shadow-sm border-start border-4 border-chiro-yellow">
                        <div class="mb-3">
                            <small class="text-muted d-block mb-1">Rekeningnummer (IBAN)</small>
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <span class="fw-bold fs-5 text-dark font-monospace">BE71 7845 4208 8869</span>
                                <button type="button" class="btn btn-sm btn-light rounded-circle shadow-sm" onclick="copyText('BE71 7845 4208 8869', this)" title="Kopieer IBAN">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                        <div class="mb-0">
                            <small class="text-muted d-block mb-1">Vermelding / Mededeling</small>
                            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                                <span id="summaryRef" class="fw-bold fs-5 text-chiro-red font-monospace" style="white-space: pre-line;">...</span>
                                <button type="button" class="btn btn-sm btn-light rounded-circle shadow-sm" onclick="copyRef(this)" title="Kopieer mededeling">
                                    <i class="bi bi-clipboard"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info border-0 rounded-4 bg-light-blue d-flex align-items-start gap-3 p-4 mb-0">
                        <i class="bi bi-truck fs-3 mt-n1 text-primary"></i>
                        <p class="mb-0 small text-muted">
                            Wanneer de betaling ontvangen is, leggen we het T-shirt voor je klaar. Je kan het dan eenvoudig ophalen op de eerstvolgende Chiro-zondag!
                        </p>
                    </div>
                </div>

                <!-- Prompt when not yet selected -->
                <div id="formPrompt" class="text-center p-4 p-md-5 rounded-4 border-2 border-dashed border-secondary border-opacity-25 bg-light mt-3">
                    <i class="bi bi-arrow-up-circle fs-2 text-chiro-blue mb-2 d-block"></i>
                    <p class="mb-0 text-muted font-playful">Kies hierboven een maat en vul de naam in om de betaalinstructies te ontgrendelen.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    :root {
        --light-blue-bg: #f0f7ff;
    }

    .bg-light-blue { background-color: var(--light-blue-bg); }

    .step-number {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        background-color: var(--chiro-red);
        color: white;
        border-radius: 50%;
        font-size: 0.9rem;
        box-shadow: 0 4px 10px rgba(219, 62, 65, 0.2);
    }

    .btn-size-select {
        border: 2px solid #edf2f7;
        background: white;
        color: #4a5568;
        padding: 10px 18px;
        border-radius: 16px;
        font-weight: 600;
        font-family: var(--font-heading);
        transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

    .btn-size-select:hover {
        border-color: var(--chiro-blue);
        color: var(--chiro-blue);
        transform: translateY(-2px);
    }

    .btn-check:checked + .btn-size-select {
        background-color: var(--chiro-blue);
        border-color: var(--chiro-blue);
        color: white;
        box-shadow: 0 4px 12px rgba(29, 78, 137, 0.25);
    }

    .order-summary-card {
        border-left: 5px solid var(--chiro-yellow) !important;
    }
</style>

<script>
    function updateUI() {
        const nameInput = document.getElementById('memberName');
        const name = nameInput ? nameInput.value.trim() : '';
        const sizeElement = document.querySelector('input[name="size"]:checked');
        const size = sizeElement ? sizeElement.value : null;
        
        const paymentBox = document.getElementById('paymentBox');
        const prompt = document.getElementById('formPrompt');
        const refText = document.getElementById('summaryRef');
        
        if (name && size) {
            paymentBox.classList.remove('d-none');
            prompt.classList.add('d-none');
            refText.innerText = 'T-shirt — ' + name + ' — ' + size;
        } else {
            paymentBox.classList.add('d-none');
            prompt.classList.remove('d-none');
        }
    }

    function copyText(text, btn) {
        navigator.clipboard.writeText(text).then(() => {
            const icon = btn.querySelector('i');
            icon.className = 'bi bi-check2 text-success';
            setTimeout(() => { icon.className = 'bi bi-clipboard'; }, 2000);
        });
    }

    function copyRef(btn) {
        const text = document.getElementById('summaryRef').innerText;
        copyText(text, btn);
    }
</script>

<%- include('../partials/live_editor_bottom') %>
<%- include('../partials/footer') %>
