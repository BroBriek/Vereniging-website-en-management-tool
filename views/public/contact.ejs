<%- include('../partials/header') %>

<%
var contactBadge = (content && content.contact_badge && content.contact_badge.content) ? content.contact_badge.content : '✉️ Zeg Eens Hallo • Contact';
var contactTitle = (content && content.contact_title && content.contact_title.content) ? content.contact_title.content : 'Contacteer Ons';
var contactLead = (content && content.contact_lead && content.contact_lead.content) ? content.contact_lead.content : 'Heb je een vraag over onze werking, wil je een keertje komen proberen of wil je de leiding iets laten weten? Stuur ons gerust een bericht!';

var contactImg = (content && content.contact_polaroid_img && content.contact_polaroid_img.content) ? content.contact_polaroid_img.content : '/uploads/image-1791810054939-717577279.jpeg';
var contactCap = (content && content.contact_polaroid_cap && content.contact_polaroid_cap.content) ? content.contact_polaroid_cap.content : 'Onze Chiro-thuisbasis 🌲';
%>

<div class="scrapbook-canvas<% if (user && (user.role === 'admin' || user.role === 'media')) { %> admin-logged-in<% } %>" data-page-slug="contact">
    <%- include('../partials/live_editor_top', { pageSlug: 'contact', pageTitle: 'Contact' }) %>

    <!-- Header Spread -->
    <header class="scrapbook-page-header">
        <span class="washi-tape washi-tape-yellow washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-blue washi-tape-top-right"></span>

        <h1 class="journal-main-title mb-3" data-live-edit="contact_title" data-live-edit-type="text">
            <%= contactTitle %>
        </h1>

        <p class="journal-main-lead mb-0" data-live-edit="contact_lead" data-live-edit-type="text">
            <%= contactLead %>
        </p>
    </header>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success shadow-sm rounded-4 border-0 p-4 mb-4 d-flex align-items-center gap-3">
            <i class="bi bi-check-circle-fill fs-2 text-success"></i>
            <div>
                <strong class="fs-5 d-block font-playful">Bedankt voor je bericht!</strong>
                <span class="text-muted">We hebben je bericht goed ontvangen en nemen zo snel mogelijk contact met je op.</span>
            </div>
        </div>
    <% } %>

    <div class="row g-5 mb-5">
        <!-- Contact Details & Postcard (Left) -->
        <div class="col-lg-5">
            <div class="contact-postcard-box p-4 p-md-5 mb-4">
                <span class="washi-tape washi-tape-yellow washi-tape-top-center"></span>
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <span class="scrapbook-stamp-label mb-0">
                        <i class="bi bi-geo-alt me-1"></i> Onze Gegevens
                    </span>
                </div>

                <div class="d-flex flex-column gap-3 mb-4">
                    <div class="d-flex align-items-start gap-3">
                        <div class="postcard-icon-box bg-danger flex-shrink-0" style="width: 40px; height: 40px; font-size: 1.2rem;">
                            <i class="bi bi-envelope"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold font-playful">E-mail</small>
                            <a href="mailto:<%= contactEmail %>" class="fw-bold text-dark text-decoration-none"><%= contactEmail %></a>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="postcard-icon-box bg-primary flex-shrink-0" style="width: 40px; height: 40px; font-size: 1.2rem;">
                            <i class="bi bi-geo-alt"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold font-playful">Lokalen / Adres</small>
                            <span class="fw-bold text-dark">Kloosterstraat 5, 3670 Meeuwen</span>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="postcard-icon-box bg-warning text-dark flex-shrink-0" style="width: 40px; height: 40px; font-size: 1.2rem;">
                            <i class="bi bi-clock"></i>
                        </div>
                        <div>
                            <small class="text-muted d-block text-uppercase fw-bold font-playful">Chirozondagen</small>
                            <span class="fw-bold text-dark">Om de 2 weken van 14u00 tot 17u00</span>
                        </div>
                    </div>
                </div>

                <!-- Taped Polaroid Snapshot -->
                <div class="sidebar-polaroid p-2 mt-4">
                    <div class="polaroid-img-wrapper" data-live-edit="contact_polaroid_img" data-live-edit-type="image" data-live-edit-ratio="1.33333" style="aspect-ratio: 4/3;">
                        <img src="<%= contactImg %>" alt="<%= contactCap %>" class="polaroid-img" loading="lazy">
                        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                            <div class="live-image-overlay">
                                <i class="bi bi-crop"></i> <span>Foto aanpassen</span>
                            </div>
                        <% } %>
                    </div>
                    <div class="polaroid-caption font-playful fs-5" data-live-edit="contact_polaroid_cap" data-live-edit-type="text"><%= contactCap %></div>
                </div>
            </div>
        </div>

        <!-- Message Form (Right) -->
        <div class="col-lg-7">
            <div class="scrapbook-card p-4 p-md-5">
                <span class="washi-tape washi-tape-kraft washi-tape-top-right"></span>

                <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-3">
                    <span class="scrapbook-stamp-label mb-0">
                        <i class="bi bi-chat-left-text me-1"></i> Schrijf Een Berichtje
                    </span>
                    <span class="badge bg-light text-muted border rounded-pill font-playful px-3 py-1">
                        We helpen je graag
                    </span>
                </div>

                <div style="position: relative; min-height: 380px;">
                    <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %>
                        <div class="d-flex justify-content-center align-items-center" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; background-color: rgba(255,255,255,0.75); border-radius: 20px;">
                            <div class="alert alert-warning shadow p-4 rounded-4 border-0 text-center">
                                <i class="bi bi-exclamation-triangle-fill fs-2 text-warning d-block mb-2"></i>
                                <h5 class="alert-heading fw-bold font-playful mb-0">Deze functie is tijdelijk niet beschikbaar</h5>
                            </div>
                        </div>
                    <% } %>

                    <% if (typeof captchaEnabled !== 'undefined' && captchaEnabled && recaptchaSiteKey) { %>
                        <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>"></script>
                    <% } %>

                    <form id="contactForm" action="/contact" method="POST" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> style="filter: blur(4px); pointer-events: none; user-select: none;" tabindex="-1" <% } %>>
                        <!-- Honeypot field to prevent spam -->
                        <div style="position: absolute; left: -9999px;">
                            <label for="website">Website</label>
                            <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                        </div>
                        
                        <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">

                        <div class="row g-4 mb-3">
                            <div class="col-md-6">
                                <label for="name" class="form-label fw-bold font-playful">Je Naam</label>
                                <input type="text" class="form-control rounded-pill px-4 py-2 border shadow-sm" id="name" name="name" required placeholder="Bijv. Jan Klaassen" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>>
                            </div>
                            <div class="col-md-6">
                                <label for="email" class="form-label fw-bold font-playful">Je E-mailadres</label>
                                <input type="email" class="form-control rounded-pill px-4 py-2 border shadow-sm" id="email" name="email" required placeholder="je@email.be" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>>
                            </div>
                        </div>
                        
                        <div class="mb-4">
                            <label for="message" class="form-label fw-bold font-playful">Je Bericht</label>
                            <textarea class="form-control rounded-4 p-3 border shadow-sm" id="message" name="message" rows="6" required placeholder="Waar kunnen we je mee helpen? Typ hier je vraag of opmerking..." <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>></textarea>
                        </div>

                        <button type="submit" class="btn btn-chiro btn-lg w-100 py-3 shadow font-playful" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>>
                            <i class="bi bi-send-fill me-2"></i> Verstuur Bericht
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<% if (typeof captchaEnabled !== 'undefined' && captchaEnabled && recaptchaSiteKey) { %>
<script>
    document.getElementById('contactForm').addEventListener('submit', function(e) {
        e.preventDefault();
        grecaptcha.ready(function() {
            grecaptcha.execute('<%= recaptchaSiteKey %>', {action: 'submit'}).then(function(token) {
                document.getElementById('g-recaptcha-response').value = token;
                document.getElementById('contactForm').submit();
            });
        });
    });
</script>
<% } %>

<%- include('../partials/live_editor_bottom') %>
<%- include('../partials/footer') %>
