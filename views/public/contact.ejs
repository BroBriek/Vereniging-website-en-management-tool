<%- include('../partials/header') %>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-4 fw-bold mb-0">Contact</h1>
    </div>

    <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-success shadow-sm rounded-4 border-0 p-4 mb-4">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>Bedankt voor je bericht!</strong> We nemen zo snel mogelijk contact op.
        </div>
    <% } %>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-body p-4 p-md-5">
            <div style="position: relative; min-height: 400px;">
                <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %>
                    <div class="d-flex justify-content-center align-items-center" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 10; background-color: rgba(255,255,255,0.7); border-radius: 20px;">
                        <div class="alert alert-warning shadow-lg p-4 rounded-4 border-0">
                            <h4 class="alert-heading text-center mb-0 fw-bold">
                                <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                Deze functie is tijdelijk nog niet beschikbaar
                            </h4>
                        </div>
                    </div>
                <% } %>

                <script src="https://www.google.com/recaptcha/api.js?render=<%= recaptchaSiteKey %>"></script>
                <form id="contactForm" action="/contact" method="POST" class="mt-2" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> style="filter: blur(4px); pointer-events: none; user-select: none;" tabindex="-1" <% } %>>
                    <!-- Honeypot field to prevent spam -->
                    <div style="position: absolute; left: -9999px;">
                        <label for="website">Website</label>
                        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off">
                    </div>
                    
                    <input type="hidden" id="g-recaptcha-response" name="g-recaptcha-response">

                    <div class="row g-4">
                        <div class="col-md-6 mb-3">
                            <label for="name" class="form-label fw-bold">Naam</label>
                            <input type="text" class="form-control" id="name" name="name" required placeholder="Je naam" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label fw-bold">Email</label>
                            <input type="email" class="form-control" id="email" name="email" required placeholder="je@email.be" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>>
                        </div>
                    </div>
                    
                    <div class="mb-4">
                        <label for="message" class="form-label fw-bold">Bericht</label>
                        <textarea class="form-control" id="message" name="message" rows="6" required placeholder="Wat wil je ons vertellen?" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>></textarea>
                    </div>

                    <button type="submit" class="btn btn-chiro btn-lg w-100 py-3 shadow" <% if (typeof contactFormDisabled !== 'undefined' && contactFormDisabled) { %> disabled <% } %>>
                        Verstuur Bericht <i class="bi bi-send ms-2"></i>
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('contactForm').addEventListener('submit', function(e) {
        e.preventDefault();
        grecaptcha.ready(function() {
            grecaptcha.execute('<%= recaptchaSiteKey %>', {action: 'submit'}).then(function(token) {
                document.getElementById('g-recaptcha-response').value = token;
                document.getElementById('contactForm').submit();
            });
        });
    });
</script>
<%- include('../partials/footer') %>