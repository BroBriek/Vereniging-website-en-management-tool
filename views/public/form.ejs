<%- include('../partials/header') %>

<style>
    .form-public-container {
        max-width: 800px;
        margin: 40px auto;
        background: white;
        padding: 40px;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0,0,0,0.08);
    }
    @media (max-width: 768px) {
        .form-public-container {
            padding: 20px;
            margin: 20px auto;
            border-radius: 0;
        }
        .pricing-module {
            padding: 15px !important;
        }
        .pricing-item {
            flex-wrap: wrap;
        }
        .pricing-item > .col-6 {
            width: 100% !important;
            margin-bottom: 10px;
        }
        .pricing-item > .col-3 {
            width: 50% !important;
        }
    }
    .form-field-item {
        margin-bottom: 25px;
    }
    .form-field-label {
        font-weight: 600;
        margin-bottom: 10px;
        display: block;
        font-size: 1.1rem;
        white-space: pre-wrap;
    }
    .rich-text-content {
        line-height: 1.6;
        color: #444;
    }
    .rich-text-content img {
        max-width: 100%;
        height: auto;
        border-radius: 8px;
    }
</style>

<div class="container">
    <% if (typeof isAdmin !== 'undefined' && isAdmin && form.status !== 'visible') { %>
        <div class="alert alert-warning border-0 shadow-sm mb-4 mt-2 d-flex align-items-center">
            <i class="bi bi-shield-lock-fill fs-3 me-3"></i>
            <div>
                <strong>Admin Preview:</strong> Dit formulier is momenteel 
                <span class="badge bg-<%= form.status === 'closed' ? 'danger' : 'secondary' %>">
                    <%= form.status === 'closed' ? 'Gesloten' : 'Onzichtbaar' %>
                </span>. 
                Alleen admins kunnen dit nu zien.
            </div>
        </div>
    <% } %>

    <div class="form-public-container mt-0">
        <h1 class="font-playful mb-2"><%= form.title %></h1>
        <% if (form.description) { %>
            <p class="text-muted lead mb-4" style="white-space: pre-wrap;"><%= form.description %></p>
        <% } %>
        <hr class="mb-4">

        <% if (form.status === 'closed' && (!user || user.role !== 'admin')) { %>
            <div class="alert alert-danger text-center p-4">
                <i class="bi bi-lock-fill display-4 d-block mb-3"></i>
                <h5>Dit formulier is gesloten.</h5>
                <p class="mb-0">Het is niet meer mogelijk om antwoorden in te sturen.</p>
            </div>
        <% } else { %>
            <form action="/forms/<%= form.slug %>/submit" method="POST">
                <% form.fields.forEach(field => { %>
                    <div class="form-field-item">
                        <% if (field.type === 'text') { %>
                            <div class="rich-text-content">
                                <%- field.content %>
                            </div>
                        <% } else if (field.type === 'image') { %>
                            <% if (field.url) { %>
                                <div class="text-center">
                                    <a href="<%= field.url %>" onclick="openFilePreview('<%= field.url %>', '<%= field.url.split('/').pop() %>'); return false;" class="d-inline-block">
                                        <img src="<%= field.url %>" class="img-fluid rounded shadow-sm" alt="Form afbeelding" style="cursor: pointer;">
                                    </a>
                                </div>
                            <% } %>
                        <% } else if (field.type === 'short_text') { %>
                            <label class="form-field-label" for="<%= field.id %>">
                                <%= field.label %>
                                <% if (field.required) { %> <span class="text-danger">*</span> <% } %>
                            </label>
                            <% const isEmailField = typeof form !== 'undefined' && form.emailFieldId === field.id; %>
                            <input type="<%= isEmailField ? 'email' : 'text' %>" name="<%= field.id %>" id="<%= field.id %>" class="form-control form-control-lg" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %>>
                        <% } else if (field.type === 'long_text') { %>
                            <label class="form-field-label" for="<%= field.id %>">
                                <%= field.label %>
                                <% if (field.required) { %> <span class="text-danger">*</span> <% } %>
                            </label>
                            <textarea name="<%= field.id %>" id="<%= field.id %>" class="form-control form-control-lg" rows="4" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %>></textarea>
                        <% } else if (field.type === 'multiple_choice') { %>
                            <label class="form-field-label">
                                <%= field.label %>
                                <% if (field.required) { %> <span class="text-danger">*</span> <% } %>
                            </label>
                            <% (field.options || []).forEach((opt, i) => { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="radio" name="<%= field.id %>" id="<%= field.id %>_<%= i %>" value="<%= opt %>" <%= field.required && i === 0 ? 'required' : '' %>>
                                    <label class="form-check-label" for="<%= field.id %>_<%= i %>">
                                        <%= opt %>
                                    </label>
                                </div>
                            <% }) %>
                        <% } else if (field.type === 'multiple_choice_multi') { %>
                            <label class="form-field-label">
                                <%= field.label %>
                                <% if (field.required) { %> <span class="text-danger">*</span> <% } %>
                            </label>
                            <% (field.options || []).forEach((opt, i) => { %>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="<%= field.id %>[]" id="<%= field.id %>_<%= i %>" value="<%= opt %>">
                                    <label class="form-check-label" for="<%= field.id %>_<%= i %>">
                                        <%= opt %>
                                    </label>
                                </div>
                            <% }) %>
                        <% } else if (field.type === 'pricing') { %>
                            <div class="d-flex align-items-center mb-2">
                                <label class="form-field-label mb-0 me-2">
                                    <%= field.label %>
                                    <% if (field.required) { %> <span class="text-danger">*</span> <% } %>
                                </label>
                                <span class="text-muted cursor-pointer" data-bs-toggle="tooltip" data-bs-placement="top" title="Selecteer de gewenste aantallen. Het totaalbedrag wordt automatisch onderaan berekend op basis van de ingevulde hoeveelheden.">
                                    <i class="bi bi-info-circle"></i>
                                </span>
                            </div>
                            <div class="pricing-module p-4 bg-light rounded-4 border">
                                <div class="pricing-items">
                                    <% (field.options || []).forEach((opt, i) => { %>
                                        <div class="pricing-item row align-items-center mb-3 pb-3 border-bottom border-white">
                                            <div class="col-6 col-md-7">
                                                <div class="fw-bold"><%= opt.label %></div>
                                                <% if (opt.showPrice) { %>
                                                    <div class="small text-muted">€<%= opt.price.toLocaleString('nl-BE', { minimumFractionDigits: 2 }) %> per stuk</div>
                                                <% } %>
                                            </div>
                                            <div class="col-3 col-md-2">
                                                <input type="number" 
                                                       name="<%= field.id %>[<%= opt.label %>]" 
                                                       class="form-control pricing-qty" 
                                                       value="0" 
                                                       min="0" 
                                                       data-price="<%= opt.price %>"
                                                       oninput="calculatePricingTotal('<%= field.id %>')">
                                            </div>
                                            <div class="col-3 col-md-3 text-end">
                                                <span class="subtotal-display fw-bold">€0,00</span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                                <div class="pricing-footer d-flex justify-content-between align-items-center mt-3 pt-2">
                                    <h5 class="mb-0 font-playful">Totaal</h5>
                                    <div class="d-flex align-items-center">
                                        <h4 class="mb-0 text-primary fw-bold me-2" id="total-display-<%= field.id %>">€0,00</h4>
                                        <input type="hidden" name="<%= field.id %>[total]" id="total-input-<%= field.id %>" value="0">
                                    </div>
                                </div>
                            </div>
                            <% if (field.required) { %>
                                <input type="checkbox" style="opacity: 0; position: absolute; pointer-events: none;" class="pricing-required-check" id="req-<%= field.id %>" required>
                                <div class="invalid-feedback">Selecteer minstens één item.</div>
                            <% } %>
                        <% } %>
                    </div>
                <% }) %>

                <div class="mt-5 pt-3 border-top text-center">
                    <button type="submit" class="btn btn-primary btn-lg px-5 rounded-pill shadow-sm">
                        Verzenden <i class="bi bi-send ms-2"></i>
                    </button>
                </div>
            </form>
        <% } %>
    </div>
</div>

<!-- File Preview Modal -->
<div class="modal fade" id="filePreviewModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable">
    <div class="modal-content rounded-4 border-0 shadow" style="height: 90vh;">
      <div class="modal-header border-0 pb-0">
        <h5 class="modal-title font-playful text-truncate" id="previewFileName" style="max-width: 80%;">Bestand</h5>
        <div class="d-flex gap-2">
            <a id="previewDownloadBtn" href="#" class="btn btn-primary btn-sm rounded-pill">
                <i class="bi bi-download"></i> Download
            </a>
            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
        </div>
      </div>
      <div class="modal-body p-0 h-100 position-relative bg-light">
        <div id="previewLoader" class="position-absolute top-50 start-50 translate-middle text-center">
            <div class="spinner-border text-primary" role="status"></div>
            <p class="mt-2 text-muted">Laden...</p>
        </div>
        <iframe id="previewFrame" src="" class="w-100 h-100 border-0 rounded-bottom-4 d-none"></iframe>
        <div id="previewImageContainer" class="w-100 h-100 d-none d-flex align-items-center justify-content-center bg-white rounded-bottom-4 overflow-auto">
            <img id="previewImage" src="" class="img-fluid" style="max-height: 100%; object-fit: contain;">
        </div>
        <div id="previewError" class="d-none position-absolute top-50 start-50 translate-middle text-center p-4 w-100">
            <i class="bi bi-file-earmark-x display-1 text-muted"></i>
            <h5 class="mt-3">Voorbeeld niet beschikbaar</h5>
            <p class="text-muted mb-3">Dit bestandstype kan niet worden weergegeven in de browser of we kunnen er niet bij.</p>
            <a id="previewErrorDownloadBtn" href="#" class="btn btn-primary rounded-pill mt-2">
                <i class="bi bi-download"></i> Download Bestand
            </a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
    // triggerDownload and openFilePreview are now provided by /js/download-helper.js

    function calculatePricingTotal(fieldId) {
        const container = document.querySelector(`[name^="${fieldId}"][class*="pricing-qty"]`).closest('.pricing-module');
        const qtyInputs = container.querySelectorAll('.pricing-qty');
        let total = 0;

        qtyInputs.forEach(input => {
            const qty = parseInt(input.value) || 0;
            const price = parseFloat(input.getAttribute('data-price')) || 0;
            const subtotal = qty * price;
            total += subtotal;

            const subtotalDisplay = input.closest('.pricing-item').querySelector('.subtotal-display');
            subtotalDisplay.innerText = '€' + subtotal.toLocaleString('nl-BE', { minimumFractionDigits: 2 });
        });

        document.getElementById(`total-display-${fieldId}`).innerText = '€' + total.toLocaleString('nl-BE', { minimumFractionDigits: 2 });
        document.getElementById(`total-input-${fieldId}`).value = total;

        // Update hidden required checkbox
        const reqCheck = document.getElementById(`req-${fieldId}`);
        if (reqCheck) {
            reqCheck.checked = total > 0;
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Wrap images in rich text content with preview links
        document.querySelectorAll('.rich-text-content img').forEach(img => {
            if (img.closest('a')) return; // Already wrapped
            const src = img.getAttribute('src');
            const filename = src.split('/').pop();
            const wrapper = document.createElement('a');
            wrapper.href = src;
            wrapper.className = 'd-inline-block';
            wrapper.onclick = function(e) {
                e.preventDefault();
                openFilePreview(src, filename);
                return false;
            };
            img.parentNode.insertBefore(wrapper, img);
            wrapper.appendChild(img);
            img.style.cursor = 'pointer';
        });

        // Handle PDF links in rich text content
        document.querySelectorAll('.rich-text-content a[href$=".pdf"]').forEach(link => {
            link.classList.add('pdf-preview-link');
            link.onclick = function(e) {
                e.preventDefault();
                const src = this.getAttribute('href');
                const filename = src.split('/').pop();
                openFilePreview(src, filename);
                return false;
            };
        });
    });
</script>

<%- include('../partials/footer') %>
