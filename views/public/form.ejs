<%- include('../partials/header') %>

<style>
    .form-page-canvas {
        max-width: 860px;
        margin: 0 auto;
    }

    .form-banner {
        margin-bottom: 1.75rem;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.06);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.05);
        max-height: 380px;
        background-color: #f8fafc;
    }

    .form-banner img {
        width: 100%;
        height: 100%;
        max-height: 380px;
        object-fit: cover;
        display: block;
    }

    .form-field-item {
        margin-bottom: 1.85rem;
    }

    .form-field-item:last-of-type {
        margin-bottom: 1rem;
    }

    .form-field-label {
        font-family: var(--font-heading);
        color: var(--chiro-blue);
        font-weight: 600;
        margin-bottom: 0.45rem;
        display: block;
        font-size: 1.15rem;
        line-height: 1.35;
        white-space: pre-wrap;
    }

    .form-field-help {
        font-family: var(--font-body);
        color: #64748b;
        font-size: 1.05rem;
        line-height: 1.4;
        margin-bottom: 0.65rem;
        white-space: pre-wrap;
    }

    .form-page-canvas .form-control {
        border: 2px solid #e2e8f0 !important;
        border-radius: 16px !important;
        padding: 0.75rem 1.1rem !important;
        background-color: #fcfcfd;
        color: var(--text-color);
        transition: border-color 0.2s ease, box-shadow 0.2s ease, background-color 0.2s ease;
    }

    .form-page-canvas .form-control:hover {
        border-color: #cbd5e1 !important;
    }

    .form-page-canvas .form-control:focus {
        background-color: #ffffff;
        border-color: var(--chiro-blue) !important;
        box-shadow: 0 0 0 4px rgba(29, 78, 137, 0.1) !important;
    }

    /* Radio & Checkbox Choice Cards (matching Register page options) */
    .form-choices-list {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
    }

    .form-choice-card {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        padding: 0.8rem 1.1rem;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        background-color: #ffffff;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
        margin-bottom: 0;
    }

    .form-choice-card:hover {
        border-color: #cbd5e1;
        background-color: #f8fafc;
    }

    .form-choice-card:has(.form-check-input:checked),
    .form-choice-card.selected {
        border-color: var(--chiro-blue);
        background-color: #f4f8fd;
        box-shadow: 0 4px 12px rgba(29, 78, 137, 0.06);
    }

    .form-choice-card .form-check-input {
        width: 1.25rem !important;
        height: 1.25rem !important;
        margin: 0 !important;
        padding: 0 !important;
        flex-shrink: 0;
        cursor: pointer;
        border: 2px solid #94a3b8 !important;
        border-radius: 50% !important;
        background-position: center;
    }

    .form-choice-card .form-check-input[type="checkbox"] {
        border-radius: 6px !important;
    }

    .form-choice-card:has(.form-check-input:checked) .form-check-input,
    .form-choice-card.selected .form-check-input {
        border-color: var(--chiro-blue) !important;
        background-color: var(--chiro-blue) !important;
    }

    .form-choice-card .form-check-label {
        font-family: var(--font-body);
        font-size: 1.15rem;
        line-height: 1.35;
        color: #1e293b;
        cursor: pointer;
        flex: 1;
    }

    .form-choice-card:has(.form-check-input:checked) .form-choice-label,
    .form-choice-card.selected .form-choice-label {
        color: var(--chiro-blue);
        font-weight: 600;
    }

    /* Rich Text & Images */
    .form-rich-block {
        background: #fffdf9;
        border: 1px solid rgba(0, 0, 0, 0.06);
        border-left: 4px solid var(--chiro-yellow);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
    }

    .rich-text-content {
        line-height: 1.65;
        color: #334155;
    }

    .rich-text-content p:last-child {
        margin-bottom: 0;
    }

    .rich-text-content img {
        max-width: 100%;
        height: auto;
        border-radius: 12px;
    }

    .form-image-frame {
        display: inline-block;
        background: #ffffff;
        padding: 10px;
        border-radius: 16px;
        border: 1px solid rgba(0, 0, 0, 0.07);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.06);
        transition: transform 0.25s ease, box-shadow 0.25s ease;
    }

    .form-image-frame:hover {
        transform: translateY(-3px);
        box-shadow: 0 12px 28px rgba(0, 0, 0, 0.1);
    }

    .form-image-frame img {
        border-radius: 10px;
        max-height: 460px;
        width: auto;
        object-fit: contain;
    }

    /* Pricing Module */
    .pricing-module {
        background: #fffdf7;
        border: 2px dashed #d8cfc0;
        border-radius: 20px;
        padding: 1.5rem;
    }

    .pricing-item {
        padding: 0.85rem 0;
        border-bottom: 1px dashed #e2d9c8;
    }

    .pricing-item:first-child {
        padding-top: 0;
    }

    .pricing-item:last-child {
        border-bottom: none;
    }

    .pricing-item-title {
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 1.08rem;
        color: #1e293b;
    }

    .pricing-item-price {
        font-family: var(--font-body);
        font-size: 1rem;
        color: #64748b;
    }

    .pricing-stepper {
        display: inline-flex;
        align-items: center;
        background: #ffffff;
        border: 2px solid #e2e8f0;
        border-radius: 14px;
        padding: 2px;
    }

    .pricing-stepper-btn {
        width: 34px;
        height: 34px;
        border: none;
        background: transparent;
        color: var(--chiro-blue);
        font-family: var(--font-heading);
        font-weight: 700;
        font-size: 1.1rem;
        border-radius: 10px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        transition: background-color 0.15s ease, color 0.15s ease;
        user-select: none;
    }

    .pricing-stepper-btn:hover {
        background-color: #f1f5f9;
    }

    .pricing-stepper-btn:active {
        background-color: #e2e8f0;
    }

    .pricing-module .pricing-qty {
        width: 54px;
        text-align: center;
        border: none !important;
        background: transparent !important;
        padding: 0.25rem 0.2rem !important;
        font-family: var(--font-heading);
        font-weight: 600;
        font-size: 1.05rem !important;
        box-shadow: none !important;
        -moz-appearance: textfield;
    }

    .pricing-module .pricing-qty::-webkit-outer-spin-button,
    .pricing-module .pricing-qty::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    .pricing-footer {
        background: #ffffff;
        border: 1px solid #ece4d5;
        border-radius: 14px;
        padding: 0.9rem 1.25rem;
        margin-top: 0.75rem;
    }

    /* Smart Total Box */
    .smart-total-box {
        background: #fffdf7;
        border: 2px dashed var(--chiro-red);
        border-radius: 22px;
        padding: 1.75rem 1.5rem;
        text-align: center;
        position: relative;
    }

    @media (max-width: 767px) {
        .form-banner {
            border-radius: 14px;
            margin-bottom: 1.25rem;
        }
        .pricing-module {
            padding: 1.15rem !important;
        }
        .pricing-item > .col-12 {
            margin-bottom: 0.5rem;
        }
    }
</style>

<div class="scrapbook-canvas form-page-canvas">
    <% if (typeof isAdmin !== 'undefined' && isAdmin && form.status !== 'visible') { %>
        <div class="scrapbook-card mb-4 p-3 bg-light border-0 d-flex flex-wrap align-items-center justify-content-between gap-3">
            <div class="d-flex align-items-center">
                <i class="bi bi-shield-lock-fill fs-3 text-warning me-3"></i>
                <div>
                    <strong class="font-playful text-dark">Admin Preview:</strong> Dit formulier is momenteel 
                    <span class="badge rounded-pill bg-<%= form.status === 'closed' ? 'danger' : 'secondary' %>">
                        <%= form.status === 'closed' ? 'Gesloten' : 'Onzichtbaar' %>
                    </span>.
                    <span class="text-muted small d-block d-sm-inline ms-sm-1">Alleen admins kunnen dit nu zien.</span>
                </div>
            </div>
            <a href="/admin/forms/<%= form.id %>/edit" class="btn btn-chiro btn-sm btn-edit-page">
                <i class="bi bi-pencil-square"></i> <span>Bewerken</span>
            </a>
        </div>
    <% } %>

    <!-- Header Spread -->
    <header class="scrapbook-page-header">
        <span class="washi-tape washi-tape-yellow washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-yellow washi-tape-top-right"></span>

        <% if (form.bannerEnabled && form.bannerImage && !form.bannerImage.startsWith('file:') && !/^[a-zA-Z]:[\\/]/.test(form.bannerImage)) { %>
            <div class="form-banner">
                <img src="<%= form.bannerImage %>" alt="<%= form.title %>">
            </div>
        <% } %>

        <h1 class="journal-main-title <%= form.description ? 'mb-3' : 'mb-0' %>"><%= form.title %></h1>
        <% if (form.description) { %>
            <p class="journal-main-lead mb-0" style="white-space: pre-wrap;"><%= form.description %></p>
        <% } %>
    </header>

    <!-- Main Form Card -->
    <div class="scrapbook-card mb-5 p-4 p-md-5">
        <span class="washi-tape washi-tape-kraft washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-kraft washi-tape-top-right"></span>

        <% if (form.status === 'closed' && (!user || user.role !== 'admin')) { %>
            <div class="text-center py-5">
                <div class="display-1 text-muted mb-3">
                    <i class="bi bi-lock"></i>
                </div>
                <h2 class="fw-bold font-playful mb-2">Dit formulier is gesloten</h2>
                <p class="lead text-muted mb-0">Het is niet meer mogelijk om antwoorden in te sturen.</p>
            </div>
        <% } else { %>
            <form action="/forms/<%= form.slug %>/submit" method="POST">
                <% form.fields.forEach(field => { %>
                    <div class="form-field-item">
                        <% if (field.type === 'text') { %>
                            <div class="form-rich-block rich-text-content">
                                <%- field.content %>
                            </div>
                        <% } else if (field.type === 'image') { %>
                            <% if (field.url && !field.url.startsWith('file:') && !/^[a-zA-Z]:[\\/]/.test(field.url)) { %>
                                <div class="text-center my-2">
                                    <a href="<%= field.url %>" data-preview-url="<%= field.url %>" data-preview-name="<%= field.url.split('/').pop() %>" onclick="openFilePreview(this.dataset.previewUrl, this.dataset.previewName); return false;" class="form-image-frame">
                                        <img src="<%= field.url %>" class="img-fluid" alt="Formulier afbeelding" style="cursor: pointer;">
                                    </a>
                                </div>
                            <% } %>
                        <% } else if (field.type === 'short_text') { %>
                            <label class="form-field-label" for="<%= field.id %>"><%= field.label %><% if (field.required) { %> <span class="text-danger">*</span><% } %></label>
                            <% if (field.extraExplanation) { %>
                                <div class="form-field-help"><%= field.extraExplanation %></div>
                            <% } %>
                            <% const isEmailField = typeof form !== 'undefined' && form.emailFieldId === field.id; %>
                            <input type="<%= isEmailField ? 'email' : 'text' %>" name="<%= field.id %>" id="<%= field.id %>" class="form-control" placeholder="<%= field.placeholder || '' %>" <% if (isEmailField) { %>autocomplete="email" inputmode="email"<% } %> <%= field.required ? 'required' : '' %>>
                        <% } else if (field.type === 'long_text') { %>
                            <label class="form-field-label" for="<%= field.id %>"><%= field.label %><% if (field.required) { %> <span class="text-danger">*</span><% } %></label>
                            <% if (field.extraExplanation) { %>
                                <div class="form-field-help"><%= field.extraExplanation %></div>
                            <% } %>
                            <textarea name="<%= field.id %>" id="<%= field.id %>" class="form-control" rows="4" placeholder="<%= field.placeholder || '' %>" <%= field.required ? 'required' : '' %>></textarea>
                        <% } else if (field.type === 'multiple_choice') { %>
                            <label class="form-field-label"><%= field.label %><% if (field.required) { %> <span class="text-danger">*</span><% } %></label>
                            <% if (field.extraExplanation) { %>
                                <div class="form-field-help"><%= field.extraExplanation %></div>
                            <% } %>
                            <div class="form-choices-list">
                                <% (field.options || []).forEach((opt, i) => { %>
                                    <label class="form-choice-card" for="<%= field.id %>_<%= i %>">
                                        <input class="form-check-input" type="radio" name="<%= field.id %>" id="<%= field.id %>_<%= i %>" value="<%= opt %>" <%= field.required && i === 0 ? 'required' : '' %>>
                                        <span class="form-check-label form-choice-label">
                                            <%= opt %>
                                        </span>
                                    </label>
                                <% }) %>
                            </div>
                        <% } else if (field.type === 'multiple_choice_multi') { %>
                            <label class="form-field-label"><%= field.label %><% if (field.required) { %> <span class="text-danger">*</span><% } %></label>
                            <% if (field.extraExplanation) { %>
                                <div class="form-field-help"><%= field.extraExplanation %></div>
                            <% } %>
                            <div class="form-choices-list">
                                <% (field.options || []).forEach((opt, i) => { %>
                                    <label class="form-choice-card" for="<%= field.id %>_<%= i %>">
                                        <input class="form-check-input" type="checkbox" name="<%= field.id %>[]" id="<%= field.id %>_<%= i %>" value="<%= opt %>">
                                        <span class="form-check-label form-choice-label">
                                            <%= opt %>
                                        </span>
                                    </label>
                                <% }) %>
                            </div>
                        <% } else if (field.type === 'pricing') { %>
                            <div class="d-flex align-items-center mb-1">
                                <label class="form-field-label mb-0 me-2"><%= field.label %><% if (field.required) { %> <span class="text-danger">*</span><% } %></label>
                                <span class="text-muted cursor-pointer" data-bs-toggle="tooltip" data-bs-placement="top" title="Selecteer de gewenste aantallen. Het totaalbedrag wordt automatisch onderaan berekend op basis van de ingevulde hoeveelheden.">
                                    <i class="bi bi-info-circle"></i>
                                </span>
                            </div>
                            <% if (field.extraExplanation) { %>
                                <div class="form-field-help"><%= field.extraExplanation %></div>
                            <% } %>
                            <div class="pricing-module mt-2">
                                <div class="pricing-items">
                                    <% (field.options || []).forEach((opt, i) => { %>
                                        <div class="pricing-item row align-items-center g-2">
                                            <div class="col-12 col-sm-6">
                                                <div class="pricing-item-title"><%= opt.label %></div>
                                                <% if (opt.showPrice) { %>
                                                    <div class="pricing-item-price">€<%= opt.price.toLocaleString('nl-BE', { minimumFractionDigits: 2 }) %> per stuk</div>
                                                <% } %>
                                            </div>
                                            <div class="col-7 col-sm-3 text-sm-center">
                                                <div class="pricing-stepper">
                                                    <button type="button" class="pricing-stepper-btn" onclick="stepPricingQty(this, -1, '<%= field.id %>')" aria-label="Minder">−</button>
                                                    <input type="number" 
                                                           name="<%= field.id %>[<%= opt.label %>]" 
                                                           class="form-control pricing-qty" 
                                                           value="0" 
                                                           min="0" 
                                                           data-price="<%= opt.price %>"
                                                           oninput="calculatePricingTotal('<%= field.id %>')">
                                                    <button type="button" class="pricing-stepper-btn" onclick="stepPricingQty(this, 1, '<%= field.id %>')" aria-label="Meer">+</button>
                                                </div>
                                            </div>
                                            <div class="col-5 col-sm-3 text-end">
                                                <span class="subtotal-display fw-bold font-playful" style="color: var(--chiro-blue);">€0,00</span>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>
                                <div class="pricing-footer d-flex justify-content-between align-items-center">
                                    <h5 class="mb-0 font-playful" style="color: var(--chiro-blue);">Subtotaal</h5>
                                    <div class="d-flex align-items-center">
                                        <h4 class="mb-0 fw-bold font-playful" style="color: var(--chiro-red);" id="total-display-<%= field.id %>">€0,00</h4>
                                        <input type="hidden" name="<%= field.id %>[total]" id="total-input-<%= field.id %>" value="0">
                                    </div>
                                </div>
                            </div>
                            <% if (field.required) { %>
                                <input type="checkbox" style="opacity: 0; position: absolute; pointer-events: none;" class="pricing-required-check" id="req-<%= field.id %>" required>
                                <div class="invalid-feedback">Selecteer minstens één item.</div>
                            <% } %>
                        <% } else if (field.type === 'total_box') { %>
                            <div class="smart-total-box my-4" id="total-box-<%= field.id %>">
                                <span class="scrapbook-stamp-label mb-2"><i class="bi bi-receipt me-1"></i> Overzicht</span>
                                <h3 class="mb-1 font-playful" style="color: var(--chiro-blue);"><%= field.label || 'TOTAAL' %></h3>
                                <div class="display-5 fw-bold font-playful mt-1 smart-grand-total-display" style="color: var(--chiro-red);">€0,00</div>
                                <input type="hidden" name="<%= field.id %>" class="smart-grand-total-input" value="0">
                                <p class="text-muted small mt-2 mb-0">Totaalbedrag van alle geselecteerde items hierboven.</p>
                            </div>
                        <% } %>
                    </div>
                <% }) %>

                <div class="mt-5 pt-4 border-top text-center">
                    <button type="submit" class="btn btn-chiro btn-lg px-5 py-3 shadow font-playful">
                        Verzenden <i class="bi bi-send-fill ms-2"></i>
                    </button>
                </div>
            </form>
        <% } %>
    </div>
</div>

<script>
    // triggerDownload and openFilePreview are now provided by /js/download-helper.js

    function stepPricingQty(btn, delta, fieldId) {
        const stepper = btn.closest('.pricing-stepper');
        const input = stepper ? stepper.querySelector('.pricing-qty') : null;
        if (!input) return;
        const current = parseInt(input.value) || 0;
        const next = Math.max(0, current + delta);
        input.value = next;
        calculatePricingTotal(fieldId);
    }

    function updateGrandTotal() {
        let grandTotal = 0;
        document.querySelectorAll('input[id^="total-input-"]').forEach(input => {
            grandTotal += parseFloat(input.value) || 0;
        });

        document.querySelectorAll('.smart-grand-total-display').forEach(display => {
            display.innerText = '€' + grandTotal.toLocaleString('nl-BE', { minimumFractionDigits: 2 });
        });

        document.querySelectorAll('.smart-grand-total-input').forEach(input => {
            input.value = grandTotal;
        });
    }

    function calculatePricingTotal(fieldId) {
        const container = document.querySelector(`[name^="${fieldId}"][class*="pricing-qty"]`).closest('.pricing-module');
        const qtyInputs = container.querySelectorAll('.pricing-qty');
        let total = 0;

        qtyInputs.forEach(input => {
            const qty = Math.max(0, parseInt(input.value) || 0);
            const price = parseFloat(input.getAttribute('data-price')) || 0;
            const subtotal = qty * price;
            total += subtotal;

            const subtotalDisplay = input.closest('.pricing-item').querySelector('.subtotal-display');
            subtotalDisplay.innerText = '€' + subtotal.toLocaleString('nl-BE', { minimumFractionDigits: 2 });
        });

        document.getElementById(`total-display-${fieldId}`).innerText = '€' + total.toLocaleString('nl-BE', { minimumFractionDigits: 2 });
        document.getElementById(`total-input-${fieldId}`).value = total;

        // Update hidden required checkbox
        const reqCheck = document.getElementById(`req-${fieldId}`);
        if (reqCheck) {
            reqCheck.checked = total > 0;
        }

        updateGrandTotal();
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Initialize tooltips
        const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        });

        // Initialize grand total
        updateGrandTotal();

        // Sync .selected class on choice cards for browsers without :has()
        document.querySelectorAll('.form-choice-card .form-check-input').forEach(input => {
            input.addEventListener('change', function() {
                const list = this.closest('.form-choices-list');
                if (list) {
                    list.querySelectorAll('.form-choice-card').forEach(card => {
                        const chk = card.querySelector('.form-check-input');
                        card.classList.toggle('selected', !!(chk && chk.checked));
                    });
                }
            });
        });

        // Wrap images in rich text content with preview links (filter out local file paths)
        document.querySelectorAll('.rich-text-content img').forEach(img => {
            const src = img.getAttribute('src');
            if (!src || src.startsWith('file:') || /^[a-zA-Z]:[\\/]/.test(src)) {
                img.remove();
                return;
            }
            if (img.closest('a')) return; // Already wrapped
            const filename = src.split('/').pop();
            const wrapper = document.createElement('a');
            wrapper.href = src;
            wrapper.className = 'd-inline-block';
            wrapper.onclick = function(e) {
                e.preventDefault();
                openFilePreview(src, filename);
                return false;
            };
            img.parentNode.insertBefore(wrapper, img);
            wrapper.appendChild(img);
            img.style.cursor = 'pointer';
        });

        // Handle Document links (PDF, Word, Excel, PPT) in rich text content
        document.querySelectorAll('.rich-text-content a').forEach(link => {
            const href = link.getAttribute('href');
            if (href && (href.startsWith('file:') || /^[a-zA-Z]:[\\/]/.test(href))) {
                link.removeAttribute('href');
                return;
            }
            if (href && /\.(pdf|docx?|xlsx?|pptx?)$/i.test(href)) {
                link.classList.add('document-preview-link');
                link.onclick = function(e) {
                    e.preventDefault();
                    const filename = href.split('/').pop();
                    openFilePreview(href, filename);
                    return false;
                };
            }
        });
    });
</script>

<%- include('../partials/footer') %>
