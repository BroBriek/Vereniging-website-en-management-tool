<%- include('../partials/header') %>

<% if (page.bannerEnabled && page.bannerImage) { %>
    <div class="hero-banner position-relative mb-5 rounded-4 overflow-hidden shadow-sm" style="height: 300px;">
        <img src="<%= page.bannerImage %>" class="w-100 h-100 object-fit-cover" alt="<%= page.title %>">
        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-dark bg-opacity-25">
            <h1 class="text-white display-3 font-playful mb-0 text-shadow"><%= page.title %></h1>
        </div>
    </div>
<% } else { %>
    <div class="row mb-4">
        <div class="col-12">
            <h1 class="display-4 font-playful fw-bold"><%= page.title %></h1>
            <hr class="chiro-divider">
        </div>
    </div>
<% } %>

<div class="row justify-content-center">
    <div class="col-lg-10">
        <div class="custom-page-content">
            <% if (user && user.role === 'admin') { %>
                <div class="admin-edit-badge mb-4 d-flex justify-content-between align-items-center p-3 bg-light rounded-4 border">
                    <div class="d-flex align-items-center">
                        <i class="bi bi-shield-check text-primary fs-4 me-3"></i>
                        <div>
                            <div class="fw-bold">Admin Weergave</div>
                            <div class="small text-muted">Alleen zichtbaar voor jou.</div>
                        </div>
                    </div>
                    <a href="/admin/custom-pages/<%= page.id %>/edit" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-pencil-square me-2"></i>Bewerk Pagina
                    </a>
                </div>
            <% } %>
            <% 
            function renderComponent(comp) { 
                switch(comp.type) { 
                    case 'header': %>
                        <h<%= comp.level || 2 %> class="font-playful mt-4 mb-3"><%= comp.text %></h<%= comp.level || 2 %>>
                    <% break; 
                    case 'text': %>
                        <div class="rich-text-content">
                            <%- comp.text %>
                        </div>
                    <% break; 
                    case 'image': %>
                        <% if (comp.url) { %>
                            <div class="text-center my-4">
                                <div style="display: inline-block; transform: rotate(<%= comp.rotation || 0 %>deg); width: <%= comp.width || 'auto' %>; max-width: 100%;">
                                    <img src="<%= comp.url %>" class="img-fluid rounded-4 shadow-sm" style="width: 100%; height: <%= comp.height || 'auto' %>; object-fit: cover;" alt="Pagina afbeelding">
                                </div>
                            </div>
                        <% } %>
                    <% break; 
                    case 'columns': 
                        // Migration for old format in public view
                        if (!comp.cols) {
                            comp.cols = [
                                { width: comp.leftWidth || 50, content: comp.left || [] },
                                { width: comp.rightWidth || 50, content: comp.right || [] }
                            ];
                        }
                        %>
                        <div class="row g-4 my-4">
                            <% comp.cols.forEach(col => { %>
                                <div class="col" style="flex: 0 1 calc(<%= col.width %>% - 0.5px); max-width: <%= col.width %>%; width: <%= col.width %>%;">
                                    <% (col.content || []).forEach(child => { %>
                                        <% renderComponent(child) %>
                                    <% }) %>
                                </div>
                            <% }) %>
                        </div>
                    <% break;
                    case 'button': %>
                        <div class="text-<%= comp.align || 'start' %> my-4">
                            <a href="<%= comp.url || '#' %>" class="btn btn-primary btn-lg rounded-pill px-5 shadow-sm">
                                <%= comp.text || 'Klik Hier' %>
                            </a>
                        </div>
                    <% break; 
                    case 'divider': %>
                        <hr class="my-5 opacity-10">
                    <% break; 
                    case 'spacer': %>
                        <div style="height: <%= comp.height || 50 %>px;"></div>
                    <% break;
                }
            } 

            page.content.forEach(comp => { 
                renderComponent(comp);
            });
            %>
        </div>
    </div>
</div>
<style>
    .text-shadow {
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
    .custom-page-content {
        background: white;
        padding: 40px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0,0,0,0.02);
    }
    @media (max-width: 768px) {
        .custom-page-content {
            padding: 20px;
        }
    }
</style>

<%- include('../partials/footer') %>
