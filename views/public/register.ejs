<%- include('../partials/header') %>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="display-4 fw-bold mb-0">Inschrijven</h1>
        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
            <a href="/admin/page/register" class="btn btn-chiro btn-sm btn-edit-page shadow-sm">
                <i class="bi bi-pencil-square"></i><span class="d-none d-sm-inline ms-1">Bewerk Pagina</span><span class="d-sm-none ms-1">Bewerken</span>
            </a>
        <% } %>
    </div>

    <%
        // Safely get form config with defaults
        const fc = (typeof formConfig !== 'undefined' && formConfig) ? formConfig : null;
        const labels = fc ? fc.labels : {};
        const customQuestions = (fc && fc.customQuestions) ? fc.customQuestions : [];
        const fd = (typeof formData !== 'undefined' && formData) ? formData : {};
        // Helper to get label with fallback
        const L = (key, fallback) => (labels[key] || fallback);

        // Helper to extract content string safely from section object or string
        const getSectionContent = (c) => {
            if (!c) return '';
            if (typeof c === 'string') return c;
            if (c && typeof c.content === 'string') return c.content;
            return '';
        };

        // Helper to check if rich HTML text is truly empty (e.g. <p><br></p>)
        const isHtmlEmpty = (str) => {
            if (!str || typeof str !== 'string') return true;
            if (/<(img|iframe|video|audio|svg|canvas)\b/i.test(str)) return false;
            return str.replace(/<[^>]*>/g, '').replace(/&nbsp;/gi, ' ').trim().length === 0;
        };
    %>

    <!-- Top Info Text -->
    <div class="card border-0 shadow-sm rounded-4 mb-4">
        <div class="card-body p-4 p-md-5">
            <% const topText = getSectionContent(content && content.top_text); %>
            <% if (topText && !isHtmlEmpty(topText)) { %>
                <div class="fs-5 mb-4"><%- topText %></div>
            <% } %>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="alert alert-danger mt-3 rounded-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i><%= error %>
                </div>
            <% } %>

            <% if (isRegistrationOpen) { %>
                <form action="/inschrijven" method="POST" class="mt-4" id="registrationForm">
                    
                    <!-- Role Selection -->
                    <div class="mb-5 p-4 border-0 rounded-4 bg-light shadow-inner">
                        <label class="form-label fw-bold text-primary mb-3"><%= L('roleLabel', 'Ik schrijf in als:') %></label>
                        <div class="d-flex gap-4">
                            <div class="form-check custom-option">
                                <input class="form-check-input" type="radio" name="type" id="roleLid" value="lid" checked>
                                <label class="form-check-label fw-bold" for="roleLid"><%= L('roleLid', 'Lid') %></label>
                            </div>
                            <div class="form-check custom-option">
                                <input class="form-check-input" type="radio" name="type" id="roleLeiding" value="leiding">
                                <label class="form-check-label fw-bold" for="roleLeiding"><%= L('roleLeiding', 'Leiding') %></label>
                            </div>
                        </div>
                    </div>

                    <div class="row g-4">
                        <!-- First Name -->
                        <div class="col-md-6">
                            <label for="firstName" class="form-label fw-bold"><%= L('firstName', 'Voornaam') %></label>
                            <input type="text" class="form-control" id="firstName" name="firstName" required placeholder="<%= L('firstNamePlaceholder', 'Bijv. Pluk') %>">
                        </div>
                        <!-- Last Name -->
                        <div class="col-md-6">
                            <label for="lastName" class="form-label fw-bold"><%= L('lastName', 'Achternaam') %></label>
                            <input type="text" class="form-control" id="lastName" name="lastName" required placeholder="<%= L('lastNamePlaceholder', 'Bijv. Van De Petteflet') %>">
                        </div>
                    </div>

                    <div class="mt-4">
                        <label for="birthdate" class="form-label fw-bold"><%= L('birthdate', 'Geboortedatum') %></label>
                        <input type="date" class="form-control" id="birthdate" name="birthdate" required>
                    </div>

                    <!-- Contact Info -->
                    <div class="row g-4 mt-2">
                        <div class="col-md-6">
                            <label for="email" class="form-label fw-bold" id="labelEmail"><%= L('emailLid', 'Email Ouders') %></label>
                            <input type="email" class="form-control" id="email" name="email" required autocomplete="email" inputmode="email" placeholder="<%= L('emailPlaceholder', 'email@voorbeeld.be') %>" value="<%= fd.email || '' %>">
                        </div>
                        <div class="col-md-6">
                            <label for="phone" class="form-label fw-bold" id="labelPhone"><%= L('phoneLid', 'Telefoon Ouders') %></label>
                            <input type="tel" class="form-control" id="phone" name="parentsPhone" required autocomplete="tel" inputmode="tel" placeholder="<%= L('phonePlaceholder', '0470 00 00 00') %>" pattern="^(0\d{2,3} \d{2} \d{2} \d{2})|(\+\d{7,15})$" title="Gebruik het formaat: 0470 12 34 56 of +31612345678" value="<%= fd.parentsPhone || fd.phone || '' %>">
                        </div>
                    </div>

                    <!-- Optional Second Parent Contact (for members) -->
                    <div id="secondParentToggleWrapper" class="mt-3">
                        <button type="button" class="btn btn-outline-secondary btn-sm rounded-pill px-3 py-1-5 d-inline-flex align-items-center gap-2 shadow-sm" id="toggleSecondParentBtn">
                            <i class="bi bi-person-plus-fill text-primary"></i>
                            <span><%= L('addSecondParentBtn', '+ Tweede ouder / contactpersoon toevoegen (optioneel)') %></span>
                        </button>
                    </div>

                    <div id="secondParentSection" class="mt-3 p-3 rounded-3 border bg-light bg-opacity-50 shadow-sm" style="display: none;">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold small text-muted">
                                <i class="bi bi-people-fill text-primary me-1"></i> <%= L('secondParentSectionTitle', 'Gegevens Tweede Ouder / Voogd (Optioneel)') %>
                            </span>
                            <button type="button" class="btn btn-sm btn-link text-danger text-decoration-none p-0 d-inline-flex align-items-center gap-1" id="removeSecondParentBtn">
                                <i class="bi bi-x-circle"></i><span>Wissen</span>
                            </button>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label for="secondEmail" class="form-label fw-bold small"><%= L('secondEmailLid', 'Tweede Email (Optioneel)') %></label>
                                <input type="email" class="form-control" id="secondEmail" name="secondEmail" autocomplete="email" inputmode="email" placeholder="<%= L('secondEmailPlaceholder', 'tweede-ouder@voorbeeld.be') %>" value="<%= fd.secondEmail || '' %>">
                            </div>
                            <div class="col-md-6">
                                <label for="secondParentsPhone" class="form-label fw-bold small"><%= L('secondPhoneLid', 'Tweede Telefoon (Optioneel)') %></label>
                                <input type="tel" class="form-control" id="secondParentsPhone" name="secondParentsPhone" autocomplete="tel" inputmode="tel" placeholder="<%= L('secondPhonePlaceholder', '0470 00 00 00') %>" pattern="^(0\d{2,3} \d{2} \d{2} \d{2})|(\+\d{7,15})$" title="Gebruik het formaat: 0470 12 34 56 of +31612345678" value="<%= fd.secondParentsPhone || '' %>">
                            </div>
                        </div>
                    </div>

                    <!-- Member Specific Fields -->
                    <div id="memberFields" class="mt-4">
                        <div class="mb-4">
                            <label for="parentsNames" class="form-label fw-bold"><%= L('parentsNames', 'Namen Ouders/Voogd') %></label>
                            <input type="text" class="form-control" id="parentsNames" name="parentsNames" placeholder="<%= L('parentsNamesPlaceholder', 'Bijv. Jan Klaassen en Marie Klaassen') %>">
                        </div>
                        
                        <div class="mb-4">
                            <label for="memberPhone" class="form-label fw-bold"><%= L('memberPhone', 'GSM Nummer Lid (Optioneel)') %></label>
                            <input type="text" class="form-control" id="memberPhone" name="memberPhone" placeholder="<%= L('memberPhonePlaceholder', '0475 00 00 00') %>" pattern="^(0\d{2,3} \d{2} \d{2} \d{2})|(\+\d{7,15})$" title="Gebruik het formaat: 0475 12 34 56 of +31612345678">
                        </div>

                        <div class="mb-4 p-4 border rounded-4 bg-white border-2">
                            <label class="form-label fw-bold text-primary mb-3"><%= L('photoPermissionLabel', "Mogen er foto's genomen en gepubliceerd worden van het lid?") %></label>
                            <div class="d-flex gap-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="photoPermission" id="photoYes" value="true" checked>
                                    <label class="form-check-label" for="photoYes"><%= L('photoYes', 'Ja, tuurlijk!') %></label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="photoPermission" id="photoNo" value="false">
                                    <label class="form-check-label" for="photoNo"><%= L('photoNo', 'Liever niet') %></label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Group Selection -->
                    <div class="mt-4" id="groupFields">
                        <label for="group" class="form-label fw-bold"><%= L('groupLabel', 'Groep') %></label>
                        <select class="form-select" id="groupInput" name="group" required>
                            <option value="" disabled selected><%= L('groupPlaceholder', 'Kies een groep...') %></option>
                            <option value="ribbel">Ribbels (1e en 2e leerjaar)</option>
                            <option value="speelclub">Speelclub (3e en 4e leerjaar)</option>
                            <option value="rakwi">Rakwi (5e en 6e leerjaar)</option>
                            <option value="tito">Tito (1e en 2e middelbaar)</option>
                            <option value="keti">Keti (3e en 4e middelbaar)</option>
                            <option value="aspi">Aspi (5e en 6e middelbaar)</option>
                        </select>
                    </div>

                    <!-- Payment Method Selection -->
                    <div class="mt-4 p-4 border rounded-4 bg-white border-2">
                        <label class="form-label fw-bold text-primary mb-3"><%= L('paymentLabel', 'Hoe wens je te betalen?') %></label>
                        <div class="d-flex flex-column gap-3">
                            <div class="form-check custom-option">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="payQr" value="<%= L('paymentOption1', 'Met QR code op de startdag') %>" checked required>
                                <label class="form-check-label fw-bold" for="payQr">
                                    <%= L('paymentOption1', 'Met QR code op de startdag') %>
                                </label>
                            </div>
                            <div class="form-check custom-option">
                                <input class="form-check-input" type="radio" name="paymentMethod" id="payTransfer" value="<%= L('paymentOption2', 'Via overschrijving naar het rekeningnummer dat op de volgende pagina getoond wordt') %>" required>
                                <label class="form-check-label fw-bold" for="payTransfer">
                                    <%= L('paymentOption2', 'Via overschrijving naar het rekeningnummer dat op de volgende pagina getoond wordt') %>
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Extra Info -->
                    <% 
                        const hasMedicalInfo = (typeof labels.medicalInfoLabel === 'undefined') 
                            ? true 
                            : (labels.medicalInfoLabel && labels.medicalInfoLabel.trim().length > 0);
                    %>
                    <% if (hasMedicalInfo) { %>
                        <div class="mt-4">
                            <label for="medicalInfo" class="form-label fw-bold"><%= labels.medicalInfoLabel || 'Extra Info (Allergieën, medische info, etc.)' %></label>
                            <textarea class="form-control" id="medicalInfo" name="medicalInfo" rows="4" placeholder="<%= L('medicalInfoPlaceholder', 'Zijn er zaken waar we rekening mee moeten houden?') %>"></textarea>
                        </div>
                    <% } %>

                    <!-- Custom Questions -->
                    <% if (customQuestions.length > 0) { %>
                        <div class="mt-4">
                            <% customQuestions.forEach(q => { %>
                                <div class="mb-4">
                                    <label for="custom_<%= q.id %>" class="form-label fw-bold">
                                        <%= q.label %><% if (!q.required) { %> <span class="text-muted fw-normal">(Optioneel)</span><% } %>
                                    </label>
                                    <% if (q.type === 'textarea') { %>
                                        <textarea class="form-control" id="custom_<%= q.id %>" name="custom_<%= q.id %>" rows="3" 
                                            placeholder="<%= q.placeholder || '' %>"
                                            <% if (q.required) { %>required<% } %>></textarea>
                                    <% } else if (q.type === 'radio') { %>
                                        <div class="d-flex gap-4 mt-1">
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="custom_<%= q.id %>" id="custom_<%= q.id %>_yes" value="Ja" <% if (q.required) { %>required<% } %>>
                                                <label class="form-check-label" for="custom_<%= q.id %>_yes">Ja</label>
                                            </div>
                                            <div class="form-check">
                                                <input class="form-check-input" type="radio" name="custom_<%= q.id %>" id="custom_<%= q.id %>_no" value="Nee">
                                                <label class="form-check-label" for="custom_<%= q.id %>_no">Nee</label>
                                            </div>
                                        </div>
                                    <% } else { %>
                                        <input type="text" class="form-control" id="custom_<%= q.id %>" name="custom_<%= q.id %>" 
                                            placeholder="<%= q.placeholder || '' %>"
                                            <% if (q.required) { %>required<% } %>>
                                    <% } %>
                                </div>
                            <% }) %>
                        </div>
                    <% } %>

                    <div class="mt-5 mb-4 form-check bg-light p-3 rounded-3 ms-0">
                        <div class="ms-4">
                            <input class="form-check-input" type="checkbox" id="privacyAccepted" name="privacyAccepted" required>
                            <label class="form-check-label small" for="privacyAccepted">
                                Ik heb de <a href="/pdf/privacyNotice.pdf" target="_blank" rel="noopener" class="text-primary fw-bold">privacy notice</a> gelezen en ga akkoord met de verwerking van deze gegevens.
                            </label>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-chiro w-100 py-3 fs-4 mt-2 shadow"><%= L('submitButton', 'Nu Inschrijven!') %></button>
                </form>
            <% } else { %>
                <div class="text-center py-5">
                    <div class="display-1 text-muted mb-4">
                        <i class="bi bi-lock"></i>
                    </div>
                    <h2 class="fw-bold mb-3">Inschrijvingen Gesloten</h2>
                    <p class="lead mb-0">De inschrijvings periode is gesloten. Voor meer info kan je altijd een bericht sturen naar onze hoofdleiding.</p>
                </div>
            <% } %>
        </div>
    </div>

    <!-- Dynamic Footer Text -->
    <% const infoText = getSectionContent(content && content.info_text); %>
    <% if (infoText && !isHtmlEmpty(infoText)) { %>
        <div class="card border-0 bg-light text-dark rounded-4 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h3 class="fw-bold mb-3" style="color: var(--chiro-yellow);"><i class="bi bi-info-circle me-2"></i>Belangrijke Info</h3>
                <div class="fs-5 opacity-90 text-dark">
                    <%- infoText %>
                </div>
            </div>
        </div>
    <% } %>
</div>

<script>
    const roleLid = document.getElementById('roleLid');
    const roleLeiding = document.getElementById('roleLeiding');
    const memberFields = document.getElementById('memberFields');
    const groupFields = document.getElementById('groupFields');
    const labelEmail = document.getElementById('labelEmail');
    const labelPhone = document.getElementById('labelPhone');
    const phoneInput = document.getElementById('phone');
    const parentsNamesInput = document.getElementById('parentsNames');
    const groupInput = document.getElementById('groupInput');

    const secondParentToggleWrapper = document.getElementById('secondParentToggleWrapper');
    const toggleSecondParentBtn = document.getElementById('toggleSecondParentBtn');
    const secondParentSection = document.getElementById('secondParentSection');
    const removeSecondParentBtn = document.getElementById('removeSecondParentBtn');
    const secondEmailInput = document.getElementById('secondEmail');
    const secondParentsPhoneInput = document.getElementById('secondParentsPhone');

    // Store configurable labels for JS toggling
    const emailLidLabel = '<%= L("emailLid", "Email Ouders").replace(/'/g, "\\'") %>';
    const emailLeidingLabel = '<%= L("emailLeiding", "Email").replace(/'/g, "\\'") %>';
    const phoneLidLabel = '<%= L("phoneLid", "Telefoon Ouders").replace(/'/g, "\\'") %>';
    const phoneLeidingLabel = '<%= L("phoneLeiding", "Telefoon").replace(/'/g, "\\'") %>';

    let isSecondParentOpen = (secondEmailInput && (secondEmailInput.value.trim() !== '' || (secondParentsPhoneInput && secondParentsPhoneInput.value.trim() !== '')));

    function showSecondParent() {
        isSecondParentOpen = true;
        if (secondParentSection) secondParentSection.style.display = 'block';
        if (secondParentToggleWrapper) secondParentToggleWrapper.style.display = 'none';
        if (labelEmail) labelEmail.innerText = 'Email Ouder 1';
        if (labelPhone) labelPhone.innerText = 'Telefoon Ouder 1';
    }

    function hideSecondParent(clear = true) {
        isSecondParentOpen = false;
        if (clear) {
            if (secondEmailInput) secondEmailInput.value = '';
            if (secondParentsPhoneInput) secondParentsPhoneInput.value = '';
        }
        if (secondParentSection) secondParentSection.style.display = 'none';
        if (roleLid.checked && secondParentToggleWrapper) {
            secondParentToggleWrapper.style.display = 'block';
            labelEmail.innerText = emailLidLabel;
            labelPhone.innerText = phoneLidLabel;
        }
    }

    if (toggleSecondParentBtn) {
        toggleSecondParentBtn.addEventListener('click', () => {
            showSecondParent();
            if (secondEmailInput) secondEmailInput.focus();
        });
    }

    if (removeSecondParentBtn) {
        removeSecondParentBtn.addEventListener('click', () => {
            hideSecondParent(true);
        });
    }

    function updateForm() {
        if (roleLid.checked) {
            memberFields.style.display = 'block';
            groupFields.style.display = 'block';
            groupInput.setAttribute('required', 'required');
            phoneInput.setAttribute('name', 'parentsPhone'); // Use parentsPhone field
            parentsNamesInput.setAttribute('required', 'required');
            if (isSecondParentOpen) {
                showSecondParent();
            } else {
                labelEmail.innerText = emailLidLabel;
                labelPhone.innerText = phoneLidLabel;
                if (secondParentToggleWrapper) secondParentToggleWrapper.style.display = 'block';
                if (secondParentSection) secondParentSection.style.display = 'none';
            }
        } else {
            memberFields.style.display = 'none';
            groupFields.style.display = 'none';
            groupInput.removeAttribute('required');
            labelEmail.innerText = emailLeidingLabel;
            labelPhone.innerText = phoneLeidingLabel;
            phoneInput.setAttribute('name', 'phone'); // Use generic phone field
            parentsNamesInput.removeAttribute('required');
            if (secondParentToggleWrapper) secondParentToggleWrapper.style.display = 'none';
            if (secondParentSection) secondParentSection.style.display = 'none';
        }
    }

    roleLid.addEventListener('change', updateForm);
    roleLeiding.addEventListener('change', updateForm);
    
    // Auto-format phone numbers
    const memberPhoneInput = document.getElementById('memberPhone');
    
    function formatPhoneInput(input) {
        if (!input) return;
        input.addEventListener('input', (e) => {
            let originalValue = e.target.value;
            let value = originalValue.replace(/\D/g, '');
            let isPlus = originalValue.startsWith('+');
            
            // Normalize 00 to + for internal processing
            if (originalValue.startsWith('00')) {
                isPlus = true;
                value = value.substring(2);
            } else if (originalValue.startsWith('32') && value.length > 9) {
                // If it starts with 32 and is long enough, treat as Belgian local
                value = '0' + value.substring(2);
                isPlus = false;
            }

            // Only auto-convert to Belgian local if it is a Belgian international number
            if (isPlus && value.startsWith('32') && value.length > 2) {
                value = '0' + value.substring(2);
                isPlus = false;
            }
            
            let formatted = '';
            if (value.length > 0) {
                const isMobile = value.startsWith('04');
                const len = value.length;
                
                // If it's international (and not Belgian anymore), just sanitize and keep +
                if (isPlus) {
                    formatted = '+' + value;
                } else {
                    const firstPartLen = isMobile ? 4 : 3;
                    formatted = value.substring(0, firstPartLen);
                    
                    if (len > firstPartLen) {
                        formatted += ' ' + value.substring(firstPartLen, firstPartLen + 2);
                    }
                    if (len > firstPartLen + 2) {
                        formatted += ' ' + value.substring(firstPartLen + 2, firstPartLen + 4);
                    }
                    if (len > firstPartLen + 4) {
                        formatted += ' ' + value.substring(firstPartLen + 4);
                    }
                }
            }
            e.target.value = formatted.trim();
        });
    }

    formatPhoneInput(phoneInput);
    formatPhoneInput(memberPhoneInput);
    formatPhoneInput(secondParentsPhoneInput);

    // Init
    updateForm();
</script>

<%- include('../partials/footer') %>
