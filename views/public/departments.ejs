<%- include('../partials/header') %>

<div class="mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <h1 class="display-4 fw-bold mb-0">Afdelingen</h1>
        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
            <a href="/admin/page/departments" class="btn btn-chiro btn-sm btn-edit-page shadow-sm">
                <i class="bi bi-pencil-square"></i><span class="d-none d-sm-inline ms-1">Bewerk Pagina</span><span class="d-sm-none ms-1">Bewerken</span>
            </a>
        <% } %>
    </div>

    <div class="card p-4 p-md-5">
        <div class="card-body fs-5">
            <%- (content.main && content.main.content) ? content.main.content : '<div class="text-center py-5 text-muted"><i class="bi bi-people display-1 mb-3 d-block"></i><p>Info over afdelingen.</p></div>' %>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>