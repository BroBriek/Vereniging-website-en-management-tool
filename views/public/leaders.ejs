<%- include('../partials/header') %>

<%
var leadersTitle = (content && content.leaders_title && content.leaders_title.content) ? content.leaders_title.content : 'De Leidingsploeg';
var leadersLead = (content && content.leaders_lead && content.leaders_lead.content) ? content.leaders_lead.content : 'Elke zondag staan deze enthousiaste leiders en leidsters paraat om de leukste spelen, onvergetelijke weekends en het legendarische zomerkamp te organiseren!';
%>

<div class="scrapbook-canvas<% if (user && (user.role === 'admin' || user.role === 'media')) { %> admin-logged-in<% } %>" data-page-slug="leaders">
    <%- include('../partials/live_editor_top', { pageSlug: 'leaders', pageTitle: 'Leiding' }) %>

    <!-- Header Spread -->
    <header class="scrapbook-page-header">
        <span class="washi-tape washi-tape-yellow washi-tape-top-left"></span>
        <span class="washi-tape washi-tape-red washi-tape-top-right"></span>

        <h1 class="journal-main-title mb-3" data-live-edit="leaders_title" data-live-edit-type="text">
            <%= leadersTitle %>
        </h1>

        <p class="journal-main-lead mb-3" data-live-edit="leaders_lead" data-live-edit-type="text">
            <%= leadersLead %>
        </p>

        <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
            <div class="d-flex align-items-center gap-2 mt-3 pt-2 border-top">
                <a href="/admin/leaders" class="btn btn-outline-primary btn-sm rounded-pill shadow-sm">
                    <i class="bi bi-person-lines-fill me-1"></i> Leiders toevoegen / bewerken in beheer
                </a>
            </div>
        <% } %>
    </header>

    <!-- Leaders Groups -->
    <% Object.keys(groups).forEach(groupName => { %>
        <% if (groups[groupName].length > 0) { 
            var groupClass = groupName.toLowerCase().replace(/[^a-z]/g, '');
        %>
            <section class="mb-5">
                <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
                    <h3 class="group-header group-<%= groupClass %> px-4 py-2 rounded-pill shadow-sm mb-0 fs-4 fw-bold">
                        <%= groupName %>
                    </h3>
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-2">
                        <%= groups[groupName].length %> <%= groups[groupName].length === 1 ? 'leider/leidster' : 'leiders & leidsters' %>
                    </span>
                </div>

                <% if (groups[groupName].length > 4) { %>
                    <!-- Carousel Layout for many items (Original Structure) -->
                    <div class="carousel-container">
                        <button class="carousel-control-prev d-none d-md-flex" onclick="scrollCarousel(this, -1)" aria-label="Vorige">
                            <i class="bi bi-chevron-left"></i>
                        </button>
                        <div class="leader-carousel mb-4">
                            <% groups[groupName].forEach(leader => { %>
                                <div class="leader-card-wrapper" 
                                     data-leader="<%= JSON.stringify(leader) %>"
                                     onclick="openLeaderModal(this)">
                                    <div class="card h-100 leader-card border-0 shadow-sm">
                                        <% if (leader.image) { %>
                                            <div class="position-relative">
                                                <img src="<%= leader.image %>" class="card-img-top" alt="<%= leader.name %>" 
                                                     style="height: 280px; object-fit: cover;" draggable="false">
                                                <% if (leader.is_head_leader) { %>
                                                    <div class="position-absolute top-0 end-0 m-2">
                                                        <span class="badge bg-warning text-dark shadow-sm">Hoofdleiding</span>
                                                    </div>
                                                <% } %>
                                            </div>
                                        <% } else { %>
                                            <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 280px;">
                                                <i class="bi bi-person-circle display-4"></i>
                                            </div>
                                        <% } %>
                                        <div class="card-body text-center">
                                            <h5 class="card-title fw-bold mb-1 text-primary"><%= leader.name %></h5>
                                            <p class="card-text small text-muted mb-0">
                                                <%= leader.years_active %> jaar leiding
                                            </p>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                        <button class="carousel-control-next d-none d-md-flex" onclick="scrollCarousel(this, 1)" aria-label="Volgende">
                            <i class="bi bi-chevron-right"></i>
                        </button>
                    </div>
                <% } else { %>
                    <!-- Mobile: Carousel Layout for few items -->
                    <div class="leader-carousel mb-4 d-flex d-md-none">
                        <% groups[groupName].forEach(leader => { %>
                            <div class="leader-card-wrapper" 
                                 data-leader="<%= JSON.stringify(leader) %>"
                                 onclick="openLeaderModal(this)">
                                <div class="card h-100 leader-card border-0 shadow-sm">
                                    <% if (leader.image) { %>
                                        <div class="position-relative">
                                            <img src="<%= leader.image %>" class="card-img-top" alt="<%= leader.name %>" 
                                                 style="height: 280px; object-fit: cover;" draggable="false">
                                            <% if (leader.is_head_leader) { %>
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge bg-warning text-dark shadow-sm">Hoofdleiding</span>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 280px;">
                                            <i class="bi bi-person-circle display-4"></i>
                                        </div>
                                    <% } %>
                                    <div class="card-body text-center">
                                        <h5 class="card-title fw-bold mb-1 text-primary"><%= leader.name %></h5>
                                        <p class="card-text small text-muted mb-0">
                                            <%= leader.years_active %> jaar leiding
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>

                    <!-- Desktop: Standard Grid Layout for few items -->
                    <div class="row d-none d-md-flex g-4 mb-4">
                        <% groups[groupName].forEach(leader => { %>
                            <div class="col-md-6 col-lg-3 mb-4" style="cursor: pointer;" 
                                 data-leader="<%= JSON.stringify(leader) %>"
                                 onclick="openLeaderModal(this)">
                                <div class="card h-100 leader-card border-0 shadow-sm">
                                    <% if (leader.image) { %>
                                        <div class="position-relative">
                                            <img src="<%= leader.image %>" class="card-img-top" alt="<%= leader.name %>" 
                                                 style="height: 280px; object-fit: cover;" draggable="false">
                                            <% if (leader.is_head_leader) { %>
                                                <div class="position-absolute top-0 end-0 m-2">
                                                    <span class="badge bg-warning text-dark shadow-sm">Hoofdleiding</span>
                                                </div>
                                            <% } %>
                                        </div>
                                    <% } else { %>
                                        <div class="bg-light text-muted d-flex align-items-center justify-content-center" style="height: 280px;">
                                            <i class="bi bi-person-circle display-4"></i>
                                        </div>
                                    <% } %>
                                    <div class="card-body text-center">
                                        <h5 class="card-title fw-bold mb-1 text-primary"><%= leader.name %></h5>
                                        <p class="card-text small text-muted mb-0">
                                            <%= leader.years_active %> jaar leiding
                                        </p>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </section>
        <% } %>
    <% }) %>
</div>

<!-- Leader Details Modal -->
<div class="modal fade" id="leaderModal" tabindex="-1" aria-labelledby="leaderModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden position-relative">
            <div class="modal-header border-0 pb-0 pt-4 px-4">
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal" aria-label="Sluiten"></button>
            </div>
            <div class="modal-body p-4 pt-0">
                <div class="text-center mb-3">
                    <div class="mx-auto rounded-circle overflow-hidden shadow mb-3 border border-3 border-white" style="width: 140px; height: 140px; background: #f1f5f9;">
                        <img id="modalImage" src="" alt="Leider foto" class="w-100 h-100 object-fit-cover">
                    </div>
                    <h3 class="fw-bold mb-1 text-chiro-blue font-playful" id="modalName"></h3>
                    <span class="badge bg-light text-muted border rounded-pill px-3 py-1 font-playful">Chiro <%= orgName %></span>
                </div>

                <div class="row g-2 justify-content-center mb-3">
                    <div class="col-auto">
                        <div class="p-2 border rounded-3 bg-light text-center" style="min-width: 110px;">
                            <div class="text-muted small text-uppercase mb-1"><i class="bi bi-hourglass-split text-primary"></i> Ervaring</div>
                            <div class="fw-bold text-dark"><span id="modalYears"></span> jaar</div>
                        </div>
                    </div>
                    
                    <div class="col-auto" id="modalBirthDateWrapper" style="display:none;">
                        <div class="p-2 border rounded-3 bg-light text-center" style="min-width: 110px;">
                            <div class="text-muted small text-uppercase mb-1"><i class="bi bi-gift text-danger"></i> Verjaardag</div>
                            <div class="fw-bold text-dark" id="modalBirthDate"></div>
                        </div>
                    </div>

                    <div class="col-auto" id="modalPhoneWrapper" style="display:none;">
                        <div class="p-2 border rounded-3 bg-light text-center" style="min-width: 110px;">
                            <div class="text-muted small text-uppercase mb-1"><i class="bi bi-telephone text-success"></i> Telefoon</div>
                            <div class="fw-bold text-dark"><a id="modalPhone" href="" class="text-decoration-none text-dark"></a></div>
                        </div>
                    </div>
                </div>

                <div class="text-center">
                    <h6 class="mb-2 text-primary fw-bold font-playful" id="modalStudy"></h6>
                    <div class="d-flex justify-content-center">
                        <p class="fst-italic text-muted small" id="modalExtra" style="max-width: 85%;"></p>
                    </div>
                    <% if (user && (user.role === 'admin' || user.role === 'media')) { %>
                        <div class="mt-3 pt-3 border-top">
                            <a id="modalEditLink" href="#" class="btn btn-sm btn-outline-primary rounded-pill px-4">
                                <i class="bi bi-pencil me-1"></i> Deze leiding bewerken
                            </a>
                        </div>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function openLeaderModal(element) {
        const leaderJson = element.getAttribute('data-leader');
        if (!leaderJson) return;
        
        const leader = JSON.parse(leaderJson);
        
        document.getElementById('modalName').textContent = leader.name;
        document.getElementById('modalYears').textContent = leader.years_active;
        document.getElementById('modalStudy').textContent = leader.study || '';
        document.getElementById('modalExtra').textContent = leader.extra_info || '';

        const birthDateWrapper = document.getElementById('modalBirthDateWrapper');
        const birthDateSpan = document.getElementById('modalBirthDate');
        if (leader.birth_date) {
            const date = new Date(leader.birth_date);
            const options = { day: 'numeric', month: 'long', year: 'numeric' };
            birthDateSpan.textContent = date.toLocaleDateString('nl-BE', options);
            birthDateWrapper.style.display = 'block';
        } else {
            birthDateWrapper.style.display = 'none';
        }

        const phoneWrapper = document.getElementById('modalPhoneWrapper');
        const phoneLink = document.getElementById('modalPhone');
        if (leader.phone_number) {
            phoneLink.textContent = leader.phone_number;
            phoneLink.href = 'tel:' + leader.phone_number.replace(/\s+/g, '');
            phoneWrapper.style.display = 'block';
        } else {
            phoneWrapper.style.display = 'none';
        }
        
        const editLink = document.getElementById('modalEditLink');
        if (editLink) {
            editLink.href = `/admin/leaders/${leader.id}/edit`;
        }

        const img = document.getElementById('modalImage');
        if (leader.image) {
            img.src = leader.image;
            img.style.display = 'block';
        } else {
            img.style.display = 'none';
        }

        const myModal = new bootstrap.Modal(document.getElementById('leaderModal'));
        myModal.show();
    }

    function scrollCarousel(button, direction) {
        const container = button.closest('.carousel-container');
        const carousel = container.querySelector('.leader-carousel');
        const scrollAmount = carousel.offsetWidth * 0.8;
        carousel.scrollBy({
            left: direction * scrollAmount,
            behavior: 'smooth'
        });
    }
</script>

<%- include('../partials/live_editor_bottom') %>
<%- include('../partials/footer') %>
