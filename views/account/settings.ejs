<%- include('../partials/header') %>

<div class="container mt-4">
    <h1>Account Instellingen</h1>
    <p class="lead">Beheer je account en voorkeuren.</p>
    
    <div class="row">
        <!-- Profile Picture Settings -->
        <div class="col-md-12 mb-4">
            <div class="card">
                <div class="card-header text-white" style="background-color: #db3e41;">
                    Profielfoto
                </div>
                <div class="card-body d-flex align-items-center">
                    <div class="me-4 text-center">
                        <% if (user.profilePicture) { %>
                            <img src="<%= user.profilePicture %>" alt="Profielfoto" class="rounded-circle" style="width: 100px; height: 100px; object-fit: cover; border: 3px solid #db3e41;">
                        <% } else { %>
                            <% 
                                const getAvatarColor = (username) => {
                                    if (!username) return '#db3e41';
                                    const vibrantColors = ['#f1c40f', '#2ecc71', '#e67e22', '#e74c3c', '#3498db', '#9b59b6', '#1abc9c', '#d35400'];
                                    let hash = 0;
                                    for (let i = 0; i < username.length; i++) {
                                        hash = username.charCodeAt(i) + ((hash << 5) - hash);
                                    }
                                    return vibrantColors[Math.abs(hash) % vibrantColors.length];
                                };
                                const getInitials = (username) => {
                                    if (!username) return '?';
                                    return username.substring(0, 2).toUpperCase();
                                };
                            %>
                            <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold shadow-sm" style="width: 100px; height: 100px; font-size: 2.5rem; background-color: <%= getAvatarColor(user.username) %>;">
                                <%= getInitials(user.username) %>
                            </div>
                        <% } %>
                    </div>
                    <div class="flex-grow-1">
                        <form action="/account/profile-picture" method="POST" enctype="multipart/form-data" class="d-flex gap-2 align-items-center mb-2">
                            <input type="file" class="form-control" name="profilePicture" accept="image/*" required>
                            <button type="submit" class="btn btn-primary">Uploaden</button>
                        </form>
                        <% if (user.profilePicture) { %>
                            <form action="/account/profile-picture/delete" method="POST">
                                <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Ben je zeker dat je je profielfoto wilt verwijderen?')">Profielfoto Verwijderen</button>
                            </form>
                        <% } %>
                        <p class="text-muted small mt-2 mb-0">Upload een afbeelding (JPG, PNG, GIF). Max 5MB.</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Password Settings -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    Wachtwoord Wijzigen
                </div>
                <div class="card-body">
                    <form action="/account/password" method="POST">
                        <div class="mb-3">
                            <label class="form-label">Huidig Wachtwoord</label>
                            <input type="password" class="form-control" name="currentPassword" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Nieuw Wachtwoord</label>
                            <input type="password" class="form-control" name="newPassword" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Bevestig Nieuw Wachtwoord</label>
                            <input type="password" class="form-control" name="confirmPassword" required>
                        </div>
                        <button type="submit" class="btn btn-primary">Wachtwoord Bijwerken</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Notification Settings -->
        <div class="col-md-6 mb-4">
            <div class="card">
                <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                    <span>Meldingen</span>
                    <a href="/notificaties" class="text-white text-decoration-none" title="Hulp bij notificaties">
                        <i class="bi bi-question-circle fs-5"></i>
                    </a>
                </div>
                <div class="card-body">
                    <!-- Push Notification Setup -->
                    <h5 class="card-title h6 mb-3">Push Meldingen (App/Browser)</h5>
                    <p class="small text-muted">Ontvang meldingen direct op dit toestel.</p>
                    <div id="notification-ui" class="mb-4">
                        <button id="enable-push-btn" class="btn btn-outline-success w-100">
                            <i class="bi bi-bell"></i> Meldingen Inschakelen
                        </button>
                        <p id="push-status" class="mt-2 text-muted small"></p>
                    </div>

                    <hr class="my-4">

                    <!-- Email Notification Setup -->
                    <h5 class="card-title h6 mb-3">E-mailinstellingen</h5>
                    
                    <% if (!user.emailVerified) { %>
                        <div class="alert alert-warning py-2 small">
                            Je e-mailadres is nog niet geverifieerd.
                        </div>
                        <form action="/account/email" method="POST" class="mb-3">
                            <div class="input-group mb-2">
                                <input type="email" class="form-control" name="email" value="<%= user.email || '' %>" placeholder="jouw@email.com" required>
                                <button type="submit" class="btn btn-info text-white">Verifiëren</button>
                            </div>
                        </form>
                    <% } else { %>
                        <div class="mb-3">
                            <p class="mb-2 small"><strong>Geverifieerd e-mailadres:</strong><br><%= user.email %></p>
                            
                            <form action="/account/email-toggle" method="POST" id="emailToggleForm">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="emailNotifToggle" name="enabled" <%= user.emailNotificationsEnabled ? 'checked' : '' %>>
                                    <label class="form-check-label" for="emailNotifToggle">
                                        <span id="emailToggleStatus"><%= user.emailNotificationsEnabled ? 'E-mailmeldingen zijn AAN' : 'E-mailmeldingen zijn UIT' %></span>
                                    </label>
                                </div>
                            </form>
                        </div>
                    <% } %>

                    <hr class="my-4">

                    <!-- Preferences -->
                    <h5 class="card-title h6 mb-3">Voorkeuren</h5>
                    <p class="small text-muted mb-3">Kies waarover je meldingen wilt ontvangen (via push en/of e-mail).</p>

                    <form action="/account/notifications/preferences" method="POST">
                        <% 
                            const prefs = user.notificationPreferences || { newPost: true, mention: true, comment: true, reaction: true };
                            const p = (typeof prefs === 'string') ? JSON.parse(prefs) : prefs;
                        %>
                        
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="prefNewPost" name="newPost" <%= p.newPost ? 'checked' : '' %>>
                            <label class="form-check-label small" for="prefNewPost">Nieuwe berichten in Leidingshoekje</label>
                        </div>
                        
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="prefMention" name="mention" <%= p.mention ? 'checked' : '' %>>
                            <label class="form-check-label small" for="prefMention">Wanneer ik genoemd word (@mention)</label>
                        </div>
                        
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="prefComment" name="comment" <%= p.comment ? 'checked' : '' %>>
                            <label class="form-check-label small" for="prefComment">Reacties op mijn berichten</label>
                        </div>
                        
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="prefReaction" name="reaction" <%= p.reaction ? 'checked' : '' %>>
                            <label class="form-check-label small" for="prefReaction">Likes op mijn berichten</label>
                        </div>

                        <button type="submit" class="btn btn-warning w-100 btn-sm">Voorkeuren Opslaan</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- iOS Install Modal -->
<div class="modal fade" id="iosInstallModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title">Meldingen op iOS</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Sluiten"></button>
      </div>
      <div class="modal-body">
        <p>Apple vereist dat je deze website eerst toevoegt aan je startscherm voordat je meldingen kunt ontvangen.</p>
        <ol class="ps-3">
            <li class="mb-2">Tik op de <strong>Deel</strong> knop <i class="bi bi-box-arrow-up"></i> in de menubalk van Safari.</li>
            <li class="mb-2">Scroll omlaag en kies <strong>Zet op beginscherm</strong> <i class="bi bi-plus-square"></i>.</li>
            <li>Open de nieuwe app op je beginscherm en zet meldingen aan bij Instellingen.</li>
        </ol>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Begrepen</button>
      </div>
    </div>
  </div>
</div>

<script>
// Email Toggle Logic
const emailToggle = document.getElementById('emailNotifToggle');
const emailForm = document.getElementById('emailToggleForm');
const emailStatus = document.getElementById('emailToggleStatus');

if (emailToggle) {
    emailToggle.addEventListener('change', function() {
        // Submit form automatically when toggled
        emailForm.submit();
    });
}

const VAPID_PUBLIC_KEY = '<%= vapidPublicKey %>';

// Function to convert VAPID key
function urlBase64ToUint8Array(base64String) {
  const padding = '='.repeat((4 - base64String.length % 4) % 4);
  const base64 = (base64String + padding)
    .replace(/\-/g, '+')
    .replace(/_/g, '/');
  const rawData = window.atob(base64);
  const outputArray = new Uint8Array(rawData.length);
  for (let i = 0; i < rawData.length; ++i) {
    outputArray[i] = rawData.charCodeAt(i);
  }
  return outputArray;
}

const enableBtn = document.getElementById('enable-push-btn');
const statusText = document.getElementById('push-status');

async function registerServiceWorker() {
  if ('serviceWorker' in navigator) {
    try {
      const registration = await navigator.serviceWorker.register('/sw.js');
      console.log('Service Worker registered');
      return registration;
    } catch (error) {
      console.error('Service Worker registration failed:', error);
    }
  }
  return null;
}

async function subscribeUserToPush() {
  if (!VAPID_PUBLIC_KEY) {
      alert('Server configuratie fout: VAPID key ontbreekt.');
      return;
  }

  try {
    const permission = await Notification.requestPermission();
    if (permission !== 'granted') {
      statusText.innerText = 'Meldingen zijn geblokkeerd. Sta meldingen toe in je browser.';
      return;
    }

    const registration = await navigator.serviceWorker.ready;
    if (!registration) return;

    const subscription = await registration.pushManager.subscribe({
      userVisibleOnly: true,
      applicationServerKey: urlBase64ToUint8Array(VAPID_PUBLIC_KEY)
    });

    console.log('Received PushSubscription:', JSON.stringify(subscription));

    await fetch('/account/subscribe', {
      method: 'POST',
      body: JSON.stringify(subscription),
      headers: {
        'Content-Type': 'application/json'
      }
    });

    statusText.innerText = 'Meldingen zijn ingeschakeld voor dit toestel.';
    enableBtn.disabled = true;
    enableBtn.innerText = 'Ingeschakeld';
    enableBtn.classList.remove('btn-outline-success');
    enableBtn.classList.add('btn-success');

  } catch (err) {
    console.error('Failed to subscribe the user: ', err);
    statusText.innerText = 'Kon meldingen niet inschakelen. Sta meldingen toe in je browser.';
  }
}

// Check current status
const isIOS = /iPad|iPhone|iPod/.test(navigator.userAgent) || (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
const inStandalone = window.matchMedia('(display-mode: standalone)').matches || navigator.standalone;

if ('serviceWorker' in navigator && 'PushManager' in window) {
    registerServiceWorker().then(async () => {
        const registration = await navigator.serviceWorker.ready;
        const subscription = await registration.pushManager.getSubscription();
        
        if (subscription) {
             statusText.innerText = 'Meldingen zijn al actief op dit toestel.';
             enableBtn.disabled = true;
             enableBtn.innerText = 'Al Ingeschakeld';
             enableBtn.classList.remove('btn-outline-success');
             enableBtn.classList.add('btn-success');
        }
    });

    enableBtn.addEventListener('click', subscribeUserToPush);
} else {
    if (isIOS && !inStandalone) {
        // iOS User in Browser - Show specific instructions
        statusText.innerText = 'Voeg de app toe aan je beginscherm om meldingen te ontvangen.';
        enableBtn.disabled = false;
        
        // Initialize Modal
        const iosModal = new bootstrap.Modal(document.getElementById('iosInstallModal'));
        
        enableBtn.addEventListener('click', function(e) {
            e.preventDefault();
            iosModal.show();
        });
    } else if (isIOS && inStandalone) {
        statusText.innerText = 'Deze iOS versie ondersteunt geen push meldingen. Update je toestel naar iOS 16.4 of nieuwer.';
        enableBtn.disabled = true;
    } else {
        statusText.innerText = 'Push meldingen worden niet ondersteund door deze browser.';
        enableBtn.disabled = true;
    }
}
</script>

<%- include('../partials/footer') %>
